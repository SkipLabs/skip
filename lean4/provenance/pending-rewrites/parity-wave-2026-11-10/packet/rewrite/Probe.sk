    else { L4_Lean_Meta_Tactic_Simp_Simproc.f_Simp_simprocArrayCore_spec_0_0d13093a68(runtime, args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11], args[12]) }
