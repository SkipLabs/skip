    else { L4_Lean_Meta_Tactic_Simp_Rewrite.f_Simp_preDefault_lam_0_da18db3c18(runtime, args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9]) }
  | 4 ->
    if (old) { L4_Lean_Meta_Tactic_Simp_Rewrite.f_Simp_tryTheoremCore_go_eda42a565c_fallback(runtime, args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11], args[12], args[13], args[14]) }
    else { L4_Lean_Meta_Tactic_Simp_Rewrite.f_Simp_tryTheoremCore_go_eda42a565c(runtime, args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11], args[12], args[13], args[14]) }
  | 5 -> L4_Lean_Meta_Tactic_Simp_Simproc.f_Meta_Simp_simprocArrayCore_90779dbc46(runtime, args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10])
