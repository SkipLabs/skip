// Validate the same constructor projections as the original, including discarded fields.
fun f_rewriteWave_decide_fields(value: LeanValue, tag: LeanTag.Value, count: Int): Array<LeanValue> {
  if (leanTag(value) != tag) return leanFail("non-exhaustive Lean case");
