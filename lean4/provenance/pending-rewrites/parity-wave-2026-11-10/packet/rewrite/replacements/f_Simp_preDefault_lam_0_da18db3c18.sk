  value match {
  | LeanCtor(_, fields) -> fields
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

fun f_rewriteWave_decide_bool(value: LeanValue): Bool {
  leanTag(value) match {
  | LeanTag.Bool_false -> false
  | LeanTag.Bool_true -> true
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

// Preserve error payload and returned world, rather than converting failure to no-match.
fun f_rewriteWave_decide_ok(output: LeanValue): Bool {
  leanTag(output) match {
  | LeanTag.EST_Out_ok ->
    _ = leanField(output, 0);
    _ = leanField(output, 1);
    true
  | LeanTag.EST_Out_error ->
    _ = leanField(output, 0);
    _ = leanField(output, 1);
    false
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

fun f_rewriteWave_decide_continue(world: LeanValue): LeanValue {
  LeanCtor(LeanTag.EST_Out_ok, Array[LeanCtor(LeanTag.Meta_Simp_Step_continue, Array[LeanCtor(LeanTag.Option_none, Array[])]), world])
}

fun f_rewriteWave_decide_recover(runtime: mutable LeanExecution, failure: LeanValue): LeanValue {
  exception = leanField(failure, 0);
  if (f_rewriteWave_decide_bool(L4_Lean_Exception.f_Lean_Exception_isInterrupt_eb68b9cc5e(runtime, exception))) return failure;
  if (f_rewriteWave_decide_bool(L4_Lean_CoreM.f_Lean_Exception_isRuntime_7532163bc2(runtime, exception))) return failure;
  // Ordinary elaboration failure is swallowed, retaining its world and reference effects.
  f_rewriteWave_decide_continue(leanField(failure, 1))
}

