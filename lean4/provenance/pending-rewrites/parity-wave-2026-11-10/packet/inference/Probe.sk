  // Refusing further postponement without universe approximation returns false
  // and keeps the unsolved entry (the helper did not throw).
  noApproxConfig = leanReplaceField(L4_Lean_Meta_Basic.f_Meta_Context_config_2f4f6fdcbe(runtime, state.metaContext), 11, leanBool(false));
  noApproxKey = L4_Lean_Meta_Basic.f_Meta_Config_toKey_993126c67a(runtime, noApproxConfig);
  noApproxMeta = leanReplaceField(state.metaContext, 0, LeanCtor(LeanTag.Private_Lean_Meta_Basic_0_Lean_Meta_ConfigWithKey_mk, Array[noApproxConfig, noApproxKey]));
  (refused, refusedAfter) = f_inference_probe_compare("postponed no progress refused", noProgressSaved, 5,
    Array[leanBool(false), leanBool(false), noApproxMeta, state.metaStateRef, state.coreContext, state.coreStateRef, world], Some(f_inference_probe_ok(leanBool(false), world)));
  refusedRuntime = refusedAfter.restoreRaw();
  assert(rewriteProbeSameInput(leanField(refusedRuntime.readRef(state.metaStateRef), 3), leanField(levelRuntime.readRef(state.metaStateRef), 3)));
  !checks = checks + 1;

  // Check old ++ new ordering with a new, genuinely postponed sort equality.
  mergeRuntime = saved.restoreRaw();
  mergeState = mergeRuntime.readRef(state.metaStateRef);
  mergeRuntime.writeRef(state.metaStateRef, Some(leanReplaceField(mergeState, 0, levelMctx)));
  mergeSaved = f_inference_probe_postponed(mergeRuntime, state, zero, zero);
  leftSort = L4_Lean_Expr.f_Lean_mkSort_ccbb836181(runtime, levelM);
  rightSort = L4_Lean_Expr.f_Lean_mkSort_ccbb836181(runtime, blocked);
  (merged, mergedAfter) = f_inference_probe_compare("defeq old postponed before new", mergeSaved, 3,
    Array[leftSort, rightSort, leanBool(true)].concat(contextArgs), Some(f_inference_probe_ok(leanBool(true), world)));
  mergedRuntime = mergedAfter.restoreRaw();
  mergedEntries = leanArray(L4_Lean_Data_PersistentArray.f_Lean_PersistentArray_toArray_35eebe4fe9(mergedRuntime, leanField(mergedRuntime.readRef(state.metaStateRef), 3)));
  assert(mergedEntries.size() >= 2);
  assert(rewriteProbeSameInput(leanField(mergedEntries[0], 1), zero));
  assert(rewriteProbeSameInput(leanField(mergedEntries[0], 2), zero));
  assert(rewriteProbeSameInput(leanField(mergedEntries[1], 1), levelM));
  assert(rewriteProbeSameInput(leanField(mergedEntries[1], 2), blocked));
  !checks = checks + 1;

  // Real runtime exception: recursion limit fires after clearing the transient
  // cache and resetting postponed entries. Runtime errors do NOT restore them.
  limitedCore = leanReplaceField(state.coreContext, 0, leanReplaceField(leanField(state.coreContext, 0), 3, LeanNatLiterals.n1));
  !limitedCore = leanReplaceField(limitedCore, 1, LeanNatLiterals.n1);
  (depthError, depthAfter) = f_inference_probe_compare("defeq runtime exception retains reset", pendingSaved, 3,
    Array[a, a, leanBool(false), state.metaContext, state.metaStateRef, limitedCore, state.coreStateRef, world]);
  assert(leanTag(depthError) == LeanTag.EST_Out_error);
  assert(leanIsTrue(L4_Lean_CoreM.f_Lean_Exception_isRuntime_7532163bc2(runtime, leanField(depthError, 0))));
  assert(rewriteProbeSameInput(leanField(depthError, 1), world));
  depthRuntime = depthAfter.restoreRaw();
  baselineRuntime = saved.restoreRaw();
  assert(rewriteProbeSameInput(leanField(depthRuntime.readRef(state.metaStateRef), 3), leanField(baselineRuntime.readRef(state.metaStateRef), 3)));
  !checks = checks + 1;
  // Populate a real stale transient cache and an unrelated permanent cache.
  // Early runtime failure makes the cleared/retained fields directly observable.
  cacheRuntime = saved.restoreRaw();
  cacheState = cacheRuntime.readRef(state.metaStateRef);
  cacheBefore = leanField(cacheState, 1);
  cacheKeyResult = L4_Lean_Meta_Basic.f_Lean_Meta_mkDefEqCacheKey_32603aaacd(cacheRuntime, a, a, state.metaContext, world);
  assert(leanTag(cacheKeyResult) == LeanTag.EST_Out_ok);
  staleTrans = L4_Lean_Meta_ExprDefEq.f_Meta_cacheResult_spec_0_3db025d4e6(cacheRuntime, leanField(cacheBefore, 4), leanField(cacheKeyResult, 0), leanBool(false));
  permanent = L4_Lean_Meta_ExprDefEq.f_Meta_cacheResult_spec_0_3db025d4e6(cacheRuntime, leanField(cacheBefore, 5), leanField(cacheKeyResult, 0), leanBool(true));
  cached = leanReplaceField(leanReplaceField(cacheBefore, 4, staleTrans), 5, permanent);
  cacheRuntime.writeRef(state.metaStateRef, Some(leanReplaceField(cacheState, 1, cached)));
  (cacheFailure, cacheAfter) = f_inference_probe_compare("defeq resets only transient cache", cacheRuntime.checkpoint(), 3,
    Array[a, a, leanBool(false), state.metaContext, state.metaStateRef, limitedCore, state.coreStateRef, world]);
  assert(leanTag(cacheFailure) == LeanTag.EST_Out_error);
  cacheAfterRuntime = cacheAfter.restoreRaw();
  finalCache = leanField(cacheAfterRuntime.readRef(state.metaStateRef), 1);
  assert(rewriteProbeSameInput(leanField(finalCache, 4), leanField(cacheBefore, 4)));
  assert(rewriteProbeSameInput(leanField(finalCache, 5), permanent));
  for (i in Array[0, 1, 2, 3, 6, 7]) assert(rewriteProbeSameInput(leanField(finalCache, i), leanField(cacheBefore, i)));
  !checks = checks + 1;

  // Ordinary missing-constant error restores the original pending queue.
  missing = L4_Lean_Expr.f_Lean_mkConst_b40a363b86(runtime, f_inference_probe_name(runtime, "inferenceMissing"), LeanCtor(LeanTag.List_nil, Array[]));
  (ordinaryFailure, ordinaryAfter) = f_inference_probe_compare("defeq ordinary exception restores", pendingSaved, 3,
    Array[missing, x, leanBool(false)].concat(contextArgs));
  assert(leanTag(ordinaryFailure) == LeanTag.EST_Out_error);
  assert(!leanIsTrue(L4_Lean_CoreM.f_Lean_Exception_isRuntime_7532163bc2(runtime, leanField(ordinaryFailure, 0))));
  ordinaryRuntime = ordinaryAfter.restoreRaw();
  assert(rewriteProbeSameInput(leanField(ordinaryRuntime.readRef(state.metaStateRef), 0), leanField(pendingRuntime.readRef(state.metaStateRef), 0)));
  assert(rewriteProbeSameInput(leanField(ordinaryRuntime.readRef(state.metaStateRef), 3), leanField(pendingRuntime.readRef(state.metaStateRef), 3)));
  !checks = checks + 1;

  // Interrupt and runtime-tagged exceptions bypass error-leaf tracing.
  interrupt = LeanCtor(LeanTag.Exception_internal, Array[leanReadInitializer(runtime, "Lean.interruptExceptionId"), LeanCtor(LeanTag.List_nil, Array[])]);
  runtimeKind = L4_Init_Prelude.f_Lean_Name_mkStr2_ed89eae6ad(runtime, LeanText("runtime"), LeanText("maxRecDepth"));
  runtimeMessage = LeanCtor(LeanTag.MessageData_tagged, Array[runtimeKind, L4_Lean_Message.f_Lean_stringToMessageData_1e55fa4f40(runtime, LeanText("inference depth sentinel"))]);
  runtimeException = LeanCtor(LeanTag.Exception_error, Array[leanField(state.coreContext, 2), runtimeMessage]);
  for (exception in Array[interrupt, runtimeException]) {
    action = LeanClosure(f_inference_probe_traceContinuation, 8, Array[calls, leanBool(false), exception]);
    core = f_inference_probe_traceOption(runtime, state.coreContext, "error");
    (result, after) = f_inference_probe_compare("trace exception bypass", saved, 7,
      Array[function, empty, action, state.metaContext, state.metaStateRef, core, state.coreStateRef, world], Some(LeanCtor(LeanTag.EST_Out_error, Array[exception, world])));
    beforeRuntime = saved.restoreRaw();
    afterRuntime = after.restoreRaw();
    assert(rewriteProbeSameInput(beforeRuntime.readRef(state.coreStateRef), afterRuntime.readRef(state.coreStateRef)));
    !checks = checks + 1
  };
  print_string(checks.toString() + " inference comparisons completed (timing modes are separate expected failures)")
}
