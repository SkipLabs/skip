// Parent-run only after reviewed integration retains canonical_fallback bodies.
// Default: result/ref/input parity + independent semantic assertions.
// Optional stdin modes: app-old-nanos, app-new-nanos, app-old-heartbeats,
// app-new-heartbeats, postponed-old-nanos, postponed-new-nanos,
// postponed-old-heartbeats, postponed-new-heartbeats. These MUST fail explicitly
// at the unsupported timing primitive; they are not ordinary parity successes.

// Target numbers follow manifest.json order. Arguments retain each canonical ABI.
fun f_inference_probe_call(runtime: mutable LeanExecution, fallback: Bool, target: Int, args: Array<LeanValue>): LeanValue {
  target match {
  | 0 ->
    method = if (fallback) L4_Lean_Meta_Basic.f_Meta_forallTelescopeReducingAuxAux_process_0ca40475ce_fallback else L4_Lean_Meta_Basic.f_Meta_forallTelescopeReducingAuxAux_process_0ca40475ce;
    method(runtime, args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11], args[12], args[13])
  | 1 ->
    method = if (fallback) L4_Lean_Meta_Basic.f_Meta_forallMetaTelescopeReducingAux_process_ae3c4fa1ca_fallback else L4_Lean_Meta_Basic.f_Meta_forallMetaTelescopeReducingAux_process_ae3c4fa1ca;
    method(runtime, args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11])
  | 2 ->
    method = if (fallback) L4_Lean_Meta_Basic.f_Lean_Meta_forallTelescopeReducingAux_49d009dc47_fallback else L4_Lean_Meta_Basic.f_Lean_Meta_forallTelescopeReducingAux_49d009dc47;
    method(runtime, args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9])
  | 3 ->
    method = if (fallback) L4_Lean_Meta_Basic.f_Meta_isExprDefEq_spec_0_bfe54879ba_fallback else L4_Lean_Meta_Basic.f_Meta_isExprDefEq_spec_0_bfe54879ba;
    method(runtime, args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7])
  | 4 ->
    method = if (fallback) L4_Lean_Meta_AppBuilder.f_Meta_mkAppMArgs_loop_42adf6c397_fallback else L4_Lean_Meta_AppBuilder.f_Meta_mkAppMArgs_loop_42adf6c397;
    method(runtime, args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11])
  | 5 ->
    method = if (fallback) L4_Lean_Meta_Basic.f_Lean_Meta_processPostponed_f8ab161000_fallback else L4_Lean_Meta_Basic.f_Lean_Meta_processPostponed_f8ab161000;
    method(runtime, args[0], args[1], args[2], args[3], args[4], args[5], args[6])
  | 6 ->
    method = if (fallback) L4_Lean_Meta_Basic.f_Meta_lambdaTelescopeImp_process_ee1adca301_fallback else L4_Lean_Meta_Basic.f_Meta_lambdaTelescopeImp_process_ee1adca301;
    method(runtime, args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9], args[10], args[11], args[12], args[13], args[14])
  | 7 ->
    method = if (fallback) L4_Lean_Meta_AppBuilder.f_Meta_mkAppM_spec_1_f44548f5b2_fallback else L4_Lean_Meta_AppBuilder.f_Meta_mkAppM_spec_1_f44548f5b2;
    method(runtime, args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7])
  | _ -> leanFail("unknown inference probe target")
  }
}

fun f_inference_probe_name(runtime: mutable LeanExecution, text: String): LeanValue {
  L4_Init_Prelude.f_Lean_Name_mkStr1_4962bb4b4e(runtime, LeanText(text))
}

fun f_inference_probe_ok(value: LeanValue, world: LeanValue): LeanValue {
  LeanCtor(LeanTag.EST_Out_ok, Array[value, world])
}

fun f_inference_probe_compare(
  label: String, saved: LeanExecutionCheckpoint, target: Int,
  args: Array<LeanValue>, expected: ?LeanValue = None(),
): (LeanValue, LeanExecutionCheckpoint) {
  oldArgs = args.map(rewriteProbeCopyInput);
  oldMetrics: mutable Vector<Array<Int>> = mutable Vector[];
  newArgs = args.map(rewriteProbeCopyInput);
  (result, after) = rewriteProbeCompare(label, saved,
    (runtime: mutable LeanExecution) ~> {
      result = f_inference_probe_call(runtime, true, target, oldArgs);
      for (i in Range(0, args.size())) assert(rewriteProbeSameInput(args[i], oldArgs[i]));
      oldMetrics.push(runtime.checkpoint().metrics);
      result
    },
    (runtime: mutable LeanExecution) ~> {
      result = f_inference_probe_call(runtime, false, target, newArgs);
      for (i in Range(0, args.size())) assert(rewriteProbeSameInput(args[i], newArgs[i]));
      result
    }, expected);
  assert(oldMetrics.size() == 1);
  for (i in Range(0, after.metrics.size())) {
    if (i != 4 && i != 7) assert(oldMetrics[0][i] == after.metrics[i])
  };
  // Verify an old checkpoint is still a usable root after both executions.
  restored = saved.restoreRaw();
  assert(native_eq(restored.checkpoint().refs, saved.refs) == 0);
  (result, after)
}

// Capture two arguments, then accept fvars/body and the five Meta/Core/world args.
fun f_inference_probe_telescopeContinuation(runtime: mutable LeanExecution, args: Array<LeanValue>): LeanValue {
  calls = runtime.readRef(args[0]);
  runtime.writeRef(args[0], Some(L4_Init_Prelude.f_Nat_add_86990f4822(runtime, calls, LeanNatLiterals.n1)));
  payload = LeanCtor(LeanTag.Prod_mk, Array[args[2], LeanCtor(LeanTag.Prod_mk, Array[args[3], args[4]])]);
  if (leanIsTrue(args[1])) return LeanCtor(LeanTag.EST_Out_error, Array[LeanText("inference continuation sentinel"), args[8]]);
  f_inference_probe_ok(payload, args[8])
}

// Capture counter/success/value and accept the five Meta/Core/world arguments.
fun f_inference_probe_traceContinuation(runtime: mutable LeanExecution, args: Array<LeanValue>): LeanValue {
  calls = runtime.readRef(args[0]);
  runtime.writeRef(args[0], Some(L4_Init_Prelude.f_Nat_add_86990f4822(runtime, calls, LeanNatLiterals.n1)));
  LeanCtor(if (leanIsTrue(args[1])) LeanTag.EST_Out_ok else LeanTag.EST_Out_error, Array[args[2], args[7]])
}

fun f_inference_probe_traceOption(runtime: mutable LeanExecution, core: LeanValue, suffix: String): LeanValue {
  trace = f_inference_probe_name(runtime, "trace");
  name = if (suffix == "postponed") {
    L4_Init_Prelude.f_Lean_Name_mkStr3_2a3962ce81(runtime, LeanText("Meta"), LeanText("isLevelDefEq"), LeanText("postponed"))
  } else if (suffix == "appBuilder") {
    L4_Init_Prelude.f_Lean_Name_mkStr2_ed89eae6ad(runtime, LeanText("Meta"), LeanText("appBuilder"))
  } else {
    L4_Init_Prelude.f_Lean_Name_mkStr3_2a3962ce81(runtime, LeanText("Meta"), LeanText("appBuilder"), LeanText(suffix))
  };
  option = L4_Init_Prelude.f_Lean_Name_append_54ec01d162(runtime, trace, name);
  cold = leanField(core, 0);
  options = L4_Lean_Data_Options.f_Lean_Options_set_314ab34d9b(runtime, L4_Lean_Data_KVMap.f_Lean_KVMap_instValueBool_0fa99278c1(runtime), leanField(cold, 2), option, leanBool(true));
  leanReplaceField(core, 0, leanReplaceField(cold, 2, options))
}

fun f_inference_probe_checkNames(before: LeanExecutionCheckpoint, after: LeanExecutionCheckpoint, coreRef: LeanValue, count: Int): void {
  original = before.restoreRaw();
  updated = after.restoreRaw();
  oldGenerator = leanField(original.readRef(coreRef), 2);
  newGenerator = leanField(updated.readRef(coreRef), 2);
  assert(rewriteProbeSameInput(leanField(oldGenerator, 0), leanField(newGenerator, 0)));
  assert(leanNat(leanField(newGenerator, 1)) == leanNat(leanField(oldGenerator, 1)).add(LeanNat::fromInt(count)))
}

fun f_inference_probe_localDecl(runtime: mutable LeanExecution, context: LeanValue, fvar: LeanValue): LeanValue {
  found = L4_Lean_LocalContext.f_Lean_LocalContext_find_001c4a7be2(runtime, leanField(context, 3), leanField(fvar, 1));
  assert(leanTag(found) == LeanTag.Option_some);
  leanField(found, 0)
}

fun f_inference_probe_postponed(runtime: mutable LeanExecution, state: RewriteProbeState, left: LeanValue, right: LeanValue): LeanExecutionCheckpoint {
  initial = runtime.readRef(state.metaStateRef);
  entry = LeanCtor(LeanTag.Meta_PostponedEntry_mk, Array[leanField(state.coreContext, 2), left, right, leanField(state.metaContext, 5)]);
  pending = L4_Lean_Data_PersistentArray.f_Lean_PersistentArray_push_8ec9d2434c(runtime, leanField(initial, 3), entry);
  runtime.writeRef(state.metaStateRef, Some(leanReplaceField(initial, 3, pending)));
  runtime.checkpoint()
}

// Used only by expected-failure projection-order modes. Its marker must NOT run.
fun f_inference_probe_projectionMarker(runtime: mutable LeanExecution, args: Array<LeanValue>): LeanValue {
  print_error("UNEXPECTED callback reached before constructor projection");
  leanFail("projection-order callback executed")
}

fun main(): void {
  mode = read_to_end().trim();
  runtime = mutable LeanExecution{unboundedHeartbeats => true, profileRuntime => mode == "profile"};
  leanInitializeSimp(runtime);
  zero: LeanValue = LeanCtor(LeanTag.Level_zero__impl, Array[]);
  one = L4_Lean_Level.f_Lean_mkLevelSucc_2631235517(runtime, zero);
  prop = L4_Lean_Expr.f_Lean_mkSort_ccbb836181(runtime, zero);
  type = L4_Lean_Expr.f_Lean_mkSort_ccbb836181(runtime, one);
  aName = f_inference_probe_name(runtime, "InferenceA");
  xName = f_inference_probe_name(runtime, "inferenceX");
  functionName = f_inference_probe_name(runtime, "inferenceFunction");
  alphaName = f_inference_probe_name(runtime, "alpha");
  binderName = f_inference_probe_name(runtime, "boundX");
  a = L4_Lean_Expr.f_Lean_mkFVar_3175adace5(runtime, aName);
  x = L4_Lean_Expr.f_Lean_mkFVar_3175adace5(runtime, xName);
  function = L4_Lean_Expr.f_Lean_mkFVar_3175adace5(runtime, functionName);
  binder: LeanValue = LeanCtor(LeanTag.BinderInfo_default, Array[]);
  natural: LeanValue = LeanCtor(LeanTag.MetavarKind_natural, Array[]);
  bvar0 = L4_Lean_Expr.f_Lean_mkBVar_eb2781ad2d(runtime, LeanNatLiterals.n0);
  bvar1 = L4_Lean_Expr.f_Lean_mkBVar_eb2781ad2d(runtime, LeanNatLiterals.n1);
  arrow = L4_Lean_Expr.f_Lean_mkForall_fc2281f2c3(runtime, binderName, binder, a, a);
  dependentTail = L4_Lean_Expr.f_Lean_mkForall_fc2281f2c3(runtime, binderName, binder, bvar0, bvar1);
  dependent = L4_Lean_Expr.f_Lean_mkForall_fc2281f2c3(runtime, alphaName, binder, type, dependentTail);
  annotatedA = L4_Lean_Expr.f_Lean_mkAnnotation_fe98cbf276(runtime, f_inference_probe_name(runtime, "inference.annotation"), a);
  annotatedArrow = L4_Lean_Expr.f_Lean_mkForall_fc2281f2c3(runtime, binderName, binder, annotatedA, a);
  annotatedDependent = L4_Lean_Expr.f_Lean_mkAnnotation_fe98cbf276(runtime, f_inference_probe_name(runtime, "inference.head"), dependent);
  locals = L4_Lean_LocalContext.f_Lean_LocalContext_empty_68c9cb2aed(runtime);
  for ((id, localType) in Array[(aName, type), (xName, a), (functionName, arrow)]) {
    !locals = L4_Lean_LocalContext.f_Lean_LocalContext_mkLocalDecl_741af88ec8(runtime, locals, id, id, localType, binder, LeanCtor(LeanTag.LocalDeclKind_default, Array[]))
  };
  environment = rewriteProbeEnvironment(runtime, (Map[] : Map<String, LeanConstantFile>));
  state = rewriteProbeState(runtime, environment, locals, "<inference-parity-wave>");
  calls = runtime.newRef(LeanNatLiterals.n0);
  saved = runtime.checkpoint();
  world = leanNatValue(73);
  empty: LeanValue = LeanArray(Array[]);
  none: LeanValue = LeanCtor(LeanTag.Option_none, Array[]);
  huge = leanBoxNat(LeanNat::parse("184467440737095516170"));
  limits = Array[none, LeanCtor(LeanTag.Option_some, Array[LeanNatLiterals.n0]), LeanCtor(LeanTag.Option_some, Array[LeanNatLiterals.n1]), LeanCtor(LeanTag.Option_some, Array[leanNatValue(2)]), LeanCtor(LeanTag.Option_some, Array[huge])];
  contextArgs = Array[state.metaContext, state.metaStateRef, state.coreContext, state.coreStateRef, world];
  continuation = LeanClosure(f_inference_probe_telescopeContinuation, 9, Array[calls, leanBool(false)]);
  checks = 0;

  if (mode.contains("-short-context")) {
    shortened = LeanCtor(LeanTag.Meta_Context_mk, Array[
      leanField(state.metaContext, 0), leanField(state.metaContext, 1),
      leanField(state.metaContext, 2), leanField(state.metaContext, 3),
      leanField(state.metaContext, 4), leanField(state.metaContext, 5),
      leanField(state.metaContext, 6), leanField(state.metaContext, 7),
      leanField(state.metaContext, 8), leanField(state.metaContext, 9)]);
    marker = LeanClosure(f_inference_probe_projectionMarker, 2, Array[]);
    old = mode.contains("-old-");
    if (mode.contains("lambda-")) {
      _ = f_inference_probe_call(runtime, old, 6, Array[leanBool(false), leanBool(false), none, marker, leanBool(false), leanBool(true), LeanUnavailable("unused consumeLet"), locals, empty, prop, shortened, state.metaStateRef, state.coreContext, state.coreStateRef, world])
    } else {
      _ = f_inference_probe_call(runtime, old, 0, Array[leanBool(false), limits[1], marker, leanBool(false), leanBool(false), locals, empty, LeanNatLiterals.n0, dependent, shortened, state.metaStateRef, state.coreContext, state.coreStateRef, world])
    };
    leanFail("short context unexpectedly accepted")
  };
  if (!mode.isEmpty() && mode != "profile") {
    isApp = mode.contains("app-");
    isOld = mode.contains("-old-");
    heartbeats = mode.contains("heartbeats");
    core = f_inference_probe_traceOption(runtime, state.coreContext, if (isApp) "appBuilder" else "postponed");
    cold = leanField(core, 0);
    hbName = L4_Init_Prelude.f_Lean_Name_mkStr3_2a3962ce81(runtime, LeanText("trace"), LeanText("profiler"), LeanText("useHeartbeats"));
    options = L4_Lean_Data_Options.f_Lean_Options_set_314ab34d9b(runtime, L4_Lean_Data_KVMap.f_Lean_KVMap_instValueBool_0fa99278c1(runtime), leanField(cold, 2), hbName, leanBool(heartbeats));
    !core = leanReplaceField(core, 0, leanReplaceField(cold, 2, options));
    if (isApp) {
      action = LeanClosure(f_inference_probe_traceContinuation, 8, Array[calls, leanBool(true), x]);
      _ = f_inference_probe_call(runtime, isOld, 7, Array[function, empty, action, state.metaContext, state.metaStateRef, core, state.coreStateRef, world])
    } else {
      _ = f_inference_probe_postponed(runtime, state, zero, zero);
      _ = f_inference_probe_call(runtime, isOld, 5, Array[leanBool(false), leanBool(false), state.metaContext, state.metaStateRef, core, state.coreStateRef, world])
    };
    leanFail("unsupported timing mode unexpectedly returned")
  };

  // I-1: lambda-enabled nonbinders do NOT inspect consumeLet. Also exercise
  // lambda-disabled/let-disabled dispatch without touching the irrelevant flags.
  poison = LeanUnavailable("unused telescope flag must remain uninspected");
  for ((label, input, consumeLambda, consumeLet) in Array[
    ("I-1 nonbinder", prop, leanBool(true), poison),
    ("both consumption flags off", prop, leanBool(false), leanBool(false)),
  ]) {
    expectedPayload = LeanCtor(LeanTag.Prod_mk, Array[empty, LeanCtor(LeanTag.Prod_mk, Array[input, state.metaContext])]);
    (result, after) = f_inference_probe_compare(label, saved, 6,
      Array[poison, poison, none, continuation, poison, consumeLambda, consumeLet, locals, empty, input].concat(contextArgs), Some(f_inference_probe_ok(expectedPayload, world)));
    afterRuntime = after.restoreRaw();
    assert(leanNat(afterRuntime.readRef(calls)) == LeanNat::fromInt(1));
    f_inference_probe_checkNames(saved, after, state.coreStateRef, 0);
    !checks = checks + 1
  };

  // Direct forall worker, including the reduction-to-forall continuation path.
  for (reducing in Array[false, true]) {
    for (cleanup in Array[false, true]) {
      for (limitIndex in Range(0, limits.size())) {
        for ((label, input, total) in Array[("dependent", dependent, 2), ("annotated-domain", annotatedArrow, 1)]) {
          count = if (limitIndex == 1) 0 else if (limitIndex == 2) 1 else total;
          args = Array[leanBool(reducing), limits[limitIndex], continuation, leanBool(cleanup), leanBool(false), locals, empty, LeanNatLiterals.n0, input].concat(contextArgs);
          (result, after) = f_inference_probe_compare("forall worker " + label, saved, 0, args);
          assert(leanTag(result) == LeanTag.EST_Out_ok);
          assert(rewriteProbeSameInput(leanField(result, 1), world));
          payload = leanField(result, 0);
          fvars = leanArray(leanField(payload, 0));
          tail = leanField(payload, 1);
          openedBody = leanField(tail, 0);
          openedContext = leanField(tail, 1);
          assert(fvars.size() == count);
          afterRuntime = after.restoreRaw();
          assert(leanNat(afterRuntime.readRef(calls)) == LeanNat::fromInt(1));
          f_inference_probe_checkNames(saved, after, state.coreStateRef, count);
          if (count == 0) assert(rewriteProbeSameInput(openedBody, input));
          if (label == "dependent" && count > 0) {
            firstDecl = f_inference_probe_localDecl(afterRuntime, openedContext, fvars[0]);
            assert(rewriteProbeSameInput(L4_Lean_LocalContext.f_Lean_LocalDecl_type_813f33525c(afterRuntime, firstDecl), type));
            expectedBody = if (count == 1) L4_Lean_Expr.f_Lean_mkForall_fc2281f2c3(afterRuntime, binderName, binder, fvars[0], fvars[0]) else fvars[0];
            assert(rewriteProbeSameInput(openedBody, expectedBody));
            if (count == 2) {
              secondDecl = f_inference_probe_localDecl(afterRuntime, openedContext, fvars[1]);
              assert(rewriteProbeSameInput(L4_Lean_LocalContext.f_Lean_LocalDecl_type_813f33525c(afterRuntime, secondDecl), fvars[0]))
            }
          };
          if (label == "annotated-domain" && count == 1) {
            decl = f_inference_probe_localDecl(afterRuntime, openedContext, fvars[0]);
            assert(rewriteProbeSameInput(L4_Lean_LocalContext.f_Lean_LocalDecl_type_813f33525c(afterRuntime, decl), if (cleanup) a else annotatedA));
            assert(rewriteProbeSameInput(openedBody, a))
          };
          !checks = checks + 1
        }
      }
    }
  };
  // Existing prefix is not re-instantiated: j=1 applies only the newly opened suffix.
  prefix: LeanValue = LeanArray(Array[x]);
  (prefixResult, prefixAfter) = f_inference_probe_compare("forall nonzero j", saved, 0,
    Array[leanBool(false), none, continuation, leanBool(false), leanBool(false), locals, prefix, LeanNatLiterals.n1, dependent].concat(contextArgs));
  prefixPayload = leanField(prefixResult, 0);
  prefixVars = leanArray(leanField(prefixPayload, 0));
  assert(prefixVars.size() == 3 && rewriteProbeSameInput(prefixVars[0], x));
  assert(rewriteProbeSameInput(leanField(leanField(prefixPayload, 1), 0), prefixVars[1]));
  f_inference_probe_checkNames(saved, prefixAfter, state.coreStateRef, 2);
  !checks = checks + 1;

  // Entry chooses original vs WHNF result and skips WHNF at limit zero.
  for (whnfBody in Array[false, true]) {
    for (limit in Array[limits[1], none]) {
      for ((label, input) in Array[("plain", annotatedA), ("head forall", annotatedDependent)]) {
        (result, after) = f_inference_probe_compare("forall entry " + label, saved, 2,
          Array[input, limit, continuation, leanBool(false), leanBool(whnfBody)].concat(contextArgs));
        payload = leanField(result, 0);
        fvars = leanArray(leanField(payload, 0));
        body = leanField(leanField(payload, 1), 0);
        zeroLimit = leanTag(limit) == LeanTag.Option_some;
        if (label == "plain") {
          assert(fvars.size() == 0);
          assert(rewriteProbeSameInput(body, if (whnfBody) a else annotatedA))
        } else if (zeroLimit) {
          assert(fvars.size() == 0);
          assert(rewriteProbeSameInput(body, if (whnfBody) dependent else annotatedDependent))
        } else {
          assert(fvars.size() == 2);
          assert(rewriteProbeSameInput(body, fvars[0]))
        };
        afterRuntime = after.restoreRaw();
        assert(leanNat(afterRuntime.readRef(calls)) == LeanNat::fromInt(1));
        !checks = checks + 1
      }
    }
  };
  failureContinuation = LeanClosure(f_inference_probe_telescopeContinuation, 9, Array[calls, leanBool(true)]);
  (failed, failedAfter) = f_inference_probe_compare("continuation error keeps fresh names", saved, 0,
    Array[leanBool(false), none, failureContinuation, leanBool(false), leanBool(false), locals, empty, LeanNatLiterals.n0, dependent].concat(contextArgs),
    Some(LeanCtor(LeanTag.EST_Out_error, Array[LeanText("inference continuation sentinel"), world])));
  f_inference_probe_checkNames(saved, failedAfter, state.coreStateRef, 2);
  !checks = checks + 1;

  poisonLambda = L4_Lean_Expr.f_Lean_mkLambda_fa85a512c1(runtime, binderName, binder, a, bvar0);
  (poisonLambdaResult, poisonLambdaAfter) = f_inference_probe_compare("lambda leaves let flags unused", saved, 6,
    Array[poison, poison, none, continuation, leanBool(false), leanBool(true), poison, locals, empty, poisonLambda].concat(contextArgs));
  poisonPayload = leanField(poisonLambdaResult, 0);
  assert(leanArray(leanField(poisonPayload, 0)).size() == 1);
  assert(rewriteProbeSameInput(leanField(leanField(poisonPayload, 1), 0), leanArray(leanField(poisonPayload, 0))[0]));
  f_inference_probe_checkNames(saved, poisonLambdaAfter, state.coreStateRef, 1);
  !checks = checks + 1;

  // Metavariable telescope preserves binder order, dependent domains and kinds.
  for (binderInfo in Array[binder, LeanCtor(LeanTag.BinderInfo_implicit, Array[]), LeanCtor(LeanTag.BinderInfo_strictImplicit, Array[]), LeanCtor(LeanTag.BinderInfo_instImplicit, Array[])]) {
    input = L4_Lean_Expr.f_Lean_mkForall_fc2281f2c3(runtime, alphaName, binderInfo, type, dependentTail);
    for (reducing in Array[false, true]) {
      for (limitIndex in Range(0, limits.size())) {
        count = if (limitIndex == 1) 0 else if (limitIndex == 2) 1 else 2;
        (result, after) = f_inference_probe_compare("meta telescope", saved, 1,
          Array[leanBool(reducing), limits[limitIndex], natural, empty, empty, LeanNatLiterals.n0, input].concat(contextArgs));
        assert(leanTag(result) == LeanTag.EST_Out_ok);
        payload = leanField(result, 0);
        mvars = leanArray(leanField(payload, 0));
        tail = leanField(payload, 1);
        infos = leanArray(leanField(tail, 0));
        body = leanField(tail, 1);
        assert(mvars.size() == count && infos.size() == count);
        afterRuntime = after.restoreRaw();
        mctx = leanField(afterRuntime.readRef(state.metaStateRef), 0);
        if (count == 0) assert(rewriteProbeSameInput(body, input));
        if (count > 0) {
          first = L4_Lean_MetavarContext.f_Lean_MetavarContext_getDecl_22100e60b6(afterRuntime, mctx, leanField(mvars[0], 1));
          assert(rewriteProbeSameInput(leanField(first, 0), alphaName));
          assert(rewriteProbeSameInput(leanField(first, 2), type));
          assert(rewriteProbeSameInput(leanField(first, 3), leanField(mctx, 0)));
          expectedKind = if (leanTag(binderInfo) == LeanTag.BinderInfo_instImplicit) LeanTag.MetavarKind_synthetic else LeanTag.MetavarKind_natural;
          assert(leanTag(leanField(first, 5)) == expectedKind);
          assert(rewriteProbeSameInput(infos[0], binderInfo));
          expectedBody = if (count == 1) L4_Lean_Expr.f_Lean_mkForall_fc2281f2c3(afterRuntime, binderName, binder, mvars[0], mvars[0]) else mvars[0];
          assert(rewriteProbeSameInput(body, expectedBody));
