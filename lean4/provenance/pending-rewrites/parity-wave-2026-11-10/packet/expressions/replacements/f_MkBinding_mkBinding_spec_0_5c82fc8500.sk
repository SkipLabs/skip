        runtime,
        body,
        LeanNatLiterals.n1,
        LeanNatLiterals.n1,
      );
      return LeanCtor(LeanTag.EStateM_Result_ok, Array[lowered, state])
    | LeanTag.Bool_true -> void
    | _ -> return leanFail("non-exhaustive Lean case")
    }
  | _ -> return leanFail("non-exhaustive Lean case")
  };
  reducedType = L4_Lean_Expr.f_Lean_Expr_headBeta_d2d563c891(runtime, type);
  eliminated = f_MetavarContext_MkBinding_elimMVarDeps_6d1bd7cdba(
    runtime,
    variables,
    reducedType,
    context,
    state,
  );
  leanTag(eliminated) match {
  | LeanTag.EStateM_Result_error ->
    _ = leanField(eliminated, 0);
    _ = leanField(eliminated, 1);
    eliminated
  | LeanTag.EStateM_Result_ok ->
    cleanType = leanField(eliminated, 0);
    nextState = leanField(eliminated, 1);
    abstractType = L4_Lean_Expr.f_Lean_Expr_abstractRange_6ddf7c6c71(
      runtime,
      cleanType,
      index,
      variables,
    );
    binding = leanTag(isLambda) match {
    | LeanTag.Bool_false -> L4_Lean_Expr.f_Lean_mkForall_fc2281f2c3(
        runtime,
        name,
        binderInfo,
        abstractType,
        body,
      )
    | LeanTag.Bool_true -> f_MetavarContext_MkBinding_mkLambda_4c7a10d5e6(
        runtime,
        name,
