  | LeanTag.MetavarDecl_mk -> void
  | _ -> return leanFail("non-exhaustive Lean case")
  };
  name = leanField(decl, 0);
  _ = leanField(decl, 1);
  type = leanField(decl, 2);
  _ = leanField(decl, 3);
  _ = leanField(decl, 4);
  _ = leanField(decl, 5);
  _ = leanField(decl, 6);
  _ = leanField(decl, 7);
  reducedType = L4_Lean_Expr.f_Lean_Expr_headBeta_d2d563c891(runtime, type);
  typeResult = f_MetavarContext_MkBinding_elimMVarDeps_6d1bd7cdba(
    runtime,
    variables,
    reducedType,
    context,
    state,
  );
  leanTag(typeResult) match {
  | LeanTag.EStateM_Result_error ->
    _ = leanField(typeResult, 0);
    _ = leanField(typeResult, 1);
    return typeResult
  | LeanTag.EStateM_Result_ok -> void
  | _ -> return leanFail("non-exhaustive Lean case")
  };
  cleanType = leanField(typeResult, 0);
  nextState = leanField(typeResult, 1);
  abstractType = L4_Lean_Expr.f_Lean_Expr_abstractRange_6ddf7c6c71(runtime, cleanType, index, variables);
  anonymous = L4_Lean_Data_Name.f_Lean_Name_isAnonymous_6fce118087(runtime, name);
  leanTag(anonymous) match {
  | LeanTag.Bool_false -> void
  | LeanTag.Bool_true ->
    baseName = L4_Init_Prelude.f_Lean_Name_mkStr1_4962bb4b4e(runtime, LeanText("x"));
    fresh = f_MetavarContext_MkBinding_mkFreshBinderName_ce64156ebd(
      runtime,
      baseName,
      context,
      nextState,
    );
    leanTag(fresh) match {
    | LeanTag.EStateM_Result_ok ->
      !name = leanField(fresh, 0);
      !nextState = leanField(fresh, 1)
    | LeanTag.EStateM_Result_error ->
      _ = leanField(fresh, 0);
      _ = leanField(fresh, 1);
      return leanFail("unreachable: _private.Init.Data.Nat.Control.0.Nat.foldRevM.loop._at_.Lean.MetavarContext.MkBinding.mkBinding.spec_0._redArg")
    | _ -> return leanFail("non-exhaustive Lean case")
    }
  | _ -> return leanFail("non-exhaustive Lean case")
  };
  // The original tests isLambda before projecting the context, even on error.
  lambda = leanTag(isLambda) match {
  | LeanTag.Bool_false -> false
  | LeanTag.Bool_true -> true
  | _ -> return leanFail("non-exhaustive Lean case")
  };
  leanTag(context) match {
  | LeanTag.MetavarContext_MkBinding_Context_mk -> void
  | _ -> return leanFail("non-exhaustive Lean case")
  };
  _ = leanField(context, 0);
  _ = leanField(context, 1);
  binderInfo = leanField(context, 2);
  _ = leanField(context, 3);
  binding = if (lambda) {
    f_MetavarContext_MkBinding_mkLambda_4c7a10d5e6(
      runtime,
      name,
      binderInfo,
      abstractType,
      body,
      etaReduce,
    )
