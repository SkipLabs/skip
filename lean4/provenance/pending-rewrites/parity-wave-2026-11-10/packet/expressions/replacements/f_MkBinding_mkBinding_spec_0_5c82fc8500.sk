        runtime,
        body,
        LeanNatLiterals.n1,
        LeanNatLiterals.n1,
      );
      return LeanCtor(LeanTag.EStateM_Result_ok, Array[lowered, state])
    | LeanTag.Bool_true -> void
    | _ -> return leanFail("non-exhaustive Lean case")
    }
  | _ -> return leanFail("non-exhaustive Lean case")
  };
  typeResult = f_MetavarContext_MkBinding_elimMVarDeps_6d1bd7cdba(
    runtime,
    variables,
    type,
    context,
    state,
  );
  leanTag(typeResult) match {
  | LeanTag.EStateM_Result_error ->
    _ = leanField(typeResult, 0);
    _ = leanField(typeResult, 1);
    typeResult
  | LeanTag.EStateM_Result_ok ->
    cleanType = leanField(typeResult, 0);
    typeState = leanField(typeResult, 1);
    valueResult = f_MetavarContext_MkBinding_elimMVarDeps_6d1bd7cdba(
      runtime,
      variables,
      value,
      context,
      typeState,
    );
    leanTag(valueResult) match {
    | LeanTag.EStateM_Result_error ->
      _ = leanField(valueResult, 0);
      _ = leanField(valueResult, 1);
      valueResult
    | LeanTag.EStateM_Result_ok ->
      cleanValue = leanField(valueResult, 0);
      valueState = leanField(valueResult, 1);
      abstractType = L4_Lean_Expr.f_Lean_Expr_abstractRange_6ddf7c6c71(
        runtime,
        cleanType,
        index,
        variables,
      );
      abstractValue = L4_Lean_Expr.f_Lean_Expr_abstractRange_6ddf7c6c71(
        runtime,
        cleanValue,
        index,
        variables,
      );
      binding = L4_Lean_Expr.f_Expr_letE_override_53a36b789f(
        runtime,
        name,
        abstractType,
        abstractValue,
        body,
        nondep,
      );
      LeanCtor(LeanTag.EStateM_Result_ok, Array[binding, valueState])
    | _ -> leanFail("non-exhaustive Lean case")
    }
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

// Metavariables are always bound: usedOnly applies only to local declarations.
fun f_expressionsWave_bindMVar(
