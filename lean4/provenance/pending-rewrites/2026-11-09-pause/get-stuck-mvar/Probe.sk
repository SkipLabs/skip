// Stuck IDs and state effects using registered classes, projections and matchers.
class StuckCase(label: String, expression: LeanValue, expected: ?LeanValue, unchanged: Bool)

fun stuckApply(runtime: mutable LeanExecution, head: LeanValue, arguments: Array<LeanValue>): LeanValue {
  result = head;
  for (argument in arguments) !result = L4_Lean_Expr.f_Lean_mkApp_4478491ddb(runtime, result, argument);
  result
}

fun stuckBinders(runtime: mutable LeanExecution, domains: Array<(LeanValue, LeanTag.Value)>, body: LeanValue, lambda: Bool): LeanValue {
  result = body;
  for (offset in Range(0, domains.size())) {
    (domain, binder) = domains[domains.size() - offset - 1];
    !result = if (lambda) {
      L4_Lean_Expr.f_Lean_mkLambda_fa85a512c1(runtime, LeanCtor(LeanTag.Name_anonymous__impl, Array[]), LeanCtor(binder, Array[]), domain, result)
    } else {
      L4_Lean_Expr.f_Lean_mkForall_fc2281f2c3(runtime, LeanCtor(LeanTag.Name_anonymous__impl, Array[]), LeanCtor(binder, Array[]), domain, result)
    }
  };
  result
}

fun stuckArrow(runtime: mutable LeanExecution, domains: Array<LeanValue>, body: LeanValue, lambda: Bool = false): LeanValue {
  stuckBinders(runtime, domains.map(domain -> (domain, LeanTag.BinderInfo_default)), body, lambda)
}

fun stuckAxiom(name: LeanValue, type: LeanValue): LeanValue {
  LeanCtor(LeanTag.ConstantInfo_axiomInfo, Array[LeanCtor(LeanTag.AxiomVal_mk, Array[
    LeanCtor(LeanTag.ConstantVal_mk, Array[name, LeanCtor(LeanTag.List_nil, Array[]), type]), leanBool(false),
  ])])
}

fun stuckDefinition(name: LeanValue, type: LeanValue, value: LeanValue): LeanValue {
  nil = LeanCtor(LeanTag.List_nil, Array[]);
  LeanCtor(LeanTag.ConstantInfo_defnInfo, Array[LeanCtor(LeanTag.DefinitionVal_mk, Array[
    LeanCtor(LeanTag.ConstantVal_mk, Array[name, nil, type]), value,
    LeanCtor(LeanTag.ReducibilityHints_abbrev, Array[]), LeanCtor(LeanTag.DefinitionSafety_safe, Array[]),
    LeanCtor(LeanTag.List_cons, Array[name, nil]),
  ])])
}

fun stuckStructure(name: LeanValue, ctor: LeanValue, type: LeanValue, ctorType: LeanValue, parameters: Int): Array<LeanValue> {
  nil = LeanCtor(LeanTag.List_nil, Array[]);
  singleton = (value: LeanValue) -> LeanCtor(LeanTag.List_cons, Array[value, nil]);
  Array[
    LeanCtor(LeanTag.ConstantInfo_inductInfo, Array[LeanCtor(LeanTag.InductiveVal_mk, Array[
      LeanCtor(LeanTag.ConstantVal_mk, Array[name, nil, type]), leanNatValue(parameters), LeanNatLiterals.n0,
      singleton(name), singleton(ctor), LeanNatLiterals.n0, leanBool(false), leanBool(false), leanBool(false),
    ])]),
    LeanCtor(LeanTag.ConstantInfo_ctorInfo, Array[LeanCtor(LeanTag.ConstructorVal_mk, Array[
      LeanCtor(LeanTag.ConstantVal_mk, Array[ctor, nil, ctorType]), name, LeanNatLiterals.n0,
      leanNatValue(parameters), LeanNatLiterals.n1, leanBool(false),
    ])]),
  ]
}

fun stuckCheck(label: String, saved: LeanExecutionCheckpoint, state: RewriteProbeState, expression: LeanValue,
  context: LeanValue, core: LeanValue, world: LeanValue, expected: LeanValue, unchanged: Bool): LeanExecutionCheckpoint {
  oldExpression = rewriteProbeCopyInput(expression);
  newExpression = rewriteProbeCopyInput(expression);
  oldContext = rewriteProbeCopyInput(context);
  newContext = rewriteProbeCopyInput(context);
  oldCore = rewriteProbeCopyInput(core);
  newCore = rewriteProbeCopyInput(core);
  (result, after) = rewriteProbeCompare(label, saved,
    (runtime: mutable LeanExecution) ~> {
      result = L4_Lean_Meta_WHNF.f_Lean_Meta_getStuckMVar_d961eb9381_fallback(runtime,
        oldExpression, oldContext, state.metaStateRef, oldCore, state.coreStateRef, world);
      assert(rewriteProbeSameInput(expression, oldExpression));
      assert(rewriteProbeSameInput(context, oldContext));
      assert(rewriteProbeSameInput(core, oldCore));
      result
    },
    (runtime: mutable LeanExecution) ~> {
      result = L4_Lean_Meta_WHNF.f_Lean_Meta_getStuckMVar_d961eb9381(runtime,
        newExpression, newContext, state.metaStateRef, newCore, state.coreStateRef, world);
      assert(rewriteProbeSameInput(expression, newExpression));
      assert(rewriteProbeSameInput(context, newContext));
      assert(rewriteProbeSameInput(core, newCore));
      result
    });
  if (!rewriteProbeSameInput(result, expected)) leanFail("unexpected stuck result: " + label);
  assert(rewriteProbeSameInput(leanField(result, 1), world));
  if (unchanged && native_eq(saved.refs, after.refs) != 0) leanFail("unexpected stuck state change: " + label);
  after
}

fun stuckPolicy(runtime: mutable LeanExecution, arguments: Array<LeanValue>): LeanValue {
  declarationName = L4_Lean_Declaration.f_Lean_ConstantInfo_name_42ee85d973(runtime, arguments[4]);
  assert(rewriteProbeSameInput(declarationName, arguments[1]));
  assert(rewriteProbeSameInput(leanField(arguments[2], 1), arguments[7]));
  runtime.writeRef(arguments[0], Some(leanBoxNat(leanNat(runtime.readRef(arguments[0])).add(LeanNat::fromInt(1)))));
  arguments[2]
}

fun stuckDepthError(runtime: mutable LeanExecution, source: LeanValue, world: LeanValue): LeanValue {
  tag = L4_Init_Prelude.f_Lean_Name_mkStr2_ed89eae6ad(runtime, LeanText("runtime"), LeanText("maxRecDepth"));
  message = L4_Lean_Message.f_Lean_MessageData_ofFormat_9fc6d2a204(runtime,
    LeanCtor(LeanTag.Std_Format_text, Array[LeanText("maximum recursion depth has been reached\nuse `set_option maxRecDepth <num>` to increase limit\nuse `set_option diagnostics true` to get diagnostic information")]));
  LeanCtor(LeanTag.EST_Out_error, Array[LeanCtor(LeanTag.Exception_error,
    Array[source, LeanCtor(LeanTag.MessageData_tagged, Array[tag, message])]), world])
}

