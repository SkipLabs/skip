        StuckCase("opaque metavariable remains blocking", mvar(opaqueId), Some(opaqueId), true),
        StuckCase("assigned value clears blocker", mvar(assignedId), None(), true),
        StuckCase("assignment follows metavariable", mvar(linkedId), Some(maId), true),
        StuckCase("assigned function head beta reduces", stuckApply(builder, mvar(functionId), Array[ma]), Some(maId), true),
        StuckCase("unassigned function head wins", stuckApply(builder, mf, Array[x, ma, mb]), Some(mfId), true),
        StuckCase("metadata recursion", L4_Lean_Expr.f_Lean_mkMData_3cfcde81b2(builder, metadata, ma), Some(maId), true),
        StuckCase("metadata loop preserves nested input", nestedMetadata, Some(maId), true),
      ]) {
        _checked = stuckCheck(example.label, saved, metaOnly, example.expression, unused, unused, world, ok(example.expected), example.unchanged);
        !checks = checks + 1
      };
      for (example in Array[
        StuckCase("constant app without mvars", stuckApply(builder, project, Array[instance, x, x, y]), None(), true),
        StuckCase("unregistered constant app", stuckApply(builder, constant(name("stuckMissing")), Array[ma]), None(), true),
        StuckCase("ordinary projection is not class", stuckApply(builder, constant(boxProjectName), Array[mvar(mboxId), ma, mb, x]), None(), true),
        StuckCase("ordinary auxiliary is not class", stuckApply(builder, constant(nonclassAuxName), Array[mvar(mboxId)]), None(), true),
        StuckCase("projection registration wins over auxiliary", stuckApply(builder, constant(dualName), Array[mvar(mboxId)]), None(), true),
        StuckCase("auxiliary missing major skips parameter scan", stuckApply(builder, constant(indexedAuxName), Array[ma]), None(), true),
        StuckCase("huge auxiliary index cannot wrap", stuckApply(builder, constant(hugeAuxName), Array[ma]), None(), true),
        StuckCase("partial recursor skips major normalization", stuckApply(builder, constant(recName), Array[recMotive]), None(), true),
        StuckCase("K recursor ignores blocking major", stuckApply(builder, constant(kRecName),
          Array[stuckArrow(builder, Array[truth], p, true), constant(proofName), mvar(truthId)]), None(), true),
      ]) {
        _checked = stuckCheck(example.label, saved, coreOnly, example.expression, unused, unused, world, ok(example.expected), example.unchanged);
        !checks = checks + 1
      };
      for (example in Array[
        StuckCase("assigned ordinary body is not normalized", mvar(bodyId), None(), false),
        StuckCase("raw projection normalizes its major", rawProjection(mc), Some(mcId), false),
        StuckCase("applied raw projection keeps major priority", stuckApply(builder, rawProjection(mc), Array[ma, mb, x]), Some(mcId), false),
        StuckCase("constructor field mvar is not major blocker", rawProjection(mvar(classAssignedId)), None(), false),
        StuckCase("class instance precedes explicit arguments", stuckApply(builder, project, Array[mc, ma, mb, x]), Some(mcId), false),
        StuckCase("first explicit stuck argument wins", stuckApply(builder, project, Array[instance, x, ma, mb]), Some(maId), false),
        StuckCase("later explicit stuck argument", stuckApply(builder, project, Array[instance, x, x, mb]), Some(mbId), false),
        StuckCase("implicit argument is skipped", stuckApply(builder, project, Array[instance, ma, x, y]), None(), false),
        StuckCase("explicit arguments are not normalized", stuckApply(builder, project,
          Array[instance, x, stuckApply(builder, constant(identityName), Array[ma]), mb]), Some(mbId), false),
        StuckCase("partial explicit scan stops at argument end", stuckApply(builder, project, Array[instance, ma]), None(), false),
        StuckCase("missing class major still scans parameters", stuckApply(builder, constant(indexedName), Array[ma]), Some(maId), false),
        StuckCase("huge projection index still scans parameters", stuckApply(builder, constant(hugeProjectionName), Array[ma]), Some(maId), false),
        StuckCase("auxiliary class major", stuckApply(builder, constant(auxiliaryName), Array[mc]), Some(mcId), false),
        StuckCase("auxiliary known instance", stuckApply(builder, constant(auxiliaryName), Array[instance]), None(), true),
        StuckCase("auxiliary normalizes assigned instance without scanning fields",
          stuckApply(builder, constant(auxiliaryName), Array[mvar(classAssignedId)]), None(), false),
        StuckCase("empty recursor major", stuckApply(builder, constant(recName), Array[recMotive, mvar(meId)]), Some(meId), false),
        StuckCase("empty recursor known major", stuckApply(builder, constant(recName), Array[recMotive, emptyLocal]), None(), false),
        StuckCase("matcher normalizes projection major", rawProjection(matcherMajor), Some(mc2Id), false),
        StuckCase("matcher normalizes class instance", stuckApply(builder, project, Array[matcherMajor, x, ma, mb]), Some(mc2Id), false),
      ]) {
        _checked = stuckCheck(example.label, saved, state, example.expression, state.metaContext, state.coreContext, world, ok(example.expected), example.unchanged);
        !checks = checks + 1
      };
      oversaturated = stuckApply(builder, project, Array[instance, x, x, y, ma]);
      _bounded = stuckCheck("negative oversaturation stops at parameter end", saved, state, oversaturated,
        state.metaContext, state.coreContext, world, ok(None()), false);
      !checks = checks + 1;
      for (arity in Array[129, 257]) {
        for (earlyBlocker in Array[false, true]) {
          arguments = Array::fillBy(arity, index ->
            if (index == 0) instance else if (index == arity - 1 || (earlyBlocker && index == 2)) ma else x);
          _large = stuckCheck("persistent arguments preserve bounded scan", saved, state,
            stuckApply(builder, project, arguments), state.metaContext, state.coreContext, world,
            ok(if (earlyBlocker) Some(maId) else None()), false);
          !checks = checks + 1
        }
      };
      compressed = stuckCheck("assignment normalization updates only its stored value", saved, metaOnly,
        mvar(compressedId), unused, unused, world, ok(None()), false);
      expectedRuntime = saved.restoreRaw();
      expectedMeta = expectedRuntime.readRef(state.metaStateRef);
      expectedMctx = L4_Lean_MetavarContext.f_Lean_assignExp_5e8f394bd8(expectedRuntime,
        leanField(expectedMeta, 0), compressedId, x);
      expectedRuntime.writeRef(state.metaStateRef, Some(leanReplaceField(expectedMeta, 0, expectedMctx)));
      assert(native_eq(compressed.refs, expectedRuntime.checkpoint().refs) == 0);
      !checks = checks + 1;
      limited = leanReplaceField(leanReplaceField(state.coreContext, 1, LeanNatLiterals.n1), 0,
        leanReplaceField(leanField(state.coreContext, 0), 3, LeanNatLiterals.n1));
      for (expression in Array[rawProjection(mc), stuckApply(builder, project, Array[mc, ma, mb, x]),
        stuckApply(builder, constant(recName), Array[recMotive, emptyLocal])]) {
        _depth = stuckCheck("major normalization error before other arguments", saved, state, expression,
          state.metaContext, limited, world, stuckDepthError(builder, leanField(limited, 2), world), true);
        !checks = checks + 1
      };
      oracle = saved.restoreRaw();
      functionError = L4_Lean_Meta_FunInfo.f_Lean_Meta_getFunInfo_5b0f80513a(oracle, constant(indexedName),
        LeanCtor(LeanTag.Option_none, Array[]), state.metaContext, state.metaStateRef, limited, state.coreStateRef, world);
      assert(leanTag(functionError) == LeanTag.EST_Out_error);
      functionFailure = stuckCheck("function info error before explicit parameter scan", saved, state,
        stuckApply(builder, constant(indexedName), Array[ma]), state.metaContext, limited, world, functionError, false);
      assert(native_eq(functionFailure.refs, oracle.checkpoint().refs) == 0);
      !checks = checks + 1;
      for (decision in Range(0, 3)) {
        policyResult = if (decision == 2) {
          LeanCtor(LeanTag.EST_Out_error, Array[LeanCtor(LeanTag.Exception_error, Array[leanField(state.coreContext, 2),
            L4_Lean_Message.f_Lean_stringToMessageData_1e55fa4f40(builder, LeanText("stuck explicit argument error"))]), world])
        } else { LeanCtor(LeanTag.EST_Out_ok, Array[leanBool(decision == 1), world]) };
        policy = LeanClosure(stuckPolicy, 8, Array[callbackCount, instanceName, policyResult]);
        custom = leanReplaceField(state.metaContext, 7, LeanCtor(LeanTag.Option_some, Array[policy]));
        argument = stuckApply(builder, rawProjection(constant(instanceName)), Array[x, x, y]);
        expression = stuckApply(builder, project, Array[instance, x, argument, ma]);
        after = stuckCheck("explicit argument policy " + decision.toString(), saved, state, expression, custom, state.coreContext,
          world, if (decision == 2) policyResult else ok(Some(maId)), false);
        afterRuntime = after.restoreRaw();
        assert(leanNat(afterRuntime.readRef(callbackCount)) == LeanNat::fromInt(1));
        !checks = checks + 1
      }
    }
  };
  assert(checks == 224);
  print_string("Stuck metavariable discovery passed " + checks.toString() + " cases")
}
