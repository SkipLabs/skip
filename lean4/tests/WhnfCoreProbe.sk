// Compare weak-head reduction results and state, including repeated calls.
// Other reduction helpers are shared; the retained core recursion is independent.
fun main(): void {
  runtime = mutable LeanExecution{unboundedHeartbeats => true};
  leanInitializeSimp(runtime);
  name = (s: String) ->
    L4_Init_Prelude.f_Lean_Name_mkStr1_4962bb4b4e(runtime, LeanText(s));
  xName = name("x");
  yName = name("y");
  pName = name("p");
  qName = name("q");
  zName = name("z");
  mName = name("m");
  uName = name("u");
  unknown = name("unknown");
  zero = LeanCtor(LeanTag.Level_zero__impl, Array[]);
  one = L4_Lean_Level.f_Lean_mkLevelSucc_2631235517(runtime, zero);
  param = L4_Lean_Level.f_Lean_mkLevelParam_810abd49d1(runtime, uName);
  mu = L4_Lean_Level.f_Lean_mkLevelMVar_a2479655d3(runtime, mName);
  prop = L4_Lean_Expr.f_Lean_mkSort_ccbb836181(runtime, zero);
  type = L4_Lean_Expr.f_Lean_mkSort_ccbb836181(runtime, one);
  sortU = L4_Lean_Expr.f_Lean_mkSort_ccbb836181(runtime, param);
  sortM = L4_Lean_Expr.f_Lean_mkSort_ccbb836181(runtime, mu);
  fvar = (n: LeanValue) -> L4_Lean_Expr.f_Lean_mkFVar_3175adace5(runtime, n);
  x = fvar(xName);
  y = fvar(yName);
  p = fvar(pName);
  q = fvar(qName);
  z = fvar(zName);
  missing = fvar(unknown);
  binder = LeanCtor(LeanTag.BinderInfo_default, Array[]);
  localKind = LeanCtor(LeanTag.LocalDeclKind_default, Array[]);
  locals = L4_Lean_LocalContext.f_Lean_LocalContext_empty_68c9cb2aed(runtime);
  for ((n, t) in Array[(xName, prop), (yName, prop), (pName, x), (qName, x)]) {
    !locals = L4_Lean_LocalContext.f_Lean_LocalContext_mkLocalDecl_741af88ec8(
      runtime,
      locals,
      n,
      n,
      t,
      binder,
      localKind,
    )
  };
  !locals = L4_Lean_LocalContext.f_Lean_LocalContext_mkLetDecl_253fda64a7(
    runtime,
    locals,
    zName,
    zName,
    prop,
    x,
    leanBool(false),
    localKind,
  );
  defaults = L4_Lean_Meta_Basic.f_Meta_instInhabitedContext_default_0798ec5988(
    runtime,
  );
  context = leanReplaceField(defaults, 3, locals);
  initialState = L4_Lean_Meta_Basic.f_Meta_instInhabitedState_default_581318f17c(
    runtime,
  );
  mctx = L4_Lean_MetavarContext.f_Lean_MetavarContext_addLevelMVarDecl_fd66df8a2a(
    runtime,
    leanField(initialState, 0),
    mName,
  );
  !mctx = L4_Lean_MetavarContext.f_Lean_MetavarContext_addExprMVarDecl_da6770b970(
    runtime,
    mctx,
    mName,
    mName,
    locals,
    LeanArray(Array[]),
    prop,
    LeanCtor(LeanTag.MetavarKind_natural, Array[]),
    LeanNatLiterals.n0,
  );
  m = L4_Lean_Expr.f_Lean_mkMVar_5925a7099d(runtime, mName);
  state = runtime.newRef(leanReplaceField(initialState, 0, mctx));
  constants = LeanConstantMap((Map[] : Map<String, LeanConstantFile>));
  // Register real extension callbacks and create their initial states. An empty
  // constants map alone is insufficient when binder checks consult unification hints.
  extensions = L4_Lean_Environment.f_Lean_EnvExtension_mkInitialExtStates_0da187769b(
    runtime,
    LeanErased(),
  );
  generations = L4_Lean_Environment.f_Lean_EnvExtension_ensureGensArraySize_12e77b18b8(
    runtime,
    LeanArray(Array[]),
    leanField(extensions, 1),
  );
  assert(leanTag(extensions) == LeanTag.EST_Out_ok);
  assert(leanTag(generations) == LeanTag.EST_Out_ok);
  environment = leanEnvironment(
    runtime,
    LeanConstantsView("imports", constants),
    LeanConstantsView("locals", constants),
    leanEmptyEnvironmentHeader(),
    leanField(extensions, 0),
    leanField(generations, 0),
    false,
    LeanNatLiterals.n0,
  );
  core = leanUnboundedCoreContext(runtime, "<whnf-core-probe>", "");
  coreState = runtime.newRef(leanCoreState(runtime, environment));
  bound = L4_Lean_Expr.f_Lean_mkBVar_eb2781ad2d(runtime, LeanNatLiterals.n0);
  identity = L4_Lean_Expr.f_Lean_mkLambda_fa85a512c1(
    runtime,
    xName,
    binder,
    prop,
    bound,
  );
  functionType = L4_Lean_Expr.f_Lean_mkForall_fc2281f2c3(
    runtime,
    xName,
    binder,
    prop,
    prop,
  );
  fnName = name("fn");
  fn = fvar(fnName);
  !locals = L4_Lean_LocalContext.f_Lean_LocalContext_mkLocalDecl_741af88ec8(
    runtime,
    locals,
    fnName,
    fnName,
    functionType,
    binder,
    localKind,
  );
  values: mutable Vector<LeanValue> = mutable Vector[
    prop,
    type,
    sortU,
    sortM,
    x,
    y,
    p,
    q,
    z,
    m,
    missing,
    identity,
    functionType,
    fn,
  ];
  for ((label, nondep, kind) in Array[
    ("letFn", false, localKind),
    ("haveFn", true, localKind),
    ("implFn", false, LeanCtor(LeanTag.LocalDeclKind_implDetail, Array[])),
  ]) {
    id = name(label);
    !locals = L4_Lean_LocalContext.f_Lean_LocalContext_mkLetDecl_253fda64a7(
      runtime,
      locals,
      id,
      id,
      functionType,
      identity,
      leanBool(nondep),
      kind,
    );
    values.push(fvar(id));
    values.push(L4_Lean_Expr.f_Lean_mkApp_4478491ddb(runtime, fvar(id), x))
  };
  !context = leanReplaceField(context, 3, locals);
  for (head in Array[identity, fn]) {
    values.push(L4_Lean_Expr.f_Lean_mkApp_4478491ddb(runtime, head, x));
    values.push(
      L4_Lean_Expr.f_Lean_mkApp_4478491ddb(
        runtime,
        head,
        L4_Lean_Expr.f_Lean_mkApp_4478491ddb(runtime, identity, x),
      ),
    )
  };
  for (nondep in Array[false, true]) {
    for (body in Array[x, bound]) {
      values.push(
        L4_Lean_Expr.f_Lean_mkLet_82f97eecaa(
          runtime,
          zName,
          prop,
          x,
          body,
          leanBool(nondep),
        ),
      )
    }
  };
  // A projection whose structure does not reduce and an unknown head exercise
  // the original failure/unchanged-result behavior without fabricated metadata.
  values.push(
    L4_Lean_Expr.f_Lean_mkProj_3b27598f19(
      runtime,
      unknown,
      LeanNatLiterals.n0,
      x,
    ),
  );
  unknownConst = L4_Lean_Expr.f_Lean_mkConst_b40a363b86(
    runtime,
    unknown,
    LeanCtor(LeanTag.List_nil, Array[]),
  );
  values.push(unknownConst);
  values.push(L4_Lean_Expr.f_Lean_mkApp_4478491ddb(runtime, unknownConst, x));
  for (expr in values.toArray()) {
    values.push(
      L4_Lean_Expr.f_Lean_mkMData_3cfcde81b2(
        runtime,
        LeanCtor(LeanTag.List_nil, Array[]),
        expr,
      ),
    )
  };
  expressions = values.toArray();
  cold = leanField(core, 0);
  tracingOptions = leanReplaceField(leanField(cold, 2), 1, leanBool(true));
  traceCore = leanReplaceField(
    core,
    0,
    leanReplaceField(cold, 2, tracingOptions),
  );
  count = 0;
  errors = 0;
  effects = 0;
  for (assignment in Array[None(), Some(x), Some(z)]) {
    assigned = assignment match {
    | None() -> mctx
    | Some(value) ->
      L4_Lean_MetavarContext.f_Lean_assignExp_5e8f394bd8(
        runtime,
        mctx,
        mName,
        value,
      )
    };
    runtime.writeRef(state, Some(leanReplaceField(initialState, 0, assigned)));
    for (flags in Range(0, 32)) {
      config = L4_Lean_Meta_Basic.f_Meta_Context_config_2f4f6fdcbe(
        runtime,
        context,
      );
      for ((field, bit) in Array[
        (12, 1),
        (13, 2),
        (15, 4),
        (16, 8),
        (17, 16),
      ]) {
        !config = leanReplaceField(config, field, leanBool(flags.and(bit) != 0))
      };
      !config = leanReplaceField(config, 18, leanBool(flags.and(2) != 0));
      mode = Array[
        LeanTag.Meta_ProjReductionKind_no,
        LeanTag.Meta_ProjReductionKind_yes,
        LeanTag.Meta_ProjReductionKind_yesWithDelta,
        LeanTag.Meta_ProjReductionKind_yesWithDeltaI,
      ][flags % 4];
      !config = leanReplaceField(config, 14, LeanCtor(mode, Array[]));
      key = L4_Lean_Meta_Basic.f_Meta_Config_toKey_993126c67a(runtime, config);
      configured = leanReplaceField(
        context,
        0,
        LeanCtor(
          LeanTag.Private_Lean_Meta_Basic_0_Lean_Meta_ConfigWithKey_mk,
          Array[config, key],
        ),
      );
      for (track in Array[false, true]) {
        configuredTrack = leanReplaceField(configured, 1, leanBool(track));
        for (coreContext in Array[core, traceCore]) {
          for (index in Range(0, expressions.size())) {
            snapshot = runtime.checkpoint();
            original = snapshot.restoreRaw();
            structured = snapshot.restoreRaw();
            for (_ in Range(0, 2)) {
              expected = L4_Lean_Meta_WHNF.f_whnfCore_go_spec_3_85c62e30bd_fallback(
                original,
                expressions[index],
                configuredTrack,
                state,
                coreContext,
                coreState,
                leanNatValue(37),
              );
              actual = L4_Lean_Meta_WHNF.f_whnfCore_go_spec_3_85c62e30bd(
                structured,
                expressions[index],
                configuredTrack,
                state,
                coreContext,
                coreState,
                leanNatValue(37),
              );
              refs = structured.checkpoint().refs;
              if (
                native_eq(expected, actual) != 0 ||
                native_eq(original.checkpoint().refs, refs) != 0
              ) {
                leanFail(
                  "WHNF mismatch: expression " +
                    index.toString() +
                    " flags " +
                    flags.toString(),
                )
              };
              if (native_eq(snapshot.refs, refs) != 0) !effects = effects + 1;
              if (leanTag(actual) == LeanTag.EST_Out_error) {
                !errors = errors + 1
              };
              !count = count + 1
            }
          }
        }
      }
    }
  };
  assert(effects > 0 && errors > 0);
  print_string(
    count.toString() +
      " WHNF result/state comparisons passed; " +
      errors.toString() +
      " errors, " +
      effects.toString() +
      " state changes",
  )
}
