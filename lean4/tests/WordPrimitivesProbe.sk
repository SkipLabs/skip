// Compare statically selected wrappers with the generic dispatcher, whose
// arithmetic is checked independently by tests/runtime.py against Python integers.
class LeanWordProbe(
  name: String,
  kind: String,
  operation: String,
  invoke: (mutable LeanExecution, Array<LeanValue>) ~> LeanValue,
) {}

