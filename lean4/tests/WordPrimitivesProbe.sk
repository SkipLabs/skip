      L4_Init_Prelude.f_USize_ofNatLT_84e9726cb8(runtime, args[0], args[1])
    ),
    LeanWordProbe("lean_uint32_dec_eq", "uint32", "dec_eq", (runtime, args) ~>
      L4_Init_Prelude.f_UInt32_decEq_8e017905ad(runtime, args[0], args[1])
    ),
    LeanWordProbe("lean_uint32_of_nat", "uint32", "of_nat", (runtime, args) ~>
      L4_Init_Prelude.f_Char_ofNatAux_c52218ec65(runtime, args[0], args[1])
    ),
    LeanWordProbe("lean_uint8_dec_le", "uint8", "dec_le", (runtime, args) ~>
      L4_Init_Prelude.f_UInt8_decLe_e76284d58b(runtime, args[0], args[1])
    ),
    LeanWordProbe("lean_uint8_of_nat", "uint8", "of_nat", (runtime, args) ~>
      L4_Init_Prelude.f_UInt8_ofNat_56001605a5(runtime, args[0])
    ),
    LeanWordProbe("lean_uint64_dec_eq", "uint64", "dec_eq", (runtime, args) ~>
      L4_Init_Prelude.f_UInt64_decEq_97f4edb260(runtime, args[0], args[1])
    ),
    LeanWordProbe("lean_uint32_dec_lt", "uint32", "dec_lt", (runtime, args) ~>
      L4_Init_Prelude.f_UInt32_decLt_d96374b7f5(runtime, args[0], args[1])
    ),
    LeanWordProbe(
      "lean_uint8_of_nat_mk",
      "uint8",
      "of_nat_mk",
      (runtime, args) ~>
        L4_Init_Prelude.f_UInt8_ofBitVec_70f8f0d83e(runtime, args[0])
      ,
    ),
    LeanWordProbe("lean_uint64_to_nat", "uint64", "to_nat", (runtime, args) ~>
      L4_Init_Prelude.f_UInt64_toBitVec_8414fc4c05(runtime, args[0])
    ),
    LeanWordProbe("lean_uint8_dec_eq", "uint8", "dec_eq", (runtime, args) ~>
      L4_Init_Prelude.f_UInt8_decEq_926bae36a1(runtime, args[0], args[1])
    ),
  ];
  runtime = mutable LeanExecution{};
  profiled = mutable LeanExecution{profileRuntime => true};
  checks = 0;
  for (case in cases) {
    numbers = Array[
      0,
      1,
      2,
      7,
      31,
      32,
      63,
      64,
      65,
      255,
      256,
      65535,
      4294967295,
      9223372036854775807,
      Int::min,
      -2,
      -1,
    ];
    for (a in numbers) {
      for (b in numbers) {
        left: LeanValue = if (
          case.operation == "of_nat" ||
          case.operation == "of_nat_mk"
        ) {
          LeanNatural(LeanNat::fromWord(a))
        } else {
          leanWordValue(case.kind, a)
        };
        args = Array[left, leanWordValue(case.kind, b)];
        expected = leanInvokePrimitive(runtime, case.name, case.name, args);
        actual = case.invoke(runtime, args);
        counted = case.invoke(profiled, args);
        assert(native_eq(expected, actual) == 0);
        assert(native_eq(expected, counted) == 0);
        !checks = checks + 1
      }
    };
    if (case.operation == "of_nat" || case.operation == "of_nat_mk") {
      for (digits in Array[
        "18446744073709551616",
        "9999999999999999999999999999999999999999999999999999999999999999",
      ]) {
        // Some ofNat wrappers retain an erased bound proof argument.
        args: Array<LeanValue> = Array[LeanScalar("nat", digits), LeanErased()];
        assert(
          native_eq(
            leanInvokePrimitive(runtime, case.name, case.name, args),
            case.invoke(runtime, args),
          ) == 0,
        )
      }
    }
  };
  assert(profiled.primitiveCount == checks);
  assert(runtime.primitiveCount == 0);
  print_string(
    checks.toString() +
      " direct word operations match generic dispatch, including profiled execution",
  )
}
