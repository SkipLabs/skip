    cases.push(
      MatchLoopCase(
        "chain star edge discards arguments",
        quietContext,
        LeanArray(Array[appCX]),
        resumeTrieChain(starKey, resumeTrieLeaf("starHit")),
        nothingTodo,
        false,
        payload(Array["starHit"]),
        expectAnyException,
