// Executable probe for the unchanged
// L4_Lean_Meta_DiscrTree_Main.f_Meta_DiscrTree_getMatchLoop_afa84324e9.
// Every case runs the retained fallback oracle (exact original ABI, identity
// guaranteed by the assignment) and the canonical function on identically
// restored runtimes, then asserts independently derived expected payloads,
// worlds and input preservation from the reference traversal contract.

class MatchLoopCase(
  label: String,
  context: LeanValue,
  todo: LeanValue,
  trie: LeanValue,
  seed: LeanValue,
  expectError: Bool,
  expected: LeanValue,
  expectedException: LeanValue,
)

// --- fixture helpers copied from the validated getKeyArgs setup ---

fun matchLoopAxiom(name: LeanValue, type: LeanValue): LeanValue {
  LeanCtor(
    LeanTag.ConstantInfo_axiomInfo,
    Array[
      LeanCtor(
        LeanTag.AxiomVal_mk,
        Array[
          LeanCtor(
            LeanTag.ConstantVal_mk,
            Array[name, LeanCtor(LeanTag.List_nil, Array[]), type],
          ),
          leanBool(false),
        ],
      ),
    ],
  )
}

fun matchLoopDefinition(
  name: LeanValue,
  type: LeanValue,
  value: LeanValue,
): LeanValue {
  nil = LeanCtor(LeanTag.List_nil, Array[]);
  LeanCtor(
    LeanTag.ConstantInfo_defnInfo,
    Array[
      LeanCtor(
        LeanTag.DefinitionVal_mk,
        Array[
          LeanCtor(LeanTag.ConstantVal_mk, Array[name, nil, type]),
          value,
          LeanCtor(
            LeanTag.ReducibilityHints_regular,
            Array[LeanWord("uint32", 1)],
          ),
          LeanCtor(LeanTag.DefinitionSafety_safe, Array[]),
          LeanCtor(LeanTag.List_cons, Array[name, nil]),
        ],
      ),
    ],
  )
}

fun matchLoopApply(
  runtime: mutable LeanExecution,
  head: LeanValue,
  arguments: Array<LeanValue>,
): LeanValue {
  result = head;
  for (argument in arguments) {
    !result = L4_Lean_Expr.f_Lean_mkApp_4478491ddb(runtime, result, argument)
  };
  result
}

fun matchLoopBinders(
  runtime: mutable LeanExecution,
  domains: Array<LeanValue>,
  body: LeanValue,
  lambda: Bool,
): LeanValue {
  result = body;
  binder = LeanCtor(LeanTag.BinderInfo_default, Array[]);
  anonymous = LeanCtor(LeanTag.Name_anonymous__impl, Array[]);
  for (offset in Range(0, domains.size())) {
    domain = domains[domains.size() - offset - 1];
    !result = if (lambda) {
      L4_Lean_Expr.f_Lean_mkLambda_fa85a512c1(
        runtime,
        anonymous,
        binder,
        domain,
        result,
      )
    } else {
      L4_Lean_Expr.f_Lean_mkForall_fc2281f2c3(
        runtime,
        anonymous,
        binder,
        domain,
        result,
      )
    }
  };
  result
}

fun matchLoopContext(
  runtime: mutable LeanExecution,
  context: LeanValue,
  config: LeanValue,
): LeanValue {
  leanReplaceField(
    context,
    0,
    LeanCtor(
      LeanTag.Private_Lean_Meta_Basic_0_Lean_Meta_ConfigWithKey_mk,
      Array[
        config,
        L4_Lean_Meta_Basic.f_Meta_Config_toKey_993126c67a(runtime, config),
      ],
    ),
  )
}

// --- trie fixtures copied from TrieFixture.sk (children in strict Key order) ---

fun resumeTrieNode(
  values: Array<LeanValue>,
  childEdges: Array<LeanValue>,
): LeanValue {
  LeanCtor(
    LeanTag.Meta_DiscrTree_Trie_node,
    Array[LeanArray(values), LeanArray(childEdges)],
  )
}

fun resumeTrieLeaf(label: String): LeanValue {
  resumeTrieNode(Array[LeanText(label)], (Array[] : Array<LeanValue>))
}

fun resumeTrieChain(key: LeanValue, child: LeanValue): LeanValue {
  LeanCtor(LeanTag.Meta_DiscrTree_Trie_chain, Array[key, child])
}

fun resumeTrieChild(key: LeanValue, child: LeanValue): LeanValue {
  LeanCtor(LeanTag.Prod_mk, Array[key, child])
}

// A chain gets one concrete child per level, so exactly `level` pending
// expressions are consumed before reaching the payload leaf.
fun matchLoopDeepTrie(level: Int, key: LeanValue): LeanValue {
  if (level <= 0) {
    resumeTrieNode(Array[LeanText("deepEnd")], (Array[] : Array<LeanValue>))
  } else {
    resumeTrieNode(
      (Array[] : Array<LeanValue>),
      Array[resumeTrieChild(key, matchLoopDeepTrie(level - 1, key))],
    )
  }
}

// --- probe check: fallback oracle vs canonical plus independent expected facts ---

fun matchLoopCheck(
  label: String,
  state: RewriteProbeState,
  saved: LeanExecutionCheckpoint,
  context: LeanValue,
  todo: LeanValue,
  trie: LeanValue,
  seed: LeanValue,
  expectError: Bool,
  expected: LeanValue,
  expectedException: LeanValue,
  world: LeanValue,
  coreOverride: ?LeanValue = None(),
): LeanExecutionCheckpoint {
  core = coreOverride match {
  | Some(value) -> value
  | None() -> state.coreContext
  };
  oldCore = rewriteProbeCopyInput(core);
  newCore = rewriteProbeCopyInput(core);
  oldTodo = rewriteProbeCopyInput(todo);
  newTodo = rewriteProbeCopyInput(todo);
  oldTrie = rewriteProbeCopyInput(trie);
  newTrie = rewriteProbeCopyInput(trie);
  oldSeed = rewriteProbeCopyInput(seed);
  newSeed = rewriteProbeCopyInput(seed);
  oldContext = rewriteProbeCopyInput(context);
  newContext = rewriteProbeCopyInput(context);
  (result, after) = rewriteProbeCompare(
    label,
    saved,
    (runtime: mutable LeanExecution) ~> {
      value = L4_Lean_Meta_DiscrTree_Main.f_Meta_DiscrTree_getMatchLoop_afa84324e9_fallback(
        runtime,
        oldTodo,
        oldTrie,
        oldSeed,
        oldContext,
        state.metaStateRef,
        oldCore,
        state.coreStateRef,
        world,
      );
      assert(rewriteProbeSameInput(todo, oldTodo));
      assert(rewriteProbeSameInput(trie, oldTrie));
      assert(rewriteProbeSameInput(seed, oldSeed));
      assert(rewriteProbeSameInput(context, oldContext));
      assert(rewriteProbeSameInput(core, oldCore));
      value
    },
    (runtime: mutable LeanExecution) ~> {
      value = L4_Lean_Meta_DiscrTree_Main.f_Meta_DiscrTree_getMatchLoop_afa84324e9(
        runtime,
        newTodo,
        newTrie,
        newSeed,
        newContext,
        state.metaStateRef,
        newCore,
        state.coreStateRef,
        world,
      );
      assert(rewriteProbeSameInput(todo, newTodo));
      assert(rewriteProbeSameInput(trie, newTrie));
      assert(rewriteProbeSameInput(seed, newSeed));
      assert(rewriteProbeSameInput(context, newContext));
      assert(rewriteProbeSameInput(core, newCore));
      value
    },
  );
  if (expectError) {
    if (leanTag(result) != LeanTag.EST_Out_error) {
      leanFail("getMatchLoop expected error: " + label)
    };
    if (leanTag(expectedException) == LeanTag.Option_some) {
      if (
        !rewriteProbeSameInput(
          leanField(result, 0),
          leanField(expectedException, 0),
        )
      ) {
        leanFail("getMatchLoop unexpected exception: " + label)
      }
    } else {
      assert(leanTag(leanField(result, 0)) == LeanTag.Exception_error)
    }
  } else {
    if (leanTag(result) != LeanTag.EST_Out_ok) {
      leanFail("getMatchLoop expected success: " + label)
    };
    // Expected payloads compare contents; old/new result representation remains exact.
    if (
      !rewriteProbeSameInput(
        LeanArray(leanArray(leanField(result, 0))),
        expected,
      )
    ) {
      leanFail("getMatchLoop unexpected payload: " + label)
    };
  };
  if (!rewriteProbeSameInput(leanField(result, 1), world)) {
    leanFail("getMatchLoop unexpected world: " + label)
  };
  noEffects =
    leanValueArraySize(todo) == 0 ||
    (leanTag(trie) == LeanTag.Meta_DiscrTree_Trie_node &&
      leanValueArraySize(leanField(trie, 1)) == 0);
  if (noEffects && native_eq(saved.refs, after.refs) != 0) {
    leanFail("getMatchLoop early return changed refs: " + label)
  };
  after
}

// Inputs use the actual persistent array representation, including node children and values.
fun matchLoopPersistentArray(value: LeanValue): LeanValue {
  LeanPersistentArray(
    Persistent.RadixTreeVector::mcreateFromItems(leanArray(value)).chill(),
  )
}

fun matchLoopPersistentTrie(trie: LeanValue): LeanValue {
  leanTag(trie) match {
  | LeanTag.Meta_DiscrTree_Trie_chain ->
    LeanCtor(
      LeanTag.Meta_DiscrTree_Trie_chain,
      Array[leanField(trie, 0), matchLoopPersistentTrie(leanField(trie, 1))],
    )
  | LeanTag.Meta_DiscrTree_Trie_node ->
    childEdges = leanArray(leanField(trie, 1)).map(entry ->
      LeanCtor(
        LeanTag.Prod_mk,
        Array[
          leanField(entry, 0),
          matchLoopPersistentTrie(leanField(entry, 1)),
        ],
      )
    );
    values: LeanValue = matchLoopPersistentArray(leanField(trie, 0));
    edges: LeanValue = matchLoopPersistentArray(LeanArray(childEdges));
    LeanCtor(LeanTag.Meta_DiscrTree_Trie_node, Array[values, edges])
  | _ -> leanFail("unexpected probe trie")
  }
}

fun matchLoopDepthException(
  runtime: mutable LeanExecution,
  source: LeanValue,
): LeanValue {
  tag = L4_Init_Prelude.f_Lean_Name_mkStr2_ed89eae6ad(
    runtime,
    LeanText("runtime"),
    LeanText("maxRecDepth"),
  );
  message = L4_Lean_Message.f_Lean_MessageData_ofFormat_9fc6d2a204(
    runtime,
    LeanCtor(
      LeanTag.Std_Format_text,
      Array[
        LeanText(
          "maximum recursion depth has been reached\nuse `set_option maxRecDepth <num>` to increase limit\nuse `set_option diagnostics true` to get diagnostic information",
        ),
      ],
    ),
  );
  LeanCtor(
    LeanTag.Exception_error,
    Array[source, LeanCtor(LeanTag.MessageData_tagged, Array[tag, message])],
  )
}

