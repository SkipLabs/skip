    cases.push(
      MatchLoopCase(
        "chain matching concrete key continues with arguments",
        quietContext,
        LeanArray(Array[appCX]),
        resumeTrieChain(
          constKey(cName, 1),
          resumeTrieChain(fvarKey(xName, 0), resumeTrieLeaf("deep")),
        ),
        nothingTodo,
        false,
        payload(Array["deep"]),
        expectAnyException,
