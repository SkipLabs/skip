    );
    cases.push(
      MatchLoopCase(
        "chain literal expression key",
        quietContext,
        LeanArray(Array[zeroExpr]),
        resumeTrieChain(
          litKey(LeanCtor(LeanTag.Literal_natVal, Array[LeanNatLiterals.n0])),
          resumeTrieLeaf("zero"),
        ),
        nothingTodo,
        false,
        payload(Array["zero"]),
        expectAnyException,
      ),
    );
    cases.push(
      MatchLoopCase(
        "chain string literal key",
        quietContext,
        LeanArray(Array[strExpr]),
        resumeTrieChain(
          litKey(LeanCtor(LeanTag.Literal_strVal, Array[LeanText("discr")])),
          resumeTrieLeaf("str"),
        ),
        nothingTodo,
        false,
        payload(Array["str"]),
        expectAnyException,
      ),
    );
    cases.push(
      MatchLoopCase(
        "chain arrow key with domain continuation",
        quietContext,
        LeanArray(Array[arrowExpr]),
        resumeTrieChain(
          arrowKey,
          resumeTrieChain(constKey(pName, 0), resumeTrieLeaf("arrow")),
        ),
        nothingTodo,
        false,
        payload(Array["arrow"]),
        expectAnyException,
      ),
    );
    cases.push(
      MatchLoopCase(
        "chain projection key with base continuation",
        quietContext,
        LeanArray(Array[projExpr]),
        resumeTrieChain(
          projKey,
          resumeTrieChain(fvarKey(boxId, 0), resumeTrieLeaf("proj")),
        ),
        nothingTodo,
        false,
        payload(Array["proj"]),
        expectAnyException,
      ),
    );
    cases.push(
      MatchLoopCase(
        "chain star edge still extracts key",
        quietContext,
        LeanArray(Array[badExpr]),
        resumeTrieChain(starKey, resumeTrieLeaf("neverStarError")),
        nothingTodo,
        true,
        nothingTodo,
        expectedMissing,
      ),
    );
    cases.push(
      MatchLoopCase(
        "chain stuck key extraction error",
        stuckContext,
        LeanArray(Array[stuckExpr]),
        resumeTrieChain(fvarKey(xName, 0), resumeTrieLeaf("neverStuck")),
        nothingTodo,
        true,
        nothingTodo,
        expectStuck,
      ),
    );
    cases.push(
      MatchLoopCase(
        "node empty todo appends values keeping duplicate order",
        quietContext,
        nothingTodo,
        resumeTrieNode(
          Array[LeanText("a"), LeanText("b"), LeanText("a")],
          Array[resumeTrieChild(starKey, resumeTrieLeaf("neverStar"))],
        ),
        payload(Array["seed"]),
        false,
        payload(Array["seed", "a", "b", "a"]),
        expectAnyException,
      ),
    );
    cases.push(
      MatchLoopCase(
        "node without children ignores erroneous back expression",
        quietContext,
        LeanArray(Array[badExpr]),
        resumeTrieNode(Array[LeanText("v")], (Array[] : Array<LeanValue>)),
        kept,
        false,
        keptPayload,
        expectAnyException,
      ),
    );
    cases.push(
      MatchLoopCase(
        "node star-first then exact hit appends in order",
        quietContext,
        LeanArray(Array[constC]),
        starExactTrie,
        seeded,
        false,
        payload(Array["seed", "W", "E"]),
        expectAnyException,
      ),
    );
    cases.push(
      MatchLoopCase(
        "node star-first with missing exact returns star result",
        quietContext,
        LeanArray(Array[constP]),
        starExactTrie,
        seeded,
        false,
        payload(Array["seed", "W"]),
        expectAnyException,
      ),
    );
    cases.push(
      MatchLoopCase(
        "node single concrete child lookup miss",
        quietContext,
        LeanArray(Array[constP]),
        concreteOnlyTrie,
        nothingTodo,
        false,
        nothingTodo,
        expectAnyException,
      ),
    );
    cases.push(
      MatchLoopCase(
        "node reuses todo across star and concrete visits",
        quietContext,
        LeanArray(Array[x, appCY]),
        reuseTrie,
        nothingTodo,
        false,
        payload(Array["W", "XYE"]),
        expectAnyException,
      ),
    );
    cases.push(
      MatchLoopCase(
        "application argument order traverses first argument first",
        quietContext,
        LeanArray(Array[appFnXY]),
        resumeTrieChain(
          fvarKey(fnName, 2),
          resumeTrieChain(
            fvarKey(xName, 0),
            resumeTrieChain(fvarKey(yName, 0), resumeTrieLeaf("fxy")),
          ),
        ),
        nothingTodo,
        false,
        payload(Array["fxy"]),
        expectAnyException,
      ),
    );
    cases.push(
      MatchLoopCase(
        "application argument order rejects reversed edge key",
        quietContext,
        LeanArray(Array[appFnXY]),
        resumeTrieChain(
          fvarKey(fnName, 2),
          resumeTrieChain(fvarKey(yName, 0), resumeTrieLeaf("wrong")),
        ),
        kept,
        false,
        keptPayload,
        expectAnyException,
      ),
    );
    cases.push(
      MatchLoopCase(
        "node append crosses 128 with 127-element seed",
        quietContext,
        nothingTodo,
        resumeTrieNode(
          Array[LeanText("a"), LeanText("b")],
          (Array[] : Array<LeanValue>),
        ),
        deepSeed(127),
        false,
        seedExpected(127),
        expectAnyException,
      ),
    );
    cases.push(
      MatchLoopCase(
        "node append crosses 128 with 128-element seed",
        quietContext,
        nothingTodo,
        resumeTrieNode(
          Array[LeanText("a"), LeanText("b")],
          (Array[] : Array<LeanValue>),
        ),
        deepSeed(128),
        false,
        seedExpected(128),
        expectAnyException,
      ),
    );
    cases.push(
      MatchLoopCase(
        "deep pending todo traverses 130 levels",
        quietContext,
        deepTodo,
        deepTrieExpr,
        nothingTodo,
        false,
        payload(Array["deepEnd"]),
        expectAnyException,
      ),
    );
    cases.push(
      MatchLoopCase(
        "node star traversal error stops concrete visit",
        quietContext,
        LeanArray(Array[badExpr, constC]),
        nodeErrorTrie,
        kept,
        true,
        nothingTodo,
        expectedMissing,
      ),
    );
    limited = leanReplaceField(
      leanReplaceField(state.coreContext, 1, LeanNatLiterals.n1),
      0,
      leanReplaceField(leanField(state.coreContext, 0), 3, LeanNatLiterals.n1),
    );
    for (persistent in Array[false, true]) {
      for (world in Array[(LeanErased() : LeanValue), leanNatValue(37)]) {
        for (probeCase in cases.toArray()) {
          todo = if (persistent) matchLoopPersistentArray(probeCase.todo) else {
            probeCase.todo
          };
          trie = if (persistent) matchLoopPersistentTrie(probeCase.trie) else {
            probeCase.trie
          };
          seed = if (persistent) matchLoopPersistentArray(probeCase.seed) else {
            probeCase.seed
          };
          warm = matchLoopCheck(
            probeCase.label,
            state,
            saved,
            probeCase.context,
            todo,
            trie,
            seed,
            probeCase.expectError,
            probeCase.expected,
            probeCase.expectedException,
            world,
          );
          _warm = matchLoopCheck(
            "warm " + probeCase.label,
            state,
            warm,
            probeCase.context,
            todo,
            trie,
            seed,
            probeCase.expectError,
            probeCase.expected,
            probeCase.expectedException,
            world,
          );
          !count = count + 2
        };
        expectedDepth = LeanCtor(
          LeanTag.Option_some,
          Array[matchLoopDepthException(builder, leanField(limited, 2))],
        );
        for (trie in Array[
          resumeTrieChain(starKey, resumeTrieLeaf("never")),
          starExactTrie,
        ]) {
          checkedTrie = if (persistent) matchLoopPersistentTrie(trie) else trie;
          pending: LeanValue = LeanArray(Array[projExpr]);
          checkedTodo = if (persistent) matchLoopPersistentArray(pending) else {
            pending
          };
          before = matchLoopCheck(
            "depth error before wildcard visit",
            state,
            saved,
            quietContext,
            checkedTodo,
            checkedTrie,
            kept,
            true,
            nothingTodo,
            expectedDepth,
            world,
            Some(limited),
          );
          assert(native_eq(saved.refs, before.refs) == 0);
          !count = count + 1
        };
        unused = LeanUnavailable(
          "getMatchLoop early return must not inspect Meta/Core inputs",
        );
        noContexts = RewriteProbeState(saved, unused, unused, unused, unused);
        for ((todo, trie) in Array[
          (nothingTodo, resumeTrieChain(starKey, resumeTrieLeaf("never"))),
          (
            LeanArray(Array[badExpr]),
            resumeTrieNode(
              Array[LeanText("unused")],
              (Array[] : Array<LeanValue>),
            ),
          ),
        ]) {
          checkedTodo = if (persistent) matchLoopPersistentArray(todo) else {
            todo
          };
          checkedTrie = if (persistent) matchLoopPersistentTrie(trie) else trie;
          _noContext = matchLoopCheck(
            "early return ignores all contexts",
            noContexts,
            saved,
            unused,
            checkedTodo,
            checkedTrie,
            kept,
            false,
            keptPayload,
            expectAnyException,
            world,
          );
          !count = count + 1
        }
      }
    }
  };
  assert(count == 416);
  print_string("getMatchLoop comparisons: " + count.toString())
}
