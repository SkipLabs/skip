    cases.push(
      MatchLoopCase(
        "chain empty todo keeps result",
        quietContext,
        nothingTodo,
        resumeTrieChain(constKey(cName, 0), resumeTrieLeaf("neverChainEmpty")),
        kept,
        false,
        kept,
        expectAnyException,
