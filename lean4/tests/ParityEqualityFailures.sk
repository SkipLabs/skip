// Each mode is a separate negative run: explicit unsupported errors must remain visible.
fun main(): void {
  runtime = mutable LeanExecution{unboundedHeartbeats => true};
  fixture = f_equalityProbe_fixture(runtime);
  state = fixture.state;
  mode = Environ.varOpt("LEAN_SKIP_EQUALITY_FAILURE").default("new-trace");
  old = mode == "old-trace" || mode == "old-delayed" || mode == "old-profiler" ||
    mode == "old-firstbounds" || mode == "old-secondbounds";
  trace = mode == "old-trace" || mode == "new-trace";
  delayed = mode == "old-delayed" || mode == "new-delayed";
  profiler = mode == "old-profiler" || mode == "new-profiler";
  firstbounds = mode == "old-firstbounds" || mode == "new-firstbounds";
  secondbounds = mode == "old-secondbounds" || mode == "new-secondbounds";
  if (!trace && !delayed && !profiler && !firstbounds && !secondbounds) leanFail("unknown equality failure mode");
  world = leanNatValue(37);
  if (firstbounds || secondbounds) {
    // Exact boundary fixtures moved out of the positive probe: both circuits read
    // an empty arguments array at a valid parameter index via Array.get!Internal
    // and exit 86 in BOTH old fallback and new canonical bodies. Mirrors the
    // earliest combination the v2 trace localized (world 37, reducible, flags 0).
    context = f_equalityProbe_configure(runtime, state.metaContext, LeanTag.Meta_TransparencyMode_reducible, false);
    coreBase = leanReplaceField(state.coreContext, 3, LeanWord("uint16", 0));
    traceName = L4_Init_Prelude.f_Lean_Name_mkStr3_2a3962ce81(runtime, LeanText("trace"), LeanText("Meta"), LeanText("isDefEq"));
    traceOptions = L4_Lean_Data_Options.f_Lean_Options_setBool_50e660af42(runtime, leanField(leanField(coreBase, 0), 2), traceName, leanBool(false));
    core = leanReplaceField(coreBase, 0, leanReplaceField(leanField(coreBase, 0), 2, traceOptions));
    if (firstbounds) {
      // Removed positive case "argument default lookup": one explicit ParamInfo,
      // EMPTY left/right arguments, cursor 0.
      explicit = f_equalityProbe_parameter(runtime, LeanTag.BinderInfo_default);
      initial = f_equalityProbe_queues(Array[], Array[]);
      if (old) {
        _ = L4_Lean_Meta_ExprDefEq.f_Meta_isDefEqArgsFirstPass_spec_0_ad4075ddc6_fallback(runtime, LeanNatLiterals.n1, LeanArray(Array[explicit]), LeanArray(Array[]), LeanArray(Array[]), leanBool(false), leanBool(false), LeanNatLiterals.n0, initial, context, state.metaStateRef, core, state.coreStateRef, world)
      } else {
        _ = L4_Lean_Meta_ExprDefEq.f_Meta_isDefEqArgsFirstPass_spec_0_ad4075ddc6(runtime, LeanNatLiterals.n1, LeanArray(Array[explicit]), LeanArray(Array[]), LeanArray(Array[]), leanBool(false), leanBool(false), LeanNatLiterals.n0, initial, context, state.metaStateRef, core, state.coreStateRef, world)
      }
    } else {
      // Removed positive case "second default lookup": empty args/params with
      // queue index 12 into an empty arguments array.
      queue = LeanArray(Array[leanNatValue(12)]);
      if (old) {
        _ = L4_Lean_Meta_ExprDefEq.f_Meta_isDefEqArgs_spec_1_8eb660ca90_fallback(runtime, LeanArray(Array[]), LeanArray(Array[]), LeanArray(Array[]), leanBool(false), leanBool(false), LeanNatLiterals.n0, LeanNatLiterals.n0, queue, LeanWord("usize", 1), LeanWord("usize", 0), LeanText("prior carry"), context, state.metaStateRef, core, state.coreStateRef, world)
      } else {
        _ = L4_Lean_Meta_ExprDefEq.f_Meta_isDefEqArgs_spec_1_8eb660ca90(runtime, LeanArray(Array[]), LeanArray(Array[]), LeanArray(Array[]), leanBool(false), leanBool(false), LeanNatLiterals.n0, LeanNatLiterals.n0, queue, LeanWord("usize", 1), LeanWord("usize", 0), LeanText("prior carry"), context, state.metaStateRef, core, state.coreStateRef, world)
      }
    }
  } else if (delayed) {
    mctx = L4_Lean_MetavarContext.f_Lean_assignDelayedMVar_lam_0_21c1d3cc9b(
      runtime, LeanArray(Array[]), fixture.nId,
      LeanClosure(L4_Lean_Expr.apply_f_Lean_instBEqMVarId_beq_fc799f33a5, 2, Array[]),
      LeanClosure(L4_Lean_Expr.apply_f_Lean_instHashableMVarId_hash_524addd803, 1, Array[]),
      fixture.mId, fixture.metavariables,
    );
    runtime.writeRef(state.metaStateRef, Some(leanReplaceField(fixture.metaState, 0, mctx)));
    if (old) {
      _ = L4_Lean_Meta_ExprDefEq.f_Lean_Meta_checkAssignment_8abdc549fe_fallback(runtime, fixture.nId, LeanArray(Array[]), fixture.m, state.metaContext, state.metaStateRef, state.coreContext, state.coreStateRef, world)
    } else {
      _ = L4_Lean_Meta_ExprDefEq.f_Lean_Meta_checkAssignment_8abdc549fe(runtime, fixture.nId, LeanArray(Array[]), fixture.m, state.metaContext, state.metaStateRef, state.coreContext, state.coreStateRef, world)
    }
  } else {
    core = state.coreContext;
    options = leanField(leanField(core, 0), 2);
    if (trace) {
      traceName = L4_Init_Prelude.f_Lean_Name_mkStr3_2a3962ce81(runtime, LeanText("trace"), LeanText("Meta"), LeanText("isDefEq"));
      !options = L4_Lean_Data_Options.f_Lean_Options_setBool_50e660af42(runtime, options, traceName, leanBool(true));
      !core = leanReplaceField(core, 0, leanReplaceField(leanField(core, 0), 2, options));
      parameter = f_equalityProbe_parameter(runtime, LeanTag.BinderInfo_default, false, true);
      if (old) {
        _ = L4_Lean_Meta_ExprDefEq.f_Meta_isDefEqArgsFirstPass_spec_0_ad4075ddc6_fallback(runtime, LeanNatLiterals.n1, LeanArray(Array[parameter]), LeanArray(Array[fixture.x]), LeanArray(Array[fixture.y]), leanBool(false), leanBool(false), LeanNatLiterals.n0, f_equalityProbe_queues(Array[], Array[]), state.metaContext, state.metaStateRef, core, state.coreStateRef, world)
      } else {
        _ = L4_Lean_Meta_ExprDefEq.f_Meta_isDefEqArgsFirstPass_spec_0_ad4075ddc6(runtime, LeanNatLiterals.n1, LeanArray(Array[parameter]), LeanArray(Array[fixture.x]), LeanArray(Array[fixture.y]), leanBool(false), leanBool(false), LeanNatLiterals.n0, f_equalityProbe_queues(Array[], Array[]), state.metaContext, state.metaStateRef, core, state.coreStateRef, world)
      }
    } else {
      profilerName = L4_Init_Prelude.f_Lean_Name_mkStr2_ed89eae6ad(runtime, LeanText("trace"), LeanText("profiler"));
      heartbeatName = L4_Init_Prelude.f_Lean_Name_mkStr3_2a3962ce81(runtime, LeanText("trace"), LeanText("profiler"), LeanText("useHeartbeats"));
      !options = L4_Lean_Data_Options.f_Lean_Options_setBool_50e660af42(runtime, options, profilerName, leanBool(true));
      !options = L4_Lean_Data_Options.f_Lean_Options_setBool_50e660af42(runtime, options, heartbeatName, leanBool(true));
      !core = leanReplaceField(core, 0, leanReplaceField(leanField(core, 0), 2, options));
      if (old) {
        _ = L4_Lean_Meta_ExprDefEq.f_Lean_Meta_checkTypesAndAssign_592ac0ae25_fallback(runtime, fixture.m, fixture.x, state.metaContext, state.metaStateRef, core, state.coreStateRef, world)
      } else {
        _ = L4_Lean_Meta_ExprDefEq.f_Lean_Meta_checkTypesAndAssign_592ac0ae25(runtime, fixture.m, fixture.x, state.metaContext, state.metaStateRef, core, state.coreStateRef, world)
      }
    }
  };
  leanFail("unsupported equality fixture unexpectedly returned: " + mode)
}
