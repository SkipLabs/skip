    L4_Lean_Expr.f_Lean_Expr_hasLooseBVars_25b8fd0e1a(runtime, value),
    L4_Lean_Expr.f_Lean_Expr_hasLooseBVars_25b8fd0e1a_fallback(runtime, value),
  );
