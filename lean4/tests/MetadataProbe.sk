// Differential coverage of cached metadata reads. Synthetic nodes deliberately
// vary all metadata bits; the oracle is the retained original accessor graph.
fun metadataCompare(
  label: String,
  actual: LeanValue,
  expected: LeanValue,
): void {
  if (native_eq(actual, expected) != 0) leanFail("metadata mismatch: " + label)
}

fun metadataCheckData(runtime: mutable LeanExecution, value: LeanValue): Int {
  metadataCompare(
    "L4_Lean_Expr.f_Expr_Data_approxDepth_8b0943e63e",
    L4_Lean_Expr.f_Expr_Data_approxDepth_8b0943e63e(runtime, value),
    L4_Lean_Expr.f_Expr_Data_approxDepth_8b0943e63e_fallback(runtime, value),
  );
  metadataCompare(
    "L4_Lean_Expr.f_Expr_Data_looseBVarRange_8e964b131d",
    L4_Lean_Expr.f_Expr_Data_looseBVarRange_8e964b131d(runtime, value),
    L4_Lean_Expr.f_Expr_Data_looseBVarRange_8e964b131d_fallback(runtime, value),
  );
  metadataCompare(
    "L4_Lean_Expr.f_Expr_Data_hasFVar_58a5cf3330",
    L4_Lean_Expr.f_Expr_Data_hasFVar_58a5cf3330(runtime, value),
    L4_Lean_Expr.f_Expr_Data_hasFVar_58a5cf3330_fallback(runtime, value),
  );
  metadataCompare(
    "L4_Lean_Expr.f_Expr_Data_hasExprMVar_eccaaffcb0",
    L4_Lean_Expr.f_Expr_Data_hasExprMVar_eccaaffcb0(runtime, value),
    L4_Lean_Expr.f_Expr_Data_hasExprMVar_eccaaffcb0_fallback(runtime, value),
  );
  metadataCompare(
    "L4_Lean_Expr.f_Expr_Data_hasLevelMVar_4409fbfa06",
    L4_Lean_Expr.f_Expr_Data_hasLevelMVar_4409fbfa06(runtime, value),
    L4_Lean_Expr.f_Expr_Data_hasLevelMVar_4409fbfa06_fallback(runtime, value),
  );
  metadataCompare(
    "L4_Lean_Expr.f_Expr_Data_hasLevelParam_48aa3fc148",
    L4_Lean_Expr.f_Expr_Data_hasLevelParam_48aa3fc148(runtime, value),
    L4_Lean_Expr.f_Expr_Data_hasLevelParam_48aa3fc148_fallback(runtime, value),
  );
  metadataCompare(
    "L4_Lean_Level.f_Level_Data_hash_e7a8397800",
    L4_Lean_Level.f_Level_Data_hash_e7a8397800(runtime, value),
    L4_Lean_Level.f_Level_Data_hash_e7a8397800_fallback(runtime, value),
  );
  metadataCompare(
    "L4_Lean_Level.f_Level_Data_depth_fcd32b75c8",
    L4_Lean_Level.f_Level_Data_depth_fcd32b75c8(runtime, value),
    L4_Lean_Level.f_Level_Data_depth_fcd32b75c8_fallback(runtime, value),
  );
  metadataCompare(
    "L4_Lean_Level.f_Level_Data_hasMVar_a8d498d5a2",
    L4_Lean_Level.f_Level_Data_hasMVar_a8d498d5a2(runtime, value),
    L4_Lean_Level.f_Level_Data_hasMVar_a8d498d5a2_fallback(runtime, value),
  );
  metadataCompare(
    "L4_Lean_Level.f_Level_Data_hasParam_1083112b5b",
    L4_Lean_Level.f_Level_Data_hasParam_1083112b5b(runtime, value),
    L4_Lean_Level.f_Level_Data_hasParam_1083112b5b_fallback(runtime, value),
  );
  10
}

