}

fun metadataCheckLevel(runtime: mutable LeanExecution, value: LeanValue): Int {
  metadataCompare(
    "L4_Lean_Level.f_Level_data_override_dbd511c826",
    L4_Lean_Level.f_Level_data_override_dbd511c826(runtime, value),
    L4_Lean_Level.f_Level_data_override_dbd511c826_fallback(runtime, value),
  );
  metadataCompare(
    "L4_Lean_Level.f_Lean_Level_hash_73088a010f",
    L4_Lean_Level.f_Lean_Level_hash_73088a010f(runtime, value),
    L4_Lean_Level.f_Lean_Level_hash_73088a010f_fallback(runtime, value),
  );
  metadataCompare(
    "L4_Lean_Level.f_Lean_Level_hasMVar_1e5dea1793",
    L4_Lean_Level.f_Lean_Level_hasMVar_1e5dea1793(runtime, value),
    L4_Lean_Level.f_Lean_Level_hasMVar_1e5dea1793_fallback(runtime, value),
  );
  metadataCompare(
    "L4_Lean_Level.f_Lean_Level_hasParam_c489c472e0",
    L4_Lean_Level.f_Lean_Level_hasParam_c489c472e0(runtime, value),
    L4_Lean_Level.f_Lean_Level_hasParam_c489c472e0_fallback(runtime, value),
  );
  4
}

fun main(): void {
  runtime = mutable LeanExecution{};
  exprTags = Array[
    LeanTag.Expr_bvar__impl,
    LeanTag.Expr_fvar__impl,
    LeanTag.Expr_mvar__impl,
    LeanTag.Expr_sort__impl,
    LeanTag.Expr_const__impl,
    LeanTag.Expr_app__impl,
    LeanTag.Expr_lam__impl,
    LeanTag.Expr_forallE__impl,
    LeanTag.Expr_letE__impl,
    LeanTag.Expr_lit__impl,
    LeanTag.Expr_mdata__impl,
    LeanTag.Expr_proj__impl,
  ];
  levelTags = Array[
    LeanTag.Level_succ__impl,
    LeanTag.Level_max__impl,
    LeanTag.Level_imax__impl,
    LeanTag.Level_param__impl,
    LeanTag.Level_mvar__impl,
  ];
  count = metadataCheckLevel(
    runtime,
    LeanCtor(LeanTag.Level_zero__impl, Array[]),
  );
  for (i in Range(0, 258)) {
    bits = if (i == 0) 0 else if (i == 1) -1 else if (i < 66) {
      1.shl(i - 2)
    } else if (i < 130) 1.shl(i - 66).not() else {
      i * 6364136223846793005 + 1442695040888963407
    };
    for (data in Array[
      LeanWord("uint64", bits),
      LeanScalar("uint64", LeanNat::fromWord(bits).toString()),
    ]) {
      !count = count + metadataCheckData(runtime, data);
      for (tag in exprTags) {
        expr = LeanCtor(
          tag,
          Array[
            data,
            LeanErased(),
            LeanErased(),
            LeanErased(),
            LeanErased(),
            LeanErased(),
            LeanErased(),
            LeanErased(),
          ],
        );
        !count = count + metadataCheckExpr(runtime, expr)
      };
      for (tag in levelTags) {
        level = LeanCtor(tag, Array[data, LeanErased(), LeanErased()]);
        !count = count + metadataCheckLevel(runtime, level)
      }
    }
  };
  print_string(count.toString() + " metadata accessor comparisons passed")
}
