// Nat operation dispatch, exact name/arity recognition, and ordered operand effects.

fun reduceNatProbeDefinition(
  name: LeanValue,
  type: LeanValue,
  value: LeanValue,
): LeanValue {
  nil = LeanCtor(LeanTag.List_nil, Array[]);
  LeanCtor(
    LeanTag.ConstantInfo_defnInfo,
    Array[
      LeanCtor(
        LeanTag.DefinitionVal_mk,
        Array[
          LeanCtor(LeanTag.ConstantVal_mk, Array[name, nil, type]),
          value,
          LeanCtor(LeanTag.ReducibilityHints_abbrev, Array[]),
          LeanCtor(LeanTag.DefinitionSafety_safe, Array[]),
          LeanCtor(LeanTag.List_cons, Array[name, nil]),
        ],
      ),
    ],
  )
}

fun reduceNatProbeLiteral(
  runtime: mutable LeanExecution,
  decimal: String,
): LeanValue {
  L4_Lean_Expr.f_Lean_mkRawNatLit_73e4087d7e(
    runtime,
    leanBoxNat(leanNat(LeanScalar("nat", decimal))),
  )
}

fun reduceNatProbeApply(
  runtime: mutable LeanExecution,
  name: LeanValue,
  args: Array<LeanValue>,
): LeanValue {
  result = L4_Lean_Expr.f_Lean_mkConst_b40a363b86(
    runtime,
    name,
    LeanCtor(LeanTag.List_nil, Array[]),
  );
  for (arg in args) {
    !result = L4_Lean_Expr.f_Lean_mkApp_4478491ddb(runtime, result, arg)
  };
  result
}

fun reduceNatProbePolicy(
  runtime: mutable LeanExecution,
  args: Array<LeanValue>,
): LeanValue {
  name = L4_Lean_Declaration.f_Lean_ConstantInfo_name_42ee85d973(
    runtime,
    args[4],
  );
  calls = leanArray(runtime.readRef(args[0])).concat(Array[name]);
  runtime.writeRef(args[0], Some(LeanArray(calls)));
  if (
    leanTag(args[1]) == LeanTag.Option_some &&
    leanNameEqual(leanField(args[1], 0), name)
  ) {
    LeanCtor(LeanTag.EST_Out_error, Array[args[2], args[7]])
  } else {
    LeanCtor(LeanTag.EST_Out_ok, Array[leanBool(true), args[7]])
  }
}

fun reduceNatProbeContext(
  runtime: mutable LeanExecution,
  context: LeanValue,
  config: LeanValue,
): LeanValue {
  leanReplaceField(
    context,
    0,
    LeanCtor(
      LeanTag.Private_Lean_Meta_Basic_0_Lean_Meta_ConfigWithKey_mk,
      Array[
        config,
        L4_Lean_Meta_Basic.f_Meta_Config_toKey_993126c67a(runtime, config),
      ],
    ),
  )
}

fun reduceNatProbeCheck(
  label: String,
  saved: LeanExecutionCheckpoint,
  state: RewriteProbeState,
  expression: LeanValue,
  context: LeanValue,
  core: LeanValue,
  world: LeanValue,
  expected: LeanValue,
  unchangedRefs: Bool,
): LeanExecutionCheckpoint {
  oldExpr = rewriteProbeCopyInput(expression);
  newExpr = rewriteProbeCopyInput(expression);
  oldContext = rewriteProbeCopyInput(context);
  newContext = rewriteProbeCopyInput(context);
  oldCore = rewriteProbeCopyInput(core);
  newCore = rewriteProbeCopyInput(core);
  (result, after) = rewriteProbeCompare(
    label,
    saved,
    (runtime: mutable LeanExecution) ~>
      L4_Lean_Meta_WHNF.f_Lean_Meta_reduceNat_5f31079878_fallback(
        runtime,
        oldExpr,
        oldContext,
        state.metaStateRef,
        oldCore,
        state.coreStateRef,
        world,
      ),
    (runtime: mutable LeanExecution) ~>
      L4_Lean_Meta_WHNF.f_Lean_Meta_reduceNat_5f31079878(
        runtime,
        newExpr,
        newContext,
        state.metaStateRef,
        newCore,
        state.coreStateRef,
        world,
      )
    ,
  );
  if (!rewriteProbeSameInput(result, expected)) {
    leanFail("Nat reduction outcome: " + label)
  };
  for ((before, oldValue, newValue) in Array[
    (expression, oldExpr, newExpr),
    (context, oldContext, newContext),
    (core, oldCore, newCore),
  ]) {
    if (
      !rewriteProbeSameInput(before, oldValue) ||
      !rewriteProbeSameInput(before, newValue)
    ) {
      leanFail("Nat reduction mutated input: " + label)
    }
  };
  if (unchangedRefs && native_eq(saved.refs, after.refs) != 0) {
    leanFail("Nat reduction unexpected reference change: " + label)
  };
  after
}

fun reduceNatProbeDepthError(
  runtime: mutable LeanExecution,
  source: LeanValue,
  world: LeanValue,
): LeanValue {
  tag = L4_Init_Prelude.f_Lean_Name_mkStr2_ed89eae6ad(
    runtime,
    LeanText("runtime"),
    LeanText("maxRecDepth"),
  );
  message = L4_Lean_Message.f_Lean_MessageData_ofFormat_9fc6d2a204(
    runtime,
    LeanCtor(
      LeanTag.Std_Format_text,
      Array[
        LeanText(
          "maximum recursion depth has been reached\nuse `set_option maxRecDepth <num>` to increase limit\nuse `set_option diagnostics true` to get diagnostic information",
        ),
      ],
    ),
  );
  LeanCtor(
    LeanTag.EST_Out_error,
    Array[
      LeanCtor(
        LeanTag.Exception_error,
        Array[
          source,
          LeanCtor(LeanTag.MessageData_tagged, Array[tag, message]),
        ],
      ),
      world,
    ],
  )
}

