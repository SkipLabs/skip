          label,
          saved,
          state,
          apply("succ", Array[arg]),
          context,
          state.coreContext,
          world,
          LeanCtor(LeanTag.EST_Out_ok, Array[expected, world]),
          label == "assigned mvar" || label == "unassigned mvar",
        );
        if (label == "opaque Nat" || label == "constructor zero") {
          expectedRuntime = saved.restoreRaw();
          key = L4_Lean_Meta_Basic.f_Lean_Meta_mkExprConfigCacheKey_bd795fcce4(
            expectedRuntime,
            arg,
            context,
            world,
          );
          assert(leanTag(key) == LeanTag.EST_Out_ok);
          expectedState = expectedRuntime.readRef(state.metaStateRef);
          cache = leanField(expectedState, 1);
          entries = L4_Lean_Meta_WHNF.f_Meta_whnfImp_spec_5_f0f1dbb78c(
            expectedRuntime,
            leanField(cache, 3),
            leanField(key, 0),
            arg,
          );
          expectedRuntime.writeRef(
            state.metaStateRef,
            Some(
              leanReplaceField(
                expectedState,
                1,
                leanReplaceField(cache, 3, entries),
              ),
            ),
          );
          assert(native_eq(expectedRuntime.checkpoint().refs, after.refs) == 0)
        };
        !checks = checks + 1
      };
      for ((exponent, expected) in Array[
        ("4", LeanCtor(LeanTag.Option_some, Array[literal("81")])),
        ("5", none),
        ("18446744073709551616", none),
      ]) {
        _after = reduceNatProbeCheck(
          "exponent threshold " + exponent,
          warned,
          state,
          apply("pow", Array[literal("3"), literal(exponent)]),
          context,
          thresholdCore,
          world,
          LeanCtor(LeanTag.EST_Out_ok, Array[expected, world]),
          true,
        );
        !checks = checks + 1
      };
      for (op in Array["succ", "add", "beq", "pow"]) {
        args = if (op == "succ") Array[literal("7")] else {
          Array[literal("7"), literal("11")]
        };
        _after = reduceNatProbeCheck(
          "operand normalization depth error " + op,
          saved,
          state,
          apply(op, args),
          context,
          limitCore,
          world,
          reduceNatProbeDepthError(builder, leanField(limitCore, 2), world),
          true,
        );
        !checks = checks + 1
      };
      exception = LeanCtor(
        LeanTag.Exception_error,
        Array[
          leanField(state.coreContext, 2),
          L4_Lean_Message.f_Lean_stringToMessageData_1e55fa4f40(
            builder,
            LeanText("Nat operand policy failed"),
          ),
        ],
      );
      for ((label, first, second, failName, expectedNames, expected) in Array[
        (
          "left-to-right success",
          left,
          right,
          none,
          Array[leftName, rightName],
          LeanCtor(
            LeanTag.EST_Out_ok,
            Array[LeanCtor(LeanTag.Option_some, Array[literal("18")]), world],
          ),
        ),
        (
          "left failure skips right",
          left,
          right,
          LeanCtor(LeanTag.Option_some, Array[leftName]),
          Array[leftName],
          LeanCtor(LeanTag.EST_Out_error, Array[exception, world]),
        ),
        (
          "right failure retains left effects",
          left,
          right,
          LeanCtor(LeanTag.Option_some, Array[rightName]),
          Array[leftName, rightName],
          LeanCtor(LeanTag.EST_Out_error, Array[exception, world]),
        ),
        (
          "opaque first skips right",
          opaque,
          right,
          LeanCtor(LeanTag.Option_some, Array[rightName]),
          (Array[] : Array<LeanValue>),
          noResult,
        ),
        (
          "free second retains left effects",
          left,
          free,
          none,
          Array[leftName],
          noResult,
        ),
      ]) {
        policy = LeanClosure(
          reduceNatProbePolicy,
          8,
          Array[callLog, failName, exception],
        );
        custom = leanReplaceField(
          context,
          7,
          LeanCtor(LeanTag.Option_some, Array[policy]),
        );
        after = reduceNatProbeCheck(
          label,
          saved,
          state,
          apply("add", Array[first, second]),
          custom,
          state.coreContext,
          world,
          expected,
          false,
        );
        current = after.restoreRaw();
        assert(
          rewriteProbeSameInput(
            current.readRef(callLog),
            LeanArray(expectedNames),
          ),
        );
        if (
          label == "left failure skips right" ||
          label == "opaque first skips right"
        ) {
          expectedRuntime = saved.restoreRaw();
          expectedRuntime.writeRef(callLog, Some(LeanArray(expectedNames)));
          assert(native_eq(expectedRuntime.checkpoint().refs, after.refs) == 0)
        };
        !checks = checks + 1
      }
    }
  };
  assert(checks == 480);
  print_string(
    "Nat-reduction dispatcher passed " + checks.toString() + " cases",
  )
}
