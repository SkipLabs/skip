// Differential and expected-value checks for OfNat/Int literal recognition.
fun litProbeCompare(
  label: String,
  saved: LeanExecutionCheckpoint,
  original: (mutable LeanExecution) ~> LeanValue,
  replacement: (mutable LeanExecution) ~> LeanValue,
  expected: ?LeanValue = None(),
): (LeanValue, LeanExecutionCheckpoint) {
  oldRuntime = saved.restoreRaw();
  newRuntime = saved.restoreRaw();
  oldResult = original(oldRuntime);
  newResult = replacement(newRuntime);
  after = newRuntime.checkpoint();
  if (native_eq(oldResult, newResult) != 0) {
    print_string(
      "literal result content equality: " +
        rewriteProbeSameInput(oldResult, newResult).toString(),
    );
    print_string(
      "old tag: " +
        leanTag(oldResult).toString() +
        "; new tag: " +
        leanTag(newResult).toString(),
    );
    leanFail("rewrite result mismatch: " + label)
  };
  if (native_eq(oldRuntime.checkpoint().refs, after.refs) != 0) {
    leanFail("rewrite reference mismatch: " + label)
  };
  expected match {
  | Some(value) ->
    if (!rewriteProbeSameInput(newResult, value)) {
      leanFail("rewrite unexpected outcome: " + label)
    }
  | None() -> void
  };
  (newResult, after)
}

fun litProbeName(runtime: mutable LeanExecution, text: String): LeanValue {
  L4_Init_Prelude.f_Lean_Name_mkStr1_4962bb4b4e(runtime, LeanText(text))
}

fun litProbeDepthContext(
  base: LeanValue,
  maximum: LeanValue,
  current: LeanValue,
  source: LeanValue,
): LeanValue {
  cold = leanReplaceField(leanField(base, 0), 3, maximum);
  withCold = leanReplaceField(base, 0, cold);
  withDepth = leanReplaceField(withCold, 1, current);
  leanReplaceField(withDepth, 2, source)
}

fun litProbeDepthError(
  runtime: mutable LeanExecution,
  source: LeanValue,
  world: LeanValue,
): LeanValue {
  tag = L4_Init_Prelude.f_Lean_Name_mkStr2_ed89eae6ad(
    runtime,
    LeanText("runtime"),
    LeanText("maxRecDepth"),
  );
  message = L4_Lean_Message.f_Lean_MessageData_ofFormat_9fc6d2a204(
    runtime,
    LeanCtor(
      LeanTag.Std_Format_text,
      Array[
        LeanText(
          "maximum recursion depth has been reached\nuse `set_option maxRecDepth <num>` to increase limit\nuse `set_option diagnostics true` to get diagnostic information",
        ),
      ],
    ),
  );
  LeanCtor(
    LeanTag.EST_Out_error,
    Array[
      LeanCtor(
        LeanTag.Exception_error,
        Array[
          source,
          LeanCtor(LeanTag.MessageData_tagged, Array[tag, message]),
        ],
      ),
      world,
    ],
  )
}

fun litProbeApply(
  runtime: mutable LeanExecution,
  function: LeanValue,
  argument: LeanValue,
): LeanValue {
  L4_Lean_Expr.f_Lean_mkApp_4478491ddb(runtime, function, argument)
}

fun litProbeApply3(
  runtime: mutable LeanExecution,
  function: LeanValue,
  first: LeanValue,
  second: LeanValue,
  third: LeanValue,
): LeanValue {
  litProbeApply(
    runtime,
    litProbeApply(runtime, litProbeApply(runtime, function, first), second),
    third,
  )
}

fun litProbeAxiom(name: LeanValue, type: LeanValue): LeanValue {
  LeanCtor(
    LeanTag.ConstantInfo_axiomInfo,
    Array[
      LeanCtor(
        LeanTag.AxiomVal_mk,
        Array[
          LeanCtor(
            LeanTag.ConstantVal_mk,
            Array[name, LeanCtor(LeanTag.List_nil, Array[]), type],
          ),
          leanBool(false),
        ],
      ),
    ],
  )
}

fun litProbeDefinition(
  name: LeanValue,
  type: LeanValue,
  value: LeanValue,
): LeanValue {
  LeanCtor(
    LeanTag.ConstantInfo_defnInfo,
    Array[
      LeanCtor(
        LeanTag.DefinitionVal_mk,
        Array[
          LeanCtor(
            LeanTag.ConstantVal_mk,
            Array[name, LeanCtor(LeanTag.List_nil, Array[]), type],
          ),
          value,
          LeanCtor(LeanTag.ReducibilityHints_abbrev, Array[]),
          LeanCtor(LeanTag.DefinitionSafety_safe, Array[]),
          LeanCtor(
            LeanTag.List_cons,
            Array[name, LeanCtor(LeanTag.List_nil, Array[])],
          ),
        ],
      ),
    ],
  )
}

fun litProbeOfNat(
  runtime: mutable LeanExecution,
  useFallback: Bool,
  expr: LeanValue,
  typeName: LeanValue,
  state: RewriteProbeState,
  world: LeanValue,
): LeanValue {
  exprCopy = rewriteProbeCopyInput(expr);
  typeNameCopy = rewriteProbeCopyInput(typeName);
  metaContextCopy = rewriteProbeCopyInput(state.metaContext);
  coreContextCopy = rewriteProbeCopyInput(state.coreContext);
  callState = RewriteProbeState(
    state.saved,
    metaContextCopy,
    state.metaStateRef,
    coreContextCopy,
    state.coreStateRef,
  );
  result = if (useFallback) {
    L4_Lean_Meta_LitValues.f_Lean_Meta_getOfNatValue_4bf9090d48_fallback(
      runtime,
      exprCopy,
      typeNameCopy,
      callState.metaContext,
      callState.metaStateRef,
      callState.coreContext,
      callState.coreStateRef,
      world,
    )
  } else {
    L4_Lean_Meta_LitValues.f_Lean_Meta_getOfNatValue_4bf9090d48(
      runtime,
      exprCopy,
      typeNameCopy,
      callState.metaContext,
      callState.metaStateRef,
      callState.coreContext,
      callState.coreStateRef,
      world,
    )
  };
  if (!rewriteProbeSameInput(exprCopy, expr)) {
    leanFail("getOfNatValue mutated expr input")
  };
  if (!rewriteProbeSameInput(typeNameCopy, typeName)) {
    leanFail("getOfNatValue mutated type-name input")
  };
  if (!rewriteProbeSameInput(metaContextCopy, state.metaContext)) {
    leanFail("getOfNatValue mutated Meta context input")
  };
  if (!rewriteProbeSameInput(coreContextCopy, state.coreContext)) {
    leanFail("getOfNatValue mutated Core context input")
  };
  result
}

