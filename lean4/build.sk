// The maintained Skip files are authoritative. This hook only lists inputs.
fun main(): void {
  for (path in FileSystem.readTextFile("sources/build.txt").split("\n")) {
    if (path.isEmpty()) continue;
    invariant(
      path.startsWith("sources/Modules/"),
      "Invalid source manifest entry",
    );
    invariant(FileSystem.exists(path), "Missing maintained source: " + path);
    print_string("skargo:skc-extra-source=" + path)
  };
  print_string("skargo:rerun-if-changed=sources/build.txt")
}
