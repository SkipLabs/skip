-- Generated by tools/gcd_workload.py --bound 20 --count 3.
-- Distinct GCD claims sharing a factorial; no external libraries or axioms.
set_option exponentiation.threshold 200000
set_option maxRecDepth 200000
set_option maxHeartbeats 0
set_option Elab.async false

def fact : Nat → Nat
  | 0 => 1
  | n+1 => (n+1) * fact n

def bound : Nat := 20
def noise : Nat := 99


theorem factorial_gcd_3 :
    Nat.gcd (fact bound) (6 ^ 11) = 2 ^ 11 * 3 ^ 8 := by
  decide

#print axioms factorial_gcd_3


theorem factorial_gcd_5 :
    Nat.gcd (fact bound) (10 ^ 6) = 2 ^ 6 * 5 ^ 4 := by
  decide

#print axioms factorial_gcd_5


theorem factorial_gcd_7 :
    Nat.gcd (fact bound) (14 ^ 4) = 2 ^ 4 * 7 ^ 2 := by
  decide

#print axioms factorial_gcd_7
