    L4_Lean_Elab_Exception.f_Exception_hygCtx_hyg_626a966519,
  );
  leanInitializeBinding(
    runtime,
    "Lean.Elab.abortTermExceptionId",
    L4_Lean_Elab_Exception.f_Exception_hygCtx_hyg_5118ee9d0a,
  );
  leanInitializeBinding(
    runtime,
    "Lean.Elab.postponeExceptionId",
    L4_Lean_Elab_Exception.f_Exception_hygCtx_hyg_be1f0cf36c,
  );
  leanInitializeBinding(
    runtime,
    "Lean.Elab.autoBoundImplicitExceptionId",
    L4_Lean_Elab_Exception.f_Exception_hygCtx_hyg_ed6e74aa3c,
  );
  leanInitializeBinding(
    runtime,
    "Lean.Elab.unsupportedSyntaxExceptionId",
    L4_Lean_Elab_Exception.f_Exception_hygCtx_hyg_57b9a80f6d,
  );
  leanInitializeBinding(
    runtime,
    "Lean.Elab.abortTacticExceptionId",
    L4_Lean_Elab_Exception.f_Exception_hygCtx_hyg_a80b0c5c9a,
  );
  leanInitializeBinding(
    runtime,
    "Lean.Meta.isDefEqStuckExceptionId",
    L4_Lean_Meta_Basic.f_Basic_hygCtx_hyg_c825251f4f,
  );
  leanInitializeBinding(
    runtime,
    "Lean.PrettyPrinter.backtrackExceptionId",
    L4_Lean_PrettyPrinter_Basic.f_Basic_hygCtx_hyg_e118d116ae,
