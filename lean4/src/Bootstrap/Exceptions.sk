// Initialize only the internal-exception registry and its known identifiers.
// The original Lean initialization bodies perform allocation and duplicate checks.
// IDs are execution-local; full module initialization is still unsupported.
fun leanInitializeExceptions(runtime: mutable LeanExecution): void {
  leanInitializeBinding(
    runtime,
    "Lean.internalExceptionsRef",
    L4_Lean_InternalExceptionId.f_InternalExceptionId_hygCtx_hyg_ea47830e2b,
  );
  leanInitializeBinding(
    runtime,
    "Lean.interruptExceptionId",
    L4_Lean_Exception.f_Exception_hygCtx_hyg_56814b581c,
  );
  leanInitializeBinding(
    runtime,
