// A synchronous environment over two distinct constant views. The caller supplies
// imported module metadata and initialized extension states. This constructor
// neither validates declarations nor substitutes for module initialization.
fun leanEnvironment(
  runtime: mutable LeanExecution,
  imports: LeanConstantsView,
  locals: LeanConstantsView,
  header: LeanValue,
  extensions: LeanValue,
  extensionGenerations: LeanValue,
  quotInitialized: Bool,
  trackedGeneration: LeanValue = LeanUnavailable("imported tracked generation"),
  importedExtraConstants: LeanValue = LeanUnavailable(
    "imported extra IR constants",
  ),
): LeanValue {
  none: LeanValue = LeanCtor(LeanTag.Option_none, Array[]);
  nil: LeanValue = LeanCtor(LeanTag.List_nil, Array[]);
  leaf: LeanValue = LeanCtor(
    LeanTag.Std_DTreeMap_Internal_Impl_leaf,
    Array[],
  );
  hashMap: LeanValue = LeanCtor(
    LeanTag.PersistentHashMap_Node_entries,
    Array[
      LeanArray(
        Array::fill(
          32,
          LeanCtor(
            LeanTag.PersistentHashMap_Entry_null,
            Array[],
          ),
        ),
      ),
    ],
  );
  constants: LeanValue = LeanCtor(
    LeanTag.ConstMap_mk,
    Array[
      LeanCtor(
        LeanTag.ImportedConsts_mk,
        Array[none, LeanTrackedConstants(imports)],
      ),
      LeanTrackedConstants(locals),
    ],
  );
  kernel: LeanValue = LeanCtor(
    LeanTag.Private_Lean_Environment_0_Lean_Kernel_Environment_mk,
    Array[
      constants,
      leanBool(quotInitialized),
      LeanCtor(
        LeanTag.Kernel_Diagnostics_mk,
        Array[hashMap, leanBool(false)],
      ),
      importedExtraConstants,
      extensions,
      LeanUnavailable("IR environment extension state"),
      extensionGenerations,
      trackedGeneration,
      header,
    ],
  );
  asyncConsts = L4_Lean_Environment.f_Lean_instInhabitedAsyncConsts_default_13eda108e4(
    runtime,
  );
  visibility = LeanTag.Private_Lean_Environment_0_Lean_VisibilityMap_mk;
  LeanCtor(
    LeanTag.Private_Lean_Environment_0_Lean_Environment_mk,
    Array[
      LeanCtor(visibility, Array[kernel, kernel]),
      LeanUnavailable("server environment extension state"),
      LeanCompletedTask(kernel),
      LeanCtor(visibility, Array[asyncConsts, asyncConsts]),
      none,
      none,
      leaf,
      LeanCompletedTask(leaf),
      leanBool(false),
      leanBool(false),
      none,
      LeanCtor(
        LeanTag.DeclChangeLog_mk,
        Array[leanNatValue(0), nil],
      ),
      leanNatValue(0),
      hashMap,
      leanNatValue(0),
    ],
  )
}

// Valid header for tests without imports. Imported environments must instead use
// the actual module header from their import data.
fun leanEmptyEnvironmentHeader(): LeanValue {
  empty: LeanValue = LeanArray(Array[]);
  moduleIndices: LeanValue = LeanCtor(
    LeanTag.Std_DHashMap_Raw_mk,
    Array[
      leanNatValue(0),
      LeanArray(
        Array::fill(
          8,
          LeanCtor(
            LeanTag.Std_DHashMap_Internal_AssocList_nil,
            Array[],
          ),
        ),
      ),
    ],
  );
  LeanCtor(
    LeanTag.Private_Lean_Environment_0_Lean_EnvironmentHeader_mk,
    Array[
      LeanWord("uint32", 0),
      LeanCtor(LeanTag.Name_anonymous__impl, Array[]),
      leanBool(false),
      empty,
      empty,
      empty,
      empty,
      moduleIndices,
      empty,
      empty,
    ],
  )
}
