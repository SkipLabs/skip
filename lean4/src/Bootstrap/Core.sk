// Pure state construction. Module initialization and import data must be supplied
// separately; this function never invents imported declarations or extensions.
fun leanCoreState(
  runtime: mutable LeanExecution,
  environment: LeanValue,
): LeanValue {
  LeanCtor(
    LeanTag.Core_State_mk,
    Array[
      environment,
      leanNatValue(2),
      L4_Init_MetaTypes.f_Lean_instInhabitedNameGenerator_default_c64d1df201(
        runtime,
      ),
      L4_Lean_CoreM.f_Lean_instInhabitedDeclNameGenerator_default_4661a7c552(
        runtime,
      ),
      L4_Lean_Util_Trace.f_Lean_instInhabitedTraceState_default_da6a26b190(
        runtime,
      ),
      L4_Lean_CoreM.f_Core_instInhabitedCache_default_fdcbc02675(runtime),
      L4_Lean_CoreM.f_Lean_instInhabitedRecordedDeps_default_a565cf883a(
        runtime,
      ),
      L4_Lean_Message.f_Lean_instInhabitedMessageLog_default_9420f96dfb(
        runtime,
      ),
      L4_Lean_Elab_InfoTree_Types.f_Elab_instInhabitedInfoState_default_7e43361277(
        runtime,
      ),
      LeanArray(Array[]),
    ],
  )
}
