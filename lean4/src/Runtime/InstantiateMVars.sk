// Direct assignment and universe substitution from instantiate_mvars.cpp.
// Context reads/write-back use the maintained Lean implementations. Delayed
// assignments and cyclic assignments fail explicitly. Traversal-local DAG
// sharing is not yet preserved; this is separate from SKStore dependency reuse.
fun leanExprHasMVars(expr: LeanValue): Bool {
  leanExprData(expr).and(6.shl(40)) != 0
}

fun leanLevelHasMVars(level: LeanValue): Bool {
  if (leanTag(level) == LeanTag.Level_zero__impl) return false;
  leanWordBits(leanField(level, 0)).and(1.shl(32)) != 0
}

// Only called for an assigned metavariable at an application head. Ordinary
// lambda applications are left alone, as in Lean's direct-assignment pass.
fun leanMVarApplyBeta(
  runtime: mutable LeanExecution,
  fn: LeanValue,
  args: Array<LeanValue>,
): LeanValue {
  result = fn;
  index = 0;
  while (index < args.size()) {
    leanTag(result) match {
    | LeanTag.Expr_lam__impl ->
      !result = leanExprInstantiate(
        runtime,
        leanField(result, 3),
        Array[args[index]],
        0,
      );
      !index = index + 1
    | LeanTag.Expr_letE__impl ->
      !result = leanExprInstantiate(
        runtime,
        leanField(result, 4),
        Array[leanField(result, 3)],
        0,
      )
    | LeanTag.Expr_mdata__impl ->
      !result = leanField(result, 2)
    | _ ->
      while (index < args.size()) {
        !result = L4_Lean_Expr.f_Lean_mkApp_4478491ddb(
          runtime,
          result,
          args[index],
        );
        !index = index + 1
      }
    }
  };
  result
}

mutable class LeanMVarInstantiation{
  runtime: mutable LeanExecution,
  mutable context: LeanValue,
  activeExpr: mutable Map<String, Bool> = mutable Map[],
  activeLevel: mutable Map<String, Bool> = mutable Map[],
} {
  mutable fun assignment(id: LeanValue): ?LeanValue {
    original = L4_Lean_MetavarContext.f_Lean_MetavarContext_getExprAssignmentCore_7080b00ff2(
      this.runtime,
      this.context,
      id,
    );
    if (leanTag(original) == LeanTag.Option_none) {
      delayed = L4_Lean_MetavarContext.f_Lean_MetavarContext_getDelayedMVarAssignmentCore_7f0b380b23(
        this.runtime,
        this.context,
        id,
      );
      if (leanTag(delayed) != LeanTag.Option_none) {
        leanFail(
          "not implemented: delayed metavariable assignment [lean_instantiate_expr_mvars]",
        )
      };
      return None()
    };
    value = leanField(original, 0);
    if (!leanExprHasMVars(value)) return Some(value);
    key = leanNameKey(id);
    if (this.activeExpr.maybeGet(key).default(false)) {
      leanFail("not implemented: cyclic expression metavariable assignment")
    };
    this.activeExpr.set(key, true);
    normalized = this.expr(value);
    this.activeExpr.set(key, false);
    if (native_eq(value, normalized) != 0) {
      this.!context = L4_Lean_MetavarContext.f_Lean_assignExp_5e8f394bd8(
        this.runtime,
        this.context,
        id,
        normalized,
      )
    };
    Some(normalized)
  }

  mutable fun level(value: LeanValue): LeanValue {
    if (!leanLevelHasMVars(value)) return value;
    leanTag(value) match {
    | LeanTag.Level_mvar__impl ->
      id = leanField(value, 1);
      assignment = L4_Lean_MetavarContext.f_Lean_getLevelMVarAssignmentExp_65f9d81d1e(
        this.runtime,
        this.context,
        id,
      );
      if (leanTag(assignment) == LeanTag.Option_none) return value;
      original = leanField(assignment, 0);
      if (!leanLevelHasMVars(original)) return original;
      key = leanNameKey(id);
      if (this.activeLevel.maybeGet(key).default(false)) {
        leanFail("not implemented: cyclic universe metavariable assignment")
      };
      this.activeLevel.set(key, true);
      normalized = this.level(original);
      this.activeLevel.set(key, false);
      if (native_eq(original, normalized) != 0) {
        this.!context = L4_Lean_MetavarContext.f_Lean_assignLevelMVarExp_3aaad3f7ed(
          this.runtime,
          this.context,
          id,
          normalized,
        )
      };
      normalized
    | LeanTag.Level_succ__impl ->
      L4_Lean_Level.f_Lean_mkLevelSucc_2631235517(
        this.runtime,
        this.level(leanField(value, 1)),
      )
    | LeanTag.Level_max__impl ->
      left = this.level(leanField(value, 1));
      right = this.level(leanField(value, 2));
      L4_Lean_Level.f_Lean_mkLevelMax_68700d1eab(this.runtime, left, right)
    | LeanTag.Level_imax__impl ->
      left = this.level(leanField(value, 1));
      right = this.level(leanField(value, 2));
      L4_Lean_Level.f_Lean_mkLevelIMax_bf6ea94d24(this.runtime, left, right)
    | _ -> leanFail("invalid universe metadata in metavariable substitution")
    }
  }

  mutable fun levels(values: LeanValue): LeanValue {
    leanTag(values) match {
    | LeanTag.List_nil -> values
    | LeanTag.List_cons ->
      value = this.level(leanField(values, 0));
      tail = this.levels(leanField(values, 1));
      LeanCtor(LeanTag.List_cons, Array[value, tail])
    | _ -> leanFail("invalid universe list in metavariable substitution")
    }
  }

  mutable fun expr(value: LeanValue): LeanValue {
    if (!leanExprHasMVars(value)) return value;
    leanTag(value) match {
    | LeanTag.Expr_mvar__impl ->
      this.assignment(leanField(value, 1)).default(value)
    | LeanTag.Expr_sort__impl ->
      L4_Lean_Expr.f_Lean_mkSort_ccbb836181(
        this.runtime,
        this.level(leanField(value, 1)),
      )
    | LeanTag.Expr_const__impl ->
      levels = this.levels(leanField(value, 2));
      L4_Lean_Expr.f_Lean_mkConst_b40a363b86(
        this.runtime,
        leanField(value, 1),
        levels,
      )
    | LeanTag.Expr_app__impl ->
      head = value;
      while (leanTag(head) == LeanTag.Expr_app__impl) {
        !head = leanField(head, 1)
      };
      if (leanTag(head) == LeanTag.Expr_mvar__impl) {
        this.assignment(leanField(head, 1)) match {
        | Some(fn) ->
          reversed: mutable Vector<LeanValue> = mutable Vector[];
          current = value;
          while (leanTag(current) == LeanTag.Expr_app__impl) {
            reversed.push(this.expr(leanField(current, 2)));
            !current = leanField(current, 1)
          };
          args = Array::fillBy(reversed.size(), i ->
            reversed[reversed.size() - i - 1]
          );
          return leanMVarApplyBeta(this.runtime, fn, args)
        | None() -> void
        }
      };
      arg = this.expr(leanField(value, 2));
      fn = this.expr(leanField(value, 1));
      L4_Lean_Expr.f_Lean_mkApp_4478491ddb(this.runtime, fn, arg)
    | _ ->
      childValues = leanExprChildren(value).map(child ->
        this.expr(leanField(value, child.i0))
      );
      leanExprRebuild(this.runtime, value, childValues)
    }
  }
}

fun leanInstantiateMVars(
  runtime: mutable LeanExecution,
  context: LeanValue,
  value: LeanValue,
  isLevel: Bool,
): LeanValue {
  traversal = mutable LeanMVarInstantiation{runtime, context};
  result = if (isLevel) traversal.level(value) else traversal.expr(value);
  LeanCtor(LeanTag.Prod_mk, Array[traversal.context, result])
}
