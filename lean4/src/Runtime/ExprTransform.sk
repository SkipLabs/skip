// Runtime operations over Lean expressions. Rebuilding uses the maintained Lean
// constructors, so hashes, binder annotations and cached metadata stay consistent.
// Abstraction preserves sharing with a traversal-local memo table. Instantiation
// and shifting still revisit shared subtrees; their DAG optimization is pending.

// Child field index and number of additional binders in that child.
fun leanExprChildren(expr: LeanValue): Array<(Int, Int)> {
  leanTag(expr) match {
  | LeanTag.Expr_app__impl -> Array[(1, 0), (2, 0)]
  | LeanTag.Expr_lam__impl
  | LeanTag.Expr_forallE__impl ->
    Array[(2, 0), (3, 1)]
  | LeanTag.Expr_letE__impl -> Array[(2, 0), (3, 0), (4, 1)]
  | LeanTag.Expr_mdata__impl -> Array[(2, 0)]
  | LeanTag.Expr_proj__impl -> Array[(3, 0)]
  | LeanTag.Expr_bvar__impl
  | LeanTag.Expr_fvar__impl
  | LeanTag.Expr_mvar__impl
  | LeanTag.Expr_sort__impl
  | LeanTag.Expr_const__impl
  | LeanTag.Expr_lit__impl ->
    Array[]
  | _ -> leanFail("invalid expression in Lean runtime traversal")
  }
}

fun leanExprRebuild(
  runtime: mutable LeanExecution,
  expr: LeanValue,
  values: Array<LeanValue>,
): LeanValue {
  leanTag(expr) match {
  | LeanTag.Expr_app__impl ->
    L4_Lean_Expr.f_Lean_mkApp_4478491ddb(runtime, values[0], values[1])
  | LeanTag.Expr_lam__impl ->
    L4_Lean_Expr.f_Lean_mkLambda_fa85a512c1(
      runtime,
      leanField(expr, 1),
      leanField(expr, 4),
      values[0],
      values[1],
    )
  | LeanTag.Expr_forallE__impl ->
    L4_Lean_Expr.f_Lean_mkForall_fc2281f2c3(
      runtime,
      leanField(expr, 1),
      leanField(expr, 4),
      values[0],
      values[1],
    )
  | LeanTag.Expr_letE__impl ->
    L4_Lean_Expr.f_Lean_mkLet_82f97eecaa(
      runtime,
      leanField(expr, 1),
      values[0],
      values[1],
      values[2],
      leanField(expr, 5),
    )
  | LeanTag.Expr_mdata__impl ->
    L4_Lean_Expr.f_Lean_mkMData_3cfcde81b2(
      runtime,
      leanField(expr, 1),
      values[0],
    )
  | LeanTag.Expr_proj__impl ->
    L4_Lean_Expr.f_Lean_mkProj_3b27598f19(
      runtime,
      leanField(expr, 1),
      leanField(expr, 2),
      values[0],
    )
  | _ -> expr
  }
}

// A negative delta lowers indices. Callers enforce the public s >= d condition.
fun leanExprShift(
  runtime: mutable LeanExecution,
  expr: LeanValue,
  cutoff: Int,
  delta: Int,
): LeanValue {
  if (delta == 0 || leanExprData(expr).ushr(44) <= cutoff) return expr;
  if (leanTag(expr) == LeanTag.Expr_bvar__impl) {
    index = leanNat(leanField(expr, 1)).toInt();
    if (index < cutoff) return expr;
    return L4_Lean_Expr.f_Lean_mkBVar_eb2781ad2d(
      runtime,
      leanNatValue(index + delta),
    )
  };
  leanExprRebuild(
    runtime,
    expr,
    leanExprChildren(expr).map(child ->
      leanExprShift(
        runtime,
        leanField(expr, child.i0),
        cutoff + child.i1,
        delta,
      )
    ),
  )
}

// subst[0] replaces loose index zero. Passing under a binder
// increases offset and lifts the substitution, preventing variable capture.
fun leanExprInstantiate(
  runtime: mutable LeanExecution,
  expr: LeanValue,
  subst: Array<LeanValue>,
  offset: Int,
): LeanValue {
  if (subst.isEmpty() || leanExprData(expr).ushr(44) <= offset) return expr;
  if (leanTag(expr) == LeanTag.Expr_bvar__impl) {
    index = leanNat(leanField(expr, 1)).toInt();
    if (index < offset) return expr;
    if (index - offset < subst.size()) {
      return leanExprShift(runtime, subst[index - offset], 0, offset)
    };
    return L4_Lean_Expr.f_Lean_mkBVar_eb2781ad2d(
      runtime,
      leanNatValue(index - subst.size()),
    )
  };
  leanExprRebuild(
    runtime,
    expr,
    leanExprChildren(expr).map(child ->
      leanExprInstantiate(
        runtime,
        leanField(expr, child.i0),
        subst,
        offset + child.i1,
      )
    ),
  )
}

fun leanExprInstantiateRange(
  runtime: mutable LeanExecution,
  expr: LeanValue,
  begin: LeanValue,
  end: LeanValue,
  input: LeanValue,
  reverse: Bool,
): LeanValue {
  subst = leanArray(input);
  if (
    leanNat(begin) > leanNat(end) ||
    leanNat(end) > LeanNat::fromInt(subst.size())
  ) {
    leanFail("invalid Lean expression substitution range")
  };
  first = leanNat(begin).toInt();
  last = leanNat(end).toInt();
  selected = Array::fillBy(last - first, i ->
    subst[if (reverse) last - 1 - i else first + i]
  );
  leanExprInstantiate(runtime, expr, selected, 0)
}

fun leanExprShiftRange(
  runtime: mutable LeanExecution,
  expr: LeanValue,
  start: LeanValue,
  amount: LeanValue,
  lower: Bool,
): LeanValue {
  s = leanNat(start);
  d = leanNat(amount);
  if (
    s >= LeanNat::fromInt(leanExprData(expr).ushr(44)) ||
    (lower && s < d) ||
    d == LeanNat::fromInt(0)
  ) return expr;
  if (!lower && d > LeanNat::fromInt(1048575)) {
    leanFail("too many Lean bound variables")
  };
  leanExprShift(
    runtime,
    expr,
    s.toInt(),
    if (lower) 0 - d.toInt() else d.toInt(),
  )
}

fun leanExprHasLooseBVarAt(expr: LeanValue, index: LeanValue): LeanValue {
  n = leanNat(index);
  if (n >= LeanNat::fromInt(leanExprData(expr).ushr(44))) {
    return leanBool(false)
  };
  leanBool(leanExprHasLooseBVar(expr, n.toInt()))
}

fun leanExprHasLooseBVar(expr: LeanValue, index: Int): Bool {
  if (leanExprData(expr).ushr(44) <= index) return false;
  if (leanTag(expr) == LeanTag.Expr_bvar__impl) {
    return leanNat(leanField(expr, 1)).toInt() == index
  };
  leanExprChildren(expr).any(child ->
    leanExprHasLooseBVar(leanField(expr, child.i0), index + child.i1)
  )
}

// Abstract free variables and metavariables. The last matching array entry wins;
// bound indices are counted from the end of the selected prefix, under binders.
// Entries of other Expr kinds are ignored, matching lean_expr_abstract_core.
class LeanExprScopeKey(expr: LeanValue, offset: Int) uses Hashable, Equality {
  fun hash(): Int {
    LeanImmutableKey(this.expr).hash().xor(this.offset.shl(32))
  }
  fun ==(other: this): Bool {
    this.offset == other.offset &&
      (leanSameObject(this.expr, other.expr) != 0 ||
        native_eq(this.expr, other.expr) == 0)
  }
}

fun leanExprAbstractAt(
  runtime: mutable LeanExecution,
  expr: LeanValue,
  subst: Array<LeanValue>,
  count: Int,
  offset: Int,
): LeanValue {
  cache: mutable Map<LeanExprScopeKey, LeanValue> = mutable Map[];
  leanExprAbstractVisit(runtime, expr, subst, count, offset, cache)
}

fun leanExprAbstractVisit(
  runtime: mutable LeanExecution,
  expr: LeanValue,
  subst: Array<LeanValue>,
  count: Int,
  offset: Int,
  cache: mutable Map<LeanExprScopeKey, LeanValue>,
): LeanValue {
  if (count == 0 || leanExprData(expr).and(7.shl(40)) == 0) return expr;
  key = LeanExprScopeKey(expr, offset);
  cache.maybeGet(key) match {
  | Some(result) -> return result
  | None() -> void
  };
  result = leanExprAbstractNode(runtime, expr, subst, count, offset, cache);
  cache.set(key, result);
  result
}

fun leanExprAbstractNode(
  runtime: mutable LeanExecution,
  expr: LeanValue,
  subst: Array<LeanValue>,
  count: Int,
  offset: Int,
  cache: mutable Map<LeanExprScopeKey, LeanValue>,
): LeanValue {
  tag = leanTag(expr);
  if (
    tag == LeanTag.Expr_fvar__impl ||
    tag == LeanTag.Expr_mvar__impl
  ) {
    i = count;
    while (i > 0) {
      !i = i - 1;
      if (
        leanTag(subst[i]) == tag &&
        leanNameEqual(leanField(subst[i], 1), leanField(expr, 1))
      ) {
        return L4_Lean_Expr.f_Lean_mkBVar_eb2781ad2d(
          runtime,
          leanNatValue(offset + count - i - 1),
        )
      }
    };
    return expr
  };
  leanExprRebuild(
    runtime,
    expr,
    leanExprChildren(expr).map(child ->
      leanExprAbstractVisit(
        runtime,
        leanField(expr, child.i0),
        subst,
        count,
        offset + child.i1,
        cache,
      )
    ),
  )
}

fun leanExprAbstractRange(
  runtime: mutable LeanExecution,
  expr: LeanValue,
  count: LeanValue,
  input: LeanValue,
): LeanValue {
  subst = leanArray(input);
  n = leanNat(count);
  size = if (n >= LeanNat::fromInt(subst.size())) subst.size() else n.toInt();
  leanExprAbstractAt(runtime, expr, subst, size, 0)
}
