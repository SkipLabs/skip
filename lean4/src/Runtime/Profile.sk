// With profiling disabled, Lean.profileit executes the action exactly once.
// Profiling output/counters are not implemented; enabling them fails explicitly.
fun leanProfile(
  runtime: mutable LeanExecution,
  options: LeanValue,
  action: LeanValue,
): LeanValue {
  name = L4_Init_Prelude.f_Lean_Name_mkStr1_4962bb4b4e(
    runtime,
    LeanText("profiler"),
  );
  profilingEnabled = L4_Lean_Data_Options.f_Lean_Options_getBool_b4c4887473(
    runtime,
    options,
    name,
    leanBool(false),
  );
  if (leanIsTrue(profilingEnabled)) {
    return leanPrimitive(
      "Lean.profileit [lean_profileit] with profiler enabled",
    )
  };
  leanApply(runtime, action, Array[LeanCtor(LeanTag.PUnit_unit, Array[])])
}
