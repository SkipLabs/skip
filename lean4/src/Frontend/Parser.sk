    if (
      leanIsTrue(
        L4_Lean_Parser_Types.f_Parser_InputContext_atEnd_2795c49548(
          runtime,
          inputContext,
          leanField(state, 2),
        ),
      )
    ) {
      syntax = L4_Lean_Parser_Types.f_Parser_SyntaxStack_back_d4f5029b0b(
        runtime,
        leanField(state, 0),
      );
      return LeanCtor(LeanTag.Except_ok, Array[syntax])
