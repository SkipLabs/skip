// Lean's ordinal within an inductive type is distinct from a global tag code.
// The immutable table is pinned to provenance/constructors.json.
fun leanConstructorOrdinal(tag: LeanTag.Value): Int {
  tag match {
  | LeanTag.Known(code) -> LeanTag.ordinals[code]
  | LeanTag.Unknown(name) ->
    leanFail("unknown Lean constructor ordinal: " + name)
  }
}
