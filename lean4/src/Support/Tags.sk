// Compact typed identities. Named constants work in Skip patterns, so the
// execution path compares integer codes instead of protocol strings.
// The codes are globally unique; Lean constructor ordinals are separate.
module LeanTag;

base class Value uses Equality {
  children =
  | Known(code: Int)
  | Unknown(name: String)

  fun toString(): String {
    this match {
    | Known(code) -> names[code]
    | Unknown(name) -> name
    }
  }
}

