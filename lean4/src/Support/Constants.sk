// The scope identifies an immutable command-prefix view. Updates replace entries
// inside that view; a later declaration must never be inserted into an earlier
// command's scope. Imported and local maps use distinct scopes.
class LeanConstantKey(scope: String, name: String) extends SKStore.Key

class LeanConstantFile(
  value: LeanValue,
  moduleIndex: ?Int,
) extends SKStore.File

base class LeanConstantStorage {
  children =
  | LeanConstantDirectory(
    entries: SKStore.EHandle<LeanConstantKey, LeanConstantFile>,
  )
  | LeanConstantMap(entries: Map<String, LeanConstantFile>)
}

class LeanConstantsView(scope: String, storage: LeanConstantStorage) {
  fun lookup(
    runtime: mutable LeanExecution,
    name: LeanValue,
  ): ?LeanConstantFile {
    nameKey = leanNameKey(name);
    entries = this.storage match {
    | LeanConstantMap(values) -> return values.maybeGet(nameKey)
    | LeanConstantDirectory(entries) -> entries
    };
    key = LeanConstantKey(this.scope, nameKey);
    // Reading the empty array is intentional: a later insertion must invalidate
    // computations that depended on this name being absent.
    values = entries.getArray(runtime.context(), key);
    if (values.size() > 1) {
      leanFail("multiple constants in one environment slot")
    };
    values.maybeGet(0)
  }
}

// Length prefixes distinguish string components, numeric components and nesting.
// Cached hashes are intentionally excluded from the semantic identity of names.
fun leanNameKey(name: LeanValue): String {
  leanTag(name) match {
  | LeanTag.Name_anonymous__impl -> "a"
  | LeanTag.Name_str__impl ->
    text = leanText(leanField(name, 2));
    leanNameKey(leanField(name, 1)) +
      "s" +
      text.bytes().size().toString() +
      ":" +
      text
  | LeanTag.Name_num__impl ->
    leanNameKey(leanField(name, 1)) +
      "n" +
      leanNat(leanField(name, 2)).toString() +
      ":"
  | _ -> leanFail("invalid Lean Name for environment lookup")
  }
}

fun leanLocalConstantLookup(
  runtime: mutable LeanExecution,
  view: LeanConstantsView,
  name: LeanValue,
): LeanValue {
  view.lookup(runtime, name) match {
  | Some(entry) -> LeanCtor(LeanTag.Option_some, Array[entry.value])
  | None() -> LeanCtor(LeanTag.Option_none, Array[])
  }
}

fun leanImportedConstantLookup(
  runtime: mutable LeanExecution,
  imported: LeanValue,
  name: LeanValue,
  indexOnly: Bool,
): LeanValue {
  if (leanTag(imported) != LeanTag.ImportedConsts_mk) {
    return leanFail("invalid Lean imported constant map")
  };
  leanField(imported, 1) match {
  | LeanTrackedConstants(view) ->
    view.lookup(runtime, name) match {
    | None() ->
      if (indexOnly) leanNatValue(0) else {
        LeanCtor(LeanTag.Option_none, Array[])
      }
    | Some(entry) ->
      index = entry.moduleIndex match {
      | Some(index) -> index
      | None() -> leanFail("local declaration stored in imported constants")
      };
      if (indexOnly) leanNatValue(index + 1) else {
        LeanCtor(
          LeanTag.Option_some,
          Array[
            LeanCtor(
              LeanTag.Prod_mk,
              Array[entry.value, leanNatValue(index)],
            ),
          ],
        )
      }
    }
  | _ -> leanFail("lookup of a native Lean imported tree is not implemented")
  }
}
