// Structural level equality. Cached hash/data words are not part of identity.
fun leanLevelEqual(a: LeanValue, b: LeanValue): Bool {
  if (leanSameObject(a, b) != 0) return true;
  if (leanTag(a) != leanTag(b)) return false;
  leanTag(a) match {
  | LeanTag.Level_zero__impl -> true
  | LeanTag.Level_param__impl
  | LeanTag.Level_mvar__impl ->
    leanNameEqual(leanField(a, 1), leanField(b, 1))
  | LeanTag.Level_succ__impl ->
    leanLevelEqual(leanField(a, 1), leanField(b, 1))
  | LeanTag.Level_max__impl
  | LeanTag.Level_imax__impl ->
    leanLevelEqual(leanField(a, 1), leanField(b, 1)) &&
      leanLevelEqual(leanField(a, 2), leanField(b, 2))
  | _ -> leanFail("invalid Lean universe level")
  }
}

fun leanLevelListEqual(a: LeanValue, b: LeanValue): Bool {
  left = a;
  right = b;
  loop {
    if (leanSameObject(left, right) != 0) return true;
    if (leanTag(left) != leanTag(right)) return false;
    leanTag(left) match {
    | LeanTag.List_nil -> return true
    | LeanTag.List_cons ->
      if (!leanLevelEqual(leanField(left, 0), leanField(right, 0))) {
        return false
      };
      !left = leanField(left, 1);
      !right = leanField(right, 1)
    | _ -> return leanFail("invalid Lean universe level list")
    }
  }
}
