// Fixed empty-options Core context for the first synchronous execution path.
// This does not initialize modules or create an imported environment. Heartbeat
// limits are disabled explicitly; host cancellation is not implemented.
fun leanCoreContext(fileName: String, source: String): LeanValue {
  anonymous: LeanValue = LeanCtor(
    LeanTag.Name_anonymous__impl,
    Array[],
  );
  nil: LeanValue = LeanCtor(LeanTag.List_nil, Array[]);
  none: LeanValue = LeanCtor(LeanTag.Option_none, Array[]);
  options: LeanValue = LeanCtor(
    LeanTag.Private_Lean_Data_Options_0_Lean_Options_mk,
    Array[
      LeanCtor(
        LeanTag.Std_DTreeMap_Internal_Impl_leaf,
        Array[],
      ),
      leanBool(false),
    ],
  );
  positions = mutable Vector[leanNatValue(0)];
  bytes = source.bytes();
  for (i in Range(0, bytes.size())) {
    if (bytes[i].toInt() == 10) positions.push(leanNatValue(i + 1))
  };
  positions.push(leanNatValue(source.bytes().size()));
  fileMap: LeanValue = LeanCtor(
    LeanTag.FileMap_mk,
    Array[LeanText(source), LeanArray(positions.toArray())],
  );
  inheritedTraceOptions: LeanValue = LeanCtor(
    LeanTag.Std_DHashMap_Raw_mk,
    Array[
      leanNatValue(0),
      LeanArray(
        Array::fill(
          8,
          LeanCtor(
            LeanTag.Std_DHashMap_Internal_AssocList_nil,
            Array[],
          ),
        ),
      ),
    ],
  );
  cold: LeanValue = LeanCtor(
    LeanTag.Core_Context_Cold_mk,
    Array[
      LeanText(fileName),
      fileMap,
      options,
      leanNatValue(1000),
      anonymous,
      nil,
      leanNatValue(0),
      leanNatValue(0),
      anonymous,
      leanNatValue(1),
      none,
      inheritedTraceOptions,
    ],
  );
  LeanCtor(
    LeanTag.Core_Context_mk,
    Array[
      cold,
      leanNatValue(0),
      LeanCtor(LeanTag.Syntax_missing, Array[]),
      LeanWord("uint16", 255),
      LeanErased(),
      leanBool(false),
      LeanCtor(LeanTag.Core_DeprecationCheck_all, Array[]),
      leanBool(false),
    ],
  )
}
