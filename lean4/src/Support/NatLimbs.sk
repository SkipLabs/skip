// Retained base-10^9 arithmetic for large naturals.
class LeanNatLimbs private (limbs: Array<Int>) uses Orderable, Show {
  static fun create(limbs: Array<Int>): this {
    size = limbs.size();
    while (size > 0 && limbs[size - 1] == 0) !size = size - 1;
    static(limbs.take(size))
  }

  static fun fromInt(value: Int): this {
    invariant(value >= 0, "Negative Lean Nat");
    if (value == 0) return static(Array[]);
    if (value < 1000000000) return static(Array[value]);
    low = value % 1000000000;
    high = value / 1000000000;
    if (high < 1000000000) return static(Array[low, high]);
    static(Array[low, high % 1000000000, high / 1000000000])
  }

  static fun parse(text: String): this {
    invariant(!text.isEmpty(), "Empty Lean Nat");
    bytes = text.bytes();
    // Runtime literals are usually small. Parse up to 18 decimal digits with
    // host arithmetic; larger values are read directly in base-10^9 chunks.
    if (bytes.size() <= 18) {
      value = 0;
      for (byte in bytes) {
        digit = byte.toInt() - 48;
        invariant(digit >= 0 && digit <= 9, "Invalid Lean Nat literal");
        !value = value * 10 + digit
      };
      return static::fromInt(value)
    };
    limbs = mutable Vector[];
    end = bytes.size();
    while (end > 0) {
      begin = max(0, end - 9);
      value = 0;
      for (i in Range(begin, end)) {
        digit = bytes[i].toInt() - 48;
        invariant(digit >= 0 && digit <= 9, "Invalid Lean Nat literal");
        !value = value * 10 + digit
      };
      limbs.push(value);
      !end = begin
    };
    static::create(limbs.toArray())
  }

  static fun fromWord(bits: Int): this {
    if (bits >= 0) return static::fromInt(bits);
    static::fromInt(bits.ushr(32))
      .mulSmall(4294967296)
      .add(static::fromInt(bits.and(4294967295)))
  }

  fun toString(): String {
    if (this.limbs.isEmpty()) return "0";
    result = this.limbs.last().toString();
    i = this.limbs.size() - 1;
    while (i > 0) {
      !i = i - 1;
      digits = this.limbs[i].toString();
      for (_ in Range(digits.length(), 9)) !result = result + "0";
      !result = result + digits
    };
    result
  }

  fun compare(other: this): Order {
    if (this.limbs.size() != other.limbs.size()) {
      return this.limbs.size().compare(other.limbs.size())
    };
    i = this.limbs.size();
    while (i > 0) {
      !i = i - 1;
      if (this.limbs[i] != other.limbs[i]) {
        return this.limbs[i].compare(other.limbs[i])
      }
    };
    EQ()
  }

  fun isZero(): Bool {
    this.limbs.isEmpty()
  }

  // Return a host-sized value only when it fits; normalization uses this to
  // demote arbitrary-precision results back to the small representation.
  fun maybeInt(): ?Int {
    result = 0;
    i = this.limbs.size();
    while (i > 0) {
      !i = i - 1;
      if (result > (Int::max - this.limbs[i]) / 1000000000) return None();
      !result = result * 1000000000 + this.limbs[i]
    };
    Some(result)
  }

  fun toInt(): Int {
    result = 0;
    i = this.limbs.size();
    while (i > 0) {
      !i = i - 1;
      invariant(
        result <= (Int::max - this.limbs[i]) / 1000000000,
        "Lean Nat exceeds the host indexing range",
      );
      !result = result * 1000000000 + this.limbs[i]
    };
    result
  }

  // Modular conversion is intentional for Lean's UInt64/USize conversions.
  fun toWord(): Int {
    result = 0;
    i = this.limbs.size();
    while (i > 0) {
      !i = i - 1;
      !result = result * 1000000000 + this.limbs[i]
    };
    result
  }

  fun add(other: this): this {
    if (this.limbs.isEmpty()) return other;
    if (other.limbs.isEmpty()) return this;
    if (this.limbs.size() == 1 && other.limbs.size() == 1) {
      return static::fromInt(this.limbs[0] + other.limbs[0])
    };
    out = mutable Vector[];
    carry = 0;
    for (i in Range(0, max(this.limbs.size(), other.limbs.size()))) {
      value =
        carry +
        this.limbs.maybeGet(i).default(0) +
        other.limbs.maybeGet(i).default(0);
      out.push(value % 1000000000);
      !carry = value / 1000000000
    };
    if (carry != 0) out.push(carry);
    static(out.toArray())
  }

  fun sub(other: this): this {
    if (other.limbs.isEmpty()) return this;
    if (this.limbs.size() == 1 && other.limbs.size() == 1) {
      return static::fromInt(max(0, this.limbs[0] - other.limbs[0]))
    };
    if (this < other) return static::fromInt(0);
    out = mutable Vector[];
    borrow = 0;
    for (i in Range(0, this.limbs.size())) {
      value = this.limbs[i] - other.limbs.maybeGet(i).default(0) - borrow;
      !borrow = if (value < 0) 1 else 0;
      out.push(if (value < 0) value + 1000000000 else value)
    };
    static::create(out.toArray())
  }

  fun mulSmall(factor: Int): this {
    invariant(factor >= 0 && factor <= 4294967296, "Invalid limb multiplier");
    if (this.limbs.isEmpty() || factor == 1) return this;
    if (factor == 0) return static::fromInt(0);
    if (this.limbs.size() == 1) {
      return static::fromInt(this.limbs[0] * factor)
    };
    out = mutable Vector[];
    carry = 0;
    for (limb in this.limbs) {
      value = limb * factor + carry;
      out.push(value % 1000000000);
      !carry = value / 1000000000
    };
    while (carry != 0) {
      out.push(carry % 1000000000);
      !carry = carry / 1000000000
    };
    static::create(out.toArray())
  }

  fun mul(other: this): this {
    if (this.limbs.isEmpty() || other.limbs.isEmpty()) {
      return static::fromInt(0)
    };
    if (this.limbs.size() == 1) return other.mulSmall(this.limbs[0]);
    if (other.limbs.size() == 1) return this.mulSmall(other.limbs[0]);
    out = Array::mfill(this.limbs.size() + other.limbs.size() + 1, 0);
    for (i in Range(0, this.limbs.size())) {
      carry = 0;
      for (j in Range(0, other.limbs.size())) {
        value = out[i + j] + this.limbs[i] * other.limbs[j] + carry;
        out.set(i + j, value % 1000000000);
        !carry = value / 1000000000
      };
      out.set(i + other.limbs.size(), carry)
    };
    static::create(out.chill())
  }

  fun pow(exponent: this): this {
    // Match lean_nat_pow's exponent bound and its total 0/1-base cases.
    if (exponent.isZero()) return static::fromInt(1);
    if (this.isZero() || this == static::fromInt(1)) return this;
    if (exponent > static::fromInt(4294967295)) {
      return leanFail("Nat.pow exponent is too big")
    };
    remaining = exponent.toInt();
    base = this;
    result = static::fromInt(1);
    while (remaining > 0) {
      if (remaining.and(1) == 1) !result = result.mul(base);
      !remaining = remaining.ushr(1);
      if (remaining > 0) !base = base.mul(base)
    };
    result
  }

  fun gcd(other: this): this {
    a = this;
    b = other;
    while (!b.isZero()) {
      remainder = a.divMod(b).i1;
      !a = b;
      !b = remainder
    };
    a
  }

  fun divMod(other: this): (this, this) {
    if (other.isZero()) return (static::fromInt(0), this);
    quotient = Array::mfill(this.limbs.size(), 0);
    remainder = static::fromInt(0);
    i = this.limbs.size();
    while (i > 0) {
      !i = i - 1;
      !remainder = static::create(Array[this.limbs[i]].concat(remainder.limbs));
      lo = 0;
      hi = 1000000000;
      while (lo + 1 < hi) {
        mid = (lo + hi) / 2;
        if (other.mulSmall(mid) <= remainder) !lo = mid else !hi = mid
      };
      quotient.set(i, lo);
      !remainder = remainder.sub(other.mulSmall(lo))
    };
    (static::create(quotient.chill()), remainder)
  }

  fun shiftRight(amount: this): this {
    // Each decimal limb has fewer than 30 bits. Test before converting the
    // shift to a host index, so even an arbitrarily large shift returns zero.
    if (amount >= static::fromInt(this.limbs.size()).mulSmall(30)) {
      return static::fromInt(0)
    };
    remaining = amount.toInt();
    result = this;
    while (remaining > 0) {
      bits = min(remaining, 32);
      divisor = 1.shl(bits);
      quotient = Array::mfill(result.limbs.size(), 0);
      carry = 0;
      i = result.limbs.size();
      while (i > 0) {
        !i = i - 1;
        value = carry * 1000000000 + result.limbs[i];
        quotient.set(i, value / divisor);
        !carry = value % divisor
      };
      !result = static::create(quotient.chill());
      !remaining = remaining - bits
    };
    result
  }
}
