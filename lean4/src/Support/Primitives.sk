// Implementations shared by the original named runtime entry points. Unknown
// functions keep failing with both their Lean name and their foreign symbol.
fun leanArray(value: LeanValue): Array<LeanValue> {
  value match {
  | LeanArray(values) -> values
  | LeanTrackedExtensionArray(_) ->
    leanFail(
      "mutation/materialization of tracked Lean extension arrays is not implemented",
    )
  | LeanUnavailable(description) -> leanFail("not implemented: " + description)
  | _ -> leanFail("expected a Lean Array")
  }
}

fun leanText(value: LeanValue): String {
  value match {
  | LeanText(text) -> text
  | LeanUnavailable(description) -> leanFail("not implemented: " + description)
  | _ -> leanFail("expected a Lean String")
  }
}

fun leanNameEqual(a: LeanValue, b: LeanValue): Bool {
  if (leanTag(a) != leanTag(b)) return false;
  leanTag(a) match {
  | "[\"Lean\",\"Name\",\"anonymous\",\"_impl\"]" -> true
  | "[\"Lean\",\"Name\",\"str\",\"_impl\"]" ->
    leanText(leanField(a, 2)) == leanText(leanField(b, 2)) &&
      leanNameEqual(leanField(a, 1), leanField(b, 1))
  | "[\"Lean\",\"Name\",\"num\",\"_impl\"]" ->
    leanNat(leanField(a, 2)) == leanNat(leanField(b, 2)) &&
      leanNameEqual(leanField(a, 1), leanField(b, 1))
  | _ -> leanFail("invalid Lean Name")
  }
}

fun leanInvokePrimitive(
  runtime: mutable LeanExecution,
  name: String,
  foreign: String,
  args: Array<LeanValue>,
): LeanValue {
  foreign match {
  // Lean's lean_void_mk discards its input and returns the opaque ST world
  // token. Mutable state itself lives in this execution's reference table.
  | "lean_void_mk" -> return LeanErased()
  | "lean_string_utf8_extract_fast" ->
    return LeanText(
      leanStringExtract(leanText(args[0]), leanNat(args[1]), leanNat(args[2])),
    )
  | "lean_string_utf8_next_fast" ->
    position = leanNat(args[1]);
    code = leanStringDecodeChar(leanText(args[0]), position);
    width = if (code < 128) 1 else if (code < 2048) 2 else if (code < 65536) {
      3
    } else {
      4
    };
    return LeanNatural(position.add(LeanNat::fromInt(width)))
  | "lean_string_utf8_get_fast" ->
    return LeanWord(
      "uint32",
      leanStringDecodeChar(leanText(args[0]), leanNat(args[1])),
    )
  | "lean_io_initializing" ->
    return leanSTResult(leanBool(runtime.initializing), args[0])
  | "lean_level_eq" -> return leanBool(leanLevelEqual(args[0], args[1]))
  | "lean_task_pure" -> return LeanCompletedTask(args[1])
  | "lean_task_get_own" ->
    args[1] match {
    | LeanCompletedTask(value) -> return value
    | _ ->
      return leanFail("waiting for asynchronous Lean tasks is not implemented")
    }
  | "lean_imported_consts_find_entry_cached" ->
    return leanImportedConstantLookup(runtime, args[1], args[2], false)
  | "lean_imported_consts_find_mod_idx_cached"
  | "lean_imported_extra_consts_find_mod_idx_cached" ->
    return leanImportedConstantLookup(runtime, args[1], args[2], true)
  | "lean_obj_tag_nat" ->
    args[1] match {
    | LeanCtor(ctor, _) -> return leanNatValue(leanConstructorOrdinal(ctor))
    | _ -> return leanFail("getObjTagNat on non-constructor is not implemented")
    }
  | "lean_expr_data" -> return LeanWord("uint64", leanExprData(args[0]))
  | "lean_expr_mk_data" -> return leanExprMakeData(args)
  | "lean_expr_mk_app_data" ->
    return leanExprMakeAppData(leanWordBits(args[0]), leanWordBits(args[1]))
  | "lean_level_mk_data" -> return leanLevelMakeData(args)
  | "lean_bool_to_uint8" ->
    return leanWordValue("uint8", if (leanIsTrue(args[0])) 1 else 0)
  | "lean_bool_to_uint16" ->
    return leanWordValue("uint16", if (leanIsTrue(args[0])) 1 else 0)
  | "lean_bool_to_uint32" ->
    return leanWordValue("uint32", if (leanIsTrue(args[0])) 1 else 0)
  | "lean_bool_to_uint64" ->
    return leanWordValue("uint64", if (leanIsTrue(args[0])) 1 else 0)
  | "lean_bool_to_usize" ->
    return leanWordValue("usize", if (leanIsTrue(args[0])) 1 else 0)
  | "lean_nat_add" -> return LeanNatural(leanNat(args[0]).add(leanNat(args[1])))
  | "lean_nat_sub" -> return LeanNatural(leanNat(args[0]).sub(leanNat(args[1])))
  | "lean_nat_mul" -> return LeanNatural(leanNat(args[0]).mul(leanNat(args[1])))
  | "lean_nat_div" ->
    return LeanNatural(leanNat(args[0]).divMod(leanNat(args[1])).i0)
  | "lean_nat_mod" ->
    return LeanNatural(leanNat(args[0]).divMod(leanNat(args[1])).i1)
  | "lean_nat_shiftr" ->
    return LeanNatural(leanNat(args[0]).shiftRight(leanNat(args[1])))
  | "lean_nat_pred" ->
    return LeanNatural(leanNat(args[0]).sub(LeanNat::fromInt(1)))
  // Mono erasure represents Decidable as Bool, including functions named decEq.
  | "lean_nat_dec_eq" -> return leanBool(leanNat(args[0]) == leanNat(args[1]))
  | "lean_nat_dec_lt" -> return leanBool(leanNat(args[0]) < leanNat(args[1]))
  | "lean_nat_dec_le" -> return leanBool(leanNat(args[0]) <= leanNat(args[1]))
  | "lean_mk_empty_array_with_capacity" -> return LeanArray(Array[])
  | "lean_mk_array" ->
    return LeanArray(Array::fill(leanNat(args[1]).toInt(), args[2]))
  | "lean_array_get_size" -> return leanNatValue(leanValueArraySize(args[1]))
  | "lean_array_size" -> return LeanWord("usize", leanValueArraySize(args[1]))
  | "lean_array_push" ->
    return LeanArray(leanArray(args[1]).concat(Array[args[2]]))
  | "lean_array_fget" | "lean_array_fget_borrowed" ->
    return leanArrayRead(runtime, args[1], args[2], false)
  | "lean_array_uget" | "lean_array_uget_borrowed" ->
    return leanArrayRead(runtime, args[1], args[2], true)
  | "lean_array_get" | "lean_array_get_borrowed" ->
    return leanArrayRead(runtime, args[2], args[3], false)
  | "lean_array_fset" | "lean_array_set" ->
    values = leanArray(args[1]);
    index = leanArrayIndex(values, args[2]);
    return LeanArray(
      values.mapWithIndex((i, value) -> if (i == index) args[3] else value),
    )
  | "lean_array_uset" ->
    values = leanArray(args[1]);
    index = leanArrayWordIndex(values, args[2]);
    return LeanArray(
      values.mapWithIndex((i, value) -> if (i == index) args[3] else value),
    )
  | "lean_array_pop" ->
    values = leanArray(args[1]);
    return LeanArray(values.take(max(0, values.size() - 1)))
  | "lean_array_mk" ->
    values = mutable Vector[];
    list = args[1];
    while (leanTag(list) != "[\"List\",\"nil\"]") {
      invariant(leanTag(list) == "[\"List\",\"cons\"]", "Invalid Lean list");
      values.push(leanField(list, 0));
      !list = leanField(list, 1)
    };
    return LeanArray(values.toArray())
  | "lean_array_to_list" ->
    values = leanArray(args[1]);
    list: LeanValue = LeanCtor("[\"List\",\"nil\"]", Array[]);
    i = values.size();
    while (i > 0) {
      !i = i - 1;
      !list = LeanCtor("[\"List\",\"cons\"]", Array[values[i], list])
    };
    return list
  | "lean_st_mk_ref" -> return leanSTResult(runtime.newRef(args[2]), args[3])
  | "lean_st_ref_get" -> return leanSTResult(runtime.readRef(args[2]), args[3])
  | "lean_st_ref_take" ->
    value = runtime.readRef(args[2]);
    runtime.writeRef(args[2], None());
    return leanSTResult(value, args[3])
  | "lean_st_ref_put" ->
    runtime.writeRef(args[2], Some(args[3]));
    return leanSTResult(LeanCtor("[\"PUnit\",\"unit\"]", Array[]), args[4])
  | "lean_st_ref_swap" ->
    value = runtime.readRef(args[2]);
    runtime.writeRef(args[2], Some(args[3]));
    return leanSTResult(value, args[4])
  | "lean_st_ref_ptr_eq" ->
    return leanSTResult(leanBool(native_eq(args[2], args[3]) == 0), args[4])
  | "lean_string_hash" ->
    return LeanWord("uint64", leanStringHash(leanText(args[0])))
  | "lean_string_compare" ->
    left = leanText(args[0]);
    right = leanText(args[1]);
    return LeanCtor(
      if (left < right) "[\"Ordering\",\"lt\"]" else if (right < left) {
        "[\"Ordering\",\"gt\"]"
      } else {
        "[\"Ordering\",\"eq\"]"
      },
      Array[],
    )
  | "lean_string_memcmp" -> return leanBool(leanStringMemcmp(args) == 0)
  | "lean_string_memcmp_lt" -> return leanBool(leanStringMemcmp(args) < 0)
  | "lean_string_memcmp_compare" ->
    cmp = leanStringMemcmp(args);
    return LeanCtor(
      if (cmp < 0) "[\"Ordering\",\"lt\"]" else if (cmp > 0) {
        "[\"Ordering\",\"gt\"]"
      } else {
        "[\"Ordering\",\"eq\"]"
      },
      Array[],
    )
  | "lean_uint64_mix_hash" ->
    return LeanWord(
      "uint64",
      leanMixHash(leanWordBits(args[0]), leanWordBits(args[1])),
    )
  | "lean_uint32_mix_hash" ->
    return LeanWord(
      "uint32",
      leanMixHash32(leanWordBits(args[0]), leanWordBits(args[1])),
    )
  | "lean_name_eq" -> return leanBool(leanNameEqual(args[0], args[1]))
  | "lean_string_dec_eq" ->
    return leanBool(leanText(args[0]) == leanText(args[1]))
  | "lean_string_dec_lt" ->
    return leanBool(leanText(args[0]) < leanText(args[1]))
  | "lean_string_append" ->
    return LeanText(leanText(args[0]) + leanText(args[1]))
  | "lean_string_utf8_byte_size" ->
    return leanNatValue(leanText(args[0]).bytes().size())
  | "lean_string_length" -> return leanNatValue(leanText(args[0]).length())
  | "lean_string_isempty" -> return leanBool(leanText(args[0]).isEmpty())
  | "lean_strict_and" ->
    return leanBool(leanIsTrue(args[0]) && leanIsTrue(args[1]))
  | "lean_strict_or" ->
    return leanBool(leanIsTrue(args[0]) || leanIsTrue(args[1]))
  | _ -> void
  };
  parts = foreign.split("_");
  if (
    parts.size() >= 3 &&
    parts[0] == "lean" &&
    Array["uint8", "uint16", "uint32", "uint64", "usize"].contains(parts[1])
  ) {
    kind = parts[1];
    op = parts.drop(2).join("_");
    if (op == "of_nat" || op == "of_nat_mk") {
      return leanWordValue(kind, leanNat(args[0]).toWord())
    };
    a = leanWordBits(args[0]);
    if (op == "to_nat") return LeanNatural(LeanNat::fromWord(a));
    if (op.startsWith("to_")) {
      target = parts.drop(3).join("_");
      if (
        Array["uint8", "uint16", "uint32", "uint64", "usize"].contains(target)
      ) {
        return leanWordValue(target, a)
      }
    };
    if (op == "neg") return leanWordValue(kind, 0 - a);
    if (op == "complement") return leanWordValue(kind, a.xor(-1));
    if (args.size() >= 2) {
      b = leanWordBits(args[1]);
      op match {
      | "add" -> return leanWordValue(kind, a + b)
      | "sub" -> return leanWordValue(kind, a - b)
      | "mul" -> return leanWordValue(kind, a * b)
      | "div" -> return leanWordValue(kind, leanUnsignedDiv(a, b))
      | "mod" -> return leanWordValue(kind, a - leanUnsignedDiv(a, b) * b)
      | "land" -> return leanWordValue(kind, a.and(b))
      | "lor" -> return leanWordValue(kind, a.or(b))
      | "xor" -> return leanWordValue(kind, a.xor(b))
      | "shift_left" ->
        return leanWordValue(kind, a.shl(b.and(leanWordWidth(kind) - 1)))
      | "shift_right" ->
        return leanWordValue(kind, a.ushr(b.and(leanWordWidth(kind) - 1)))
      | "dec_eq" -> return leanBool(a == b)
      | "dec_lt" -> return leanBool(a.ult(b))
      | "dec_le" -> return leanBool(a.ule(b))
      | _ -> void
      }
    }
  };
  leanPrimitive(name + " [" + foreign + "]")
}

fun leanArrayIndex(values: Array<LeanValue>, value: LeanValue): Int {
  index = leanNat(value);
  if (index >= LeanNat::fromInt(values.size())) {
    // Lean's recoverable panic/default-value mode is deliberately unsupported.
    leanFail(
      "Lean Array index out of bounds (panic recovery is not implemented)",
    )
  } else {
    index.toInt()
  }
}

fun leanArrayWordIndex(values: Array<LeanValue>, value: LeanValue): Int {
  index = leanWordBits(value);
  if (!index.ult(values.size())) {
    leanFail("Lean Array USize index out of bounds")
  };
  index
}
