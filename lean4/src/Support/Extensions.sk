// Slots are allocated by Lean's original initializers. Store keys use stable
// extension names instead, so native and Skip registration order may differ.
class LeanExtensionKey(scope: String, name: String) extends SKStore.Key
class LeanExtensionFile(
  state: LeanValue,
  generation: ?LeanValue,
) extends SKStore.File

class LeanExtensionArray(
  slots: Array<LeanExtensionKey>,
  entries: SKStore.EHandle<LeanExtensionKey, LeanExtensionFile>,
  generations: Bool,
) {
  fun get(runtime: mutable LeanExecution, index: Int): LeanValue {
    key = this.slots[index];
    values = this.entries.getArray(runtime.context(), key);
    if (values.size() != 1) {
      leanFail("imported extension state is unavailable: " + key.name)
    };
    value = values[0];
    if (this.generations) {
      value.generation match {
      | Some(generation) -> generation
      | None() ->
        leanFail("generation requested for an untracked Lean extension")
      }
    } else {
      value.state
    }
  }
}

fun leanValueArraySize(value: LeanValue): Int {
  value match {
  | LeanTrackedExtensionArray(view) -> view.slots.size()
  | LeanArrayOverride(base, _, _) -> leanValueArraySize(base)
  | LeanPersistentArray(values) -> values.size()
  | _ -> leanArray(value).size()
  }
}

@always_inline
fun leanArrayReadIndex(size: Int, at: LeanValue, word: Bool): Int {
  if (word) {
    bits = leanWordBits(at);
    if (!bits.ult(size)) leanFail("Lean Array USize index out of bounds");
    bits
  } else {
    n = leanNat(at);
    if (n >= LeanNat::fromInt(size)) {
      leanFail(
        "Lean Array index out of bounds (panic recovery is not implemented)",
      )
    };
    n.toInt()
  }
}

fun leanArrayRead(
  runtime: mutable LeanExecution,
  value: LeanValue,
  at: LeanValue,
  word: Bool,
): LeanValue {
  value match {
  | LeanArray(values) -> values[leanArrayReadIndex(values.size(), at, word)]
  | _ -> leanArrayReadOther(runtime, value, at, word)
  }
}

// Keep tracked-store access and recursive overrides off the ordinary read path.
@no_inline
fun leanArrayReadOther(
  runtime: mutable LeanExecution,
  value: LeanValue,
  at: LeanValue,
  word: Bool,
): LeanValue {
  size = leanValueArraySize(value);
  index = leanArrayReadIndex(size, at, word);
  value match {
  | LeanTrackedExtensionArray(view) -> view.get(runtime, index)
  | LeanArrayOverride(base, changed, replacement) ->
    if (index == changed) replacement else {
      leanArrayRead(runtime, base, at, word)
    }
  | LeanPersistentArray(values) -> values[index]
  | _ -> leanArray(value)[index]
  }
}

fun leanArrayWrite(
  value: LeanValue,
  at: LeanValue,
  replacement: LeanValue,
  word: Bool,
): LeanValue {
  size = leanValueArraySize(value);
  index = if (word) {
    bits = leanWordBits(at);
    if (!bits.ult(size)) leanFail("Lean Array USize index out of bounds");
    bits
  } else {
    n = leanNat(at);
    if (n >= LeanNat::fromInt(size)) leanFail("Lean Array index out of bounds");
    n.toInt()
  };
  value match {
  | LeanTrackedExtensionArray(_) -> LeanArrayOverride(value, index, replacement)
  | LeanArrayOverride(base, changed, _) if (changed == index) ->
    LeanArrayOverride(base, index, replacement)
  | LeanArrayOverride(_, _, _) -> LeanArrayOverride(value, index, replacement)
  | LeanPersistentArray(values) ->
    updated = values.clone();
    updated.set(index, replacement);
    LeanPersistentArray(updated.chill())
  | LeanArray(values) if (values.size() > 128) ->
    updated = Persistent.RadixTreeVector::mcreateFromItems(values);
    updated.set(index, replacement);
    LeanPersistentArray(updated.chill())
  | _ ->
    updated = leanArray(value).clone();
    updated.set(index, replacement);
    // The fresh copy has no mutable aliases outside this function.
    LeanArray(unsafe_chill_trust_me(updated))
  }
}

fun leanArrayPush(value: LeanValue, item: LeanValue): LeanValue {
  value match {
  | LeanPersistentArray(values) ->
    updated = values.clone();
    updated.push(item);
    LeanPersistentArray(updated.chill())
  | LeanArray(values) if (values.size() >= 128) ->
    updated = Persistent.RadixTreeVector::mcreateFromItems(values);
    updated.push(item);
    LeanPersistentArray(updated.chill())
  | _ -> LeanArray(leanArray(value).concat(Array[item]))
  }
}

fun leanArrayPop(value: LeanValue): LeanValue {
  value match {
  | LeanPersistentArray(values) ->
    if (values.size() == 0) return value;
    updated = values.clone();
    _ = updated.pop();
    LeanPersistentArray(updated.chill())
  | _ ->
    values = leanArray(value);
    LeanArray(values.take(max(0, values.size() - 1)))
  }
}
