fun f_Lean_Expr_getAppNumArgsAux_62e193b5dc(
  runtime: mutable LeanExecution,
  expr: LeanValue,
  initialCount: LeanValue,
): LeanValue {
  if (leanTag(expr) != LeanTag.Expr_app__impl) return initialCount;

  current = expr;
  if (runtime.profileRuntime) {
    boxedCount = initialCount;
    while (leanTag(current) == LeanTag.Expr_app__impl) {
      !boxedCount = L4_Init_Prelude.f_Nat_add_86990f4822(
        runtime,
        boxedCount,
        LeanNatLiterals.n1,
      );
      !current = leanField(current, 1)
