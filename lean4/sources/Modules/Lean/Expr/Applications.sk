  };

  nativeCount = leanNat(initialCount);
  while (leanTag(current) == LeanTag.Expr_app__impl) {
    !nativeCount = nativeCount.add(LeanNat::fromInt(1));
    !current = leanField(current, 1)
  };
  leanBoxNat(nativeCount)
}

