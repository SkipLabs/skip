    | LeanTag.Option_some ->
      parentConstant = leanField(parent, 0);
      if (
        leanTag(parentConstant) !=
        LeanTag.Private_Lean_Environment_0_Lean_AsyncConst_mk
      ) {
        return leanFail("non-exhaustive Lean case")
      };
      f_parity_environment_readShape(parentConstant, 4);
      leanField(parentConstant, 1)
    | _ -> return leanFail("non-exhaustive Lean case")
    };
    leanTag(branch) match {
    | LeanTag.AsyncBranch_mainEnv ->
      if (
        leanTag(child) != LeanTag.Private_Lean_Environment_0_Lean_AsyncConst_mk
      ) {
        return leanFail("non-exhaustive Lean case")
      };
      f_parity_environment_readShape(child, 4);
      childExtensions = leanField(child, 1);
      leanTag(leanField(child, 3)) match {
      | LeanTag.Bool_false ->
        f_parity_environment_readOptionalTask(
          runtime,
          inhabited,
          extension,
          base,
          parentExtensions,
        )
      | LeanTag.Bool_true ->
        f_parity_environment_readOptionalTask(
          runtime,
          inhabited,
          extension,
          base,
          childExtensions,
        )
      | _ -> leanFail("non-exhaustive Lean case")
      }
    | LeanTag.AsyncBranch_asyncEnv ->
      if (
        leanTag(child) != LeanTag.Private_Lean_Environment_0_Lean_AsyncConst_mk
      ) {
        return leanFail("non-exhaustive Lean case")
      };
      f_parity_environment_readShape(child, 4);
      asyncChildExtensions = leanField(child, 1);
      leanTag(asyncChildExtensions) match {
      | LeanTag.Option_none ->
        f_parity_environment_readOptionalTask(
          runtime,
          inhabited,
          extension,
          base,
          parentExtensions,
        )
      | LeanTag.Option_some ->
        f_parity_environment_readTask(
          runtime,
          inhabited,
          extension,
          leanField(asyncChildExtensions, 0),
        )
      | _ -> leanFail("non-exhaustive Lean case")
      }
    | _ -> leanFail("non-exhaustive Lean case")
    }
  | _ ->
    realizations = L4_Init_Core.f_Task_get_c7ebb314a7(
      runtime,
      LeanErased(),
      realizationsTask,
    );
    realized = L4_Lean_Data_NameMap_Basic.f_NameMap_find_spec_0_da0ebb7ac9(
      runtime,
      realizations,
      declaration,
    );
    leanTag(realized) match {
    | LeanTag.Option_some ->
      constant = leanField(realized, 0);
      if (
        leanTag(constant) !=
        LeanTag.Private_Lean_Environment_0_Lean_AsyncConst_mk
      ) {
        return leanFail("non-exhaustive Lean case")
      };
      f_parity_environment_readShape(constant, 4);
      f_parity_environment_readOptionalTask(
        runtime,
        inhabited,
        extension,
        base,
        leanField(constant, 1),
      )
    | _ -> f_parity_environment_readPrivate(runtime, inhabited, extension, base)
    }
  }
}

