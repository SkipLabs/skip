  | LeanTag.Option_some ->
    pair = leanField(found, 0);
    if (leanTag(pair) != LeanTag.Prod_mk) {
      return leanFail("non-exhaustive Lean case")
    };
    child = leanField(pair, 0);
    parent = leanField(pair, 1);
    parentExtensions = leanTag(parent) match {
    | LeanTag.Option_none ->
      extensions = f_parity_environment_privateExtensions(base);
      task = L4_Init_Core.f_Task_pure_8e8af46293(
        runtime,
        LeanErased(),
        extensions,
      );
