  leanTag(inBounds) match {
  | LeanTag.Bool_true ->
    L4_Init_Prelude.f_Array_getInternal_3b1463d18e(
      runtime,
      LeanErased(),
      extensions,
      index,
      LeanErased(),
    )
  | LeanTag.Bool_false ->
    message = L4_Init_Util.f_mkPanicMessageWithDecl_c4fc2d6e79(
      runtime,
      LeanText("Lean.Environment"),
      LeanText("_private.Lean.Environment.0.Lean.EnvExtension.getStateImpl"),
