fun f_parity_environment_readArray(
  runtime: mutable LeanExecution,
  inhabited: LeanValue,
  extension: LeanValue,
  extensions: LeanValue,
): LeanValue {
  leanTag(extension) match {
  | LeanTag.Private_Lean_Environment_0_Lean_EnvExtension_mk ->
    f_parity_environment_readShape(extension, 7);
    f_parity_environment_readAt(
      runtime,
      inhabited,
      extensions,
      leanField(extension, 0),
    )
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

fun f_parity_environment_readTask(
  runtime: mutable LeanExecution,
  inhabited: LeanValue,
  extension: LeanValue,
  extensionsTask: LeanValue,
): LeanValue {
  // Validate/project the extension before waiting, as in the original task paths.
  leanTag(extension) match {
  | LeanTag.Private_Lean_Environment_0_Lean_EnvExtension_mk ->
    f_parity_environment_readShape(extension, 7);
    index = leanField(extension, 0);
    extensions = L4_Init_Core.f_Task_get_c7ebb314a7(
      runtime,
      LeanErased(),
      extensionsTask,
    );
    f_parity_environment_readAt(runtime, inhabited, extensions, index)
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

fun f_parity_environment_privateExtensions(base: LeanValue): LeanValue {
  leanTag(base) match {
  | LeanTag.Private_Lean_Environment_0_Lean_VisibilityMap_mk ->
    f_parity_environment_readShape(base, 2);
    privateKernel = leanField(base, 0);
    leanTag(privateKernel) match {
    | LeanTag.Private_Lean_Environment_0_Lean_Kernel_Environment_mk ->
      f_parity_environment_readShape(privateKernel, 9);
      leanField(privateKernel, 4)
    | _ -> leanFail("non-exhaustive Lean case")
    }
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

fun f_parity_environment_readPrivate(
  runtime: mutable LeanExecution,
  inhabited: LeanValue,
  extension: LeanValue,
  base: LeanValue,
): LeanValue {
  extensions = f_parity_environment_privateExtensions(base);
  f_parity_environment_readArray(runtime, inhabited, extension, extensions)
}

fun f_parity_environment_readOptionalTask(
  runtime: mutable LeanExecution,
  inhabited: LeanValue,
  extension: LeanValue,
  base: LeanValue,
  optionalTask: LeanValue,
): LeanValue {
  leanTag(optionalTask) match {
  | LeanTag.Option_some ->
    f_parity_environment_readTask(
      runtime,
      inhabited,
      extension,
      leanField(optionalTask, 0),
    )
  | _ -> f_parity_environment_readPrivate(runtime, inhabited, extension, base)
  }
}

// Recursive declaration lookup has a distinct parent-snapshot policy from a
// direct hit. In particular an unrealized main-branch child reads its parent.
fun f_parity_environment_readRecursive(
  runtime: mutable LeanExecution,
  inhabited: LeanValue,
  extension: LeanValue,
  environment: LeanValue,
  base: LeanValue,
  realizationsTask: LeanValue,
  declaration: LeanValue,
  branch: LeanValue,
