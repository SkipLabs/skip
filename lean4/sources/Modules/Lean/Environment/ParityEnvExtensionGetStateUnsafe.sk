// Replay the original discarded projections without decoding their payloads.
// This keeps short/malformed constructor failures and dormant sentinel fields.
fun f_parity_environment_readShape(value: LeanValue, fieldCount: Int): void {
  for (index in Range(0, fieldCount)) {
    _ = leanField(value, index)
  }
}

