    _ = leanField(value, index)
  }
}

fun f_parity_environment_asyncInfo(constant: LeanValue): LeanValue {
  leanTag(constant) match {
  | LeanTag.Private_Lean_Environment_0_Lean_AsyncConst_mk ->
    f_parity_environment_findShape(constant, 4);
    LeanCtor(LeanTag.Option_some, Array[leanField(constant, 0)])
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

