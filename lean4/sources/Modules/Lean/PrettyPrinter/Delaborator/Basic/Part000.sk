  );
  _x_7_6: LeanValue = LeanText(
    "Registers a delaborator.\n\n`@[delab k]` registers a declaration of type `Lean.PrettyPrinter.Delaborator.Delab` for the\n`Lean.Expr` constructor `k`. Multiple delaborators for a single constructor are tried in turn until\nthe first success. If the term to be delaborated is an application of a constant `c`, elaborators\nfor `app.c` are tried first; this is also done for `Expr.const`s (\"nullary applications\") to reduce\nspecial casing. If the term is an `Expr.mdata` with a single key `k`, `mdata.k` is tried first.",
  );
  L4_Lean_DocString_Extension.f_Lean_addBuiltinDocString_e430758a4e(
    _runtime,
    _x_6_5,
    _x_7_6,
    _a_1_0,
  )
}
