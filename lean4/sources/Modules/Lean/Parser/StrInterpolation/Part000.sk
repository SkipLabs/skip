// "_private.Lean.Parser.StrInterpolation.0.Lean.Parser.interpolatedStr._regBuiltin.Lean.Parser.interpolatedStr.docString_1"
fun f_Parser_interpolatedStr_docString_1_e9d9169edb(
  _a_1_0: LeanValue,
): LeanValue {
  _x_5_4: LeanValue = L4_Init_Prelude.f_Lean_Name_mkStr3_2a3962ce81(
    LeanText("Lean"),
    LeanText("Parser"),
    LeanText("interpolatedStr"),
  );
  _x_6_5: LeanValue = LeanText(
    "The parser `interpolatedStr(p)` parses a string literal like `\"foo\"` (see `str`), but the string\nmay also contain `{}` escapes, and within the escapes the parser `p` is used. For example,\n`interpolatedStr(term)` will parse `\"foo {2 + 2}\"`, where `2 + 2` is parsed as a term rather than\nas a string. Note that the full Lean term grammar is available here, including string literals,\nso for example `\"foo {\"bar\" ++ \"baz\"}\"` is a legal interpolated string (which evaluates to\n`foo barbaz`).\n\nThis parser has arity 1, and returns a `interpolatedStrKind` with an odd number of arguments,\nalternating between chunks of literal text and results from `p`. The literal chunks contain\nuninterpreted substrings of the input. For example, `\"foo\\n{2 + 2}\"` would have three arguments:\nan atom `\"foo\\n{`, the parsed `2 + 2` term, and then the atom `}\"`.",
  );
  L4_Lean_DocString_Extension.f_Lean_addBuiltinDocString_e430758a4e(
    _x_5_4,
    _x_6_5,
    _a_1_0,
  )
}
