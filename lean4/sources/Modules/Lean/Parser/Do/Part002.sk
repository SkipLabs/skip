// "_private.Lean.Parser.Do.0.Lean.Parser.Term.doForward._regBuiltin.Lean.Parser.Term.doForward.docString_3"
fun f_Term_doForward_docString_3_209345bb7a(
  _runtime: mutable LeanExecution,
  _a_1_0: LeanValue,
): LeanValue {
  _x_6_5: LeanValue = L4_Init_Prelude.f_Lean_Name_mkStr4_cfa3e36682(
    _runtime,
    LeanText("Lean"),
    LeanText("Parser"),
    LeanText("Term"),
    LeanText("doForward"),
  );
  _x_7_6: LeanValue = LeanText(
    "`do← s` (or ASCII `do<- s`) hands `s` to the enclosing wrapper as a body\nwhose control-flow effects (`return`, `break`, `continue`, `mut`-variable\nreassignment) target the surrounding `do` block, not the body's local monad.\n\nThe syntax is reminiscent of a nested action `(← s)`, but unlike a nested\naction, `s` is not run eagerly in the `do` block context before the wrapping\nfunction is called. The wrapping function decides when to run `s`, and code\nis inserted to forward `s`'s effects to the outer `do` block.\n\nOnly valid as the last argument of a function application that itself appears\nas a statement of an outer `do` block, optionally wrapped in `fun` binders.\nExamples:\n* `f a₁ … aₙ (do← s)`\n* `f a₁ … aₙ (fun b₁ … bₖ => do← s)`",
  );
  L4_Lean_DocString_Extension.f_Lean_addBuiltinDocString_e430758a4e(
    _runtime,
    _x_6_5,
    _x_7_6,
    _a_1_0,
  )
}
