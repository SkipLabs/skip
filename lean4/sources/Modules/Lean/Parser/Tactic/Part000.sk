// "_private.Lean.Parser.Tactic.0.Lean.Parser.Tactic.match._regBuiltin.Lean.Parser.Tactic.match.docString_3"
fun f_Tactic_match_docString_3_237d6b2516(
  _runtime: mutable LeanExecution,
  _a_1_0: LeanValue,
): LeanValue {
  _x_6_5: LeanValue = L4_Init_Prelude.f_Lean_Name_mkStr4_cfa3e36682(
    _runtime,
    LeanText("Lean"),
    LeanText("Parser"),
    LeanText("Tactic"),
    LeanText("match"),
  );
  _x_7_6: LeanValue = LeanText(
    "`match` performs case analysis on one or more expressions.\nSee [Induction and Recursion][tpil4].\nThe syntax for the `match` tactic is the same as term-mode `match`, except that\nthe match arms are tactics instead of expressions.\n```\nexample (n : Nat) : n = n := by\n  match n with\n  | 0 => rfl\n  | i+1 => simp\n```\n\n[tpil4]: https://lean-lang.org/theorem_proving_in_lean4/induction_and_recursion.html",
  );
  L4_Lean_DocString_Extension.f_Lean_addBuiltinDocString_e430758a4e(
    _runtime,
    _x_6_5,
    _x_7_6,
    _a_1_0,
  )
}
