// "_private.Lean.Parser.Term.0.Lean.Parser.Termination.terminationBy?._regBuiltin.Lean.Parser.Termination.terminationBy?.docString_1"
fun f_Termination_terminationBy_docString_1_c8526aa85e(
  _runtime: mutable LeanExecution,
  _a_1_0: LeanValue,
): LeanValue {
  _x_6_5: LeanValue = L4_Init_Prelude.f_Lean_Name_mkStr4_cfa3e36682(
    _runtime,
    LeanText("Lean"),
    LeanText("Parser"),
    LeanText("Termination"),
    LeanText("terminationBy?"),
  );
  _x_7_6: LeanValue = LeanText(
    "Specify a termination measure for recursive functions.\n```\ntermination_by a - b\n```\nindicates that termination of the currently defined recursive function follows\nbecause the difference between the arguments `a` and `b` decreases.\n\nIf the function takes further argument after the colon, you can name them as follows:\n```\ndef example (a : Nat) : Nat → Nat → Nat :=\ntermination_by b c => a - b\n```\n\nBy default, a `termination_by` clause will cause the function to be constructed using well-founded\nrecursion. The syntax `termination_by structural a` (or `termination_by structural _ c => c`)\nindicates the function is expected to be structural recursive on the argument. In this case\nthe body of the `termination_by` clause must be one of the function's parameters.\n\nIf omitted, a termination measure will be inferred. If written as `termination_by?`,\nthe inferred termination measure will be suggested.",
  );
  L4_Lean_DocString_Extension.f_Lean_addBuiltinDocString_e430758a4e(
    _runtime,
    _x_6_5,
    _x_7_6,
    _a_1_0,
  )
}
