// "_private.Lean.Parser.Term.0.Lean.Parser.Termination.partialFixpoint._regBuiltin.Lean.Parser.Termination.partialFixpoint.docString_1"
fun f_Termination_partialFixpoint_docString_1_7faeb65717(
  _a_1_0: LeanValue,
): LeanValue {
  _x_6_5: LeanValue = L4_Init_Prelude.f_Lean_Name_mkStr4_cfa3e36682(
    LeanText("Lean"),
    LeanText("Parser"),
    LeanText("Termination"),
    LeanText("partialFixpoint"),
  );
  _x_7_6: LeanValue = LeanText(
    "Defines a possibly non-terminating function as a fixed-point in a suitable partial order.\n\nSuch a function is compiled as if it was marked `partial`, but its equations are provided as\ntheorems, so that it can be verified.\n\nIn general it accepts functions whose return type has a `Lean.Order.CCPO` instance and whose\ndefinition is `Lean.Order.monotone` with regard to its recursive calls.\n\nCommon special cases are\n\n* Functions whose type is inhabited a-priori (as with `partial`), and where all recursive\n  calls are in tail-call position.\n* Monadic in certain “monotone chain-complete monads” (in particular, `Option`) composed using\n  the bind operator and other supported monadic combinators.\n\nBy default, the monotonicity proof is performed by the compositional `monotonicity` tactic. Using\nthe syntax `partial_fixpoint monotonicity by $tac` the proof can be done manually.",
  );
  L4_Lean_DocString_Extension.f_Lean_addBuiltinDocString_e430758a4e(
    _x_6_5,
    _x_7_6,
    _a_1_0,
  )
}
