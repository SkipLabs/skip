// "_private.Lean.Parser.Term.Basic.0.Lean.Parser.Term.strictImplicitBinder._regBuiltin.Lean.Parser.Term.strictImplicitBinder.docString_1"
fun f_Term_strictImplicitBinder_docString_1_338da34cde(
  _a_1_0: LeanValue,
): LeanValue {
  _x_6_5: LeanValue = L4_Init_Prelude.f_Lean_Name_mkStr4_cfa3e36682(
    LeanText("Lean"),
    LeanText("Parser"),
    LeanText("Term"),
    LeanText("strictImplicitBinder"),
  );
  _x_7_6: LeanValue = LeanText(
    "Strict-implicit binder, like `⦃x y : A⦄` or `⦃x y⦄`.\nIn contrast to `{ ... }` implicit binders, strict-implicit binders do not automatically insert\na `_` placeholder until at least one subsequent explicit parameter is specified.\nDo *not* use strict-implicit binders unless there is a subsequent explicit parameter.\nAssuming this rule is followed, for fully applied expressions implicit and strict-implicit binders have the same behavior.\n\nExample: If `h : ∀ ⦃x : A⦄, x ∈ s → p x` and `hs : y ∈ s`,\nthen `h` by itself elaborates to itself without inserting `_` for the `x : A` parameter,\nand `h hs` has type `p y`.\nIn contrast, if `h' : ∀ {x : A}, x ∈ s → p x`, then `h` by itself elaborates to have type `?m ∈ s → p ?m`\nwith `?m` a fresh metavariable.",
  );
  L4_Lean_DocString_Extension.f_Lean_addBuiltinDocString_e430758a4e(
    _x_6_5,
    _x_7_6,
    _a_1_0,
  )
}
