fun f_Tactic_sepBy1IndentSemicolon_docString_1_d033b9ed3c(
  _a_1_0: LeanValue,
): LeanValue {
  _x_6_5: LeanValue = L4_Init_Prelude.f_Lean_Name_mkStr4_cfa3e36682(
    LeanText("Lean"),
    LeanText("Parser"),
    LeanText("Tactic"),
    LeanText("sepBy1IndentSemicolon"),
  );
  _x_7_6: LeanValue = LeanText(
    "`sepBy1IndentSemicolon(p)` parses a (nonempty) sequence of `p` optionally followed by `;`,\nsimilar to `many1Indent(p \";\"?)`, except that if two occurrences of `p` occur on the same line,\nthe `;` is mandatory. This is used by tactic parsing, so that\n```\nexample := by\n  skip\n  skip\n```\nis legal, but `by skip skip` is not - it must be written as `by skip; skip`.",
  );
  L4_Lean_DocString_Extension.f_Lean_addBuiltinDocString_e430758a4e(
    _x_6_5,
    _x_7_6,
    _a_1_0,
  )
}
