  _x_5_4: LeanValue = L4_Init_Prelude.f_Lean_Name_mkStr3_2a3962ce81(
    LeanText("Lean"),
    LeanText("Parser"),
    LeanText("manyIndent"),
  );
  _x_6_5: LeanValue = LeanText(
    "The parser `manyIndent(p)` is equivalent to `withPosition((colGe p)*)`. This has the effect of\nparsing zero or more occurrences of `p`, where each subsequent `p` parse needs to be indented\nthe same or more than the first parse.\n\nThis parser has arity 1, and returns a list of the results from `p`.\n`p` is \"auto-grouped\" if it is not arity 1.",
  );
  L4_Lean_DocString_Extension.f_Lean_addBuiltinDocString_e430758a4e(
    _x_5_4,
    _x_6_5,
    _a_1_0,
  )
}
