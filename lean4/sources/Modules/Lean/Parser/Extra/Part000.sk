  _a_1_0: LeanValue,
): LeanValue {
  _x_5_4: LeanValue = L4_Init_Prelude.f_Lean_Name_mkStr3_2a3962ce81(
    _runtime,
    LeanText("Lean"),
    LeanText("Parser"),
    LeanText("optional"),
  );
  _x_6_5: LeanValue = LeanText(
    "The parser `optional(p)`, or `(p)?`, parses `p` if it succeeds,\notherwise it succeeds with no value.\n\nNote that because `?` is a legal identifier character, one must write `(p)?` or `p ?` for\nit to parse correctly. `ident?` will not work; one must write `(ident)?` instead.\n\nThis parser has arity 1: it produces a `nullKind` node containing either zero arguments\n(for the `none` case) or the list of arguments produced by `p`.\n(In particular, if `p` has arity 0 then the two cases are not differentiated!)",
  );
  L4_Lean_DocString_Extension.f_Lean_addBuiltinDocString_e430758a4e(
    _runtime,
    _x_5_4,
    _x_6_5,
    _a_1_0,
  )
}
