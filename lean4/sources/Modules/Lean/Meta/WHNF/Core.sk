// Argument collection is private to this call. Freeze before passing it to Lean.
fun f_whnfCoreArguments(expr: LeanValue, reverse: Bool): LeanValue {
  arguments: mutable Vector<LeanValue> = mutable Vector[];
  while (leanTag(expr) == LeanTag.Expr_app__impl) {
    arguments.push(leanField(expr, 2));
    !expr = leanField(expr, 1)
  };
  if (reverse) LeanArray(arguments.toArray()) else {
    size = arguments.size();
    LeanArray(Array::fillBy(size, i -> arguments[size - i - 1]))
  }
}

