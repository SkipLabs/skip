module L4_Lean_Meta_WHNF;

// Persistent insertion for WHNF expression/configuration keys.

fun f_whnfCacheReplaceEntry(
  runtime: mutable LeanExecution,
  storedKey: LeanValue,
  storedValue: LeanValue,
  key: LeanValue,
  value: LeanValue,
): LeanValue {
  if (
    leanTag(key) !=
    LeanTag.Private_Lean_Meta_Basic_0_Lean_Meta_ExprConfigCacheKey_mk
  ) {
    return leanFail("non-exhaustive Lean case")
  };
  keyExpr = leanField(key, 0);
  keyConfig = leanField(key, 1);
  if (
    leanTag(storedKey) !=
    LeanTag.Private_Lean_Meta_Basic_0_Lean_Meta_ExprConfigCacheKey_mk
  ) {
    return leanFail("non-exhaustive Lean case")
  };
  storedExpr = leanField(storedKey, 0);
  storedConfig = leanField(storedKey, 1);
  exprsEqual = L4_Lean_Expr.f_Lean_Expr_equal_c60fe9d3e7(
    runtime,
    keyExpr,
    storedExpr,
  );
  sameKey: Bool = leanTag(exprsEqual) match {
  | LeanTag.Bool_false -> false
  | LeanTag.Bool_true ->
    configsEqual = L4_Init_Prelude.f_UInt64_decEq_97f4edb260(
      runtime,
      keyConfig,
      storedConfig,
    );
    leanTag(configsEqual) match {
    | LeanTag.Bool_false -> false
    | LeanTag.Bool_true -> true
    | _ -> leanFail("non-exhaustive Lean case")
    }
  | _ -> leanFail("non-exhaustive Lean case")
  };
  if (sameKey) {
    LeanCtor(LeanTag.PersistentHashMap_Entry_entry, Array[key, value])
  } else {
    collision = L4_Lean_Data_PersistentHashMap.f_Lean_PersistentHashMap_mkCollisionNode_6a9ae0c1b1(
      runtime,
      storedKey,
      storedValue,
      key,
      value,
    );
    LeanCtor(LeanTag.PersistentHashMap_Entry_ref, Array[collision])
  }
}

fun f_whnfCacheInsertEntry(
  runtime: mutable LeanExecution,
  existingEntry: LeanValue,
  remainingHash: LeanValue,
  depth: LeanValue,
  key: LeanValue,
  value: LeanValue,
): LeanValue {
  leanTag(existingEntry) match {
  | LeanTag.PersistentHashMap_Entry_null ->
    LeanCtor(LeanTag.PersistentHashMap_Entry_entry, Array[key, value])
  | LeanTag.PersistentHashMap_Entry_entry ->
    f_whnfCacheReplaceEntry(
      runtime,
      leanField(existingEntry, 0),
      leanField(existingEntry, 1),
      key,
      value,
    )
  | LeanTag.PersistentHashMap_Entry_ref ->
    LeanCtor(
      LeanTag.PersistentHashMap_Entry_ref,
      Array[
        f_whnfImp_spec_5_spec_10_5a205bd6f4(
          runtime,
          leanField(existingEntry, 0),
          L4_Init_Data_UInt_Basic.f_USize_shiftRight_dbd7e8f695(
            runtime,
            remainingHash,
            LeanWord("usize", 5),
          ),
          L4_Init_Data_UInt_BasicAux.f_USize_add_559d423481(
            runtime,
            depth,
            LeanWord("usize", 1),
          ),
          key,
          value,
        ),
      ],
    )
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

