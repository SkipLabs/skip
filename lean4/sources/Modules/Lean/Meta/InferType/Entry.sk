// "Lean.Meta.inferTypeImp._lam_0"
fun f_Meta_inferTypeImp_lam_0_5eca222887(
  runtime: mutable LeanExecution,
  expr: LeanValue,
  context: LeanValue,
  state: LeanValue,
  core: LeanValue,
  coreState: LeanValue,
  world: LeanValue,
): LeanValue {
  config = L4_Lean_Meta_Basic.f_Meta_Context_config_2f4f6fdcbe(
    runtime,
    context,
  );
  suitable =
    leanIsTrue(leanField(config, 13)) &&
    leanIsTrue(leanField(config, 12)) &&
    leanIsTrue(leanField(config, 15)) &&
    leanIsTrue(leanField(config, 18)) &&
    leanIsTrue(leanField(config, 16)) &&
    leanTag(leanField(config, 14)) ==
