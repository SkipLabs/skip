module L4_Lean_Meta_FunInfo;

fun f_funInfoDecision(decision: LeanValue): Bool {
  if (leanTag(decision) == LeanTag.Bool_true) {
    return true
  };
  if (leanTag(decision) == LeanTag.Bool_false) {
    return false
  };
  leanFail("non-exhaustive Lean case")
}

fun f_dependsOnHigherOrderOutput(
  runtime: mutable LeanExecution,
  higherOrderOutParams: LeanValue,
  higherOrderPred: LeanValue,
  declType: LeanValue,
): LeanValue {
  if (
    leanTag(higherOrderOutParams) == LeanTag.Std_DTreeMap_Internal_Impl_leaf
  ) {
    return LeanCtor(LeanTag.Bool_false, Array[])
  };
  if (
    leanTag(higherOrderOutParams) != LeanTag.Std_DTreeMap_Internal_Impl_inner
  ) {
    return leanFail("non-exhaustive Lean case")
  };
  found = L4_Lean_Util_FindExpr.f_Lean_Expr_findImpl_6534067b74(
    runtime,
    higherOrderPred,
    declType,
  );
  if (leanTag(found) == LeanTag.Option_some) {
    return LeanCtor(LeanTag.Bool_true, Array[])
  };
  if (leanTag(found) == LeanTag.Option_none) {
    return LeanCtor(LeanTag.Bool_false, Array[])
  };
  leanFail("non-exhaustive Lean case")
}

fun f_collectClassOutputs(
  runtime: mutable LeanExecution,
  classNameOpt: LeanValue,
  declType: LeanValue,
  fvars: LeanValue,
  index: LeanValue,
  upperBound: LeanValue,
