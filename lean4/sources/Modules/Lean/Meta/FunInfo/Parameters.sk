  if (leanTag(refResult) != LeanTag.ST_Out_mk) {
    return leanFail("non-exhaustive Lean case")
  };
  coreState = leanField(refResult, 0);
  coreWorld = leanField(refResult, 1);
  if (leanTag(coreState) != LeanTag.Core_State_mk) {
    return leanFail("non-exhaustive Lean case")
  };
  environment = leanField(coreState, 0);

  positionsResult = L4_Lean_Class.f_Lean_getOutParamPositions_db0dd84075(
    runtime,
    environment,
    className,
  );
  if (leanTag(positionsResult) == LeanTag.Option_none) {
    return LeanCtor(LeanTag.EST_Out_ok, Array[nextPair, coreWorld])
  };
  if (leanTag(positionsResult) != LeanTag.Option_some) {
    return leanFail("non-exhaustive Lean case")
  };
  positions = leanField(positionsResult, 0);
  positionsSize = L4_Init_Prelude.f_Array_size_3866d4555a(
    runtime,
    LeanErased(),
    positions,
  );
  sizeIsZero = L4_Init_Prelude.f_Nat_decEq_3e841b85bb(
    runtime,
    positionsSize,
    LeanNatLiterals.n0,
  );
  if (f_funInfoDecision(sizeIsZero)) {
    return LeanCtor(LeanTag.EST_Out_ok, Array[nextPair, coreWorld])
  };

  numArgs = L4_Lean_Expr.f_Lean_Expr_getAppNumArgs_a3ecdae05c(
    runtime,
    declType,
  );
  propSort = L4_Lean_Expr.f_Expr_sort_override_0fbd5e3fc5(
    runtime,
    LeanCtor(LeanTag.Level_zero__impl, Array[]),
  );
  appArgs = L4_Lean_Expr.f_Lean_Expr_getAppArgsAux_6cd9877715(
    runtime,
    declType,
    L4_Init_Data_Array_Basic.f_Array_replicate_b5e060f7a2(
      runtime,
      LeanErased(),
      numArgs,
      propSort,
    ),
    L4_Init_Prelude.f_Nat_sub_8647441ee5(runtime, numArgs, LeanNatLiterals.n1),
  );
  appArgsSize = L4_Init_Prelude.f_Array_size_3866d4555a(
    runtime,
    LeanErased(),
    appArgs,
  );
  outputsResult = f_Meta_getFunInfoAux_spec_2_1936896188(
    runtime,
    appArgsSize,
    positions,
    appArgs,
    fvars,
    index,
    upperBound,
    LeanNatLiterals.n0,
    nextPair,
    metaContext,
    metaStateRef,
    coreContext,
    coreStateRef,
    coreWorld,
  );
  if (leanTag(outputsResult) == LeanTag.EST_Out_error) {
    return outputsResult
  };
  if (leanTag(outputsResult) != LeanTag.EST_Out_ok) {
    return leanFail("non-exhaustive Lean case")
  };
  outputsPair = leanField(outputsResult, 0);
  if (leanTag(outputsPair) != LeanTag.Prod_mk) {
    return leanFail("non-exhaustive Lean case")
  };
