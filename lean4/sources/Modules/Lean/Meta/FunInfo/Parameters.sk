  };
  if (leanTag(classNameOpt) != LeanTag.Option_some) {
    return leanFail("non-exhaustive Lean case")
  };
  className = leanField(classNameOpt, 0);

  refResult = L4_Init_System_ST.f_Prim_Ref_get_ab668afddb(
    runtime,
    LeanErased(),
