fun f_collectParameterInfo(
  runtime: mutable LeanExecution,
  upperBound: LeanValue,
  fvars: LeanValue,
  index: LeanValue,
  pair: LeanValue,
  metaContext: LeanValue,
  metaStateRef: LeanValue,
  coreContext: LeanValue,
  coreStateRef: LeanValue,
  world: LeanValue,
): LeanValue {
  if (leanTag(pair) != LeanTag.Prod_mk) {
    return leanFail("non-exhaustive Lean case")
  };
  paramInfo = leanField(pair, 0);
  higherOrderOutParams = leanField(pair, 1);

  higherOrderPred = LeanClosure(
    L4_Lean_Meta_FunInfo.apply_f_getFunInfoAux_spec_4_lam_1_91c06b6fec,
    2,
    Array[higherOrderOutParams],
  );
  telescopeCont = LeanClosure(
    L4_Lean_Meta_FunInfo.apply_f_getFunInfoAux_spec_4_lam_0_95d7ee6b28,
    7,
    Array[],
  );

  fvar = L4_Init_Prelude.f_Array_getInternal_3b1463d18e(
    runtime,
    LeanErased(),
    fvars,
    index,
    LeanErased(),
  );
  declResult = L4_Lean_Meta_Basic.f_Lean_Meta_getFVarLocalDecl_53b3a14c72(
    runtime,
    fvar,
    metaContext,
    coreContext,
    coreStateRef,
    world,
  );
  if (leanTag(declResult) == LeanTag.EST_Out_error) {
    return declResult
  };
  if (leanTag(declResult) != LeanTag.EST_Out_ok) {
    return leanFail("non-exhaustive Lean case")
  };
  decl = leanField(declResult, 0);
  afterDeclWorld = leanField(declResult, 1);

  declType = L4_Lean_LocalContext.f_Lean_LocalDecl_type_813f33525c(
    runtime,
    decl,
  );
  backDeps = f_Lean_Meta_collectDeps_56366e190e(runtime, fvars, declType);
  dependsOnHigherOrderOutParam = f_dependsOnHigherOrderOutput(
    runtime,
    higherOrderOutParams,
    higherOrderPred,
    declType,
  );

  classResult = L4_Lean_Meta_Basic.f_Lean_Meta_isClass_a52be47aca(
    runtime,
    declType,
    metaContext,
    metaStateRef,
    coreContext,
    coreStateRef,
    afterDeclWorld,
  );
  if (leanTag(classResult) == LeanTag.EST_Out_error) {
    return classResult
  };
  if (leanTag(classResult) != LeanTag.EST_Out_ok) {
    return leanFail("non-exhaustive Lean case")
  };
  classNameOpt = leanField(classResult, 0);
  afterClassWorld = leanField(classResult, 1);

  binderInfo = L4_Lean_LocalContext.f_Lean_LocalDecl_binderInfo_61abf5b9d5(
    runtime,
    decl,
  );
  isInstance = LeanCtor(LeanTag.Bool_false, Array[]);
  if (leanTag(classNameOpt) == LeanTag.Option_some) {
    explicit = L4_Lean_Expr.f_Lean_BinderInfo_isExplicit_984a6ac108(
      runtime,
      binderInfo,
    );
    if (leanTag(explicit) == LeanTag.Bool_false) {
      !isInstance = LeanCtor(LeanTag.Bool_true, Array[])
    } else if (leanTag(explicit) != LeanTag.Bool_true) {
      return leanFail("non-exhaustive Lean case")
    }
  } else if (leanTag(classNameOpt) != LeanTag.Option_none) {
    return leanFail("non-exhaustive Lean case")
  };

  updatedParams = f_Lean_Meta_updateHasFwdDeps_f4be133458(
    runtime,
    paramInfo,
    backDeps,
  );

  propResult = L4_Lean_Meta_InferType.f_Lean_Meta_isProp_a6224e7718(
    runtime,
    declType,
    metaContext,
    metaStateRef,
    coreContext,
    coreStateRef,
    afterClassWorld,
  );
  if (leanTag(propResult) == LeanTag.EST_Out_error) {
    return propResult
  };
  if (leanTag(propResult) != LeanTag.EST_Out_ok) {
    return leanFail("non-exhaustive Lean case")
  };
  isProp = leanField(propResult, 0);
  afterPropWorld = leanField(propResult, 1);

  telescopeResult = f_Meta_getFunInfoAux_spec_1_40c80ae1b9(
    runtime,
    declType,
    telescopeCont,
    LeanCtor(LeanTag.Bool_false, Array[]),
    LeanCtor(LeanTag.Bool_false, Array[]),
    metaContext,
    metaStateRef,
    coreContext,
    coreStateRef,
    afterPropWorld,
  );
  if (leanTag(telescopeResult) == LeanTag.EST_Out_error) {
    return telescopeResult
  };
  if (leanTag(telescopeResult) != LeanTag.EST_Out_ok) {
    return leanFail("non-exhaustive Lean case")
  };
  isDecInst = leanField(telescopeResult, 0);
  afterTelescopeWorld = leanField(telescopeResult, 1);

  paramInfoEntry = LeanCtor(
    LeanTag.Meta_ParamInfo_mk,
    Array[
      binderInfo,
      LeanCtor(LeanTag.Bool_false, Array[]),
      backDeps,
      isProp,
      isDecInst,
      isInstance,
      LeanCtor(LeanTag.Bool_false, Array[]),
      dependsOnHigherOrderOutParam,
    ],
  );
  pushedParams = L4_Init_Prelude.f_Array_push_9cb6e9b3cb(
    runtime,
    LeanErased(),
    updatedParams,
    paramInfoEntry,
  );

  nextPair: LeanValue = LeanCtor(
    LeanTag.Prod_mk,
    Array[pushedParams, higherOrderOutParams],
  );
  nextWorld = afterTelescopeWorld;
  if (leanTag(isInstance) == LeanTag.Bool_true) {
    classBranch = f_collectClassOutputs(
      runtime,
      classNameOpt,
      declType,
      fvars,
      index,
      upperBound,
      pushedParams,
      higherOrderOutParams,
      metaContext,
      metaStateRef,
      coreContext,
      coreStateRef,
      afterTelescopeWorld,
    );
    if (leanTag(classBranch) == LeanTag.EST_Out_error) {
      return classBranch
    };
    if (leanTag(classBranch) != LeanTag.EST_Out_ok) {
      return leanFail("non-exhaustive Lean case")
    };
    !nextPair = leanField(classBranch, 0);
    !nextWorld = leanField(classBranch, 1)
  };
  LeanCtor(LeanTag.EST_Out_ok, Array[nextPair, nextWorld])
}

fun f_Meta_getFunInfoAux_spec_4_f0a9dec386(
  runtime: mutable LeanExecution,
  upperBound: LeanValue,
  fvars: LeanValue,
  index: LeanValue,
  paramInfoAndOutParams: LeanValue,
  metaContext: LeanValue,
  metaStateRef: LeanValue,
  coreContext: LeanValue,
  coreStateRef: LeanValue,
  world: LeanValue,
): LeanValue {
  currentIndex = index;
  parametersAndOutputs = paramInfoAndOutParams;
  currentWorld = world;
  while (
    f_funInfoDecision(
      L4_Init_Prelude.f_Nat_decLt_b34d01d051(runtime, currentIndex, upperBound),
    )
  ) {
    step = f_collectParameterInfo(
      runtime,
      upperBound,
      fvars,
      currentIndex,
      parametersAndOutputs,
      metaContext,
      metaStateRef,
      coreContext,
      coreStateRef,
      currentWorld,
    );
    if (leanTag(step) == LeanTag.EST_Out_error) {
      return step
    };
    if (leanTag(step) != LeanTag.EST_Out_ok) {
      return leanFail("non-exhaustive Lean case")
    };
    !parametersAndOutputs = leanField(step, 0);
    !currentWorld = leanField(step, 1);
    !currentIndex = L4_Init_Prelude.f_Nat_add_86990f4822(
      runtime,
      currentIndex,
      LeanNatLiterals.n1,
    )
  };
  LeanCtor(LeanTag.EST_Out_ok, Array[parametersAndOutputs, currentWorld])
}

