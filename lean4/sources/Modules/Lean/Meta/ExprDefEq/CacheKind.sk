  right: LeanValue,
  metaContext: LeanValue,
  world: LeanValue,
): LeanValue {
  hasMVars =
    leanIsTrue(L4_Lean_Expr.f_Lean_Expr_hasMVar_6b07f9e1fb(runtime, left)) ||
    leanIsTrue(L4_Lean_Expr.f_Lean_Expr_hasMVar_6b07f9e1fb(runtime, right));
