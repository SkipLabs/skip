// Shared equality-lane helpers are defined once, in this file only.
fun f_equalityWave_expect(value: LeanValue, tag: LeanTag.Value): LeanValue {
  if (leanTag(value) != tag) return leanFail("non-exhaustive Lean case");
  value
}

fun f_equalityWave_bool(value: LeanValue): Bool {
  leanTag(value) match {
  | LeanTag.Bool_false -> false
  | LeanTag.Bool_true -> true
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

// Used only where the original matches EST and immediately projects payload/world.
// Direct-return helpers do not pass through this check.
fun f_equalityWave_isError(result: LeanValue): Bool {
  leanTag(result) match {
  | LeanTag.EST_Out_ok ->
    _ = leanField(result, 0);
    _ = leanField(result, 1);
    false
  | LeanTag.EST_Out_error ->
    _ = leanField(result, 0);
    _ = leanField(result, 1);
    true
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

// Demand only the original matched fields, in order; never tag discarded values
// or reject surplus fields. Reconstruction is separately explicit at call sites.
fun f_equalityWave_fields(
  value: LeanValue,
  tag: LeanTag.Value,
  count: Int,
): Array<LeanValue> {
  _ = f_equalityWave_expect(value, tag);
  for (fieldIndex in Range(0, count)) {
    _ = leanField(value, fieldIndex)
  };
  value match {
  | LeanCtor(_, fields) -> fields
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

fun f_equalityWave_error(result: LeanValue): LeanValue {
  payload = leanField(result, 0);
  world = leanField(result, 1);
  LeanCtor(LeanTag.EST_Out_error, Array[payload, world])
}

