// Errors and conclusive LBool results terminate the chain; undef continues.
fun f_defEqConclusive(result: LeanValue): ?LeanValue {
  if (leanTag(result) == LeanTag.EST_Out_error) return Some(result);
  value = leanField(result, 0);
  leanTag(value) match {
  | LeanTag.LBool_undef -> None()
  | LeanTag.LBool_true ->
    Some(
      LeanCtor(LeanTag.EST_Out_ok, Array[leanBool(true), leanField(result, 1)]),
    )
  | LeanTag.LBool_false ->
    Some(
      LeanCtor(
        LeanTag.EST_Out_ok,
        Array[leanBool(false), leanField(result, 1)],
      ),
    )
  | _ -> leanFail("invalid definitional-equality result")
  }
}

