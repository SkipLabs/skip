// Convert a successful Boolean computation without losing its world or error.
fun f_quickDefEqBoolResult(
  runtime: mutable LeanExecution,
  result: LeanValue,
): LeanValue {
  leanTag(result) match {
  | LeanTag.EST_Out_error -> result
  | LeanTag.EST_Out_ok ->
    LeanCtor(
      LeanTag.EST_Out_ok,
      Array[
        L4_Lean_Data_LBool.f_Lean_Bool_toLBool_b192e84fda(
          runtime,
          leanField(result, 0),
        ),
        leanField(result, 1),
      ],
    )
  | _ -> leanFail("invalid definitional-equality result")
  }
}

