    return LeanCtor(LeanTag.EST_Out_ok, Array[leanBool(false), world])
  };
  if (transparency == LeanTag.Meta_TransparencyMode_all) {
    return LeanCtor(LeanTag.EST_Out_ok, Array[leanBool(true), world])
  };
  name = L4_Lean_Declaration.f_Lean_ConstantInfo_name_42ee85d973(runtime, info);
  if (transparency == LeanTag.Meta_TransparencyMode_default) {
    irreducible = f_Meta_canUnfoldDefault_spec_0_fa1f87a129(
      runtime,
      name,
      coreContext,
      coreStateRef,
      world,
    );
    leanTag(irreducible) match {
    | LeanTag.EST_Out_error -> return irreducible
