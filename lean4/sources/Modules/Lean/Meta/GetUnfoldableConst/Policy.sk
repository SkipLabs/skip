  leanTag(statusResult) match {
  | LeanTag.EST_Out_ok ->
    allowed = leanTag(leanField(statusResult, 0)) match {
    | LeanTag.ReducibilityStatus_reducible -> true
    | LeanTag.ReducibilityStatus_instanceReducible ->
      transparency == LeanTag.Meta_TransparencyMode_instances ||
        transparency == LeanTag.Meta_TransparencyMode_implicit
    | LeanTag.ReducibilityStatus_implicitReducible ->
      transparency == LeanTag.Meta_TransparencyMode_implicit
