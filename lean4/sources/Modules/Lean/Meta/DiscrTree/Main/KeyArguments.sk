      runtime,
      metaContext,
    );
    if (leanIsTrue(leanField(config, 4))) {
      return f_keyArgsSuccess(
        LeanCtor(LeanTag.Meta_DiscrTree_Key_star, Array[]),
        empty,
        currentWorld,
