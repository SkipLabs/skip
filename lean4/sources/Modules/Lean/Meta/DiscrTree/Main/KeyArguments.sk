// "_private.Lean.Meta.DiscrTree.Main.0.Lean.Meta.DiscrTree.getKeyArgs"
fun f_Meta_DiscrTree_getKeyArgs_8dfa358241(
  runtime: mutable LeanExecution,
  expression: LeanValue,
  isMatch: LeanValue,
  root: LeanValue,
  metaContext: LeanValue,
  metaStateRef: LeanValue,
  coreContext: LeanValue,
  coreStateRef: LeanValue,
  world: LeanValue,
): LeanValue {
