    runtime,
    expression,
    root,
    metaContext,
    metaStateRef,
    coreContext,
    coreStateRef,
    world,
  );
  if (leanTag(reduced) == LeanTag.EST_Out_error) return reduced;
  if (leanTag(reduced) != LeanTag.EST_Out_ok) {
    return leanFail("non-exhaustive Lean case")
  };
  value = leanField(reduced, 0);
  currentWorld = leanField(reduced, 1);
  empty = LeanArray(Array[]);
  if (!leanIsTrue(root)) {
    numeral = f_Meta_DiscrTree_toNatLit_7d849234a0(runtime, value);
    if (leanTag(numeral) == LeanTag.Option_some) {
