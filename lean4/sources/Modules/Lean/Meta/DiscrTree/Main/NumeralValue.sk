// Convert numeral syntax while retaining an unchanged literal's Nat representation.
module L4_Lean_Meta_DiscrTree_Main;

fun f_numeralValue(
  runtime: mutable LeanExecution,
  expression: LeanValue,
): ?LeanValue {
  current = expression;
  loop {
    head = L4_Lean_Expr.f_Lean_Expr_getAppFn_05707344ce(runtime, current);
    leanTag(head) match {
    | LeanTag.Expr_lit__impl ->
      literal = leanField(head, 1);
      return if (leanTag(literal) == LeanTag.Literal_natVal) {
        Some(leanField(literal, 0))
      } else {
        None()
      }
    | LeanTag.Expr_const__impl -> void
    | _ -> return None()
    };
    name = leanField(head, 1);
    _ = leanField(head, 2);
    successorName = L4_Init_Prelude.f_Lean_Name_mkStr2_ed89eae6ad(
      runtime,
      LeanText("Nat"),
      LeanText("succ"),
    );
    if (
      leanIsTrue(
        L4_Init_Prelude.f_Lean_Name_beq_2965acc154(
          runtime,
          name,
          successorName,
        ),
      )
    ) {
      arity = L4_Lean_Expr.f_Lean_Expr_getAppNumArgs_a3ecdae05c(
        runtime,
        current,
      );
      if (
        leanIsTrue(
          L4_Init_Prelude.f_Nat_decEq_3e841b85bb(
            runtime,
            arity,
            LeanNatLiterals.n1,
          ),
        )
      ) {
        argument = L4_Lean_Expr.f_Lean_Expr_appArg_751e777947(runtime, current);
        childValue = f_numeralValue(runtime, argument);
        childValue match {
        | None() -> return None()
        | Some(value) ->
          return Some(
            L4_Init_Prelude.f_Nat_add_86990f4822(
              runtime,
              value,
              LeanNatLiterals.n1,
            ),
          )
        }
      }
    };
    ofNatName = L4_Init_Prelude.f_Lean_Name_mkStr2_ed89eae6ad(
      runtime,
      LeanText("OfNat"),
      LeanText("ofNat"),
    );
    if (
      leanIsTrue(
        L4_Init_Prelude.f_Lean_Name_beq_2965acc154(runtime, name, ofNatName),
      )
    ) {
      arity = L4_Lean_Expr.f_Lean_Expr_getAppNumArgs_a3ecdae05c(
        runtime,
        current,
      );
      if (
        leanIsTrue(
          L4_Init_Prelude.f_Nat_decEq_3e841b85bb(
            runtime,
            arity,
            LeanNatLiterals.n3,
          ),
        )
      ) {
        !current = L4_Lean_Expr.f_Lean_Expr_getRevArg_587d3ee448(
          runtime,
          current,
          LeanNatLiterals.n1,
        );
        continue
      }
    };
    zeroName = L4_Init_Prelude.f_Lean_Name_mkStr2_ed89eae6ad(
      runtime,
      LeanText("Nat"),
      LeanText("zero"),
    );
    if (
      !leanIsTrue(
        L4_Init_Prelude.f_Lean_Name_beq_2965acc154(runtime, name, zeroName),
      )
    ) {
      return None()
    };
    arity = L4_Lean_Expr.f_Lean_Expr_getAppNumArgs_a3ecdae05c(runtime, current);
    return if (
      leanIsTrue(
        L4_Init_Prelude.f_Nat_decEq_3e841b85bb(
          runtime,
          arity,
          LeanNatLiterals.n0,
        ),
      )
    ) {
      Some(LeanNatLiterals.n0)
    } else {
      None()
    }
  }
}

fun f_DiscrTree_toNatLit_loop_fea062450d(
  runtime: mutable LeanExecution,
  expression: LeanValue,
): LeanValue {
  f_numeralValue(runtime, expression) match {
  | None() -> LeanCtor(LeanTag.Option_none, Array[])
  | Some(value) -> LeanCtor(LeanTag.Option_some, Array[value])
  }
}

module end;
