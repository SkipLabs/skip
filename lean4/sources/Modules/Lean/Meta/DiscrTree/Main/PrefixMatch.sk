): LeanValue {
  kind = leanTag(key);
  if (
    kind != LeanTag.Meta_DiscrTree_Key_const &&
    kind != LeanTag.Meta_DiscrTree_Key_fvar &&
    kind != LeanTag.Meta_DiscrTree_Key_proj
  ) {
    return LeanCtor(LeanTag.EST_Out_ok, Array[leanBool(false), world])
  };
  isProjection = kind == LeanTag.Meta_DiscrTree_Key_proj;
  head = leanField(key, 0);
  arity: LeanValue = leanField(key, if (isProjection) 2 else 1);
  loop {
    if (
      leanIsTrue(
        L4_Init_Prelude.f_Nat_decEq_3e841b85bb(
          runtime,
          arity,
          LeanNatLiterals.n0,
