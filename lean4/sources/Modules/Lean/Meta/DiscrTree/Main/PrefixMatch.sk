    ) {
      return LeanCtor(LeanTag.EST_Out_ok, Array[leanBool(false), world])
    };
    !arity = L4_Init_Prelude.f_Nat_sub_8647441ee5(
      runtime,
      arity,
      LeanNatLiterals.n1,
    );
    shorterKey = if (isProjection) {
      LeanCtor(kind, Array[head, leanField(key, 1), arity])
    } else {
      LeanCtor(kind, Array[head, arity])
    };
    found = f_DiscrTree_getStarResult_spec_0_38be478a44(
      runtime,
      rootNode,
      shorterKey,
    );
    leanTag(found) match {
    | LeanTag.Option_none -> void
    | LeanTag.Option_some ->
      _ = leanField(found, 0);
      return LeanCtor(LeanTag.EST_Out_ok, Array[leanBool(true), world])
    | _ -> return leanFail("non-exhaustive Lean case")
    }
  }
}

module end;
