// Look for an application prefix with strictly fewer arguments.
module L4_Lean_Meta_DiscrTree_Main;

fun f_DiscrTree_getMatchWithExtra_mayMatchPrefix_ef47d0e14e(
  runtime: mutable LeanExecution,
  rootNode: LeanValue,
  key: LeanValue,
  _metaContext: LeanValue,
  _metaStateRef: LeanValue,
  _coreContext: LeanValue,
  _coreStateRef: LeanValue,
