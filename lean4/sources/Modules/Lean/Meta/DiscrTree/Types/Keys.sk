// Hash discrimination-tree keys with Lean's constructor salts and field order.
module L4_Lean_Meta_DiscrTree_Types;

fun f_keyNameHash(name: LeanValue): LeanValue {
  leanTag(name) match {
  | LeanTag.Name_anonymous__impl -> LeanWord("uint64", 1723)
  | LeanTag.Name_str__impl -> leanField(name, 0)
  | LeanTag.Name_num__impl -> leanField(name, 0)
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

fun f_DiscrTree_Key_hash_d0f27b96fa(
  runtime: mutable LeanExecution,
  key: LeanValue,
): LeanValue {
  leanTag(key) match {
  | LeanTag.Meta_DiscrTree_Key_star -> LeanWord("uint64", 7883)
  | LeanTag.Meta_DiscrTree_Key_other -> LeanWord("uint64", 2411)
  | LeanTag.Meta_DiscrTree_Key_arrow -> LeanWord("uint64", 17)
  | LeanTag.Meta_DiscrTree_Key_lit ->
    literal = leanField(key, 0);
    L4_Init_Prelude.f_mixHash_f2b5fd4ac9(
      runtime,
      LeanWord("uint64", 1879),
      L4_Lean_Expr.f_Lean_Literal_hash_fe3484aa9e(runtime, literal),
    )
  | LeanTag.Meta_DiscrTree_Key_fvar ->
    fvarId = leanField(key, 0);
    arity = leanField(key, 1);
    L4_Init_Prelude.f_mixHash_f2b5fd4ac9(
      runtime,
      LeanWord("uint64", 3541),
      L4_Init_Prelude.f_mixHash_f2b5fd4ac9(
        runtime,
        L4_Lean_Expr.f_Lean_instHashableFVarId_hash_0a224ae9eb(runtime, fvarId),
        L4_Init_Data_UInt_BasicAux.f_UInt64_ofNat_fcf242b6af(runtime, arity),
      ),
    )
  | LeanTag.Meta_DiscrTree_Key_const ->
    name = leanField(key, 0);
    arity = leanField(key, 1);
    L4_Init_Prelude.f_mixHash_f2b5fd4ac9(
      runtime,
      LeanWord("uint64", 5237),
      L4_Init_Prelude.f_mixHash_f2b5fd4ac9(
        runtime,
        f_keyNameHash(name),
        L4_Init_Data_UInt_BasicAux.f_UInt64_ofNat_fcf242b6af(runtime, arity),
      ),
    )
  | LeanTag.Meta_DiscrTree_Key_proj ->
    structureName = leanField(key, 0);
    projectionIndex = leanField(key, 1);
    arity = leanField(key, 2);
    L4_Init_Prelude.f_mixHash_f2b5fd4ac9(
      runtime,
      L4_Init_Data_UInt_BasicAux.f_UInt64_ofNat_fcf242b6af(runtime, arity),
      L4_Init_Prelude.f_mixHash_f2b5fd4ac9(
        runtime,
        f_keyNameHash(structureName),
        L4_Init_Data_UInt_BasicAux.f_UInt64_ofNat_fcf242b6af(
          runtime,
          projectionIndex,
        ),
      ),
    )
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

module end;
