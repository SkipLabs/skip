// Original matched app destructuring branches demand app fields 0, 1 then 2.
fun f_offsets_wave_visitArgument(expression: LeanValue): LeanValue {
  leanTag(expression) match {
  | LeanTag.Expr_app__impl ->
    _ = leanField(expression, 0);
    _ = leanField(expression, 1);
    leanField(expression, 2)
  | _ ->
    leanFail("unreachable: _private.Lean.Meta.Offset.0.Lean.Meta.evalNat.visit")
  }
}

// A false instance test must stop before either operand is visited; the guarded
// instance result demands EST0->1 before the Bool tag. Matched tester errors
// demand both fields and reconstruct the exact two-field EST_Out_error.
fun f_offsets_wave_guardedBinary(
  runtime: mutable LeanExecution,
  instanceResult: LeanValue,
  operation: String,
  left: LeanValue,
  right: LeanValue,
  metaContext: LeanValue,
  metaState: LeanValue,
  coreContext: LeanValue,
  coreState: LeanValue,
): LeanValue {
  if (!f_offsets_wave_isOk(instanceResult)) {
    return LeanCtor(
      LeanTag.EST_Out_error,
      Array[leanField(instanceResult, 0), leanField(instanceResult, 1)],
    )
  };
  // Original demands EST field 0 (Bool) before field 1 (world).
  instanceFlag = leanField(instanceResult, 0);
  world = leanField(instanceResult, 1);
  if (!f_offsets_wave_bool(instanceFlag)) {
    return f_offsets_wave_none(world)
  };
  f_offsets_wave_evalBinary(
    runtime,
    operation,
    left,
    right,
    metaContext,
    metaState,
    coreContext,
    coreState,
    world,
  )
}

// Nat operations remain arbitrary precision. Never infer a result from one
// operand. Left EST0->1, left Option tag, left some payload BEFORE the right
// evaluation; right EST0->1 before the right Option tag. Both operand-error
// branches intentionally forward the whole output after required projections.
fun f_offsets_wave_evalBinary(
  runtime: mutable LeanExecution,
  operation: String,
  left: LeanValue,
  right: LeanValue,
  metaContext: LeanValue,
  metaState: LeanValue,
  coreContext: LeanValue,
  coreState: LeanValue,
  world: LeanValue,
): LeanValue {
  if (operation == "pow") {
    // This existing helper evaluates/checks the exponent BEFORE evaluating the base,
    // including the original safe-exponent warning, errors, and option failure.
    return f_Meta_evalNat_evalPow_eeb69d1902(
      runtime,
      left,
      right,
      metaContext,
      metaState,
      coreContext,
      coreState,
      world,
    )
  };
  leftResult = f_Lean_Meta_evalNat_6bfbb6a56e(
    runtime,
    left,
    metaContext,
    metaState,
    coreContext,
    coreState,
    world,
  );
  if (!f_offsets_wave_isOk(leftResult)) {
    // Original demands both error fields via projections, then forwards the
    // whole output (intentional forwarding branch; early if-return is legal).
    _ = leanField(leftResult, 0);
    _ = leanField(leftResult, 1);
    return leftResult
  };
  leftOption = leanField(leftResult, 0);
  leftWorld = leanField(leftResult, 1);
  leanTag(leftOption) match {
  | LeanTag.Option_none -> leftResult
  | LeanTag.Option_some ->
    leftValue = leanField(leftOption, 0);
    rightResult = f_Lean_Meta_evalNat_6bfbb6a56e(
      runtime,
      right,
      metaContext,
      metaState,
      coreContext,
      coreState,
      leftWorld,
    );
    if (!f_offsets_wave_isOk(rightResult)) {
      _ = leanField(rightResult, 0);
      _ = leanField(rightResult, 1);
      return rightResult
    };
    rightOption = leanField(rightResult, 0);
    rightWorld = leanField(rightResult, 1);
    leanTag(rightOption) match {
    | LeanTag.Option_none -> rightResult
    | LeanTag.Option_some ->
      rightValue = leanField(rightOption, 0);
      value = operation match {
      | "add" ->
        L4_Init_Prelude.f_Nat_add_86990f4822(runtime, leftValue, rightValue)
      | "sub" ->
        L4_Init_Prelude.f_Nat_sub_8647441ee5(runtime, leftValue, rightValue)
      | "mul" ->
        L4_Init_Prelude.f_Nat_mul_8d6effc865(runtime, leftValue, rightValue)
      | "div" ->
        L4_Init_Prelude.f_Nat_div_d9df18e4c4(runtime, leftValue, rightValue)
      | "mod" ->
        L4_Init_Prelude.f_Nat_mod_0b9c5755ae(runtime, leftValue, rightValue)
      | _ -> leanFail("offsets wave: unsupported internal Nat operation")
      };
      f_offsets_wave_some(value, rightWorld)
    | _ -> leanFail("non-exhaustive Lean case")
    }
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

