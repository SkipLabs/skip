    return LeanCtor(
      LeanTag.EST_Out_error,
      Array[leanField(inferred, 0), leanField(inferred, 1)],
    )
  };
  natName = L4_Init_Prelude.f_Lean_Name_mkStr1_4962bb4b4e(
    runtime,
    LeanText("Nat"),
  );
  natType = L4_Lean_Expr.f_Lean_mkConst_b40a363b86(
    runtime,
    natName,
    LeanCtor(LeanTag.List_nil, Array[]),
  );
  check = LeanClosure(
    L4_Lean_Meta_Basic.apply_f_Lean_Meta_isExprDefEqAux_34c5c35f5e,
    7,
    Array[leanField(inferred, 0), natType],
  );
  checkedType = f_Meta_matchesInstance_spec_0_4b55788272(
    runtime,
    check,
    LeanCtor(LeanTag.Bool_false, Array[]),
    metaContext,
    metaState,
    coreContext,
    coreState,
    leanField(inferred, 1),
  );
  if (!f_offsets_wave_isOk(checkedType)) {
    return LeanCtor(
      LeanTag.EST_Out_error,
      Array[leanField(checkedType, 0), leanField(checkedType, 1)],
    )
  };
  // This helper returns EST Bool, not EST LBool. Both callers map false to
  // undef and only run their continuation on true (original pc1).
  checkedTypeValue = leanField(checkedType, 0);
  checkedTypeWorld = leanField(checkedType, 1);
  LeanCtor(
    LeanTag.EST_Out_ok,
    Array[checkedTypeValue, checkedTypeWorld],
  )
}

fun f_offsets_wave_ifNatValue(
  runtime: mutable LeanExecution,
  originalLeft: LeanValue,
  value: LeanValue,
  metaContext: LeanValue,
  metaState: LeanValue,
  coreContext: LeanValue,
  coreState: LeanValue,
  world: LeanValue,
): LeanValue {
  checked = f_offsets_wave_checkNatType(
    runtime,
    originalLeft,
    metaContext,
    metaState,
    coreContext,
    coreState,
    world,
  );
  if (!f_offsets_wave_isOk(checked)) return checked;
  checkedWorld = leanField(checked, 1);
  if (!f_offsets_wave_bool(leanField(checked, 0))) {
    return f_offsets_wave_undefined(checkedWorld)
  };
  LeanCtor(LeanTag.EST_Out_ok, Array[value, checkedWorld])
}

fun f_offsets_wave_compareNat(
  runtime: mutable LeanExecution,
  originalLeft: LeanValue,
  left: LeanValue,
  right: LeanValue,
  metaContext: LeanValue,
  metaState: LeanValue,
