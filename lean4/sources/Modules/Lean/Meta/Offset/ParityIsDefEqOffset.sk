    value
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

// Offset-shift helpers demand Base0->1 before the shift effect; every matched
// shift error reconstructs the exact two-field EST_Out_error.
fun f_offsets_wave_compareOffsets(
  runtime: mutable LeanExecution,
  originalLeft: LeanValue,
  leftPair: LeanValue,
  rightPair: LeanValue,
  metaContext: LeanValue,
  metaState: LeanValue,
  coreContext: LeanValue,
  coreState: LeanValue,
  world: LeanValue,
): LeanValue {
  leftBase = leanField(leftPair, 0);
  leftOffset = leanField(leftPair, 1);
  rightBase = leanField(rightPair, 0);
  rightOffset = leanField(rightPair, 1);
  if (
    f_offsets_wave_bool(
      L4_Init_Prelude.f_Nat_decEq_3e841b85bb(runtime, leftOffset, rightOffset),
    )
  ) {
    return f_offsets_wave_compareNat(
      runtime,
      originalLeft,
      leftBase,
      rightBase,
      metaContext,
      metaState,
      coreContext,
      coreState,
      world,
    )
  };
  if (
    f_offsets_wave_bool(
      L4_Init_Prelude.f_Nat_decLt_b34d01d051(runtime, leftOffset, rightOffset),
    )
  ) {
    shifted = f_Lean_Meta_mkOffset_02c44d4985(
      runtime,
      rightBase,
      L4_Init_Prelude.f_Nat_sub_8647441ee5(runtime, rightOffset, leftOffset),
      metaContext,
      metaState,
      coreContext,
      coreState,
      world,
    );
    if (!f_offsets_wave_isOk(shifted)) {
      return LeanCtor(
        LeanTag.EST_Out_error,
        Array[leanField(shifted, 0), leanField(shifted, 1)],
      )
    };
    return f_offsets_wave_compareNat(
      runtime,
      originalLeft,
      leftBase,
      leanField(shifted, 0),
      metaContext,
      metaState,
      coreContext,
      coreState,
      leanField(shifted, 1),
    )
  };
  shifted = f_Lean_Meta_mkOffset_02c44d4985(
    runtime,
    leftBase,
    L4_Init_Prelude.f_Nat_sub_8647441ee5(runtime, leftOffset, rightOffset),
    metaContext,
    metaState,
    coreContext,
    coreState,
    world,
  );
  if (!f_offsets_wave_isOk(shifted)) {
    return LeanCtor(
      LeanTag.EST_Out_error,
      Array[leanField(shifted, 0), leanField(shifted, 1)],
    )
  };
  f_offsets_wave_compareNat(
    runtime,
    originalLeft,
    leanField(shifted, 0),
    rightBase,
    metaContext,
    metaState,
    coreContext,
    coreState,
    leanField(shifted, 1),
  )
}

fun f_offsets_wave_compareOffsetNumeral(
  runtime: mutable LeanExecution,
  originalLeft: LeanValue,
  pair: LeanValue,
  numeral: LeanValue,
  offsetOnLeft: Bool,
  metaContext: LeanValue,
  metaState: LeanValue,
  coreContext: LeanValue,
  coreState: LeanValue,
  world: LeanValue,
): LeanValue {
  base = leanField(pair, 0);
  offset = leanField(pair, 1);
  if (
    !f_offsets_wave_bool(
      L4_Init_Prelude.f_Nat_decLe_2f4affd9a0(runtime, offset, numeral),
    )
  ) {
    return f_offsets_wave_ifNatValue(
      runtime,
      originalLeft,
      LeanCtor(LeanTag.LBool_false, Array[]),
      metaContext,
      metaState,
      coreContext,
      coreState,
      world,
    )
  };
  difference = L4_Init_Prelude.f_Nat_sub_8647441ee5(runtime, numeral, offset);
  literal = L4_Lean_Expr.f_Lean_mkNatLit_5439e473a5(runtime, difference);
  f_offsets_wave_compareNat(
    runtime,
    originalLeft,
    if (offsetOnLeft) base else literal,
    if (offsetOnLeft) literal else base,
    metaContext,
    metaState,
    coreContext,
    coreState,
    world,
  )
}

// Keep this protected type check, even for unequal literals or impossible offsets.
// Assignments are forbidden at its new mctx depth: this is the original pc1
// procedure, and its error branches reconstruct the exact two-field wrappers.
// The original left expression is not replaced by a stripped base.
fun f_offsets_wave_checkNatType(
  runtime: mutable LeanExecution,
