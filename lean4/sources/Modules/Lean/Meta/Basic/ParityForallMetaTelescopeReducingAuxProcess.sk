}

fun f_inference_metaTelescope_ok(result: LeanValue): Bool {
  leanTag(result) match {
  | LeanTag.EST_Out_ok ->
    _ = leanField(result, 0);
    _ = leanField(result, 1);
    true
  | LeanTag.EST_Out_error ->
    _ = leanField(result, 0);
    _ = leanField(result, 1);
    false
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

fun f_inference_metaTelescope_result(
  mvars: LeanValue,
  binderInfos: LeanValue,
  body: LeanValue,
  world: LeanValue,
