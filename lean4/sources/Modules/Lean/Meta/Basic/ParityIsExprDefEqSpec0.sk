fun f_inference_defEq_bool(value: LeanValue): Bool {
  leanTag(value) match {
  | LeanTag.Bool_false -> false
  | LeanTag.Bool_true -> true
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

fun f_inference_defEq_ok(result: LeanValue): Bool {
  leanTag(result) match {
  | LeanTag.EST_Out_ok ->
    _ = leanField(result, 0);
    _ = leanField(result, 1);
    true
  | LeanTag.EST_Out_error ->
    _ = leanField(result, 0);
    _ = leanField(result, 1);
    false
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

fun f_inference_defEq_requireST(result: LeanValue): void {
  if (leanTag(result) != LeanTag.ST_Out_mk) {
    leanFail("non-exhaustive Lean case")
  };
