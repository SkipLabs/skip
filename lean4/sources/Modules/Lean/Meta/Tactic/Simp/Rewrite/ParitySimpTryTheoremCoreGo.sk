module L4_Lean_Meta_Tactic_Simp_Rewrite;

// Validate the same constructor projections as the original, including discarded fields.
fun f_rewriteWave_theorem_fields(
  value: LeanValue,
  tag: LeanTag.Value,
  count: Int,
): Array<LeanValue> {
  if (leanTag(value) != tag) return leanFail("non-exhaustive Lean case");
  for (index in Range(0, count)) {
    _ = leanField(value, index)
  };
  value match {
  | LeanCtor(_, fields) -> fields
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

fun f_rewriteWave_theorem_bool(value: LeanValue): Bool {
  leanTag(value) match {
  | LeanTag.Bool_false -> false
  | LeanTag.Bool_true -> true
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

// Preserve error payload and returned world, rather than converting failure to no-match.
fun f_rewriteWave_theorem_ok(output: LeanValue): Bool {
  leanTag(output) match {
  | LeanTag.EST_Out_ok ->
    _ = leanField(output, 0);
    _ = leanField(output, 1);
    true
  | LeanTag.EST_Out_error ->
    _ = leanField(output, 0);
    _ = leanField(output, 1);
    false
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

fun f_rewriteWave_theorem_none(world: LeanValue): LeanValue {
  LeanCtor(
    LeanTag.EST_Out_ok,
    Array[LeanCtor(LeanTag.Option_none, Array[]), world],
  )
}

fun f_rewriteWave_theorem_infallible(output: LeanValue): Array<LeanValue> {
  if (!f_rewriteWave_theorem_ok(output)) {
    return leanFail(
      "unreachable: _private.Lean.Meta.Tactic.Simp.Rewrite.0.Lean.Meta.Simp.tryTheoremCore.go",
    )
  };
  Array[leanField(output, 0), leanField(output, 1)]
}

fun f_rewriteWave_theorem_text(
  runtime: mutable LeanExecution,
  text: String,
): LeanValue {
  L4_Lean_Message.f_Lean_stringToMessageData_1e55fa4f40(runtime, LeanText(text))
}

fun f_rewriteWave_theorem_compose(
  left: LeanValue,
  right: LeanValue,
): LeanValue {
  LeanCtor(LeanTag.MessageData_compose, Array[left, right])
}

// Each call corresponds to one old trace branch. MessageData remains left-associated;
// theorem rendering is deferred until both the global and named trace gates pass.
fun f_rewriteWave_theorem_trace(
  runtime: mutable LeanExecution,
  reason: String,
  debugClass: LeanValue,
  theorem: LeanValue,
  expression: LeanValue,
  lhs: LeanValue,
  type: LeanValue,
  rhs: LeanValue,
  metaContext: LeanValue,
  metaState: LeanValue,
  coreContext: LeanValue,
  coreState: LeanValue,
  world: LeanValue,
): LeanValue {
  core = f_rewriteWave_theorem_fields(coreContext, LeanTag.Core_Context_mk, 8);
  cold = f_rewriteWave_theorem_fields(
    core[0],
    LeanTag.Core_Context_Cold_mk,
    12,
  );
  options = f_rewriteWave_theorem_fields(
    cold[2],
    LeanTag.Private_Lean_Data_Options_0_Lean_Options_mk,
    2,
  );
  if (!f_rewriteWave_theorem_bool(options[1])) {
    return LeanCtor(
      LeanTag.EST_Out_ok,
      Array[LeanCtor(LeanTag.PUnit_unit, Array[]), world],
    )
  };
  traceClass = debugClass;
  if (reason != "trying" && reason != "unchanged") {
    suffix = if (reason == "unify") "unify" else "rewrite";
    !traceClass = L4_Init_Prelude.f_Lean_Name_mkStr4_cfa3e36682(
      runtime,
      LeanText("Meta"),
      LeanText("Tactic"),
      LeanText("simp"),
      LeanText(suffix),
    )
  };
  tracePrefix = L4_Init_Prelude.f_Lean_Name_mkStr1_4962bb4b4e(
    runtime,
    LeanText("trace"),
  );
  optionName = L4_Init_Prelude.f_Lean_Name_append_54ec01d162(
    runtime,
    tracePrefix,
    traceClass,
  );
  enabled = L4_Lean_Util_Trace.f_Lean_checkTraceOption_go_8ac1958e84(
    runtime,
    cold[11],
    cold[2],
    optionName,
  );
  if (!f_rewriteWave_theorem_bool(enabled)) {
    return LeanCtor(
      LeanTag.EST_Out_ok,
      Array[LeanCtor(LeanTag.PUnit_unit, Array[]), world],
    )
  };
  rendered = f_rewriteWave_theorem_infallible(
    f_tryTheoremCore_go_spec_0_1ba57450a8(runtime, theorem, world),
  );
  message = rendered[0];
  reason match {
  | "trying" ->
    tryingPrefix = f_rewriteWave_theorem_text(runtime, "trying ");
    !message = f_rewriteWave_theorem_compose(tryingPrefix, message);
    !message = f_rewriteWave_theorem_compose(
      message,
      f_rewriteWave_theorem_text(runtime, " to rewrite"),
    );
    !message = f_rewriteWave_theorem_compose(
      message,
      L4_Lean_Message.f_Lean_indentExpr_f484b447e1(runtime, expression),
    )
  | "unify" ->
    !message = f_rewriteWave_theorem_compose(
      message,
      f_rewriteWave_theorem_text(runtime, ", failed to unify"),
    );
    !message = f_rewriteWave_theorem_compose(
      message,
      L4_Lean_Message.f_Lean_indentExpr_f484b447e1(runtime, lhs),
    );
    !message = f_rewriteWave_theorem_compose(
      message,
      f_rewriteWave_theorem_text(runtime, "\nwith"),
    );
    !message = f_rewriteWave_theorem_compose(
      message,
      L4_Lean_Message.f_Lean_indentExpr_f484b447e1(runtime, expression),
    )
  | "unassigned" ->
    !message = f_rewriteWave_theorem_compose(
      message,
      f_rewriteWave_theorem_text(
        runtime,
        ", has unassigned metavariables after unification",
      ),
    )
  | "unchanged" ->
    unchangedPrefix = f_rewriteWave_theorem_text(runtime, "Not applying ");
    !message = f_rewriteWave_theorem_compose(unchangedPrefix, message);
    !message = f_rewriteWave_theorem_compose(
      message,
      f_rewriteWave_theorem_text(runtime, " with type"),
    );
    !message = f_rewriteWave_theorem_compose(
      message,
      L4_Lean_Message.f_Lean_indentExpr_f484b447e1(runtime, type),
    );
    !message = f_rewriteWave_theorem_compose(
      message,
      f_rewriteWave_theorem_text(runtime, "\nto"),
    );
    !message = f_rewriteWave_theorem_compose(
      message,
      L4_Lean_Message.f_Lean_indentExpr_f484b447e1(runtime, expression),
    );
    !message = f_rewriteWave_theorem_compose(
      message,
      f_rewriteWave_theorem_text(
        runtime,
        "\nas the result is structurally equal to the original expression",
      ),
    )
  | "permutation" ->
    !message = f_rewriteWave_theorem_compose(
      message,
      f_rewriteWave_theorem_text(runtime, ", perm rejected "),
    );
    !message = f_rewriteWave_theorem_compose(
      message,
      L4_Lean_Message.f_Lean_MessageData_ofExpr_19c924d486(runtime, expression),
    );
    !message = f_rewriteWave_theorem_compose(
      message,
      f_rewriteWave_theorem_text(runtime, " ==> "),
    );
    !message = f_rewriteWave_theorem_compose(
      message,
      L4_Lean_Message.f_Lean_MessageData_ofExpr_19c924d486(runtime, rhs),
    )
  | "rewrite" ->
    !message = f_rewriteWave_theorem_compose(
      message,
      f_rewriteWave_theorem_text(runtime, ":"),
    );
    !message = f_rewriteWave_theorem_compose(
      message,
      L4_Lean_Message.f_Lean_indentExpr_f484b447e1(runtime, expression),
    );
    !message = f_rewriteWave_theorem_compose(
      message,
      f_rewriteWave_theorem_text(runtime, "\n==>"),
    );
    !message = f_rewriteWave_theorem_compose(
      message,
      L4_Lean_Message.f_Lean_indentExpr_f484b447e1(runtime, rhs),
    )
  | _ -> return leanFail("unknown rewrite-wave trace reason")
  };
  f_synthesizeArgs_synthesizeInstance_spec_0_62b88d54be(
    runtime,
    traceClass,
    message,
    metaContext,
    metaState,
    coreContext,
    coreState,
    rendered[1],
  )
}

