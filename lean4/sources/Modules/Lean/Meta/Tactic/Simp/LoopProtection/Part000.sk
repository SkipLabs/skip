    _x_3_2,
  );
  _x_6_5: LeanValue = LeanText(
    "When enabled, `simp` will check if the theorems passed as simp arguments (`simp [thm1]`) are possibly looping in the current simp set.\n\nMore precisely, it tries to simplify the right-hand side of the theorem and complains if that fails, which it typically does because of running out of recursion depth.\n\nThis is a relatively expensive check, so it i disabled by default, and only run after a `simp` call actually failed with a recursion depth error.",
  );
  _x_12_11: LeanValue = L4_Init_Prelude.f_Lean_Name_mkStr5_196cd55bbd(
    _runtime,
    LeanText("Lean"),
    LeanText("Meta"),
    LeanText("Simp"),
    _x_2_1,
    _x_3_2,
  );
  f_hygCtx_hyg_spec_0_6057dbef6b(
    _runtime,
    _x_4_3,
    LeanCtor(
      LeanTag.Option_Decl_mk,
      Array[
        LeanCtor(LeanTag.Bool_false, Array[]),
        _x_6_5,
        LeanCtor(LeanTag.Option_none, Array[]),
      ],
    ),
    _x_12_11,
    _a_1_0,
