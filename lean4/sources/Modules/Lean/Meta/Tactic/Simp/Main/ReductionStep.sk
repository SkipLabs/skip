fun f_dsimpReduceFinish_ce40a5e837(
  runtime: mutable LeanExecution,
  originalExpr: LeanValue,
  resultExpr: LeanValue,
  world: LeanValue,
): LeanValue {
  equality = L4_Lean_Expr.f_Lean_Expr_eqv_4957d9ddda(
    runtime,
    resultExpr,
    originalExpr,
