  expr: LeanValue,
  config: LeanValue,
  result: LeanValue,
  methods: LeanValue,
  context: LeanValue,
  state: LeanValue,
  meta: LeanValue,
  metaState: LeanValue,
  core: LeanValue,
  coreState: LeanValue,
  world: LeanValue,
): LeanValue {
  after = leanApply(
    runtime,
    leanField(methods, 1),
    Array[
      leanField(result, 0),
      methods,
      context,
      state,
      meta,
      metaState,
      core,
      coreState,
      world,
    ],
  );
  if (leanTag(after) == LeanTag.EST_Out_error) return after;
  step = leanField(after, 0);
  !world = leanField(after, 1);
  // A missing post-result keeps the incoming proof. Both visit and a supplied
  // continuation compose the proofs before testing whether another pass is due.
  next = leanTag(step) match {
  | LeanTag.Meta_Simp_Step_done -> Some(leanField(step, 0))
  | LeanTag.Meta_Simp_Step_visit -> Some(leanField(step, 0))
  | LeanTag.Meta_Simp_Step_continue ->
    optional = leanField(step, 0);
    leanTag(optional) match {
    | LeanTag.Option_none -> None()
    | LeanTag.Option_some -> Some(leanField(optional, 0))
    | _ -> leanFail("invalid simplifier continuation")
    }
  | _ -> leanFail("invalid simplifier step")
  };
  next match {
  | Some(nextResult) ->
    composed = L4_Lean_Meta_Tactic_Simp_Types.f_Simp_Result_mkEqTrans_aee50f8e97(
      runtime,
      result,
      nextResult,
      meta,
      metaState,
      core,
      coreState,
      world,
    );
    if (leanTag(composed) == LeanTag.EST_Out_error) return composed;
    !result = leanField(composed, 0);
    !world = leanField(composed, 1)
  | None() -> void
  };
  if (leanTag(step) == LeanTag.Meta_Simp_Step_done) {
    f_Meta_Simp_cacheResult_075347cddb(
      runtime,
      expr,
      config,
      result,
      state,
      world,
    )
  } else {
    f_Simp_simpLoop_visitPostContinue_617d44ad14(
      runtime,
      expr,
      config,
      result,
      methods,
      context,
      state,
      meta,
      metaState,
      core,
      coreState,
      world,
    )
  }
}

