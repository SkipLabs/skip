// The original simpLoop policy, expressed with scoped locals instead of its
// 96-slot temporary frame. The retained fallback is a differential oracle.
// Recursion limits precede cache lookup; cached results do not consume steps.
fun f_Meta_Simp_simpLoop_c21384c049(
  runtime: mutable LeanExecution,
  expr: LeanValue,
  methods: LeanValue,
  context: LeanValue,
  state: LeanValue,
