  limit = leanNat(leanField(leanField(core, 0), 3));
  depth = leanNat(leanField(core, 1));
  if (!limit.isZero() && depth == limit) {
    return f_Simp_reduce_spec_0_f30ff62012(runtime, leanField(core, 2), world)
  };
  !core = leanReplaceField(
    leanReplaceField(core, 1, leanBoxNat(depth.add(LeanNat::fromInt(1)))),
    4,
    LeanErased(),
  );
  config = leanField(context, 0);
  current = runtime.readRef(state);
  if (leanIsTrue(leanField(config, 3))) {
    cached = f_Simp_simpLoop_spec_4_cc6ea5540b(
      runtime,
      leanField(current, 0),
      expr,
    );
    if (leanTag(cached) == LeanTag.Option_some) {
      return LeanCtor(LeanTag.EST_Out_ok, Array[leanField(cached, 0), world])
    }
  };
  if (leanNat(leanField(config, 0)) < leanNat(leanField(current, 4))) {
    message = L4_Lean_Message.f_Lean_stringToMessageData_1e55fa4f40(
      runtime,
      LeanText("`simp` failed: maximum number of steps exceeded"),
    );
    return f_Simp_simpLoop_spec_3_1f9b890f90(
      runtime,
      message,
      meta,
      metaState,
      core,
      coreState,
      world,
    )
  };
  checked = L4_Lean_CoreM.f_Lean_Core_checkSystem_ccc29ea7a7(
    runtime,
    LeanText("simp"),
    core,
    coreState,
    world,
  );
  if (leanTag(checked) == LeanTag.EST_Out_error) return checked;
  !world = leanField(checked, 1);
  // Read again after checkSystem, matching the original take/update/put order.
  !current = runtime.readRef(state);
  steps = leanNat(leanField(current, 4)).add(LeanNat::fromInt(1));
  runtime.writeRef(
    state,
    Some(leanReplaceField(current, 4, leanBoxNat(steps))),
  );
  before = leanApply(
    runtime,
    leanField(methods, 0),
    Array[
      expr,
      methods,
      context,
      state,
      meta,
      metaState,
      core,
      coreState,
      world,
    ],
  );
  if (leanTag(before) == LeanTag.EST_Out_error) return before;
  step = leanField(before, 0);
  !world = leanField(before, 1);
  leanTag(step) match {
  | LeanTag.Meta_Simp_Step_done ->
    f_Meta_Simp_cacheResult_075347cddb(
      runtime,
      expr,
      config,
      leanField(step, 0),
      state,
      world,
    )
  | LeanTag.Meta_Simp_Step_visit ->
    result = leanField(step, 0);
    visited = f_Meta_Simp_simpLoop_c21384c049(
      runtime,
      leanField(result, 0),
      methods,
      context,
      state,
      meta,
      metaState,
      core,
      coreState,
      world,
    );
    if (leanTag(visited) == LeanTag.EST_Out_error) return visited;
    composed = L4_Lean_Meta_Tactic_Simp_Types.f_Simp_Result_mkEqTrans_aee50f8e97(
      runtime,
      result,
      leanField(visited, 0),
      meta,
      metaState,
      core,
      coreState,
      leanField(visited, 1),
    );
    if (leanTag(composed) == LeanTag.EST_Out_error) return composed;
    f_Meta_Simp_cacheResult_075347cddb(
      runtime,
      expr,
      config,
      leanField(composed, 0),
      state,
      leanField(composed, 1),
    )
  | LeanTag.Meta_Simp_Step_continue ->
    optional = leanField(step, 0);
    result = leanTag(optional) match {
    | LeanTag.Option_none ->
      LeanCtor(
        LeanTag.Meta_Simp_Result_mk,
        Array[expr, LeanCtor(LeanTag.Option_none, Array[]), leanBool(true)],
      )
    | LeanTag.Option_some -> leanField(optional, 0)
    | _ -> leanFail("invalid simplifier continuation")
    };
    f_Simp_simpLoop_visitPreContinue_385c1aaa86(
      runtime,
      expr,
      config,
      result,
      methods,
      context,
      state,
      meta,
      metaState,
      core,
      coreState,
      world,
    )
