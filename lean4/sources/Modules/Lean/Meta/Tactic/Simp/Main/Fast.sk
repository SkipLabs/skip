}

// Simplifier continuations preserve callback, proof-composition and state order.
// Trace-enabled execution delegates to the retained original implementation.
fun f_Meta_Simp_cacheResult_075347cddb(
  runtime: mutable LeanExecution,
  expr: LeanValue,
  config: LeanValue,
  result: LeanValue,
  state: LeanValue,
  world: LeanValue,
): LeanValue {
  if (leanIsTrue(leanField(config, 3)) && leanIsTrue(leanField(result, 2))) {
    current = runtime.readRef(state);
    cache = f_Simp_cacheResult_spec_0_8ef765dbbe(
      runtime,
      leanField(current, 0),
      expr,
      result,
    );
    runtime.writeRef(state, Some(leanReplaceField(current, 0, cache)))
  };
  LeanCtor(LeanTag.EST_Out_ok, Array[result, world])
}

fun f_Simp_simpLoop_visitPostContinue_617d44ad14(
  runtime: mutable LeanExecution,
  expr: LeanValue,
  config: LeanValue,
  result: LeanValue,
  methods: LeanValue,
  context: LeanValue,
  state: LeanValue,
