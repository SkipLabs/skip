      runtime,
      leanField(result, 0),
      methods,
      context,
      state,
      meta,
      metaState,
      core,
      coreState,
      world,
    );
    if (leanTag(visited) == LeanTag.EST_Out_error) return visited;
    composed = L4_Lean_Meta_Tactic_Simp_Types.f_Simp_Result_mkEqTrans_aee50f8e97(
      runtime,
      result,
      leanField(visited, 0),
      meta,
      metaState,
      core,
      coreState,
