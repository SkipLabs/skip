        | LeanTag.ForInStep_done ->
          _frame.set(46, leanField(_frame[42], 0));
          _frame.set(48, LeanCtor(LeanTag.Option_some, Array[_frame[46]]));
          _frame.set(
            49,
            LeanCtor(LeanTag.Prod_mk, Array[_frame[48], _frame[19]]),
          );
          _frame.set(
            50,
            LeanCtor(LeanTag.EST_Out_ok, Array[_frame[49], _frame[43]]),
          );
          return _frame[50]
        | LeanTag.ForInStep_yield ->
          _frame.set(47, leanField(_frame[42], 0));
          _jump0 = _frame[47];
          _jump1 = _frame[43];
          _frame.set(25, _jump0);
          _frame.set(26, _jump1);
          !pc = 1;
          void
        | _ -> return leanFail("non-exhaustive Lean case")
        }
      | LeanTag.EST_Out_error ->
        _frame.set(44, leanField(_frame[41], 0));
        _frame.set(45, leanField(_frame[41], 1));
        _frame.set(
          51,
          LeanCtor(
            LeanTag.EST_Out_error,
            Array[_frame[44], _frame[45]],
          ),
        );
        return _frame[51]
      | _ -> return leanFail("non-exhaustive Lean case")
      }
    | _ -> return leanFail("invalid join point")
    }
  }
}

module end;
