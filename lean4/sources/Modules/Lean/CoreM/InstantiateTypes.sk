    | LeanTag.Bool_false -> void
    | _ -> return leanFail("non-exhaustive Lean case")
    }
  | _ -> void
  };
  instantiated = L4_Lean_Environment.f_Lean_ConstantVal_instantiateTypeLevelParams_70d6d020df(
    runtime,
