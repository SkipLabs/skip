  );
  if (leanTag(read) != LeanTag.ST_Out_mk) {
    return leanFail("non-exhaustive Lean case")
  };
  state = leanField(read, 0);
  readWorld = leanField(read, 1);
  if (leanTag(state) != LeanTag.Core_State_mk) {
    return leanFail("non-exhaustive Lean case")
  };
  cache = leanField(state, 5);
  if (leanTag(cache) != LeanTag.Core_Cache_mk) {
    return leanFail("non-exhaustive Lean case")
  };
  if (leanTag(constant) != LeanTag.ConstantVal_mk) {
