// "_private.Lean.Elab.Quotation.Precheck.0.Lean.Elab.Term.Quotation.precheckAttribute._regBuiltin.Lean.Elab.Term.Quotation.precheckAttribute.docString_1._closed_0"
fun f_precheckAttribute_docString_1_closed_0_5a2b842068(): LeanValue {
  LeanText(
    "Registers a double backtick syntax quotation pre-check.\n\n`@[quot_precheck k]` registers a declaration of type `Lean.Elab.Term.Quotation.Precheck` for the\nsyntax node kind `k`. It should implement eager name analysis on the passed syntax by throwing an\nexception on unbound identifiers, and calling `precheck` recursively on nested terms, potentially\nwith an extended local context (`withNewLocal`). Macros without registered precheck hook are\nunfolded, and identifier-less syntax is ultimately assumed to be well-formed.",
  )
}
