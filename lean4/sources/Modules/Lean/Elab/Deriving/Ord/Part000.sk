fun f_Ord_hygCtx_hyg_3c5947bb90(_runtime: mutable LeanExecution): LeanValue {
  LeanText(
    "If the inductive data type has this many or more constructors, use a different implementation for implementing `Ord` that avoids the quadratic code size produced by the default implementation.\n\nThe alternative construction compiles to less efficient code in some cases, so by default it is only used for inductive types with 10 or more constructors.",
  )
}
