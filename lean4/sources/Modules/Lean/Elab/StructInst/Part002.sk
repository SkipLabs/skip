fun f_expandStructInstFields_docString_3_closed_0_73ca009dc6(): LeanValue {
  LeanText(
    "Expands fields.\n* Abbreviations. Example: `{ x }` expands to `{ x := x }`.\n* Equations. Example: `{ f | 0 => 0 | n + 1 => n }` expands to `{ f := fun x => match x with | 0 => 0 | n + 1 => n }`.\n* Binders and types. Example: `{ f n : Nat := n + 1 }` expands to `{ f := fun n => (n + 1 : Nat) }`.",
  )
}
