    LeanText("Elab"),
    LeanText("Tactic"),
    LeanText("Do"),
    LeanText("expandDefContract"),
  );
  _x_8_7: LeanValue = LeanText(
    "Expand a `def` carrying `given`/`requires`/`ensures`/`throws` clauses into the plain `def`\nplus a spec theorem `@[spec] theorem f.spec : ∀ xs, ⦃P⦄ f args ⦃fun b => Q; E⦄` proved by\n`vcgen`. A `where finally | spec => steps` section supplies `grind`-mode steps for the\nverification conditions `finish` leaves open.",
  );
  L4_Lean_DocString_Extension.f_Lean_addBuiltinDocString_e430758a4e(
    _runtime,
    _x_7_6,
    _x_8_7,
    _a_1_0,
  )
