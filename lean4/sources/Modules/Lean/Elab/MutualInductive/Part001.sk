fun f_Command_inferResultingUniverse_closed_16_8df07f0da1(): LeanValue {
  LeanText(
    "\nFor example, if the resulting universe is of the form `Sort (?r + 1)` and a constructor field is in universe `Sort u`, the constraint `u ≤ ?r + 1` leads to the unnecessarily high resulting universe `Sort (u + 1)`. Using `Sort (max 1 u)` avoids this universe bump, if using it is possible.",
  )
}
