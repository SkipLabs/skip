    _lhs_4_5: LeanValue = leanField(_e_1_1, 0);
    _rhs_5_6: LeanValue = leanField(_e_1_1, 1);
    leanApply(_runtime, _h_2_3, Array[_lhs_4_5, _rhs_5_6])
  | _ -> leanFail("non-exhaustive Lean case")
  }
}

module end;
