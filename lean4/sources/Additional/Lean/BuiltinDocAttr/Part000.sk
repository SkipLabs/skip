fun f_BuiltinDocAttr_hygCtx_hyg_bf4a25ebdd(): LeanValue {
  LeanText(
    "Makes the documentation and location of a declaration available as a builtin.\n\nThis allows the documentation of core Lean features to be visible without importing the file they\nare defined in. This is only useful during bootstrapping and should not be used outside of\nthe Lean source code.",
  )
}
