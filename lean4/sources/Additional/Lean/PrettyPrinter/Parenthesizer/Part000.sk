// "_private.Lean.PrettyPrinter.Parenthesizer.0.Lean.PrettyPrinter.combinatorParenthesizerAttribute._regBuiltin.Lean.PrettyPrinter.combinatorParenthesizerAttribute.docString_1._closed_2"
fun f_combinatorParenthesizerAttribute_docString_1_closed_2_b6de4a15d2(): LeanValue {
  LeanText(
    "Registers a parenthesizer for a parser combinator.\n\n`@[combinator_parenthesizer c, expose]` registers a declaration of type `Lean.PrettyPrinter.Parenthesizer`\nfor the `Parser` declaration `c`. Note that, unlike with `@[parenthesizer]`, this is not a node kind\nsince combinators usually do not introduce their own node kinds. The tagged declaration may\noptionally accept parameters corresponding to (a prefix of) those of `c`, where `Parser` is\nreplaced with `Parenthesizer` in the parameter types.",
  )
}
