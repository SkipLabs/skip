// "_private.Lean.DocString.Syntax.0.Lean.Doc.Parser.Block.command._regBuiltin.Lean.Doc.Parser.Block.command.docString_1._closed_0"
fun f_command_docString_1_closed_0_2480237433(
  _runtime: mutable LeanExecution,
): LeanValue {
  LeanText(
    "A block-level command, which invokes an extension during documentation processing.\n\nThe `NAME` is an identifier that determines which command is being used, akin to a function name.\nEach of the `ARGS` may have the following forms:\n* A value, which is a string literal, natural number, or identifier\n* A named argument, of the form `(NAME := VALUE)`\n* A flag, of the form `+NAME` or `-NAME`",
  )
}

