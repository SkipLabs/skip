  _runtime: mutable LeanExecution,
): LeanValue {
  LeanText(
    "Bold emphasis.\n\nA single `*` suffices to make text bold. Use `_` for emphasis.\n\nBold text may be nested by using longer sequences of `*` for the outer delimiters.",
  )
}
