// "_private.Lean.Parser.Term.0.Lean.Parser.Term.structInst._regBuiltin.Lean.Parser.Term.structInst.docString_3._closed_0"
fun f_structInst_docString_3_closed_0_40f1fdd39d(): LeanValue {
  LeanText(
    "Structure instance. `{ x := e, ... }` assigns `e` to field `x`, which may be\ninherited. If `e` is itself a variable called `x`, it can be elided:\n`fun y => { x := 1, y }`.\nA *structure update* of an existing value can be given via `with`:\n`{ point with x := 1 }`.\nThe structure type can be specified if not inferable:\n`{ x := 1, y := 2 : Point }`.",
  )
}
