// "_private.Lean.Parser.Term.Basic.0.Lean.Parser.Term.implicitBinder._regBuiltin.Lean.Parser.Term.implicitBinder.docString_1._closed_0"
fun f_implicitBinder_docString_1_closed_0_219e92daaa(): LeanValue {
  LeanText(
    "Implicit binder, like `{x y : A}` or `{x y}`.\nIn regular applications, whenever all parameters before it have been specified,\nthen a `_` placeholder is automatically inserted for this parameter.\nImplicit parameters should be able to be determined from the other arguments and the return type\nby unification.\n\nIn `@` explicit mode, implicit binders behave like explicit binders.",
  )
}
