// "_private.Lean.Parser.Term.Basic.0.Lean.Parser.Term.bracketedBinder._regBuiltin.Lean.Parser.Term.bracketedBinder.docString_1._closed_0"
fun f_bracketedBinder_docString_1_closed_0_507f056ecb(): LeanValue {
  LeanText(
    "A `bracketedBinder` matches any kind of binder group that uses some kind of brackets:\n* An explicit binder like `(x y : A)`\n* An implicit binder like `{x y : A}`\n* A strict implicit binder, `⦃y z : A⦄` or its ASCII alternative `{{y z : A}}`\n* An instance binder `[A]` or `[x : A]` (multiple variables are not allowed here)",
  )
}
