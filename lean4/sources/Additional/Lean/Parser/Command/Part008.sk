// "_private.Lean.Parser.Command.0.Lean.Parser.Command.withWeakNamespace._regBuiltin.Lean.Parser.Command.withWeakNamespace.docString_3._closed_0"
fun f_withWeakNamespace_docString_3_closed_0_7a5feb31f3(
  _runtime: mutable LeanExecution,
): LeanValue {
  LeanText(
    "`with_weak_namespace <id> <cmd>` changes the current namespace to `<id>` for the duration of\nexecuting command `<cmd>`, without causing scoped things to go out of scope.\n\nThis is in contrast to `namespace <id>` which pushes a new scope and deactivates scoped entries\nfrom the previous namespace. `with_weak_namespace` modifies the existing scope's namespace,\nso scoped extensions remain active.\n\nThis is primarily useful for defining syntax extensions that should be scoped to a different\nnamespace than the current one.",
  )
}
