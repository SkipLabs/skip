// "_private.Lean.Parser.Basic.0.Lean.Parser.orelse._regBuiltin.Lean.Parser.orelse.docString_1._closed_2"
fun f_orelse_docString_1_closed_2_91c7bad0e4(
  _runtime: mutable LeanExecution,
): LeanValue {
  LeanText(
    "Run `p`, falling back to `q` if `p` failed without consuming any input.\n\nNOTE: In order for the pretty printer to retrace an `orelse`, `p` must be a call to `node` or some other parser\nproducing a single node kind. Nested `orelse` calls are flattened for this, i.e. `(node k1 p1 <|> node k2 p2) <|> ...`\nis fine as well.",
  )
}
