fun f_checkColEq_docString_1_closed_2_f473c8b2da(): LeanValue {
  LeanText(
    "The `colEq` parser ensures that the next token starts at exactly the column of the saved\nposition (see `withPosition`). This can be used to do whitespace sensitive syntax like\na `by` block or `do` block, where all the lines have to line up.\n\nThis parser has arity 0 - it does not capture anything.",
  )
}
