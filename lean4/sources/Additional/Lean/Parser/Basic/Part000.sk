// "_private.Lean.Parser.Basic.0.Lean.Parser.withAntiquotAcceptLhs._regBuiltin.Lean.Parser.withAntiquotAcceptLhs.docString_1._closed_2"
fun f_withAntiquotAcceptLhs_docString_1_closed_2_af654908c4(): LeanValue {
  LeanText(
    "Like `withAntiquot`, but uses `OrElseOnAntiquotBehavior.acceptLhs` instead of `.takeLongest`.\nThis means that when the antiquotation parser `antiquotP` succeeds, `p` is not tried.\nThis is useful when `p` has side effects on the parser stack that would not be undone by\nbacktracking.",
  )
}
