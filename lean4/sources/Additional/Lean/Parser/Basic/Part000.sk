// "_private.Lean.Parser.Basic.0.Lean.Parser.withForbidden._regBuiltin.Lean.Parser.withForbidden.docString_1._closed_2"
fun f_withForbidden_docString_1_closed_2_76208390f1(
  _runtime: mutable LeanExecution,
): LeanValue {
  LeanText(
    "`withForbidden tk p` runs `p` with `tk` as a \"forbidden token\". This means that if the token\nappears anywhere in `p` (unless it is nested in `withoutForbidden`), parsing will immediately\nstop there, making `tk` effectively a lowest-precedence operator. This is used for parsers like\n`for x in arr do ...`: `arr` is parsed as `withForbidden \"do\" term` because otherwise `arr do ...`\nwould be treated as an application.\n\nThis parser has the same arity as `p` - it just forwards the results of `p`.",
  )
}
