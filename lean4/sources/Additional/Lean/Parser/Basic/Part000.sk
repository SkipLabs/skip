// "_private.Lean.Parser.Basic.0.Lean.Parser.withoutPosition._regBuiltin.Lean.Parser.withoutPosition.docString_1._closed_2"
fun f_withoutPosition_docString_1_closed_2_00be445bfa(): LeanValue {
  LeanText(
    "`withoutPosition(p)` runs `p` without the saved position, meaning that position-checking\nparsers like `colGt` will have no effect. This is usually used by bracketing constructs like\n`(...)` so that the user can locally override whitespace sensitivity.\n\nThis parser has the same arity as `p` - it just forwards the results of `p`.",
  )
}
