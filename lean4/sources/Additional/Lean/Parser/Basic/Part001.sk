// "_private.Lean.Parser.Basic.0.Lean.Parser.withForbiddens._regBuiltin.Lean.Parser.withForbiddens.docString_1._closed_2"
fun f_withForbiddens_docString_1_closed_2_5129743308(): LeanValue {
  LeanText(
    "`withForbiddens(tks, p)` runs `p` with every token in `tks` treated as forbidden, i.e. the\ncombined effect of nesting `withForbidden` for each token (see `withForbidden`). The tokens in\n`tks` must be distinct.\n\nThis parser has the same arity as `p` - it just forwards the results of `p`.",
  )
}
