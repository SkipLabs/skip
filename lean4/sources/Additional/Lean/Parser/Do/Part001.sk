fun f_doFor_docString_3_closed_0_af58a2f1b6(
  _runtime: mutable LeanExecution,
): LeanValue {
  LeanText(
    "`for x in e do s` iterates over `e` assuming `e`'s type has an instance of the `ForIn` typeclass.\n`break` and `continue` are supported inside `for` loops.\n`for x in e, x2 in e2, ... do s` iterates over the given collections in parallel,\nuntil at least one of them is exhausted.\nThe types of `e2` etc. must implement the `Std.ToStream` typeclass.",
  )
}
