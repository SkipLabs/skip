// "_private.Lean.Parser.Attr.0.Lean.Parser.Attr.tactic_name._regBuiltin.Lean.Parser.Attr.tactic_name.docString_3._closed_0"
fun f_tactic_name_docString_3_closed_0_b5dd24f6e7(
  _runtime: mutable LeanExecution,
): LeanValue {
  LeanText(
    "Sets the tactic's name.\n\nOrdinarily, tactic names are automatically set to the first token in the tactic's parser. If this\nprocess fails, or if the tactic's name should be multiple tokens (e.g. `let rec`), then this\nattribute can be used to provide a name.\n\nThe tactic's name is used in documentation as well as in completion. Thus, the name should be a\nvalid prefix of the tactic's syntax.",
  )
}
