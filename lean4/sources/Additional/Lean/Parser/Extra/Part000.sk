// "_private.Lean.Parser.Extra.0.Lean.Parser.strLit._regBuiltin.Lean.Parser.strLit.docString_1._closed_2"
fun f_strLit_docString_1_closed_2_5d90e5b9f3(): LeanValue {
  LeanText(
    "The parser `str` parses a string literal, such as `\"foo\"` or `\"\\r\\n\"`. Strings can contain\nC-style escapes like `\\n`, `\\\"`, `\\x00` or `\\u2665`, as well as literal unicode characters like `∈`.\nNewlines in a string are interpreted literally.\n\nThis parser has arity 1: it produces a `strLitKind` node containing an atom with the raw\nliteral (including the quote marks and without interpreting the escapes).\nYou can use `TSyntax.getString` to decode the string from the resulting syntax object.",
  )
}
