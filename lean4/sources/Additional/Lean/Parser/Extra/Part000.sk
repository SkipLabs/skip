// "_private.Lean.Parser.Extra.0.Lean.Parser.many._regBuiltin.Lean.Parser.many.docString_1._closed_1"
fun f_many_docString_1_closed_1_37c22cd406(): LeanValue {
  LeanText(
    "The parser `many(p)`, or `p*`, repeats `p` until it fails, and returns the list of results.\n\nThe argument `p` is \"auto-grouped\", meaning that if the arity is greater than 1 it will be\nautomatically replaced by `group(p)` to ensure that it produces exactly 1 value.\n\nThis parser has arity 1: it produces a `nullKind` node containing one argument for each\ninvocation of `p` (or `group(p)`).",
  )
}
