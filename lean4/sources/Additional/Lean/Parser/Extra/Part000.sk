// "_private.Lean.Parser.Extra.0.Lean.Parser.many1Indent._regBuiltin.Lean.Parser.many1Indent.docString_1._closed_2"
fun f_many1Indent_docString_1_closed_2_ece43dbc5a(): LeanValue {
  LeanText(
    "The parser `many1Indent(p)` is equivalent to `withPosition((colGe p)+)`. This has the effect of\nparsing one or more occurrences of `p`, where each subsequent `p` parse needs to be indented\nthe same or more than the first parse.\n\nThis parser has arity 1, and returns a list of the results from `p`.\n`p` is \"auto-grouped\" if it is not arity 1.",
  )
}
