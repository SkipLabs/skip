// One-shot compilation owns one live phase at a time. Frontend collections
// are temporary; the native backend passes ordinary values between phases.
module alias O = OuterIstToIR;
module ReleaseBuild;

// The pipeline phases, in execution order. The incremental driver (compile.sk)
// runs the same phases as graph-driven context steps; this driver runs them as
// disposable direct calls, reclaiming the region between phases. Declare new
// phases here so both modes share one list.
class Phase(name: String, run: PhaseState ~> ?PhaseState) {}

// Continuation state handed from one phase to the next. Only the fields
// relevant to the current phase are set.
class PhaseState(
  phaseIndex: Int,
  config: Config.Config,
  debugStore: Bool,
  context: ?SKStore.Context,
  converter: ?O.Converter,
  roots: ?O.RootsIR,
  specialized: ?O.SpecializerState,
  exports: Array<String>,
  env: ?GlobalEnv,
  optPhase: Int,
  definitions: ?Array<AsmOutput.AsmDef>,
  positions: ?SourcePositions.Table,
  inputs: ?Array<String>,
) {
  static fun start(config: Config.Config, debugStore: Bool): PhaseState {
    PhaseState(
      0,
      config,
      debugStore,
      None(),
      None(),
      None(),
      None(),
      Array[],
      None(),
      0,
      None(),
      None(),
      None(),
    )
  }
}

// Copy values, not the producing arrows, their old versions or dependencies.
fun snapshot<K: SKStore.Key, V: SKStore.File>(
  from: mutable SKStore.Context,
  into: mutable SKStore.Context,
  input: SKStore.EHandle<K, V>,
): SKStore.EHandle<K, V> {
  output = into.mkdir(input.keyType, input.type, input.dirName);
  for ((key, values) in input.items(from)) {
    output.writeArray(into, key, values.collect(Array))
  };
  output
}

fun throwErrors(context: mutable SKStore.Context): void {
  context.getGlobal("ERRORS") match {
  | Some(file) ->
    errors = SkipError.ErrorsFile::type(file).value;
    if (!errors.isEmpty()) {
      throw SkipError.CompileFailureException{
        message => SkipError.errorsToString(
          errors.reversed().map(x -> x.errors).flatten().collect(Vector),
          source -> FileCache.fileDir.unsafeGetArray(context, source)[0].value,
        ),
      }
    }
  | None() -> void
  }
}

// Batch cheap frontend arrows, checkpointing after a substantial allocation
// increase. Drain the final typing arrow so the next state can discard the
// frontend graph instead of collecting another complete retained version.
fun advance(context: mutable SKStore.Context): Bool {
  limit = SKStore.obstackAllocatedBytes() + 256 * 1024 * 1024;
  context
    .updateUntilBoundary(
      _ ~> false,
      dir ~>
        dir != SkipTyping.dirName && SKStore.obstackAllocatedBytes() >= limit
      ,
    )
    .isNone()
}

const phases: Array<Phase> = Array[
  Phase("read_files", state ~> {
    config = state.config;
    ensureCompatibleLLVMVersion();
    if (!Array["sklib", "llvm-ir", "link", "cdylib"].contains(config.emit)) {
      invariant_violation("Unsupported value for `--emit`: " + config.emit)
    };
    if (config.input_files.isEmpty() && config.dependencies.isEmpty()) {
      print_error("fatal error: no input files\n");
      skipExit(4)
    };
    context = SKStore.Context::mcreate{};
    context.!debugMode = state.debugStore;
    _ = context.mkdir(
      FileCache.InputSource::keyType,
      SKStore.StringFile::type,
      FileCache.fileDirName,
      Array[],
      true,
    );
    _ = context.mkdir(
      FileCache.InputPackageName::keyType,
      FileCache.InputPackageFiles::type,
      FileCache.packageDirName,
      Array[],
      true,
    );
    FileCache.scaffoldPackageEnvDirs(context);
    _ = SkipMain.type_program(context);
    runCompilerPhase("release/read_files", () -> {
      FileCache.writeFiles(
        context,
        config.input_files,
        config.dependencies,
        config.lib_name,
        (base, path) ~> {
          full = Path.join(base, path);
          if (config.canonize_paths) config.cwd.makeRelative(full) else full
        },
      )
    });
    Some(
      state with {
        phaseIndex => 1,
        config => config.backendConfig(),
        context => Some(context.clone()),
      },
    )
  }),
  Phase("frontend", state ~> {
    config = state.config;
    context = state.context.fromSome().mclone();
    finished = runCompilerPhase("release/frontend", () -> advance(context));
    if (!finished) {
      Some(state with {context => Some(context.clone())})
    } else {
      throwErrors(context);
      next = SKStore.Context::mcreate{};
      if (config.emit == "sklib") {
        // Archives contain sources and packaging metadata. No typed tree needs
        // to survive while those sources are encoded and written.
        _ = snapshot(context, next, FileCache.packageDir);
        _ = snapshot(context, next, FileCache.packageEnvAccessDir);
        _ = snapshot(context, next, FileCache.packageEnvDir(config.lib_name));
        Some(state with {phaseIndex => 2, context => Some(next.clone())})
      } else {
        _ = snapshot(context, next, SkipTyping.dir);
        _ = snapshot(context, next, SourcePositions.dir);
        Some(state with {phaseIndex => 3, context => Some(next.clone())})
      }
    }
  }),
  Phase("archive", state ~> {
    compile_sklib(state.context.fromSome().mclone(), state.config);
    None()
  }),
  Phase("outer", state ~> {
    config = state.config;
    context = state.context.fromSome().mclone();
    // Eager maps run while they are registered. Start outer conversion only
    // after the frontend handoff has reclaimed parser and naming state.
    runCompilerPhase("release/outer", () -> {
      _ = SkipMakeOuterIst.program(context, SkipTyping.dir);
      context.update()
    });
    // Lowering reads typed definitions and source locations, never the parser,
    // namer or type checker's retained versions. Drop that entire graph here.
    next = SKStore.Context::mcreate{};
    defs = snapshot(
      context,
      next,
      SKStore.EHandle(
        SKStore.SID::keyType,
        OuterIst.DefFile::type,
        SKStore.DirName::create("/outerDefs/"),
      ),
    );
    _ = snapshot(context, next, SourcePositions.dir);
    program = OuterIst.Program::create(next, defs);
    funs = program.getFunsProj(next);
    consts = program.getConstsProj(next);
    converter = O.Converter::create(
      next,
      SKStore.DirName::create("/converter/"),
      program,
      false,
    );
    next.update();
    roots = O.prepareCreateIR(
      next,
      funDef ~>
        config.disasmFunctions.contains(funDef.origName) ||
          (config.disasmAnnotated &&
            annotationsContain(funDef.annotations, "@disasm", funDef.getPos())),
      funDef ~>
        AsmOutput.cppIsExported(
          funDef.origName,
          funDef.annotations,
          funDef.getPos(),
          config.exportedAsFunctions,
          config.isWasm(),
        ),
      program,
      converter,
      consts,
      funs,
    );
    exports = if (config.isWasm()) {
      program
        .getFuns(next, funs)
        .filter(f ->
          annotationsContainParam(
            f.annotations,
            "@wasm_export",
            f.getPos(),
          ).isSome() ||
            annotationsContainParam(
              f.annotations,
              "@export",
              f.getPos(),
            ).isSome()
        )
        .map(exportName)
    } else {
      Array[]
    };
    Some(
      state with {
        phaseIndex => 4,
        context => Some(next.clone()),
        converter => Some(converter),
        roots => Some(roots),
        exports => exports,
      },
    )
  }),
  Phase("specialize", state ~> {
    config = state.config;
    context = state.context.fromSome().mclone();
    empty = context.mkdir(
      x ~> x,
      x ~> x,
      SKStore.DirName::create("/specializer/empty/"),
    );
    specializer = runCompilerPhase("release/specialize", () -> {
      sp = O.createSpecializer(
        context,
        config,
        state.converter.fromSome(),
        empty,
      ).mclone(context);
      for (root in state.roots.fromSome().forceCompile) {
        sp.requestFunction(root, Array[], Array[])
      };
      sp.specializePendingFuns();
      sp.toFixed(context);
      sp.chill()
    });
    if (config.stopAfterSpecialization) {
      None()
    } else {
      Some(
        state with {
          phaseIndex => 5,
          context => Some(context.clone()),
          specialized => Some(specializer),
        },
      )
    }
  }),
  Phase("assemble", state ~> {
    config = state.config;
    context = state.context.fromSome().mclone();
    specializer = state.specialized.fromSome().mclone(context);
    specializer.!canCreateNewSClasses = false;
    env = runCompilerPhase("release/assemble", () ->
      O.createIR(
        context,
        config,
        state.roots.fromSome(),
        specializer,
        None(),
        None(),
      )
    );
    // No frontend or specialization cache survives into the optimizer.
    Some(state with {phaseIndex => 6, env => Some(env), optPhase => 0})
  }),
  Phase("optimize", state ~> {
    config = state.config;
    phase = state.optPhase;
    env = state.env.fromSome();
    next = runCompilerPhase("release/optimize-" + phase, () -> {
      if (phase == 1) LowerConst.lowerAllConsts(env, config) else {
        Optimize.optimizeAll(
          SKStore.Context::mcreate{},
          env,
          config,
          config.optConfig.all(),
        )
      }
    });
    if (phase == 2) {
      Some(
        state with {
          phaseIndex => 7,
          env => Some(finishOptimizedFunctions(next, config)),
        },
      )
    } else {
      Some(state with {env => Some(next), optPhase => phase + 1})
    }
  }),
  Phase("lower", state ~> {
    Some(
      state with {
        phaseIndex => 8,
        env => Some(Lower.lowerFunctions(state.env.fromSome(), state.config)),
      },
    )
  }),
  Phase("graph", state ~> {
    config = state.config;
    env = state.env.fromSome();
    defs = runCompilerPhase("native/create_asm_graph", () ->
      AsmOutput.createAsmDefGraph(env, config)
    );
    runCompilerPhase("native/merge_asm_graph", () ->
      AsmOutput.mergeIdenticalAsmDefs(defs, config.debug)
    );
    runCompilerPhase("native/create_asm_symbols", () ->
      AsmOutput.assignFinalSymbols(defs, false)
    );
    Some(
      state with {
        phaseIndex => 9,
        definitions => Some(defs.values().collect(Array)),
        positions => Some(env.sourcePositions),
      },
    )
  }),
  Phase("emit", state ~> {
    config = state.config;
    defs = mutable AsmOutput.AsmDefIDToAsmDef{pos => FileRange.builtin};
    for (def in state.definitions.fromSome()) defs.set(def.id, def);
    if (config.emit == "llvm-ir") {
      compile_llvm_ir(defs, config, state.positions.fromSome());
      None()
    } else {
      inputs = runCompilerPhase("native/write_asm_files", () ->
        AsmOutput.writeNativeOutputFiles(
          defs,
          config,
          state.positions.fromSome(),
        )
      );
      Some(state with {phaseIndex => 10, inputs => Some(inputs)})
    }
  }),
  Phase("link", state ~> {
    config = state.config;
    runCompilerPhase("native/link", () -> {
      getLinkArgs(
        config.output + ".ll",
        config,
        state.exports,
        Some(state.inputs.fromSome()),
      ).each(args -> {
        if (config.no_link) {
          print_string("---LINK_ARGS_BEGIN---");
          args.each(print_string);
          print_string("---LINK_ARGS_END---")
        } else {
          runShell(args, config.verbose)
        }
      })
    });
    None()
  }),
];

fun step(state: PhaseState): ?PhaseState {
  invariant(state.phaseIndex < phases.size(), "Invalid phase index");
  phases[state.phaseIndex].run(state)
}

fun run(config: Config.Config, debugStore: Bool): void {
  try {
    SKStore.withRegionPipeline(PhaseState::start(config, debugStore), step)
  } catch {
  | exn ->
    print_error(exn.getMessage());
    skipExit(2)
  }
}

module end;
