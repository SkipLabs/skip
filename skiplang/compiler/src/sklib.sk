// The Sklib format is a binary format for pre-compiled skip packages. It is a
// simple ranlib archive, containing object files for possible extensions, as
// well as metadata and skip sources (in the `lib.skmeta` file).

module Sklib;

// The two paths produce identical UTF-8 bytes. The experimental path allocates
// the final array once, avoiding an iterator and a growable intermediate vector.
// Keep the control available for matched archive-loading measurements.
private fun metadataText(bytes: readonly Bytes): String {
  data = if (Environ.varOpt("SKC_ARCHIVE_DIRECT_BYTES").isSome()) {
    Array::fillBy(bytes.size(), i -> bytes[i])
  } else {
    bytes.values().collect(Array)
  };
  String::fromUtf8(data)
}

class Metadata{
  name: String,
  target: String,
  hash: String,
  pkg_dir: String,
  sources: Array<(String, Int, String)>,
  env: Array<(String, String)>,
  dependencies: Array<(String, String)>,
  links: Array<String>,
  preambles: Array<String>,
  has_object_code: Bool,
} {
  fun toJSON(): JSON.Object {
    JSON.Object[
      "name" => JSON.String(this.name),
      "target" => JSON.String(this.target),
      "hash" => JSON.String(this.hash),
      "pkg_dir" => JSON.String(this.pkg_dir),
      "sources" => JSON.Array(
        Vector::createFromItems(
          this.sources.map(s -> {
            (path, mtime, contents) = s;
            JSON.Object[
              "path" => JSON.String(path),
              "mtime" => JSON.IntNumber(mtime),
              "contents" => JSON.String(contents),
            ]
          }),
        ),
      ),
      "env" => JSON.Array(
        Vector::createFromItems(
          this.env.map(e ->
            JSON.Array(Vector[JSON.String(e.i0), JSON.String(e.i1)])
          ),
        ),
      ),
      "dependencies" => JSON.Array(
        Vector::createFromItems(
          this.dependencies.map(d ->
            JSON.Object[
              "name" => JSON.String(d.i0),
              "hash" => JSON.String(d.i1),
            ]
          ),
        ),
      ),
      "link" => JSON.Array(
        Vector::createFromItems(this.links.map(s -> JSON.String(s))),
      ),
      "preambles" => JSON.Array(
        Vector::createFromItems(this.preambles.map(s -> JSON.String(s))),
      ),
      "has_object_code" => JSON.Bool(this.has_object_code),
    ]
  }

  fun serialize(
    sourceCache: ?mutable SourceEncodingCache = None(),
  ): readonly Bytes {
    json = this.toJSON();
    sourceCache.each(cache -> {
      !json = json.set(
        "sources",
        JSON.Array(
          Vector::createFromItems(
            this.sources.map(source -> cache.encode(source)),
          ),
        ),
      )
    });
    json.toString().bytes()
  }

  static fun read(bytes: readonly Bytes): Metadata {
    static::readText(metadataText(bytes))
  }

  static fun readText(text: String): Metadata {
    // TODO: Proper reporting of parsing error.
    json = JSON.decode(text).expectObject();
    Metadata{
      name => json["name"].expectString(),
      target => json["target"].expectString(),
      hash => json["hash"].expectString(),
      pkg_dir => json["pkg_dir"].expectString(),
      sources => json["sources"]
        .expectArray()
        .value.map(o -> {
          src = o.expectObject();
          (
            src["path"].expectString(),
            src["mtime"].expectInt(),
            src["contents"].expectString(),
          )
        })
        .collect(Array),
      env => try {
        json["env"]
          .expectArray()
          .value.map(a -> {
            kv = a.expectArray().value;
            (kv[0].expectString(), kv[1].expectString())
          })
          .collect(Array)
      } catch {
      // TODO: Get rid of this once bootstrap is updated.
      | JSON.KeyNotFoundError("env") -> Array[]
      | e -> throw e
      },
      dependencies => json["dependencies"]
        .expectArray()
        .value.map(o -> {
          dep = o.expectObject();
          (dep["name"].expectString(), dep["hash"].expectString())
        })
        .collect(Array),
      links => json["link"]
        .expectArray()
        .value.map(s -> s.expectString())
        .collect(Array),
      preambles => json["preambles"]
        .expectArray()
        .value.map(s -> s.expectString())
        .collect(Array),
      has_object_code => json["has_object_code"].expectBool(),
    };
  }
}

private class CachedMetadata(text: String, value: Metadata)
private class MetadataCacheFile(
  entries: Map<String, CachedMetadata>,
) extends SKStore.File
private const metadataCacheKey: String = "COMPILER_ARCHIVE_METADATA_CACHE";

// The raw metadata member is read on every invocation. Exact content equality,
// rather than file timestamps or the archive's claimed hash, permits reusing its
// decoded sources. A replacement with preserved timestamps is still observed.
mutable class MetadataCache(
  previous: Map<String, CachedMetadata>,
  used: mutable Map<String, CachedMetadata> = mutable Map[],
) {
  mutable fun decode(path: String, bytes: readonly Bytes): Metadata {
    text = metadataText(bytes);
    entry = this.previous.maybeGet(path) match {
    | Some(prior) if (prior.text == text) ->
      if (Environ.varOpt("SKC_TRACE_ARCHIVE_CACHE").isSome()) {
        print_error(`ARCHIVE_METADATA_HIT: ${path}\n`)
      };
      prior
    | _ ->
      if (Environ.varOpt("SKC_TRACE_ARCHIVE_CACHE").isSome()) {
        print_error(`ARCHIVE_METADATA_MISS: ${path}\n`)
      };
      CachedMetadata(text, Metadata::readText(text))
    };
    this.used.set(path, entry);
    entry.value
  }
}

// Only archives consulted by this invocation survive. The cache has no branch
// history, and an unsuccessful resolver does not commit a partially read set.
fun withMetadataCache<T>(
  context: mutable SKStore.Context,
  read: mutable MetadataCache ~> T,
): T {
  previous = context.getPersistent(metadataCacheKey) match {
  | Some(file) -> MetadataCacheFile::type(file).entries
  | None() -> Map[]
  };
  cache = mutable MetadataCache(previous);
  result = read(cache);
  context.setPersistent(
    metadataCacheKey,
    MetadataCacheFile(cache.used.chill()),
  );
  result
}

private fun decodeMetadata(
  path: String,
  bytes: readonly Bytes,
  cache: ?mutable MetadataCache,
): Metadata {
  cache match {
  | Some(reader) -> reader.decode(path, bytes)
  | None() -> Metadata::read(bytes)
  }
}

private class EncodedSource(source: (String, Int, String), text: String)
private class SourceEncodingCacheFile(
  entries: Map<String, EncodedSource>,
) extends SKStore.File
private const sourceEncodingCacheKey: String = "COMPILER_ARCHIVE_SOURCE_ENCODING";

// The fragment is produced by the ordinary JSON writer, including escaping.
// It is used only by the compact archive serializer, never by JSON consumers.
private class EncodedSourceJSON(text: String) extends JSON.Value {
  fun writeToStream(
    write: String -> void,
    _space: Int = -1,
    _depth: Int = 0,
  ): void {
    write(this.text)
  }
}

mutable class SourceEncodingCache(
  previous: Map<String, EncodedSource>,
  used: mutable Map<String, EncodedSource> = mutable Map[],
) {
  mutable fun encode(source: (String, Int, String)): JSON.Value {
    entry = this.previous.maybeGet(source.i0) match {
    | Some(prior) if (prior.source == source) ->
      if (Environ.varOpt("SKC_TRACE_ARCHIVE_CACHE").isSome()) {
        print_error(`ARCHIVE_ENCODING_HIT: ${source.i0}\n`)
      };
      prior
    | _ ->
      if (Environ.varOpt("SKC_TRACE_ARCHIVE_CACHE").isSome()) {
        print_error(`ARCHIVE_ENCODING_MISS: ${source.i0}\n`)
      };
      (path, mtime, contents) = source;
      EncodedSource(
        source,
        JSON.Object[
          "path" => JSON.String(path),
          "mtime" => JSON.IntNumber(mtime),
          "contents" => JSON.String(contents),
        ].toString(),
      )
    };
    this.used.set(source.i0, entry);
    EncodedSourceJSON(entry.text)
  }
}

fun withSourceEncodingCache<T>(
  context: mutable SKStore.Context,
  write: mutable SourceEncodingCache -> T,
): T {
  previous = context.getPersistent(sourceEncodingCacheKey) match {
  | Some(file) -> SourceEncodingCacheFile::type(file).entries
  | None() -> Map[]
  };
  cache = mutable SourceEncodingCache(previous);
  result = write(cache);
  context.setPersistent(
    sourceEncodingCacheKey,
    SourceEncodingCacheFile(cache.used.chill()),
  );
  result
}

const kMetadataFile: String = "lib.skmeta";
const kIndexFile: String = "lib.skindex";

// Search-path discovery needs identity, not every package's embedded sources.
// Old readers ignore this optional member; new readers still accept archives
// without it. A selected archive's full metadata must agree with its index.
class ArchiveIndex(name: String, target: String, hash: String) uses Equality {
  static fun fromMetadata(metadata: Metadata): this {
    static(metadata.name, metadata.target, metadata.hash)
  }

  fun serialize(): readonly Bytes {
    JSON.Object[
      "version" => JSON.IntNumber(1),
      "name" => JSON.String(this.name),
      "target" => JSON.String(this.target),
      "hash" => JSON.String(this.hash),
    ]
      .toString()
      .bytes()
  }

  static fun read(bytes: readonly Bytes): ?this {
    json = JSON.decode(metadataText(bytes)).expectObject();
    if (json["version"].expectInt() != 1) return None();
    Some(
      static(
        json["name"].expectString(),
        json["target"].expectString(),
        json["hash"].expectString(),
      ),
    )
  }
}

class ArchiveCandidate(path: String, index: ArchiveIndex, metadata: ?Metadata) {
  static fun read(
    path: String,
    cache: ?mutable MetadataCache = None(),
  ): Result<this, ARParser.Error> {
    file = IO.File::open(path, IO.OpenOptions{read => true});
    ar = ARParser.Archive::read(file) match {
    | Success(ar) -> ar
    | Failure(err) ->
      file.close();
      return Failure(err)
    };
    indexBytes = ar[kIndexFile] match {
    | Success(bytes) -> bytes
    | Failure(err) ->
      file.close();
      return Failure(err)
    };
    indexOpt = indexBytes.flatMap(ArchiveIndex::read);
    indexOpt match {
    | Some(index) ->
      file.close();
      Success(static(path, index, None()))
    | None() ->
      bytes = ar[kMetadataFile] match {
      | Success(Some(bytes)) -> bytes
      | Success(None()) -> "".bytes()
      | Failure(err) ->
        file.close();
        return Failure(err)
      };
      metadata = decodeMetadata(path, bytes, cache);
      file.close();
      Success(
        static(path, ArchiveIndex::fromMetadata(metadata), Some(metadata)),
      )
    }
  }

  fun load(cache: ?mutable MetadataCache = None()): Metadata {
    metadata = this.metadata match {
    | Some(metadata) -> metadata
    | None() ->
      read_metadata(this.path, cache) match {
      | Success(metadata) -> metadata
      | Failure(err) ->
        print_error(`Failed to read metadata for ${this.path}: ${err}`);
        skipExit(3)
      }
    };
    if (ArchiveIndex::fromMetadata(metadata) != this.index) {
      print_error(`Archive index disagrees with metadata for ${this.path}`);
      skipExit(3)
    };
    metadata
  }
}

fun read_metadata(
  path: String,
  cache: ?mutable MetadataCache = None(),
): Result<Metadata, ARParser.Error> {
  file = IO.File::open(path, IO.OpenOptions{read => true});
  ar = ARParser.Archive::read(file) match {
  | Success(ar) -> ar
  | Failure(err) -> return Failure(err)
  };
  res = decodeMetadata(
    path,
    (ar[kMetadataFile] match {
    | Success(bytes) -> bytes
    | Failure(err) -> return Failure(err)
    } match {
    | Some(bytes) -> bytes
    | None() -> "".bytes()
    // FIXME: Properly fail.
    }),
    cache,
  );
  file.close();
  Success(res)
}

mutable class .SklibBuilder(
  name: String,
  target: String,
  pkg_dir: String,
  env: mutable Vector<(String, String)> = mutable Vector[],
  sources: mutable Vector<(String, Int, String)> = mutable Vector[],
  dependencies: mutable Vector<(String, String)> = mutable Vector[],
  links: mutable Vector<String> = mutable Vector[],
  preambles: mutable Vector<String> = mutable Vector[],
  files: mutable Vector<(String, readonly Bytes)> = mutable Vector[],
) {
  mutable fun add_dependency(name: String, metadata: Metadata): void {
    this.dependencies.push((name, metadata.hash.toString()))
  }

  mutable fun add_preamble(path: String): void {
    this.preambles.push(FileSystem.readTextFile(path))
  }

  mutable fun add_link_arg(arg: String): void {
    this.links.push(arg)
  }

  mutable fun add_static_library(path: String): void {
    lib_file = IO.File::open(path, IO.OpenOptions{read => true});
    lib_ar = ARParser.Archive::read(lib_file) match {
    | Success(v) -> v
    | Failure(err) ->
      print_error(`Failed to read ${path}: ${err}`);
      skipExit(3)
    };
    lib_file_name = Path.basename(path);
    for ((obj_file_header, contents) in lib_ar.items()) {
      if (!obj_file_header.identifier.endsWith(".o")) continue;
      this.files.push(
        (`${lib_file_name}@${obj_file_header.identifier}`, contents),
      )
    };
    lib_file.close()
  }

  mutable fun add_source(path: String): void {
    this.sources.push(
      (
        path,
        FileSystem.getLastModificationTime(path),
        FileSystem.readTextFile(path),
      ),
    )
  }

  mutable fun add_env_var(key: String, value: String): void {
    this.env.push((key, value))
  }

  readonly fun hash(): Int {
    // TODO: Digest everything, including compiler version.
    // The archive's identity depends on source paths and contents, not their
    // modification times: a fresh checkout gives every file a new mtime, and
    // dependents keep this hash in their backend option row, so including it
    // would rerun every dependent's backend with unchanged inputs (#1607).
    // The metadata still records mtimes as the frontend's change hint.
    (
      this.name,
      this.target,
      this.sources.sortedBy(s ~> s.i0).map(s -> (s.i0, s.i2)).collect(Array),
      this.env.sorted(),
      // FIXME: Bytes should implement Hashable. For now, we convert to String.
      this.files.sortedBy(f ~> Path.basename(f.i0)).map(f ->
        (f.i0, f.i1.toString())
      ),
      this.dependencies.sorted().collect(Array),
    ).hash()
  }

  mutable fun write(
    file: mutable IO.File,
    sourceCache: ?mutable SourceEncodingCache = None(),
    // variant: ARParser.Variant = ARParser.VariantGNU(),
  ): Result<void, ARParser.Error> {
    file_names = Array[kIndexFile, kMetadataFile].concat(
      this.files.map(fn -> fn.i0).collect(Array),
    );
    ar = ARParser.Builder::createGNU(file, file_names);
    metadata = Metadata{
      name => this.name,
      target => this.target,
      hash => this.hash().toString(),
      pkg_dir => this.pkg_dir,
      sources => this.sources.collect(Array),
      env => this.env.collect(Array),
      dependencies => this.dependencies.collect(Array),
      links => this.links.collect(Array),
      preambles => this.preambles.collect(Array),
      has_object_code => file_names.any(fn -> fn.endsWith(".o")),
    };
    ar.append_id(
      kIndexFile,
      ArchiveIndex::fromMetadata(metadata).serialize(),
    ) match {
    | Success _ -> void
    | Failure(err) -> return Failure(err)
    };
    ar.append_id(kMetadataFile, metadata.serialize(sourceCache)) match {
    | Success _ -> void
    | Failure(err) -> return Failure(err)
    };
    for ((file_name, contents) in this.files) {
      ar.append_id(file_name, contents) match {
      | Success _ -> void
      | Failure(err) ->
        print_error(`Could not write ${file_name}: ${err}`);
        skipExit(3)
      }
    };

    Success(void)
  }
}

mutable class Resolver(
  sklibs: Map<String, Map<String, ArchiveCandidate>>,
  target: String,
  candidatesByPath: Map<String, ArchiveCandidate>,
  cache: ?mutable MetadataCache = None(),
  loaded: mutable Map<String, Metadata> = mutable Map[],
) {
  static fun create(
    paths: Array<String>,
    target: String,
    cache: ?mutable MetadataCache = None(),
  ): mutable Resolver {
    sklibs = mutable Map[];
    candidatesByPath = mutable Map[];
    for (p in paths) {
      if (!FileSystem.exists(p)) {
        // TODO: Log it.
        continue
      };
      !p = FileSystem.realpath(p);
      for (f in FileSystem.readDirectory(p)) {
        if (!f.endsWith(".sklib")) {
          continue
        };

        path = FileSystem.realpath(Path.join(p, f));
        candidate = candidatesByPath.getOrAdd(path, () ->
          ArchiveCandidate::read(path, cache) match {
          | Success(candidate) -> candidate
          | Failure(err) ->
            print_error(`Failed to read metadata for ${path}: ${err}`);
            skipExit(3)
          }
        );
        if (candidate.index.target != target) continue;
        _ = sklibs
          .getOrAdd(candidate.index.name, () -> mutable Map[])
          .maybeSet(candidate.index.hash, candidate);
      }
    };

    mutable Resolver(
      sklibs.map((_, v) -> v.chill()),
      target,
      candidatesByPath.chill(),
      cache,
    )
  }

  private mutable fun load(candidate: ArchiveCandidate): Metadata {
    this.loaded.getOrAdd(candidate.path, () -> candidate.load(this.cache))
  }

  mutable fun resolve(
    dependencies: Array<String>,
  ): Map<String, (String, Metadata)> {
    resolved = mutable Map[];
    previous = mutable Vector[];

    // Resolve direct dependencies.
    for (dep in dependencies) {
      (!dep, path, metadata) = if (dep.contains("=")) {
        (name, path) = dep.splitFirst("=");
        !path = FileSystem.realpath(path);
        // Reuse the scanned candidate and this invocation's decoded metadata.
        // A new invocation constructs a new Resolver and observes fresh files.
        metadata = this.candidatesByPath.maybeGet(path) match {
        | Some(candidate) -> this.load(candidate)
        | None() ->
          this.loaded.getOrAdd(path, () ->
            read_metadata(path, this.cache) match {
            | Success(metadata) -> metadata
            | Failure(err) ->
              print_error(`Failed to read metadata for ${path}: ${err}`);
              skipExit(3)
            }
          )
        };
        if (metadata.target != this.target) {
          print_error(`Failed to resolve ${name} (target mismatch)`);
          skipExit(3)
        };
        if (metadata.name != name) {
          print_error(`Failed to resolve ${name} (name mismatch)`);
          skipExit(3)
        };
        (name, path, metadata)
      } else {
        // TODO: Take compile options into account.
        (path, metadata) = this.resolve_single(dep);
        (dep, path, metadata)
      };

      previous.push((dep, path, metadata, true))
    };

    // Recursively resolve indirect dependencies.
    loop {
      if (previous.isEmpty()) break void;

      latest = mutable Vector[];
      for ((name, path, metadata, is_direct_dependency) in previous) {
        resolved.maybeGet(name) match {
        | Some((other_path, other_metadata, _)) ->
          if (other_metadata.hash != metadata.hash) {
            print_error(
              `Failed to resolve ${name} (conflict between ${path} and ${other_path})`,
            );
            skipExit(3)
          }
        | None() ->
          resolved.add(name, (path, metadata, is_direct_dependency));
          latest.extend(
            metadata.dependencies.map(dep -> {
              (dep_name, dep_hash) = dep;
              (dep_path, dep_metadata) = this.resolve_single(dep_name, m ->
                m.hash == dep_hash
              );
              (dep_name, dep_path, dep_metadata, false)
            }),
          )
        }
      };
      !previous = latest
    };

    resolved.map((_, v) -> (v.i0, v.i1)).chill()
  }

  mutable fun resolve_single(
    dependency: String,
    pred: (ArchiveIndex) -> Bool = _ -> true,
  ): (String, Metadata) {
    candidates = this.sklibs.maybeGet(dependency) match {
    | Some(candidates) -> candidates
    | None() ->
      print_error(`Failed to resolve dependency ${dependency}`);
      skipExit(3)
    };

    for (candidate in candidates.values()) {
      if (pred(candidate.index)) return (candidate.path, this.load(candidate))
    };

    print_error(`Failed to resolve dependency ${dependency}`);
    skipExit(3)
  }
}

module end;
