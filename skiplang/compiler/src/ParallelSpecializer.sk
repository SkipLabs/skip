module OuterIstToIR;

// This capability is local to one specialization row. Worker instances contain
// only a ParallelReader and prepared immutable GIR, never a mutable Context.
class SerialSpecializationRequired() extends Exception {
  fun message(): String {
    "Specialization requires main-thread conversion"
  }
}

mutable class SpecializerContext private {
  private serialContext: ?mutable SKStore.Context,
  private reader: ?mutable SKStore.ParallelReader,
  private prepared: ?(LazyGFun, GFunction),
} {
  static fun serial(context: mutable SKStore.Context): mutable this {
    mutable static{
      serialContext => Some(context),
      reader => None(),
      prepared => None(),
    }
  }

  static fun parallel(
    reader: mutable SKStore.ParallelReader,
    prepared: ?(LazyGFun, GFunction),
  ): mutable this {
    mutable static{serialContext => None(), reader => Some(reader), prepared}
  }

  mutable fun requireSerial(): mutable SKStore.Context {
    this.serialContext match {
    | Some(context) -> context
    | None() -> throw SerialSpecializationRequired()
    }
  }

  mutable fun inPhase(): Bool {
    this.serialContext match {
    | None() -> true
    | Some(context) -> context.getGlobal(.pipelinePhaseKey).isSome()
    }
  }

  mutable fun getArray<K: SKStore.Key, V: SKStore.File>(
    handle: SKStore.EHandle<K, V>,
    key: K,
  ): Array<V> {
    this.reader match {
    | Some(reader) -> reader.getArray(handle, key)
    | None() -> handle.getArray(this.requireSerial(), key)
    }
  }

  mutable fun getArrayFilter<K: SKStore.Key, V: SKStore.File, R: SKStore.File>(
    handle: SKStore.EHandle<K, V>,
    key: K,
    project: V ~> R,
  ): Array<R> {
    this.reader match {
    | Some(reader) -> reader.getArray(handle, key).map(project)
    | None() -> handle.getArrayFilter(this.requireSerial(), key, project)
    }
  }

  mutable fun getGFunction(converter: Converter, lazy: LazyGFun): GFunction {
    this.prepared match {
    | Some((name, function)) if (name == lazy) -> function
    | _ -> converter.getGFunction(this.requireSerial(), lazy)
    }
  }

  mutable fun getGClass(
    converter: Converter,
    lazy: LazyGClass,
    pos: Pos,
  ): GClass {
    lazy match {
    | LiteralLazyGClass(cls) -> cls
    | _ -> converter.getGClass(this.requireSerial(), lazy, pos)
    }
  }
}

class PreparedSpecializationFile(
  values: Array<SKStore.File>,
  function: ?(LazyGFun, GFunction),
) extends SKStore.File

module end;
