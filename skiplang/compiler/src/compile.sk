module alias O = OuterIstToIR;

fun createOptimizedFunctions(
  context: mutable SKStore.Context,
  env: GlobalEnv,
  config: Config.Config,
): GlobalEnv {
  runCompilerPhase("native/compile", () -> {
    Optimize.compileAll(context, env, config)
  })
}

fun finishOptimizedFunctions(
  env: GlobalEnv,
  _config: Config.Config,
): GlobalEnv {
  // Find all the functions that are still reachable from the root set,
  // post-inlining, dead code elimination, etc.
  !env.sfuns = findAllReachableFuns(
    keep -> {
      // Seed the "reachable" recursion with functions we definitely
      // need to emit.
      keep(env.initializeAllConstsID);
      for (f in env.sfuns) {
        if (f.isDisasm || f.isRuntimeExport) {
          keep(f.id)
        }
      };
      env.runtimeFunctions.values().each(keep)
    },
    env,
  );

  // Now that we have computed the fields for all of the various
  // coroutine classes, we can finally analyze pointer escape info.
  !env = Escape.computeWhetherPointersCanEscape(env);

  env
}

// Returns the link command for the native (non-WASM) case.
// For WASM, runs the multi-step toolchain directly and returns None().
fun getLinkArgs(
  llFile: String,
  config: Config.Config,
  exports: Array<String> = Array[],
  nativeInputs: ?Array<String> = None(),
): ?Array<String> {
  linker_args = config.link_args.concat(
    config.dependencies.values().collect(Array).flatMap(x -> x.i1.links),
  );
  static_libs = config.static_libraries.concat(
    config.dependencies
      .values()
      .filter(d -> d.i1.has_object_code)
      .map(x -> x.i0)
      .collect(Array),
  );
  if (config.isWasm()) {
    output = config.output;
    bcFile = output + ".bc";
    runShell(
      Array["llvm-link", llFile].concat(Array["-o", bcFile]),
      config.verbose,
    );
    bcOptFile = output + ".opt.bc";
    runShell(
      Array["opt", `-O${config.optLevel}`, bcFile, "-o", bcOptFile],
      config.verbose,
    );
    oFile = output + ".o";
    runShell(
      Array[
        "llc",
        "-mtriple=wasm32-unknown-unknown",
        `-O${config.optLevel}`,
        "-filetype=obj",
        bcOptFile,
        "-o",
        oFile,
      ],
      config.verbose,
    );
    // TODO: Proper mechanism to select exports.
    exportJs = exports
      .concat(
        Array[
          "getCompositeName",
          "getCompositeSize",
          "getCompositeAt",
          "SKIP_String_byteSize",
          "getLeafValue",
          "objectKind",
          "SKIP_call0",
          "SKIP_Obstack_alloc",
          "skip_main",
          "SKIP_init_jsroots",
          "SKIP_add_root",
          "SKIP_remove_root",
          "SKIP_tracked_call",
          "SKIP_tracked_query",
          "sk_string_create",
          "SKIP_initializeSkip",
          "SKIP_skstore_init",
          "SKIP_skstore_end_of_init",
          "SKIP_get_persistent_size",
          "sk_pop_dirty_page",
          "SKIP_get_version",
          "SKIP_throw_EndOfFile",
          "SKIP_new_Obstack",
          "SKIP_destroy_Obstack",
          "getVersion",
          "__heap_base",
        ],
      )
      .map(x -> `-export=${x}`);
    // Strip DWARF from release wasm (the browser bundle). `-S` (not `-s`)
    // keeps the `name` section, so JS stack traces still resolve Skip
    // function names; `--debug` builds keep full debug info.
    stripArgs = if (config.debug) Array<String>[] else Array["-S"];
    runShell(
      Array[
        "wasm-ld",
        "--initial-memory=1073741824",
        oFile,
        "-o",
        output,
        "--no-entry",
        "-allow-undefined",
      ].concat(stripArgs)
        .concat(exportJs)
        .concat(linker_args)
        .concat(static_libs),
      config.verbose,
    );
    None()
  } else {
    flags = if (config.emit == "cdylib") {
      Array["-fPIC", "-shared"]
    } else {
      Array["-no-pie"]
    };

    Some(
      Array[
        "clang++",
        `-O${config.optLevel}`,
        // Honor the requested target instead of letting clang default to the
        // host. For the host target this is a no-op; it is the first step
        // toward a real cross-compilation path (the module triple, still
        // hardcoded in the preamble, is the remaining piece -- see the
        // `Target` TODO in Config.sk).
        `--target=${config.target}`,
        "-o",
        config.output,
      ].concat(nativeInputs.default(Array[llFile]))
        .concat(flags)
        .concat(linker_args)
        .concat(static_libs),
    )
  }
}

fun runShell(
  args: Array<String>,
  verbose: Bool = false,
  throwOnFailure: Bool = false,
): void {
  if (verbose) {
    print_error(">> " + args.join(" "))
  };
  p = System.subprocess(
    args,
    s -> {
      if (verbose) {
        print_error_raw(s)
      }
    },
    s -> {
      if (verbose) {
        print_error_raw(s)
      }
    },
  ).fromSuccess();
  if (!p.success()) {
    if (throwOnFailure) {
      // Parallel artifact workers must finish/join their children before the
      // main thread reports failure. Exiting here would abandon sibling jobs.
      throw SkipError.CompileFailureException{
        message => "Native command failed: " + args.join(" ") + "\n" + p.stderr,
      }
    };
    if (!verbose) {
      print_error_raw(p.stderr)
    };
    skipExit(1)
  }
}

fun ensureCompatibleLLVMVersion(): void {
  kLLVMVersion = "20.";

  p = System.subprocess(Array["llvm-config", "--version"]).fromSuccess();
  if (!p.success()) {
    print_error_raw(p.stderr);
    skipExit(1)
  } else if (!p.stdout.startsWith(kLLVMVersion)) {
    print_error(
      `Incompatible LLVM version ${p.stdout.trimRight()}, expected LLVM ${kLLVMVersion}`,
    );
    skipExit(1)
  }
}

class ConfigFile(value: Config.Config) extends SKStore.File

class SpecializationConfigFile(
  value: Config.SpecializationConfig,
) extends SKStore.File
class BackendPhase1File(
  conf: Config.Config,
  rootsIR: O.RootsIR,
) extends SKStore.File

class SpecializerFile(value: O.SpecializerState) extends SKStore.File

class SpecializerDirFile(
  value: SKStore.EHandle<SKStore.Key, SKStore.File>,
  complete: Bool,
) extends SKStore.File

class SpecializerProgress(
  dir: SKStore.EHandle<SKStore.Key, SKStore.File>,
  view: O.SpecializerView,
  round: Int,
  reads: SortedSet<SKStore.Path>,
  dirs: SortedSet<SKStore.DirName>,
  complete: Bool,
) extends SKStore.File

const pipelinePhaseKey: String = "COMPILER_PIPELINE_PHASE";
const invocationConfigKey: String = "COMPILER_INVOCATION_CONFIG";
const specializationProgressKey: String = "COMPILER_SPECIALIZATION_PROGRESS";
const discoveryStoragePolicyKey: String = "COMPILER_DISCOVERY_STORAGE_POLICY";
const discoveryHierarchyPolicyKey: String = "COMPILER_DISCOVERY_HIERARCHY_POLICY";
const classPartitionPolicyKey: String = "COMPILER_CLASS_PARTITION_POLICY";
const varianceIndexPolicyKey: String = "COMPILER_VARIANCE_INDEX_POLICY";
const closureBodyPolicyKey: String = "COMPILER_CLOSURE_BODY_POLICY";
const lambdaAnchorPolicyKey: String = "COMPILER_LAMBDA_ANCHOR_POLICY";
const specializationWorkKey: String = "COMPILER_SPECIALIZATION_WORK";

// Scheduling observation only; never an input to a semantic compiler result.
// Keep the mapper definition independent of the invocation's batching option.
fun markSpecializationWork(context: mutable SKStore.Context): void {
  context.getGlobal(specializationWorkKey) match {
  | Some(SKStore.BoolFile(false)) ->
    context.setGlobal(specializationWorkKey, SKStore.BoolFile(true))
  | _ -> void
  }
}

// Frontend errors for the current unit (empty/absent on success). The
// backend checks this once before entering specialization and throws on
// failure, so unsuccessful updates never reach persistence.
const backendSinkDirName: SKStore.DirName = SKStore.DirName::create(
  "/backendSink/",
);
const backendSinkDir: SKStore.EHandle<
  SKStore.UnitID,
  SkipError.ErrorsFile,
> = SKStore.EHandle(
  SKStore.UnitID::keyType,
  SkipError.ErrorsFile::type,
  backendSinkDirName,
);

// Render errors while the failed invocation still has its current source
// contents. The top-level handler exits before SKStore can persist the update;
// batch mode catches the exception and discards this unit's forked context.
fun throwIfFrontendErrors(context: mutable SKStore.Context): void {
  backendSinkDir.maybeGet(context, SKStore.UnitID::singleton) match {
  | Some(ef) if (!ef.value.isEmpty()) ->
    get_file = file -> {
      FileCache.fileDir.unsafeGetArray(context, file)[0].value
    };
    throw SkipError.CompileFailureException{
      message => SkipError.errorsToString(
        ef.value.map(x -> x.errors).flatten().collect(Vector),
        get_file,
      ),
    }
  | _ -> void
  }
}

class OldFile(files: Array<SKStore.File>) extends SKStore.File
class TickFile(tick: SKStore.Tick) extends SKStore.File

const maxNbrFunsPerPhase: Int = 100;

fun mergeSpecializerFiles(
  key: SKStore.Key,
  left: SKStore.File,
  right: SKStore.File,
): SKStore.File {
  (key, left, right) match {
  | (
    O.GClassNameKey _,
    O.SortedSetSClassIDFile(x),
    O.SortedSetSClassIDFile(y),
  ) ->
    O.SortedSetSClassIDFile(x.union(y))
  | (
    O.GClassArgumentKey _,
    O.SortedSetSClassIDFile(x),
    O.SortedSetSClassIDFile(y),
  ) ->
    O.SortedSetSClassIDFile(x.union(y))
  | (O.SupertypesKey _, O.SortedSetSClassIDFile(x), O.SortedSetSClassIDFile(y))
  | (O.SubtypesKey _, O.SortedSetSClassIDFile(x), O.SortedSetSClassIDFile(y)) ->
    O.SortedSetSClassIDFile(x.union(y))
  | (O.HalfSClassKey _, O.SClassIDFile(x), O.SClassIDFile(y)) ->
    if (x != y) {
      invariant_violation("Unexpected inequality in sclassMap merge")
    };
    right
  | (O.SClassIDKey _, O.SClassInfoFile(x), O.SClassInfoFile(y)) ->
    O.SClassInfoFile(x.merge(y))
  | (O.GFunKeyKey _, O.GFunKeyFile(x), O.GFunKeyFile(y)) ->
    if (x != y) {
      invariant_violation("Unexpected inequality in funsNeeded merge")
    };
    right
  | _ -> invariant_violation("Unexpected key or file type in specializer merge")
  }
}

fun mergeFun(
  _context: mutable SKStore.Context,
  writer: mutable SKStore.TWriter<SKStore.Key, SKStore.File>,
  key: SKStore.Key,
  values: mutable SKStore.NonEmptyIterator<SKStore.File>,
): void {
  files = mutable Vector[];
  oldFiles = mutable Vector[];
  for (file in values) {
    file match {
    | OldFile(x) -> oldFiles.extend(x)
    | x -> files.push(x)
    }
  };
  if (files.isEmpty()) {
    return writer.setArray(key, oldFiles.toArray())
  };
  key match {
  | O.GClassNameKey _
  | O.GClassArgumentKey _
  | O.SubtypesKey _
  | O.SupertypesKey _ ->
    // Each writer contributes only its newly discovered relationships. Keep
    // the previous round's set as another contribution; SKStore retracts a
    // writer's old contributions when that writer is recomputed or removed.
    ids = SortedSet<SClassID>[];
    oldFiles.extend(files);
    for (file in oldFiles) {
      file match {
      | O.SortedSetSClassIDFile(previousIDs) -> !ids = ids.union(previousIDs)
      | O.SClassIDFile(id) -> !ids = ids.set(id)
      | _ -> invariant_violation("Unexpected relationship contribution")
      }
    };
    writer.set(key, O.SortedSetSClassIDFile(ids))
  | O.FStackElement _ ->
    // Continuations already represent a started function. Keep every bundle
    // of blocked operations and discard duplicate requests to start it again.
    continuations = mutable Vector[];
    for (elt in files) {
      elt match {
      | c @ O.ContinuationFile _ -> continuations.push(c)
      | O.FStackElement _ -> void
      | _ -> invariant_violation("Unexpected function work file")
      }
    };
    if (continuations.isEmpty()) {
      writer.setArray(key, Array[files.first()])
    } else {
      writer.setArray(key, continuations.toArray())
    }
  | SKStore.IID(0) -> writer.setArray(key, files.toArray())
  | _ ->
    merged: ?SKStore.File = None();
    for (file in files) {
      !merged = merged match {
      | None() -> Some(file)
      | Some(previous) -> Some(mergeSpecializerFiles(key, previous, file))
      }
    };
    merged match {
    | Some(file) -> writer.set(key, file)
    | None() -> invariant_violation("Expected files to merge")
    }
  }
}

// Discovery overlays store replacement values. Relationship writes are
// additions, so fold the preceding set into just the keys changed this round.
// Retractions rerun this reducer and its tracked base read, rather than keeping
// a union containing contributions from an obsolete producer.
fun mergeDiscoveryDelta(
  context: mutable SKStore.Context,
  writer: mutable SKStore.TWriter<SKStore.Key, SKStore.File>,
  key: SKStore.Key,
  values: mutable SKStore.NonEmptyIterator<SKStore.File>,
  previous: O.SpecializerView,
): void {
  key match {
  | O.GClassNameKey _
  | O.GClassArgumentKey _
  | O.SubtypesKey _
  | O.SupertypesKey _ ->
    ids = SortedSet<SClassID>[];
    for (file in previous.getArray(context, key)) {
      !ids = O.SortedSetSClassIDFile::type(file).value;
    };
    for (file in values) {
      file match {
      | O.SortedSetSClassIDFile(additions) -> !ids = ids.union(additions)
      | O.SClassIDFile(id) -> !ids = ids.set(id)
      | _ -> invariant_violation("Unexpected discovery relation contribution")
      }
    };
    writer.set(key, O.SortedSetSClassIDFile(ids))
  | _ -> mergeFun(context, writer, key, values)
  }
}

// Attach the completed relation sets one class at a time. Each row reads only
// its own relation keys and publishes a class diff; the ordinary round merger
// forwards the remaining state without merging old and updated class records.
fun latchSpecializerClasses(
  context: mutable SKStore.Context,
  input: SKStore.EHandle<SKStore.Key, SKStore.File>,
  configDir: SKStore.EHandle<SKStore.IID, SpecializationConfigFile>,
  converter: O.Converter,
): SKStore.EHandle<SKStore.Key, SKStore.File> {
  input
    .map(
      x ~> x,
      x ~> x,
      context,
      SKStore.DirName::create("/specializer/latch-classes/"),
      (context, writer, key, values) ~> {
        key match {
        | O.SClassIDKey(id) ->
          info = O.SClassInfoFile::type(values.first).value;
          config = configDir.getArray(context, SKStore.IID(0))[0].value;
          sp = O.Specializer::make(input, context, config, converter);
          sp.!canCreateNewSClasses = false;
          !info.sclass = info.sclass with {
            subtypes => sp.trackedSubtypesGet(id),
            supertypes => sp.trackedSupertypesGet(id),
          };
          sp.sclassSet(id, info);
          sp.writeDiff(writer)
        | _ -> writer.set(key, OldFile(values.toArray()))
        }
      },
    )
    .map(
      x ~> x,
      x ~> x,
      context,
      SKStore.DirName::create("/specializer/latch-classes-merged/"),
      mergeFun,
    )
}

// Each class owns its scalarized fields and array-slot representation. Nested
// value-class reads come from the preceding, unscalarized phase, never from a
// partially updated sibling row.
fun scalarizeSpecializerClasses(
  context: mutable SKStore.Context,
  input: SKStore.EHandle<SKStore.Key, SKStore.File>,
  configDir: SKStore.EHandle<SKStore.IID, SpecializationConfigFile>,
  converter: O.Converter,
): SKStore.EHandle<SKStore.Key, SKStore.File> {
  input
    .map(
      x ~> x,
      x ~> x,
      context,
      SKStore.DirName::create("/specializer/scalarize-fields/"),
      (context, writer, key, values) ~> {
        key match {
        | O.SClassIDKey _ ->
          info = O.SClassInfoFile::type(values.first).value;
          config = configDir.getArray(context, SKStore.IID(0))[0].value;
          sp = O.Specializer::make(input, context, config, converter);
          sp.!canCreateNewSClasses = false;
          sp.scalarizeFields(info);
          sp.writeDiff(writer)
        | _ -> writer.set(key, OldFile(values.toArray()))
        }
      },
    )
    .map(
      x ~> x,
      x ~> x,
      context,
      SKStore.DirName::create("/specializer/scalarize-fields-merged/"),
      mergeFun,
    )
}

fun layoutSpecializerClasses(
  context: mutable SKStore.Context,
  input: SKStore.EHandle<SKStore.Key, SKStore.File>,
  configDir: SKStore.EHandle<SKStore.IID, SpecializationConfigFile>,
  converter: O.Converter,
): SKStore.EHandle<SKStore.Key, SKStore.File> {
  shapes = input.map(
    x ~> x,
    O.FieldLayoutShapeFile::type,
    context,
    SKStore.DirName::create("/specializer/layout-shapes/"),
    (_context, writer, key, values) ~> {
      key match {
      | O.SClassIDKey _ ->
        sc = O.SClassInfoFile::type(values.first).value.sclass;
        writer.set(
          SKStore.UnitID::singleton,
          O.FieldLayoutShapeFile(
            sc.id,
            SortedSet::createFromItems(sc.fields.map(field -> field.name)),
            sc.subtypes,
          ),
        )
      | _ -> void
      }
    },
  );
  groups = shapes.map(
    x ~> x,
    x ~> x,
    context,
    SKStore.DirName::create("/specializer/layout-groups/"),
    (_context, writer, _, values) ~> {
      for (id => group in O.planFieldLayoutGroups(values.toArray())) {
        writer.set(O.SClassIDKey(id), group)
      }
    },
  );
  SKStore.EHandle::multiMap(
    x ~> x,
    x ~> x,
    context,
    Array[
      (
        input,
        (
          (_, writer, key, values) ~> {
            writer.set(key, OldFile(values.toArray()))
          },
          None(),
        ),
      ),
      (
        groups,
        (
          (context, writer, _, values) ~> {
            group = O.FieldLayoutGroupFile::type(values.first);
            config = configDir.getArray(context, SKStore.IID(0))[0].value;
            sp = O.Specializer::make(input, context, config, converter);
            sp.!canCreateNewSClasses = false;
            O.layoutSpecializerGroup(sp, config, group.classes);
            sp.writeDiff(writer)
          },
          None(),
        ),
      ),
    ],
    SKStore.DirName::create("/specializer/layout-fields/"),
  ).map(
    x ~> x,
    x ~> x,
    context,
    SKStore.DirName::create("/specializer/layout-fields-merged/"),
    mergeFun,
  )
}

fun createFunctionIRMaps(
  context: mutable SKStore.Context,
  input: SKStore.EHandle<SKStore.Key, SKStore.File>,
  configDir: SKStore.EHandle<SKStore.IID, SpecializationConfigFile>,
  converter: O.Converter,
  identities: SKStore.LHandle<O.GFunKeyKey, SKStore.IntFile>,
  common: SKStore.EHandle<SKStore.IID, O.FunctionIRSharedFile>,
  backendConfig: SKStore.EHandle<SKStore.IID, ConfigFile>,
): void {
  shared = runCompilerPhase("function-ir/class-publication", () ->
    input.map(
      x ~> x,
      x ~> x,
      context,
      SKStore.DirName::create("/specializer/function-ir-shared/"),
      (context, writer, key, values) ~> {
        // Forwarded relations and ignored discovery keys do not read config.
        // Register it only on the class rows whose method tables need resolving.
        config = if (key is O.SClassIDKey _) {
          Some(configDir.getArray(context, SKStore.IID(0))[0].value)
        } else {
          None()
        };
        O.publishFunctionIRClassState(
          context,
          writer,
          key,
          values,
          input,
          config,
          converter,
          identities,
        )
      },
    )
  );
  plan = runCompilerPhase("function-ir/planning", () ->
    input.map(
      x ~> x,
      x ~> x,
      context,
      SKStore.DirName::create("/specializer/function-ir-plan/"),
      (context, writer, key, values) ~>
        O.planFunctionIR(context, writer, key, values, identities)
      ,
    )
  );
  // The active identity aggregate is separate from the body rows. It stays
  // cached when only a function body or an unused method changes.
  _ = runCompilerPhase("function-ir/identities", () ->
    common.map(
      SKStore.IID::keyType,
      O.FunctionIRIdentityAggregateFile::type,
      context,
      SKStore.DirName::create("/specializer/function-ir-identities/"),
      (context, writer, key, _values) ~> {
        config = backendConfig.getArray(context, SKStore.IID(0))[0].value;
        if (!BackendProgram::classHeadersEnabled(context, config)) {
          writer.set(key, O.collectFunctionIRIdentities(context, plan))
        }
      },
    )
  );
  generic = runCompilerPhase("function-ir/generic", () ->
    ParallelPhases.map(
      plan,
      x ~> x,
      O.GFunctionFile::type,
      context,
      SKStore.DirName::create("/specializer/generic-function-ir/"),
      "generic-ir",
      (context, writer, key, values) ~>
        O.generateGenericFunctionIR(context, writer, key, values, converter)
      ,
    )
  );
  _ = runCompilerPhase("function-ir/instantiate", () ->
    ParallelPhases.map(
      plan,
      x ~> x,
      O.SpecializedFunctionFile::type,
      context,
      SKStore.DirName::create("/specializer/function-ir/"),
      "function-ir",
      (context, writer, key, values) ~>
        O.generateFunctionIR(
          context,
          writer,
          key,
          values,
          plan,
          generic,
          shared,
          common,
        )
      ,
    )
  )
}

fun getOrInitializeBackend(
  context: mutable SKStore.Context,
  trackedClosureBodies: Bool,
): (
  SKStore.EHandle<SKStore.IID, ConfigFile>,
  SKStore.EHandle<SKStore.IID, TickFile>,
) {
  lambdaAnchors = Environ.varOpt("SKC_LAMBDA_SOURCE_ANCHORS").isSome();
  context.getPersistent(lambdaAnchorPolicyKey) match {
  | Some(SKStore.BoolFile(previous)) if (previous != lambdaAnchors) ->
    print_error(
      "Changing SKC_LAMBDA_SOURCE_ANCHORS requires a fresh --init cache.\n",
    );
    skipExit(2)
  | Some(SKStore.BoolFile _) -> void
  | None() ->
    context.setPersistent(
      lambdaAnchorPolicyKey,
      SKStore.BoolFile(lambdaAnchors),
    )
  | _ -> invariant_violation("Unexpected lambda anchor policy")
  };
  context.getPersistent(closureBodyPolicyKey) match {
  | Some(SKStore.BoolFile(previous)) if (previous != trackedClosureBodies) ->
    print_error(
      "Changing --tracked-closure-bodies requires a fresh --init cache.\n",
    );
    skipExit(2)
  | Some(SKStore.BoolFile _) -> void
  | None() ->
    context.setPersistent(
      closureBodyPolicyKey,
      SKStore.BoolFile(trackedClosureBodies),
    )
  | _ -> invariant_violation("Unexpected closure body policy")
  };
  backendDirName = SKStore.DirName::create("/backend/");
  tickDirName = SKStore.DirName::create("/tick/");
  if (!context.newDirs.contains(FileCache.fileDirName)) {
    _ = context.mkdir(
      FileCache.InputSource::keyType,
      SKStore.StringFile::type,
      FileCache.fileDirName,
      Array[],
      true,
    )
  };
  if (!context.newDirs.contains(FileCache.packageDirName)) {
    _ = context.mkdir(
      FileCache.InputPackageName::keyType,
      FileCache.InputPackageFiles::type,
      FileCache.packageDirName,
      Array[],
      true,
    )
  };
  FileCache.scaffoldPackageEnvDirs(context);
  context.unsafeMaybeGetEagerDir(backendDirName) match {
  | Some _ ->
    return (
      SKStore.EHandle(SKStore.IID::keyType, ConfigFile::type, backendDirName),
      SKStore.EHandle(SKStore.IID::keyType, TickFile::type, tickDirName),
    )
  | None() -> void
  };

  backendDir = context.mkdir(
    SKStore.IID::keyType,
    ConfigFile::type,
    backendDirName,
  );

  tickDir = context.mkdir(SKStore.IID::keyType, TickFile::type, tickDirName);
  _ = context.mkdir(
    SKStore.IID::keyType,
    SKStore.StringFile::type,
    AsmOutput.emissionPreambleDirName,
  );
  AsmOutput.initializeArtifactInputs(context);

  specializationConfigDir = backendDir.map(
    SKStore.IID::keyType,
    SpecializationConfigFile::type,
    context,
    SKStore.DirName::create("/specialization-config/"),
    (_context, writer, key, values) ~> {
      writer.set(
        key,
        SpecializationConfigFile(values.first.value.specializationConfig()),
      )
    },
  );

  outerIst = O.makeOuterIst(context);

  defsProj = outerIst.getFunsProj(context);
  constsProj = outerIst.getConstsProj(context);

  converter = O.Converter::create(
    context,
    SKStore.DirName::create("/converter/"),
    outerIst,
    trackedClosureBodies,
  );
  functionIdentities = O.createFunctionIdentities(context);

  _ = tickDir.map(
    SKStore.UnitID::keyType,
    SkipError.ErrorsFile::type,
    context,
    backendSinkDirName,
    (context, writer, _key, _values) ~> {
      context.getGlobal("ERRORS") match {
      | None() -> void
      | Some(errors) ->
        writer.set(
          SKStore.UnitID::singleton,
          SkipError.ErrorsFile(
            SkipError.ErrorsFile::type(errors).value.reversed(),
          ),
        )
      }
    },
  );

  backendPhase1 = backendDir.map(
    SKStore.IID::keyType,
    BackendPhase1File::type,
    context,
    SKStore.DirName::create("/backendPhase1/"),
    (context, writer, key, values) ~> {
      conf = values.first.value;

      throwIfFrontendErrors(context);

      if (conf.check) {
        return void;
      };

      if (conf.emit == "sklib") {
        // Native archive/preamble contents are filesystem inputs to packaging.
        // Refresh those external bytes on invocation; Skip sources use their
        // tracked package row in compile_sklib.
        if (!conf.static_libraries.isEmpty() || !conf.preambles.isEmpty()) {
          _ = tickDir.getArray(context, SKStore.IID(0))
        };
        compile_sklib(context, conf);
        return void
      };
      // Create a filter for what functions to compile.
      shouldRuntimeExport = (
        funDef ~>
          AsmOutput.cppIsExported(
            funDef.origName,
            funDef.annotations,
            funDef.getPos(),
            conf.exportedAsFunctions,
            conf.isWasm(),
          )
      );

      // Are we in "disassemble" mode?
      disasm = (
        conf.disasmAll ||
        conf.disasmAnnotated ||
        !conf.disasmFiles.isEmpty() ||
        !conf.disasmFunctions.isEmpty()
      );

      // Create a filter for what functions to disassemble.
      //
      // Note that for "disasmAll" we do not return true, since we only want
      // to disassemble code which is actually used, and returning true would
      // force everything to be compiled just so it could be disassembled.
      shouldDisasm = (
        funDef ~>
          disasm &&
            (conf.disasmFunctions.contains(funDef.origName) ||
              (conf.disasmAnnotated &&
                annotationsContain(
                  funDef.annotations,
                  "@disasm",
                  funDef.getPos(),
                )))
      );

      defsIR = O.prepareCreateIR(
        context,
        shouldDisasm,
        shouldRuntimeExport,
        outerIst,
        if (conf.incrementalSpecialization) converter else {
          converter.forSequential()
        },
        constsProj,
        defsProj,
      );
      writer.set(key, BackendPhase1File(conf, defsIR))
    },
  );

  specializerEmptyDir = context.mkdir(
    x ~> x,
    x ~> x,
    SKStore.DirName::create("/specializer/empty/"),
  );
  specializerInitDir = backendDir.map(
    x ~> x,
    x ~> x,
    context,
    SKStore.DirName::create("/specializer/init/"),
    (context, writer, _key, _values) ~> {
      if (backendPhase1.getArray(context, SKStore.IID(0)).isEmpty()) {
        return void
      };
      prevPhase = backendPhase1.getArray(context, SKStore.IID(0))[0];
      conf = prevPhase.conf;
      if (!conf.incrementalSpecialization) return void;
      specializer = O.createSpecializer(
        context,
        conf,
        converter,
        specializerEmptyDir,
      );
      specializer.mclone(context).writeDiff(writer);
      roots = prevPhase.rootsIR.forceCompile.map(root ->
        O.FStackElement(root, Array[], Array[])
      );

      for (root in roots) {
        writer.setArray(root, Array[root]);
      };
      writer.setArray(SKStore.IID(0), Array[SKStore.IntFile(1)]);
    },
  );

  specializerInitMerged = specializerInitDir.map(
    x ~> x,
    x ~> x,
    context,
    SKStore.DirName::create("/specializer/init-merged/"),
    mergeFun,
  );

  classGroupAttempts = O.createClassGroupAttempts(
    context,
    context ~>
      specializationConfigDir.getArray(context, SKStore.IID(0))[0].value,
    converter,
  );

  specializerDir = backendDir.map(
    SKStore.IID::keyType,
    SpecializerDirFile::type,
    context,
    SKStore.DirName::create("/specializer/"),
    (context, writer, _, _) ~> {
      // Invocation data stays in collections; work mappers capture stable handles.
      config = backendDir.getArray(context, SKStore.IID(0))[0].value;
      if (!config.incrementalSpecialization) return void;
      if (backendPhase1.getArray(context, SKStore.IID(0)).isEmpty()) {
        return void
      };
      specializerAllDir = specializerInitMerged;
      specializerView = O.SpecializerView(specializerInitMerged);
      compact = config.compactSpecializer;
      hierarchical =
        compact &&
        Environ.varOpt("SKC_HIERARCHICAL_DISCOVERY").isSome();
      partitionClasses = config.partitionClasses;
      phaseNumber = 0;
      phased = context.getGlobal(pipelinePhaseKey).isSome();
      batchCached =
        phased &&
        Environ.varOpt("SKC_BATCH_CACHED_SPECIALIZATION").isSome();
      roundsThisStep = 0;
      context.removeGlobal(specializationWorkKey);
      previousInfo = if (phased) context.currentEagerMapperInfo() else {
        SKStore.MInfoEmpty()
      };
      if (phased) {
        context.getGlobal(specializationProgressKey).each(file -> {
          file match {
          | progress @ SpecializerProgress _ if (!progress.complete) ->
            !specializerAllDir = progress.dir;
            !specializerView = progress.view;
            !phaseNumber = progress.round;
            context.!reads = progress.reads;
            context.!newDirs = progress.dirs
          | _ -> void
          }
        })
      };

      loop {
        if (batchCached) {
          context.setGlobal(specializationWorkKey, SKStore.BoolFile(false))
        };
        if (specializerAllDir.getArray(context, SKStore.IID(0)).isEmpty()) {
          context.removeGlobal(specializationWorkKey);
          break void
        };
        phaseNumberCopy = phaseNumber;
        specializerAllDirCopy = specializerAllDir;
        specializerViewCopy = specializerView;
        // Class creation inherits discovered methods, and method discovery
        // visits existing subclasses. Run them in separate rounds so each
        // sees the other's merged writes. Keep class work in one serialized
        // row: per-class rows can expose an unfinished extends_ map to
        // variance propagation, then inherited method lookup fails.
        // The phased driver synchronizes and destroys its heap after this round.
        // Only the legacy unphased path needs a separate collection region.
        runRound = (context: mutable SKStore.Context) ~> {
          workKey: SKStore.Key = SKStore.IID(0);
          classPhaseDir = specializerAllDirCopy.map(
            SKStore.IID::keyType,
            SKStore.BoolFile::type,
            context,
            SKStore.DirName::create(
              "/specializer/phase-kind/" + phaseNumberCopy + "/",
            ),
            (_context, writer, _, values) ~> {
              writer.set(
                SKStore.IID(0),
                SKStore.BoolFile(
                  values.values().any(value -> value is O.CStackElement _),
                ),
              )
            },
            Some(Array[SKStore.KeyRange::create(workKey, workKey)]),
          );
          classRequests = if (partitionClasses) {
            Some(
              O.createClassRequests(
                context,
                specializerAllDirCopy,
                specializerViewCopy,
                phaseNumberCopy,
              ),
            )
          } else {
            None()
          };
          nextDir = specializerAllDirCopy
            .map(
              x ~> x,
              x ~> x,
              context,
              SKStore.DirName::create(
                "/specializer/reduced1/" + phaseNumberCopy + "/",
              ),
              (context, writer, key, values) ~> {
                // Forward state without reading the work queue. Work rows
                // depend on the once-per-round projection of its kind.
                key match {
                | SKStore.IID _
                | O.FStackElement _ ->
                  void
                | _ ->
                  if (!compact) writer.set(key, OldFile(values.toArray()));
                  return void
                };
                classPhase = classPhaseDir.getArray(context, SKStore.IID(0))[
                  0,
                ].value;
                key match {
                | SKStore.IID _ if (!classPhase) ->
                  for (value in values) {
                    invariant(value is SKStore.IntFile _);
                  };
                  return void
                | O.FStackElement _ if (classPhase) ->
                  // These are still pending work, including any continuations.
                  // Forward them directly so mergeFun keeps them over new
                  // requests for the same function from class creation.
                  writer.setArray(key, values.toArray());
                  writer.setArray(SKStore.IID(0), Array[SKStore.IntFile(1)]);
                  return void
                | SKStore.IID _
                | O.FStackElement _ ->
                  void
                | _ -> return writer.set(key, OldFile(values.toArray()))
                };

                markSpecializationWork(context);
                specializationConfig = specializationConfigDir.getArray(
                  context,
                  SKStore.IID(0),
                )[0].value;
                if (partitionClasses && key is SKStore.IID _) {
                  O.publishClassGroups(
                    context,
                    writer,
                    classRequests.fromSome(),
                    classGroupAttempts,
                    phaseNumberCopy,
                    specializerViewCopy,
                    specializationConfig,
                    converter,
                  );
                  return void
                };
                specializer = O.Specializer::makeView(
                  specializerViewCopy,
                  context,
                  specializationConfig,
                  converter,
                );
                invariant(specializer.funStack is List.Nil());
                invariant(specializer.classStack is List.Nil());

                runCompilerPhase(
                  if (key is SKStore.IID _) "specialization/classes" else {
                    "specialization/functions"
                  },
                  () ->
                    key match {
                    | SKStore.IID _ ->
                      isolation = Environ.varOpt(
                        "SKC_SPECIALIZER_ISOLATION_AUDIT",
                      ).isSome();
                      verifyVariance =
                        specializationConfig.indexedClassVariance &&
                        Environ.varOpt("SKC_VERIFY_VARIANCE_INDEX").isSome();
                      isolatedRequests = mutable Vector<O.CStackElement>[];
                      if (Environ.varOpt("SKC_SPECIALIZER_AUDIT").isSome()) {
                        specializer.!classAudit = Some(
                          mutable O.ClassWorkAudit{},
                        )
                      };
                      for (value in values) {
                        value match {
                        | SKStore.IntFile _ -> void
                        | classElt @ O.CStackElement _ ->
                          if (isolation || verifyVariance) {
                            isolatedRequests.push(classElt)
                          };
                          if (specializer.classAudit.isSome()) {
                            specializer.classAudit
                              .fromSome()
                              .begin(classElt.hc.generic.name().id)
                          };
                          specializer.!pos = classElt.pos;
                          _sclassInfo = O.Specializer::getSClass2CPS(
                            context,
                            specializer,
                            classElt.hc,
                            classElt.k,
                          )
                        | _ -> invariant_violation("Unexpected IID key")
                        }
                      };
                      specializer.classAudit.each(audit ->
                        audit.report(phaseNumberCopy)
                      );
                      specializer.reportVarianceWork();
                      if (verifyVariance) {
                        O.auditVarianceIndex(
                          context,
                          specializerViewCopy,
                          specializationConfig,
                          converter,
                          isolatedRequests.toArray(),
                          phaseNumberCopy,
                          specializer,
                        )
                      };
                      if (isolation) {
                        O.auditIsolatedClassGroups(
                          context,
                          specializerViewCopy,
                          specializationConfig,
                          converter,
                          isolatedRequests.toArray(),
                          phaseNumberCopy,
                          specializer,
                        )
                      };
                      if (specializer.funStack is List.Cons _) {
                        for (f in specializer.funStack) {
                          writer.setArray(f, Array[f]);
                          writer.setArray(
                            SKStore.IID(0),
                            Array[SKStore.IntFile(1)],
                          );
                        };
                        specializer.!funStack = List.Nil();
                      };
                      specializer.writeDiff(writer)

                    | origin @ O.FStackElement _ ->
                      needsIID = false;
                      for (value in values) {
                        specializer.!pauseOnSClassCreation = true;
                        value match {
                        | f @ O.FStackElement _ ->
                          specializer.specializePendingFun(f)

                        | c @ O.ContinuationFile _ ->
                          for (pending in c.pending) {
                            invariant(pending.origin == origin);
                            specializer.!pos = pending.pos;
                            try {
                              specializer.!fstackOrigin = Some(origin);
                              _ = O.Specializer::getSClass2CPS(
                                context,
                                specializer,
                                pending.hc,
                                pending.k,
                              );
                              specializer.!fstackOrigin = None();
                            } catch {
                            | O.SClassCreatedExn() ->
                              specializer.!fstackOrigin = None();
                              void
                            | x ->
                              specializer.!fstackOrigin = None();
                              throw x
                            }
                          }
                        | _ ->
                          invariant_violation("Unexpected type (compile.sh)")
                        };
                      };
                      if (specializer.funStack is List.Cons _) {
                        for (f in specializer.funStack) {
                          writer.setArray(f, Array[f]);
                        };
                        !needsIID = true;
                        specializer.!funStack = List.Nil();
                      };
                      specializer.!pauseOnSClassCreation = false;
                      if (specializer.classStack is List.Cons _) {
                        pending = specializer.classStack.reversed().toArray();
                        writer.setArray(
                          SKStore.IID(0),
                          pending.map(classElt ->
                            classElt with {k => (_, _, _) ~> void}
                          ),
                        );
                        writer.setArray(
                          origin,
                          Array[O.ContinuationFile(origin, pending)],
                        );
                        specializer.!classStack = List.Nil();
                      } else if (needsIID) {
                        writer.setArray(
                          SKStore.IID(0),
                          Array[SKStore.IntFile(1)],
                        );
                      };
                      specializer.writeDiff(writer)

                    | _ ->
                      invariant_violation("Unexpected specializer work key")
                    }
                  ,
                )
              },
            )
            .map(
              x ~> x,
              x ~> x,
              context,
              SKStore.DirName::create(
                "/specializer/merge1/" + phaseNumberCopy + "/",
              ),
              (context, writer, key, values) ~> {
                if (compact) {
                  mergeDiscoveryDelta(
                    context,
                    writer,
                    key,
                    values,
                    specializerViewCopy,
                  )
                } else {
                  mergeFun(context, writer, key, values)
                }
              },
            );
          _ = nextDir.getArray(context, SKStore.IID(0));
          nextView = if (compact) {
            specializerViewCopy.append(
              context,
              nextDir,
              phaseNumberCopy,
              hierarchical,
            )
          } else {
            O.SpecializerView(nextDir)
          };
          (nextDir, nextView)
        };
        roundResult = runCompilerPhase("specialization/round", () ->
          if (phased) {
            runRound(context)
          } else {
            SKStore.withRegion(context, (_, context) ~> runRound(context))
          }
        );
        !specializerAllDir = roundResult.i0;
        !specializerView = roundResult.i1;

        !phaseNumber = phaseNumber + 1;
        !roundsThisStep = roundsThisStep + 1;
        didWork = context.getGlobal(specializationWorkKey) match {
        | Some(SKStore.BoolFile(work)) -> work
        | _ -> true
        };
        context.removeGlobal(specializationWorkKey);
        // Existing completed rounds need no heap checkpoint individually.
        // Yield after the first executed class/function transaction, or after
        // eight cached rounds to bound forwarding and coordination temporaries.
        if (phased && (didWork || roundsThisStep >= 8)) break void;
      };
      complete = specializerAllDir.getArray(context, SKStore.IID(0)).isEmpty();
      if (phased) {
        context.setGlobal(
          specializationProgressKey,
          SpecializerProgress(
            specializerAllDir,
            specializerView,
            phaseNumber,
            context.reads,
            context.newDirs,
            complete,
          ),
        );
        if (!complete) {
          for (dir in previousInfo.getNewDirs()) {
            context.!newDirs = context.newDirs.set(dir)
          };
          for (read in previousInfo.getReads()) {
            context.!reads = context.reads.set(read)
          }
        }
      };
      if (config.verbose && complete) {
        print_error(`Incremental specialization: ${phaseNumber} rounds`)
      };
      if (complete) {
        O.pruneClassGroupHints(
          context,
          phaseNumber,
          partitionClasses && config.classGroupHints,
        )
      };
      if (complete && compact) {
        !specializerAllDir = runCompilerPhase(
          "specialization/checkpoint",
          () -> specializerView.materialize(context, "discovery-complete"),
        )
      };
      completedDir = if (complete && !config.stopAfterSpecialization) {
        latched = runCompilerPhase("specialization/latch", () ->
          latchSpecializerClasses(
            context,
            specializerAllDir,
            specializationConfigDir,
            converter,
          )
        );
        scalarized = runCompilerPhase("specialization/scalarize", () ->
          scalarizeSpecializerClasses(
            context,
            latched,
            specializationConfigDir,
            converter,
          )
        );
        runCompilerPhase("specialization/layout", () ->
          layoutSpecializerClasses(
            context,
            scalarized,
            specializationConfigDir,
            converter,
          )
        )
      } else {
        specializerAllDir
      };
      writer.set(SKStore.IID(0), SpecializerDirFile(completedDir, complete));
    },
    // The pipeline collects each round. An enclosing mapper region would
    // copy the complete pipeline state again after its final round.
    None(),
    false,
  );

  // These handles refer to keyed maps installed once discovery has completed.
  // Their recipes capture stable handles, never a compilation snapshot.
  functionIRShared: SKStore.EHandle<
    SKStore.Key,
    SKStore.File,
  > = SKStore.EHandle(
    x ~> x,
    x ~> x,
    SKStore.DirName::create("/specializer/function-ir-shared/"),
  );
  functionIRIdentities: SKStore.EHandle<
    SKStore.IID,
    O.FunctionIRIdentityAggregateFile,
  > = SKStore.EHandle(
    SKStore.IID::keyType,
    O.FunctionIRIdentityAggregateFile::type,
    SKStore.DirName::create("/specializer/function-ir-identities/"),
  );
  functionIR: SKStore.EHandle<
    SKStore.Key,
    O.SpecializedFunctionFile,
  > = SKStore.EHandle(
    x ~> x,
    O.SpecializedFunctionFile::type,
    SKStore.DirName::create("/specializer/function-ir/"),
  );
  functionIRCommon = specializationConfigDir.map(
    SKStore.IID::keyType,
    O.FunctionIRSharedFile::type,
    context,
    SKStore.DirName::create("/specializer/function-ir-common/"),
    (_context, writer, key, values) ~> {
      config = values.first.value;
      writer.set(
        key,
        O.FunctionIRSharedFile(config, converter, config.ptrBitSize / 8),
      )
    },
  );
  _ = specializerDir.map(
    x ~> x,
    x ~> x,
    context,
    SKStore.DirName::create("/specializer/function-ir-driver/"),
    (context, _writer, _, values) ~> {
      completed = values.first;
      config = backendDir.getArray(context, SKStore.IID(0))[0].value;
      if (completed.complete && !config.stopAfterSpecialization) {
        createFunctionIRMaps(
          context,
          completed.value,
          specializationConfigDir,
          converter,
          functionIdentities,
          functionIRCommon,
          backendDir,
        );
        _ = O.createFunctionIRProgram(
          context,
          functionIR,
          functionIRShared,
          functionIdentities,
          backendDir,
          backendPhase1,
        )
      }
    },
  );

  functionIRProgram = O.FunctionIRProgram::handles();
  backendIRDir = backendDir.map(
    SKStore.IID::keyType,
    Optimize.InputFile::type,
    context,
    SKStore.DirName::create("/backendPhase2/"),
    (context, writer, key, _values) ~> {
      if (backendPhase1.getArray(context, SKStore.IID(0)).isEmpty()) {
        return void
      };
      prevPhase = backendPhase1.getArray(context, SKStore.IID(0))[0];
      partialConfig = prevPhase.conf;
      config = backendDir.getArray(context, SKStore.IID(0))[0].value;
      if (config.incrementalSpecialization && config.stopAfterSpecialization) {
        return void
      };
      if (context.debugMode) print_string("IR_ASSEMBLY");
      if (BackendProgram::classHeadersEnabled(context, config)) {
        writer.set(
          key,
          Optimize.InputFile(
            O.createKeyedIRHeader(context, config, prevPhase.rootsIR),
            config,
          ),
        );
        return void
      };
      prepared = if (config.incrementalSpecialization) {
        Some(
          O.collectFunctionIRPlan(
            context,
            functionIRShared,
            functionIRCommon.getArray(context, SKStore.IID(0))[0],
            functionIRIdentities.getArray(context, SKStore.IID(0))[0],
          ),
        )
      } else {
        None()
      };
      specializer = prepared match {
      | Some(plan) -> plan.state.mclone(context)
      | None() ->
        // Discovery is local to this invocation. Reclaim its temporary work,
        // returning the completed state for native code generation.
        state = runCompilerPhase("specialization/sequential", () ->
          SKStore.withRegion(context, (_, context) ~> {
            sp = O.createSpecializer(
              context,
              partialConfig,
              converter.forSequential(),
              specializerEmptyDir,
            ).mclone(context);
            for (root in prevPhase.rootsIR.forceCompile) {
              sp.requestFunction(root, Array[], Array[])
            };
            sp.specializePendingFuns();
            sp.toFixed(context);
            sp.chill()
          })
        );
        if (config.verbose) print_error("Sequential specialization complete");
        state.mclone(context)
      };

      specializer.!canCreateNewSClasses = false;
      // Return from the callback so context.update() and database persistence
      // still finish normally in specialization-only experiments.
      if (config.stopAfterSpecialization) return void;

      roots = prevPhase.rootsIR;
      env = O.createIR(
        context,
        config,
        roots,
        specializer,
        if (config.incrementalSpecialization) Some(functionIR) else None(),
        prepared,
        if (BackendProgram::enabled(context, config)) {
          Some(functionIRProgram.returnTuples)
        } else {
          None()
        },
      );
      writer.set(key, Optimize.InputFile(env, config))
    },
  );
  backendOptimizeDir = backendIRDir.map(
    SKStore.IID::keyType,
    Optimize.OutputFile::type,
    context,
    SKStore.DirName::create("/backendOptimize/"),
    (context, writer, key, values) ~> {
      input = values.first;
      config = input.config;
      output = if (config.incrementalSpecialization) {
        Optimize.compileAllIncrementally(
          context,
          BackendProgram(
            backendIRDir,
            functionIRProgram.functions,
            Some(functionIRProgram.classes),
          ),
        ) match {
        | Some(output) -> output
        | None() -> return void
        }
      } else {
        Optimize.OutputFile(
          createOptimizedFunctions(context, input.env, config),
          Optimize.workConfig(config),
        )
      };
      writer.set(key, output)
    },
  );
  // Keep final reachability, escape analysis and lowering downstream of the
  // fixed-point coordinator. Equal intermediate results do not repeat them.
  optimizedProgram = Optimize.createProgram(context, backendOptimizeDir);
  reachability = Reachability.createCache(context, optimizedProgram);
  backendReachableDir = optimizedProgram.header.map(
    SKStore.IID::keyType,
    Optimize.InputFile::type,
    context,
    SKStore.DirName::create("/backendReachable/"),
    (context, writer, key, values) ~> {
      input = values.first;
      writer.set(
        key,
        Optimize.InputFile(
          if (input.config.incrementalSpecialization) {
            reachability.finish(context, input.env, input.config)
          } else {
            finishOptimizedFunctions(input.env, input.config)
          },
          input.config,
        ),
      )
    },
  );
  loweredProgram = Lower.incrementalLower(
    context,
    BackendProgram(backendReachableDir, reachability.functions),
  );
  backendLowerDir = loweredProgram.header;
  graphCache = AsmOutput.createGraphCache(context, loweredProgram);
  backendGraphDir = backendLowerDir.map(
    SKStore.IID::keyType,
    AsmOutput.NativeGraphFile::type,
    context,
    SKStore.DirName::create("/backendGraph/"),
    (context, writer, key, values) ~> {
      env = values.first.env;
      config = backendDir.getArray(context, SKStore.IID(0))[0].value;
      if (AsmOutput.collectionEmission(context, config)) {
        writer.set(key, AsmOutput.NativeGraphFile(Array[], config));
        return void
      };
      defs = runCompilerPhase("native/create_asm_graph", () -> {
        if (config.incrementalSpecialization) {
          graphCache.assemble(context, env)
        } else {
          AsmOutput.createAsmDefGraph(env, config)
        }
      });

      runCompilerPhase("native/merge_asm_graph", () -> {
        AsmOutput.mergeIdenticalAsmDefs(defs, config.debug)
      });

      runCompilerPhase("native/create_asm_symbols", () -> {
        AsmOutput.assignFinalSymbols(
          defs,
          AsmOutput.incrementalEmission(config),
        )
      });

      writer.set(
        key,
        AsmOutput.NativeGraphFile(defs.values().collect(Array), config),
      )
    },
  );
  emission = AsmOutput.createEmissionCache(
    context,
    backendGraphDir,
    graphCache,
  );
  backendEmitDir = backendGraphDir.map(
    SKStore.IID::keyType,
    ConfigFile::type,
    context,
    SKStore.DirName::create("/backendEmit/"),
    (context, _writer, _key, values) ~> {
      input = values.first;
      config = input.config;
      defs = mutable AsmOutput.AsmDefIDToAsmDef{pos => FileRange.builtin};
      for (def in input.defs) defs.set(def.id, def);
      positions = if (AsmOutput.incrementalEmission(config)) {
        SourcePositions.Table{}
      } else {
        SourcePositions.Table::read(context)
      };
      config.emit match {
      | "llvm-ir" -> compile_llvm_ir(defs, config, positions)
      | "link" | "cdylib" ->
        // Native linking does not use the wasm export list. Reading all
        // declarations here would dirty emission for an unused helper edit.
        wasm_exports = if (config.isWasm()) {
          outerIst
            .getFuns(context, defsProj)
            .filter(f ->
              annotationsContainParam(
                f.annotations,
                "@wasm_export",
                f.getPos(),
              ).isSome() ||
                annotationsContainParam(
                  f.annotations,
                  "@export",
                  f.getPos(),
                ).isSome()
            )
            .map(exportName)
        } else {
          Array[]
        };
        if (AsmOutput.incrementalEmission(config)) {
          _ = AsmOutput.emissionPreambleDir.getArray(context, SKStore.IID(0));
          if (AsmOutput.collectionEmission(context, config)) {
            link_incremental_objects(
              emission.objectFiles(context),
              config,
              wasm_exports,
            )
          } else {
            modules = emission.contents(context);
            if (modules.isEmpty()) {
              // Unsupported opaque user preambles retain the previous native path.
              compile_binary(
                defs,
                config,
                wasm_exports,
                SourcePositions.Table::read(context),
              );
              dir = config.output + ".llvm";
              if (!FileSystem.exists(dir)) {
                runShell(Array["mkdir", "-p", dir], config.verbose)
              };
              FileSystem.writeTextFile(dir + "/outputs", config.output + ".ll")
            } else {
              compile_incremental_binary(modules, config, wasm_exports)
            }
          }
        } else {
          compile_binary(defs, config, wasm_exports, positions)
        }
      | "sklib" ->
        invariant_violation("--emit=sklib should have been handled earlier")
      | _ ->
        invariant_violation("Unsupported value for `--emit`: " + config.emit)
      }
    },
  );

  context.setDir(
    context
      .unsafeGetEagerDir(backendEmitDir.dirName)
      .withTimeStack(
        SKStore.TimeStack::create(context, SKStore.Time(Int::max)),
      ),
  );

  (backendDir, tickDir)
}

fun compile(
  config: Config.Config,
  context: mutable SKStore.Context,
  fileNames: Array<String>,
  deferUpdate: Bool = false,
): void {
  AsmOutput.checkArtifactPolicy(context);
  if (config.incrementalSpecialization) {
    indexedVariance = Environ.varOpt("SKC_INDEX_VARIANCE").isSome();
    context.getPersistent(varianceIndexPolicyKey) match {
    | Some(SKStore.BoolFile(previous)) if (previous != indexedVariance) ->
      print_error(
        "Changing SKC_INDEX_VARIANCE requires a fresh --init cache.\n",
      );
      skipExit(2)
    | Some(SKStore.BoolFile _) -> void
    | None() ->
      context.setPersistent(
        varianceIndexPolicyKey,
        SKStore.BoolFile(indexedVariance),
      )
    | _ -> invariant_violation("Unexpected variance index policy")
    };
    hierarchical =
      config.compactSpecializer &&
      Environ.varOpt("SKC_HIERARCHICAL_DISCOVERY").isSome();
    context.getPersistent(discoveryHierarchyPolicyKey) match {
    | Some(SKStore.BoolFile(previous)) if (previous != hierarchical) ->
      print_error(
        "Changing SKC_HIERARCHICAL_DISCOVERY requires a fresh --init cache.\n",
      );
      skipExit(2)
    | Some(SKStore.BoolFile _) -> void
    | None() ->
      context.setPersistent(
        discoveryHierarchyPolicyKey,
        SKStore.BoolFile(hierarchical),
      )
    | _ -> invariant_violation("Unexpected discovery hierarchy policy")
    };
    context.getPersistent(classPartitionPolicyKey) match {
    | Some(
      SKStore.BoolFile(partitioned),
    ) if (partitioned != config.partitionClasses) ->
      print_error(
        "Changing --partition-classes requires a fresh --init cache.\n",
      );
      skipExit(2)
    | Some(SKStore.BoolFile _) -> void
    | None() ->
      context.setPersistent(
        classPartitionPolicyKey,
        SKStore.BoolFile(config.partitionClasses),
      )
    | _ -> invariant_violation("Unexpected class partition policy")
    };
    context.getPersistent(discoveryStoragePolicyKey) match {
    | Some(
      SKStore.BoolFile(compact),
    ) if (compact != config.compactSpecializer) ->
      print_error(
        "Changing --compact-specializer requires a fresh --init cache.\n",
      );
      skipExit(2)
    | Some(SKStore.BoolFile _) -> void
    | None() ->
      context.setPersistent(
        discoveryStoragePolicyKey,
        SKStore.BoolFile(config.compactSpecializer),
      )
    | _ -> invariant_violation("Unexpected discovery storage policy")
    }
  };
  if (fileNames.isEmpty() && config.dependencies.isEmpty()) {
    print_error("fatal error: no input files\n");
    skipExit(4); // Exit code used by g++ for no input files
  };

  // In batch mode the LLVM version is checked once, up front.
  if (!config.batch_mode) {
    ensureCompatibleLLVMVersion()
  } else {
    SkipError.setBatchMode(context)
  };

  (backendDir, tickDir) = getOrInitializeBackend(
    context,
    config.trackedClosureBodies,
  );
  backendDir.writeArray(
    context,
    SKStore.IID(0),
    Array[ConfigFile(config.backendConfig())],
  );
  AsmOutput.refreshEmissionPreamble(context, config);
  AsmOutput.refreshArtifactInputs(context, config);
  tickDir.writeArray(
    context,
    SKStore.IID(0),
    Array[TickFile(context.getTick())],
  );

  make_input_source_path = (pkg_base_dir, src_path) ~> {
    res = Path.join(pkg_base_dir, src_path);
    if (config.canonize_paths) {
      !res = config.cwd.makeRelative(res);
    };
    res
  };

  runCompilerPhase("frontend/read_files", () -> {
    FileCache.writeFiles(
      context,
      fileNames,
      config.dependencies,
      config.lib_name,
      make_input_source_path,
    )
  });

  if (
    !config.stopAfterSpecialization &&
    config.output != "-" &&
    (!FileSystem.exists(config.output) || emissionOutputsMissing(config))
  ) {
    // Output files are external side effects. Replay the final backend map
    // when the output disappears, preserving cached specialization work.
    key: SKStore.Key = SKStore.IID(0);
    reader: SKStore.TArrowKey<SKStore.Key> = SKStore.TArrowKey::create{
      parentName => if (config.emit == "sklib") backendDir.dirName else {
        SKStore.DirName::create("/backendGraph/")
      },
      childName => SKStore.DirName::create(
        if (config.emit == "sklib") "/backendPhase1/" else "/backendEmit/",
      ),
      key,
    };
    context.invalidateReader(reader);
  };

  if (deferUpdate) return void;
  runCompilerPhase("frontend/update", () -> context.update());

  // Also check invocations that bypass or reuse the backend entry point,
  // including --check. Failures abort before the transaction is persisted.
  throwIfFrontendErrors(context)
}

fun compilerAfterOptimizer(dir: SKStore.DirName): Bool {
  name = dir.toString();
  name.startsWith("/optimizer/output-") ||
    name.startsWith("/reachability/") ||
    name.startsWith("/native-lower/") ||
    name.startsWith("/llvm-graph/") ||
    name.startsWith("/llvm-emit/") ||
    dir == SKStore.DirName::create("/backendReachable/") ||
    dir == SKStore.DirName::create("/backendLower/") ||
    dir == SKStore.DirName::create("/backendGraph/") ||
    dir == SKStore.DirName::create("/backendEmit/")
}

// These are allocation boundaries, not semantic phase barriers. Stop only
// after an entire arrow, retain its pending work, and resume the same ordered
// queue. This bounds the newly retained graph copied at one synchronization.
const backendMemoryBoundaries: SortedSet<String> = SortedSet[
  "/reachability/live/",
  "/native-lower/functions/",
  "/llvm-graph/functions/",
  "/llvm-graph/shared/",
  "/llvm-graph/nodes/",
  "/llvm-graph/resolved-nodes/",
  "/llvm-graph/sharing-candidates/",
  "/llvm-graph/shared-definitions/",
  "/llvm-emit/keyed-definitions/",
  "/llvm-emit/modules/",
];

// Sequential passes still allocate whole-program intermediates. Their output
// rows are continuation state too: synchronize them before starting the next
// phase so temporary versions from the previous phase can be reclaimed.
const sequentialBackendMemoryBoundaries: SortedSet<String> = SortedSet[
  "/backendReachable/",
  "/backendLower/",
  "/backendGraph/",
  "/backendEmit/",
];
const sequentialPipelineKey: String = "COMPILER_SEQUENTIAL_PIPELINE";

// Each callback leaves all continuation state in the context. runPipeline
// synchronizes it and reclaims the callback's temporary heap before reentry.
// Definitions are fixed for the whole compiler. Invocation options are backend
// input data; reactive work captures handles, never invocation snapshots.
const compilerPipeline: Array<mutable SKStore.Context ~> Bool> = Array[
  context ~> {
    context.removeGlobal(specializationWorkKey);
    context.setGlobal(specializationProgressKey, SKStore.IntFile(0));
    context.setGlobal(Optimize.progressKey, SKStore.IntFile(0));
    config = ConfigFile::type(
      context.getGlobal(invocationConfigKey).fromSome(),
    ).value;
    context.setGlobal(
      sequentialPipelineKey,
      SKStore.BoolFile(!config.incrementalSpecialization),
    );
    compile(config, context, config.input_files, true);
    context.removeGlobal(invocationConfigKey);
    true
  },
  context ~> {
    partitioned = context.getPersistent(classPartitionPolicyKey) match {
    | Some(SKStore.BoolFile(enabled)) -> enabled
    | _ -> false
    };
    roundLimit = context.getGlobal(specializationProgressKey) match {
    | Some(previousRound @ SpecializerProgress _) -> previousRound.round - 1
    // Existing cached rounds must propagate their changes before deciding
    // whether discovery needs a new checkpoint. Deferring them here would
    // postpone new requests until after the specialization driver has finished.
    | _ -> Int::max
    };
    boundary = context.updateUntilBoundary(
      dir ~> dir == SKStore.DirName::create("/backendPhase2/"),
      dir ~> {
        name = dir.toString();
        dir == SKStore.DirName::create("/specializer/") ||
          (partitioned &&
            (name.startsWith("/specializer/reduced1/") ||
              name == "/specializer/class-attempts/"))
      },
      dir ~> {
        name = dir.toString();
        // Keyed bodies can update without changing the coordinator's header.
        // Keep downstream work behind the phase barrier in that case too.
        if (compilerAfterOptimizer(dir) || name.startsWith("/optimizer/")) {
          false
        } else if (
          name.startsWith("/specializer/reduced1/") ||
          name.startsWith("/specializer/merge1/")
        ) {
          name.split("/")[3].toInt() <= roundLimit
        } else {
          true
        }
      },
    );
    throwIfFrontendErrors(context);
    progressOpt = context.getGlobal(specializationProgressKey);
    progressOpt match {
    | Some(progress @ SpecializerProgress _) if (!progress.complete) ->
      key: SKStore.Key = SKStore.IID(0);
      reader: SKStore.TArrowKey<SKStore.Key> = SKStore.TArrowKey::create{
        parentName => SKStore.DirName::create("/backend/"),
        childName => SKStore.DirName::create("/specializer/"),
        key,
      };
      context.invalidateReader(reader);
      false
    | _ -> boundary != Some(false)
    }
  },
  context ~> {
    sequential = context.getGlobal(sequentialPipelineKey) match {
    | Some(SKStore.BoolFile(value)) -> value
    | _ -> false
    };
    (beforeLimit, afterLimit, afterConst) = context.getGlobal(
      Optimize.progressKey,
    ) match {
    | Some(previousProgress @ Optimize.Progress _) ->
      (
        if (previousProgress.afterConst) previousProgress.beforeRound else {
          previousProgress.round - 1
        },
        if (previousProgress.afterConst) previousProgress.round - 1 else -1,
        previousProgress.afterConst,
      )
    // Body rows can invalidate existing rounds without changing the input
    // header. Let those rounds reach the coordinator while its continuation
    // phase is active; the final drain cannot resume an incomplete optimizer.
    | _ -> (Int::max, Int::max, true)
    };
    boundary = context.updateUntilBoundary(
      dir ~> dir == SKStore.DirName::create("/backendReachable/"),
      dir ~>
        dir == SKStore.DirName::create("/backendOptimize/") ||
          (sequential && dir == SKStore.DirName::create("/backendPhase2/")),
      dir ~> {
        name = dir.toString();
        if (compilerAfterOptimizer(dir)) {
          false
        } else if (name.startsWith("/optimizer/before-const/")) {
          name.split("/")[3].toInt() <= beforeLimit
        } else if (name.startsWith("/optimizer/after-const/")) {
          name.split("/")[3].toInt() <= afterLimit
        } else if (name == "/optimizer/lower-const/") {
          afterConst
        } else {
          true
        }
      },
    );
    throwIfFrontendErrors(context);
    context.getGlobal(Optimize.progressKey) match {
    | Some(
      pendingProgress @ Optimize.Progress _,
    ) if (!pendingProgress.complete) ->
      key: SKStore.Key = SKStore.IID(0);
      reader: SKStore.TArrowKey<SKStore.Key> = SKStore.TArrowKey::create{
        parentName => SKStore.DirName::create("/backendPhase2/"),
        childName => SKStore.DirName::create("/backendOptimize/"),
        key,
      };
      context.invalidateReader(reader);
      false
    | _ -> boundary != Some(false)
    }
  },
  context ~> {
    sequential = context.getGlobal(sequentialPipelineKey) match {
    | Some(SKStore.BoolFile(value)) -> value
    | _ -> false
    };
    fineBoundaries = Environ.varOpt("SKC_CHECKPOINT_BACKEND_PHASES").isSome();
    complete = if (sequential || fineBoundaries) {
      context.updateUntilBoundary(
        _ ~> false,
        dir ~>
          (sequential &&
            sequentialBackendMemoryBoundaries.contains(dir.toString())) ||
            (fineBoundaries && backendMemoryBoundaries.contains(dir.toString()))
        ,
      ) != Some(false)
    } else {
      context.update();
      true
    };
    throwIfFrontendErrors(context);
    complete
  },
];

// Compiler policy only; SKStore owns checkpoint advancement, synchronization,
// and temporary-memory reclamation between steps.
fun runCompilerPipeline(config: Config.Config, debugSKStore: Bool): void {
  SKStore.runPipeline(
    SKStore.Context::create{},
    pipelinePhaseKey,
    compilerPipeline,
    (context, phase) ~> {
      profileCompilerMemory(context, "before-" + phase);
      context.!debugMode = debugSKStore;
      if (phase == 0) {
        context.!newDirs = SortedSet[];
        // Keep full archive source inputs out of the reactive backend row.
        // Writing them there and normalizing afterward still leaves it dirty.
        context.setGlobal(invocationConfigKey, ConfigFile(config))
      }
    },
    context ~> {
      context.removeGlobal(specializationWorkKey);
      context.removeGlobal(specializationProgressKey);
      context.removeGlobal(Optimize.progressKey);
      context.removeGlobal(sequentialPipelineKey)
    },
    exn ~> {
      print_error(exn.getMessage());
      skipExit(2)
    },
  );
  if (Environ.varOpt("SKC_MEMORY_STATS").isSome()) {
    SKStore.withContext(context -> profileCompilerMemory(context, "complete"))
  }
}

// Type the stdlib (dependencies) once into `context`, with no config written
// so the backend mapper never fires — leaving a clean "warm" base that carries
// the typed stdlib and no unit-specific state.
fun warm_stdlib(config: Config.Config, context: mutable SKStore.Context): void {
  _ = getOrInitializeBackend(context, config.trackedClosureBodies);
  make_input_source_path = (pkg_base_dir, src_path) ~> {
    res = Path.join(pkg_base_dir, src_path);
    if (config.canonize_paths) {
      !res = config.cwd.makeRelative(res);
    };
    res
  };
  FileCache.writeFiles(
    context,
    Array[],
    config.dependencies,
    config.lib_name,
    make_input_source_path,
  );
  context.update()
}

// Compile many units in one process, sharing the stdlib type-checking that
// is ~64% of a one-shot compile. The stdlib is typed once into a warm base
// context; each unit then compiles on a cheap copy-on-write clone of that
// base, so its typing (and any compile error, which would otherwise corrupt
// the shared reactive state) is fully isolated — the base stays pristine and
// a failed unit doesn't affect the others. Each manifest line is:
//   <output> <mainFn> <input.sk> [<input2.sk> ...]
// (whitespace-separated), where <mainFn> is exported as skip_main.
fun compile_batch(
  base_config: Config.Config,
  context: mutable SKStore.Context,
  manifest_path: String,
): void {
  ensureCompatibleLLVMVersion();
  SkipError.setBatchMode(context);
  warm_stdlib(base_config, context);
  lines = FileSystem.readTextFile(manifest_path).split("\n");
  failures = 0;
  for (line in lines) {
    parts = line.split(" ").filter(p -> !p.isEmpty()).collect(Array);
    if (parts.isEmpty()) {
      continue
    };
    if (parts.size() < 3) {
      print_error(`Invalid batch manifest line: ${line}\n`);
      skipExit(1)
    };
    output = parts[0];
    mainFn = parts[1];
    inputs = parts.drop(2);
    unit_config = base_config.withUnit(inputs, output, mainFn);
    // Compile each unit on a throwaway clone of the warm base. The clone
    // isolates the unit's typing (and any compile error, which would
    // otherwise corrupt the shared reactive state) from the base and the
    // other units; withForkedContext reclaims the clone's memory afterwards
    // so a large batch does not accumulate per-unit state.
    try {
      SKStore.withForkedContext(context, ctx ~>
        compile(unit_config, ctx, inputs)
      )
    } catch {
    | err @ SkipError.CompileFailureException _ ->
      msg = err.getMessage();
      print_error(msg);
      // Also record this unit's errors next to its (unwritten) output, so a
      // caller driving many units can attribute failures per unit without
      // parsing the interleaved stderr stream. A successful unit writes its
      // artifact at `output` and no `.err`; a failed one writes `.err` and no
      // artifact, giving an unambiguous per-unit signal.
      FileSystem.writeTextFile(output + ".err", msg);
      !failures = failures + 1
    | exn -> throw exn
    }
  };
  if (failures > 0) {
    print_error(`Batch compilation failed: ${failures} unit(s) had errors.\n`);
    skipExit(2)
  }
}

fun compile_llvm_ir(
  defs: readonly AsmOutput.AsmDefIDToAsmDef,
  conf: Config.Config,
  positions: SourcePositions.Table,
): void {
  runCompilerPhase("native/write_asm_files", () -> {
    AsmOutput.writeOutputFiles(
      defs,
      conf.input_files,
      conf.output,
      conf,
      positions,
    )
  })
}

fun compile_binary(
  defs: readonly AsmOutput.AsmDefIDToAsmDef,
  conf: Config.Config,
  exports: Array<String>,
  positions: SourcePositions.Table,
): void {
  // TODO: Use `mkstemp()` instead.
  llFile = conf.output + ".ll";
  inputs = runCompilerPhase("native/write_asm_files", () ->
    AsmOutput.writeNativeOutputFiles(defs, conf, positions)
  );

  runCompilerPhase("native/link", () -> {
    getLinkArgs(llFile, conf, exports, Some(inputs)).each(args -> {
      if (conf.no_link) {
        print_string("---LINK_ARGS_BEGIN---");
        args.each(print_string);
        print_string("---LINK_ARGS_END---")
      } else {
        runShell(args, conf.verbose)
      }
    })
  })
}

// These files are external side effects. Missing artifacts replay only final
// materialization; cached module text remains in the eager emission collection.
fun emissionOutputsMissing(config: Config.Config): Bool {
  if (!AsmOutput.incrementalEmission(config)) return false;
  manifest = config.output + ".llvm/outputs";
  !FileSystem.exists(manifest) ||
    FileSystem.readTextFile(manifest).split("\n").any(path ->
      !path.isEmpty() && !FileSystem.exists(path)
    )
}

fun compile_incremental_binary(
  modules: Array<(String, String)>,
  config: Config.Config,
  exports: Array<String>,
): void {
  dir = config.output + ".llvm";
  if (!FileSystem.exists(dir)) {
    runShell(Array["mkdir", "-p", dir], config.verbose)
  };
  outputs = modules.flatMap(part -> {
    base = dir + "/" + part.i0;
    Array[base + ".ll", base + ".o", base + ".flags"]
  });
  // Publish the complete recovery plan before compiling. A failed first build
  // of a newly introduced module must also be detectable on the next invocation.
  FileSystem.writeTextFile(dir + "/outputs", outputs.join("\n"));
  tool = System.subprocess(Array["clang++", "--version"]).fromSuccess();
  invariant(tool.success(), tool.stderr);
  objects = modules.map(part ->
    compile_incremental_module(part.i0, part.i1, config, tool.stdout)
  );
  link_incremental_objects(objects, config, exports)
}

fun compile_incremental_module(
  name: String,
  contents: String,
  config: Config.Config,
  toolVersion: String,
  throwOnFailure: Bool = false,
): String {
  dir = config.output + ".llvm";
  ll = dir + "/" + name + ".ll";
  object = dir + "/" + name + ".o";
  stamp = dir + "/" + name + ".flags";
  temp = object + ".tmp";
  args = Array[
    "clang++",
    `-O${config.optLevel}`,
    `--target=${config.target}`,
    "-c",
    ll,
    "-o",
    temp,
  ].concat(if (config.emit == "cdylib") Array["-fPIC"] else Array[])
    .concat(config.link_args)
    .concat(
      config.dependencies.values().collect(Array).flatMap(dep -> dep.i1.links),
    );
  flags = toolVersion + "\n" + args.join("\n");
  changed = !FileSystem.exists(ll) || FileSystem.readTextFile(ll) != contents;
  if (
    changed ||
    !FileSystem.exists(object) ||
    !FileSystem.exists(stamp) ||
    FileSystem.readTextFile(stamp) != flags
  ) {
    // Invalidate success before replacing the input. A failed clang must never
    // make a retry mistake the old object for a successful compilation.
    if (FileSystem.exists(stamp)) {
      runShell(Array["rm", stamp], config.verbose, throwOnFailure)
    };
    if (changed) FileSystem.writeTextFile(ll, contents);
    runShell(args, config.verbose, throwOnFailure);
    runShell(Array["mv", temp, object], config.verbose, throwOnFailure);
    FileSystem.writeTextFile(stamp, flags)
  };
  object
}

fun link_incremental_objects(
  objects: Array<String>,
  config: Config.Config,
  exports: Array<String>,
): void {
  getLinkArgs("", config, exports, Some(objects)).each(args -> {
    if (config.no_link) {
      print_string("---LINK_ARGS_BEGIN---");
      args.each(print_string);
      print_string("---LINK_ARGS_END---")
    } else {
      runShell(args, config.verbose)
    }
  })
}

fun compile_sklib(context: mutable SKStore.Context, conf: Config.Config): void {
  runCompilerPhase("native/write_sklib", () -> {
    // Archive emission reads native files below. Track the package input so
    // source edits also rerun this mapper when its configuration is unchanged.
    _ = FileCache.packageDir.getArray(
      context,
      FileCache.InputPackageName(conf.lib_name),
    );
    accessed_env_vars = SortedSet::createFromItems(
      FileCache.packageEnvAccessDir.getArray(
        context,
        SKStore.SID(conf.lib_name.fromSome()),
      ).map(v -> v.value),
    );
    env_dir = FileCache.packageEnvDir(conf.lib_name);
    env_vars = SortedMap::createFromIterator(
      accessed_env_vars
        .map(v -> (v, env_dir.get(context, SKStore.SID(v)).value))
        .iterator(),
    );

    // NOTE: Static libraries (`.a` archives) provided as input files are
    // bundled into the `sklib`.
    sklib = mutable SklibBuilder(
      conf.lib_name.fromSome(),
      conf.target,
      getcwd(),
    );
    env_vars.each((k, v) -> sklib.add_env_var(k, v));
    conf.direct_dependencies.each(dep_name ->
      sklib.add_dependency(dep_name, conf.dependencies[dep_name].i1)
    );
    conf.static_libraries.each(sklib.add_static_library);
    conf.link_args.each(sklib.add_link_arg);
    conf.preambles.each(sklib.add_preamble);
    conf.input_files.each(sklib.add_source);

    ar_file = IO.File::open(
      conf.output,
      IO.OpenOptions{write => true, create => true, truncate => true},
    );
    written = if (Environ.varOpt("SKC_ARCHIVE_ENCODING_CACHE").isSome()) {
      Sklib.withSourceEncodingCache(context, cache ->
        sklib.write(ar_file, Some(cache))
      )
    } else {
      sklib.write(ar_file)
    };
    written match {
    | Success _ -> void
    | Failure(err) ->
      print_error(`Could not write ${conf.output}: ${err}`);
      skipExit(3)
    };
    ar_file.close();

    p = System.subprocess(Array["llvm-ar", "s", conf.output]).fromSuccess();
    if (!p.success()) {
      print_error(`ranlib failed: ${p.stdout} ${p.stderr}`);
      skipExit(3)
    }
  })
}

fun exportName(f: OuterIst.FunDef): String {
  pos = f.getPos();
  annotationsContainParam(f.annotations, "@wasm_export", pos) match {
  | Some(s) if (!s.isEmpty()) -> return s
  | _ -> void
  };
  annotationsContainParam(f.annotations, "@export", pos) match {
  | Some(s) if (!s.isEmpty()) -> return s
  | _ -> void
  };
  "SKIP_" + AsmOutput.mangle(f.origName)
}
