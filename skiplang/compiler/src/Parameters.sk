base class Parameters<+T> uses Hashable[T: Hashable], Equality[T: Equality] {
  fun map<T2>(f: T -> T2): Parameters<T2>;
  fun foldl<R>(f: (R, T) -> R, init: R): R;
  fun map_foldl<T2, R>(f: (R, T) -> (R, T2), init: R): (R, Parameters<T2>);
  fun filter(p: T -> Bool): this;
  fun size(): Int;
  fun isEmpty(): Bool;
  fun all(f: T -> Bool): Bool;
  fun any(f: T -> Bool): Bool;
  fun each(f: T -> void): void;
  fun combine<T2>(p2: Parameters<T2>): Parameters<(T, T2)>;
  fun toList(): List<T>;
  fun toArray(): Array<T>;
  fun find(p: T -> Bool): ?T;
  fun eqBy<U>[T: U](other: Parameters<U>, eq: (U, U) -> Bool): Bool;
  fun values(): mutable Iterator<T>;

  fun ==<U: Equality>[T: U](other: Parameters<U>): Bool {
    (this, other) match {
    | (Positional(x), Positional(y)) -> x == y
    | (Named(x), Named(y)) -> x == y
    | (Mixed(x1, x2, _), Mixed(y1, y2, _)) -> x1 == y1 && x2 == y2
    | _ -> false
    }
  }

  fun !=<U: Equality>[T: U](other: Parameters<U>): Bool {
    !(this == other)
  }
}

class Positional<+T>(args: Array<T>) extends Parameters<T> {
  static fun create(): Positional<T> {
    Positional(Array[])
  }

  fun values(): mutable Iterator<T> {
    this.args.values()
  }

  fun map<T2>(f: T -> T2): Positional<T2> {
    Positional(this.args.map(f))
  }

  fun foldl<R>(f: (R, T) -> R, init: R): R {
    this.args.foldl(f, init)
  }

  fun map_foldl<T2, R>(f: (R, T) -> (R, T2), init: R): (R, Positional<T2>) {
    (r, l) = this.args.mapAcc(f, init);
    (r, Positional(l))
  }

  fun size(): Int {
    this.args.size()
  }

  fun isEmpty(): Bool {
    this.args.isEmpty()
  }

  fun all(f: T -> Bool): Bool {
    this.args.all(f)
  }

  fun any(f: T -> Bool): Bool {
    this.args.any(f)
  }

  fun each(f: T -> void): void {
    this.args.each(f)
  }

  fun inspect(): Inspect {
    InspectVector(
      "Positional",
      {
        items = mutable Vector[];
        for (value in this.args) {
          items.push(inspect(value))
        };
        items.toArray();
      },
    );
  }

  fun combine<T2>(p2: Parameters<T2>): Positional<(T, T2)> {
    p2 match {
    | Positional(y) ->
      invariant(
        this.args.size() == y.size(),
        "combine different length positional",
      );
      Positional(this.args.zip(y))
    | _ -> invariant_violation("combine named into positional")
    }
  }

  fun toList(): List<T> {
    List::createFromItems(this.args)
  }

  fun toArray(): Array<T> {
    this.args
  }

  fun filter(p: T -> Bool): this {
    Positional(this.args.filter(p))
  }

  fun find(p: T -> Bool): ?T {
    this.args.find(p)
  }

  fun eqBy<U>[T: U](other: Parameters<U>, eq: (U, U) -> Bool): Bool {
    other match {
    | Positional(args) -> this.args.eqBy(args, eq)
    | _ -> false
    }
  }
}

class Named<+T>(args: UMap<T>) extends Parameters<T> {
  fun map<T2>(f: T -> T2): Named<T2> {
    Named(this.args.map((_, v) -> f(v)))
  }

  fun values(): mutable Iterator<T> {
    this.args.values()
  }

  fun foldl<R>(f: (R, T) -> R, init: R): R {
    this.args.reduce((r, _, v) -> f(r, v), init)
  }

  fun map_foldl<T2, R>(f: (R, T) -> (R, T2), init: R): (R, Named<T2>) {
    (r, l) = this.args.mapAcc((r, _, v) -> f(r, v), init);
    (r, Named(l))
  }

  fun size(): Int {
    this.args.size()
  }

  fun isEmpty(): Bool {
    this.args.isEmpty()
  }

  fun all(f: T -> Bool): Bool {
    this.args.all((_key, value) -> f(value))
  }

  fun any(f: T -> Bool): Bool {
    this.args.any((_, v) -> f(v))
  }

  fun each(f: T -> void): void {
    for (_key => value in this.args) f(value)
  }

  fun inspect(): Inspect {
    InspectMap(
      "Named",
      {
        items = Vector::mcreate(this.size());
        this.args.each((key, value) ->
          items.push((inspect(key.i1), inspect(value)))
        );
        items.toArray();
      },
    );
  }

  fun combine<T2>(p2: Parameters<T2>): Named<(T, T2)> {
    p2 match {
    | Named(m2) -> Named(this.args.map((k, v1) -> (v1, m2[k])))
    | _ -> invariant_violation("combine positional into named")
    }
  }

  fun toList(): List<T> {
    List::createFromIterator(this.args.values())
  }

  fun toArray(): Array<T> {
    this.args.values().collect(Array)
  }

  fun filter(p: T -> Bool): this {
    Named(this.args.filter((_, x) -> p(x)))
  }

  fun find(p: T -> Bool): ?T {
    this.args.find((_, v) -> p(v))
  }

  fun eqBy<U>[T: U](other: Parameters<U>, eq: (U, U) -> Bool): Bool {
    other match {
    | Named(args) -> this.args.eqBy(args, eq)
    | _ -> false
    }
  }
}

/* A parameter list (or argument list) with both positional and named parts,
 * e.g. `fun f(a: Int){b: String}` called as `f(1){b => "x"}`.
 * `namedFirst` records the source order of the two groups at a call site
 * (`f{b => "x"}(1)`), so that argument evaluation can stay in source order;
 * for declared parameters it is always false (positional group comes first).
 */
/* A parameter list (or argument list) with both positional and named parts,
 * e.g. `fun f(a: Int){b: String}` called as `f(1){b => "x"}`.
 * `namedFirst` records the source order of the two groups at a call site
 * (`f{b => "x"}(1)`), so that argument evaluation can stay in source order;
 * for declared parameters it is always false (positional group comes first).
 *
 * Ordering contract: `foldl` and `map_foldl` honour `namedFirst` (source
 * order at call sites) and must be used when evaluation order matters;
 * `values`, `toArray`, `toList`, `each` and `inspect` are always
 * declaration-ordered (positional group first, then named) and must not be
 * used to decide evaluation order.
 */
class Mixed<+T>(
  positional: Array<T>,
  named: UMap<T>,
  namedFirst: Bool,
) extends Parameters<T> {
  fun values(): mutable Iterator<T> {
    this.positional.values().concat(this.named.values())
  }

  fun map<T2>(f: T -> T2): Mixed<T2> {
    Mixed(
      this.positional.map(f),
      this.named.map((_, v) -> f(v)),
      this.namedFirst,
    )
  }

  fun foldl<R>(f: (R, T) -> R, init: R): R {
    // At call sites `namedFirst` records the source order of the two groups,
    // so fold in source order to keep argument evaluation order.
    if (this.namedFirst) {
      this.positional.foldl(f, this.named.reduce((r, _, v) -> f(r, v), init))
    } else {
      this.named.reduce((r, _, v) -> f(r, v), this.positional.foldl(f, init))
    }
  }

  fun map_foldl<T2, R>(f: (R, T) -> (R, T2), init: R): (R, Mixed<T2>) {
    if (this.namedFirst) {
      (r1, m1) = this.named.mapAcc((r, _, v) -> f(r, v), init);
      (r2, l2) = this.positional.mapAcc(f, r1);
      (r2, Mixed(l2, m1, this.namedFirst))
    } else {
      (r1, l1) = this.positional.mapAcc(f, init);
      (r2, m2) = this.named.mapAcc((r, _, v) -> f(r, v), r1);
      (r2, Mixed(l1, m2, this.namedFirst))
    }
  }

  fun size(): Int {
    this.positional.size() + this.named.size()
  }

  fun isEmpty(): Bool {
    this.positional.isEmpty() && this.named.isEmpty()
  }

  fun all(f: T -> Bool): Bool {
    this.positional.all(f) && this.named.all((_, v) -> f(v))
  }

  fun any(f: T -> Bool): Bool {
    this.positional.any(f) || this.named.any((_, v) -> f(v))
  }

  fun each(f: T -> void): void {
    this.positional.each(f);
    for (_key => value in this.named) f(value)
  }

  fun inspect(): Inspect {
    InspectVector(
      "Mixed",
      Array[
        InspectVector("positional", this.positional.map(v -> inspect(v))),
        InspectMap(
          "named",
          {
            items = Vector::mcreate(this.named.size());
            this.named.each((key, value) ->
              items.push((inspect(key.i1), inspect(value)))
            );
            items.toArray();
          },
        ),
      ],
    );
  }

  fun combine<T2>(p2: Parameters<T2>): Mixed<(T, T2)> {
    p2 match {
    | Mixed(y1, y2, _) ->
      invariant(
        this.positional.size() == y1.size(),
        "combine different length positional",
      );
      invariant(
        this.named.size() == y2.size() &&
          this.named.all((k, _) -> y2.containsKey(k)),
        "combine different named keys",
      );
      Mixed(
        this.positional.zip(y1),
        this.named.map((k, v1) -> (v1, y2[k])),
        this.namedFirst,
      )
    | _ -> invariant_violation("combine mixed with non-mixed")
    }
  }

  fun toList(): List<T> {
    List::createFromItems(
      this.positional.concat(this.named.values().collect(Array)),
    )
  }

  fun toArray(): Array<T> {
    this.positional.concat(this.named.values().collect(Array))
  }

  fun filter(p: T -> Bool): this {
    Mixed(
      this.positional.filter(p),
      this.named.filter((_, x) -> p(x)),
      this.namedFirst,
    )
  }

  fun find(p: T -> Bool): ?T {
    this.positional.find(p) match {
    | Some(x) -> Some(x)
    | None() -> this.named.find((_, v) -> p(v))
    }
  }

  fun eqBy<U>[T: U](other: Parameters<U>, eq: (U, U) -> Bool): Bool {
    other match {
    | Mixed(args1, args2, _) ->
      this.positional.eqBy(args1, eq) && this.named.eqBy(args2, eq)
    | _ -> false
    }
  }
}
