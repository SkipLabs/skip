module alias T = SKTest;

module SkcTests;

private fun compile_cmd(
  files: readonly Sequence<String>,
  output: String,
  mainFn: String = "main",
): Array<String> {
  Array[
    "skc",
    "-O0",
    "--no-inline",
    "--export-function-as",
    mainFn + "=skip_main",
    "-o",
    output,
  ].concat(files.collect(Array))
}

private fun genValidTest(basename: String, mainFn: String): void {
  p = System.subprocess(
    compile_cmd(Array[basename + ".sk"], basename + ".bin", mainFn),
  ).fromSuccess();
  if (!p.success()) {
    T.fail(
      `Unexpected compile error\nstdout: ${p.stdout}\nstderr:\n${p.stderr}`,
    );
  };

  !p = System.subprocess(Array[basename + ".bin"]).fromSuccess();

  if (!p.success()) {
    T.fail(`Unexpected error\nstdout: ${p.stdout}\nstderr:\n${p.stderr}`);
  };

  actual = p.stdout;
  expected = FileSystem.readTextFile(basename + ".exp");

  T.expectEq(actual, expected)
}

// Compile a single invalid test in its own `skc` subprocess. Used when batching
// is disabled (see `main`); the default path reads pre-batched results instead
// (`runInvalidFromBatch`).
private fun genInvalidTest(basename: String): void {
  p = System.subprocess(
    compile_cmd(Array[basename + ".sk"], basename + ".bin"),
  ).fromSuccess();

  if (p.success()) {
    T.fail("Expected compile error")
  };

  // NOTE: The `.trim()` is needed because error messages seem to currently
  // have an extra newline.
  actual = p.stderr.trim();
  expected = FileSystem.readTextFile(basename + ".exp_err").trim();

  T.expectEq(actual, expected)
}

// Invalid tests are compiled together, up front, via `skc --batch` (see
// `batchCompileInvalid`), which shares the stdlib type-check across them. Each
// unit's result lands in a scratch dir: a binary at its output path if it
// compiled, or `<output>.err` diagnostics if it failed. Here we just read that
// result — no per-test `skc`.

// Deterministic scratch dir for batch-compiled test outputs, shared between
// the parent (which runs the batches) and the re-exec'd workers (which read
// the results). The parent recreates it each run, so there are no stale
// artifacts, and both derive the same path from `Environ.temp_dir()`.
private fun batchOutDir(): String {
  Path.join(Environ.temp_dir(), "skc_test_batch")
}

// Path a batch unit writes for `basename`: its binary on success, or
// `<path>.err` (the rendered diagnostics) on failure.
private fun batchOutput(basename: String): String {
  Path.join(batchOutDir(), basename.split("/").join("_") + ".bin")
}

private fun runInvalidFromBatch(basename: String): void {
  output = batchOutput(basename);
  if (FileSystem.exists(output)) {
    // It produced an artifact — an invalid test must fail to compile.
    T.fail("Expected compile error")
  };
  // NOTE: The `.trim()` is needed because error messages seem to currently
  // have an extra newline. The `.err` sidecar holds the same rendered errors a
  // one-shot `skc` writes to stderr, so this matches the old comparison.
  actual = FileSystem.readTextFile(output + ".err").trim();
  expected = FileSystem.readTextFile(basename + ".exp_err").trim();

  T.expectEq(actual, expected)
}

// Compile every invalid test once, up front, sharing the stdlib type-check
// across them via `skc --batch`. The set is sharded into `njobs` manifests run
// as parallel `skc --batch` processes (each still types the stdlib only once),
// which recovers the parallelism the per-test subprocess path had while paying
// the ~64% stdlib type-check cost a handful of times instead of ~800. `njobs`
// is the harness's own job count (see the `test_harness` call in `main`), so
// `skargo test -j N` scales the batch exactly as it scales the test run. Runs
// in the parent only, before `test_harness` forks the per-test workers; the
// workers then read each unit's result from `batchOutDir()`.
private fun batchCompileInvalid(
  basenames: readonly Sequence<String>,
  njobs: Int,
  shouldRun: (String, String) ~> Bool,
): void {
  outDir = batchOutDir();
  // Fresh dir each run: no stale binaries/diagnostics from a previous run.
  _ = system(`rm -rf '${outDir}' && mkdir -p '${outDir}'`);

  shards = Array::fillBy(njobs, _ -> mutable Vector<String>[]);
  i = 0;
  for (b in basenames) {
    // Only compile tests that will actually run (e.g. under a `--filter`); the
    // suite/name is derived the same way it is when registering the test.
    (suite, name) = b.stripPrefix("invalid_tests/").splitLast("/");
    if (!shouldRun(suite, name)) continue;
    // Manifest line: `<output> <mainFn> <input.sk>`. mainFn is irrelevant since
    // the compile must fail; the input stays CWD-relative so the paths embedded
    // in the diagnostics match the `.exp_err` goldens.
    shards[i % njobs].push(`${batchOutput(b)} main ${b}.sk`);
    !i = i + 1
  };

  cmds = mutable Vector<String>[];
  for ((si, shard) in shards.items()) {
    if (!shard.isEmpty()) {
      manifest = Path.join(outDir, `shard_${si}.manifest`);
      FileSystem.writeTextFile(manifest, shard.join("\n"));
      // `--batch` exits 2 when units fail (expected here) and prints their
      // errors to stderr; we read results from the scratch dir, so discard it.
      cmds.push(`skc --batch '${manifest}' -O0 --no-inline >/dev/null 2>&1`)
    }
  };

  if (!cmds.isEmpty()) {
    // Run the shards concurrently and wait for all of them.
    _ = System.subprocess(Array["sh", "-c", cmds.join(" & ") + " & wait"])
  }
}

// Split a module name into (suite, testName) at the underscore that
// separates the top-level directory from the rest.
// e.g. "Runtime_Float1" → ("Runtime", "Float1")
//      "Typechecking_Exhaustiveness_Foo" → ("Typechecking/Exhaustiveness", "Foo")
private fun splitModuleName(moduleName: String): (String, String) {
  // The test name is after the last underscore
  (prefix, testName) = moduleName.splitLast("_");
  // Convert remaining underscores to slashes for the suite path
  suite = prefix.split("_").join("/");
  (suite, testName)
}

// Discover @exptest-annotated functions. These are present when all
// test .sk files are compiled into this binary (i.e. when `tests` is
// not set in Skargo.toml, so Skargo auto-discovers all files in tests/).
private macro fun addExpTestFunctions(
  tests: mutable Map<String, mutable Vector<T.Test>>,
): readonly Set<String> {
  coveredModules = mutable Set[];
  #forEachFunction (@exptest, #function, #functionName) {
    // #functionName is "ModuleName.main"
    testFn = #function;
    (moduleName, _testName) = #functionName.splitFirst(".");
    coveredModules.insert(moduleName);
    (suite, testName) = splitModuleName(moduleName);
    tests
      .getOrAdd(suite, () -> mutable Vector[])
      .push(
        T.Test{
          name => testName,
          func => untracked () ~>
            T.expectStdout(testFn, `tests/${suite}/${testName}.exp`),
        },
      );
  };
  coveredModules
}

private fun incrementalFrontendErrors(): void {
  temp = System.subprocess(Array["mktemp", "-d"]).fromSuccess();
  T.expectTrue(temp.success(), temp.stderr);
  dir = temp.stdout.trim();
  source = dir + "/input.sk";
  output = dir + "/output.ll";
  data = dir + "/data";
  valid =
    "mutable class ErrorGateExample{} {\n" +
    "  fun foo(_x: Int): void { debug(\"foo\") }\n" +
    "  readonly fun run(): void { debug(\"before\") }\n" +
    "}\n" +
    "fun unused(): Int { 42 }\n" +
    "fun main(): void { (mutable ErrorGateExample{}).run() }\n";
  args = compile_cmd(Array[source], output).concat(
    Array["--emit=llvm-ir", "--verbose"],
  );
  writeSource = (contents, timestamp) -> {
    FileSystem.writeTextFile(source, contents);
    // FileCache uses second-resolution mtimes to discover edits.
    touched = System.subprocess(
      Array["touch", "-t", timestamp, source],
    ).fromSuccess();
    T.expectTrue(touched.success(), touched.stderr);
  };
  try {
    writeSource(valid, "200001010000.01");
    initial = System.subprocess(
      args.concat(Array["--init", data]),
    ).fromSuccess();
    T.expectTrue(initial.success(), "Initial compile: " + initial.stderr);
    T.expectTrue(
      System.subprocess(Array["test", "-f", output]).fromSuccess().success(),
      "Initial compile did not create output",
    );
    initialOutput = FileSystem.readTextFile(output);
    removed = System.subprocess(Array["rm", output]).fromSuccess();
    T.expectTrue(removed.success(), removed.stderr);

    // Recreate a deleted output without rediscovering classes/functions.
    replayed = System.subprocess(
      args.concat(Array["--data", data]),
    ).fromSuccess();
    T.expectTrue(replayed.success(), "Output replay: " + replayed.stderr);
    T.expectEq(FileSystem.readTextFile(output), initialOutput);
    T.expectFalse(replayed.stderr.contains("\"KK\""), replayed.stderr);
    T.expectFalse(replayed.stderr.contains("phase1 updated"), replayed.stderr);

    // An existing output still permits a fully cached update.
    cached = System.subprocess(
      args.concat(Array["--data", data]),
    ).fromSuccess();
    T.expectTrue(cached.success(), "Cached compile: " + cached.stderr);
    T.expectFalse(cached.stderr.contains("specializer created"), cached.stderr);

    removedBeforeErrors = System.subprocess(Array["rm", output]).fromSuccess();
    T.expectTrue(removedBeforeErrors.success(), removedBeforeErrors.stderr);

    // Method-body-only errors must abort before specialization, even when
    // the backend's projected declarations are unchanged. Multiple failing
    // definitions must still produce all of their diagnostics.
    invalid = valid.replace("debug(\"before\")", "this.foo(9)");
    for ((contents, timestamp, diagnostic) in Array[
      (invalid, "200001010000.02", "Try annotating 'foo' method as 'readonly'"),
      (
        invalid.replace(
          "fun unused(): Int { 42 }",
          "fun unused(): Int { \"bad\" }",
        ),
        "200001010000.03",
        "incompatible with the return type 'Int'",
      ),
    ]) {
      writeSource(contents, timestamp);
      failed = System.subprocess(
        args.concat(Array["--data", data]),
      ).fromSuccess();
      T.expectEq(failed.exitcode(), 2, failed.stderr);
      T.expectFalse(
        failed.stderr.contains("Incremental specialization:"),
        "Frontend errors reached specialization: " + failed.stderr,
      );
      T.expectTrue(
        failed.stderr.contains("Cannot call this method on a readonly object"),
        failed.stderr,
      );
      T.expectTrue(failed.stderr.contains(diagnostic), failed.stderr);
      T.expectFalse(
        failed.stderr.contains("Invariant violation"),
        failed.stderr,
      );
      T.expectFalse(failed.stdout.contains("\"KK\""), failed.stdout);
      T.expectFalse(failed.stdout.contains("phase1 updated"), failed.stdout);
      T.expectFalse(
        System.subprocess(Array["test", "-f", output]).fromSuccess().success(),
        "Failed frontend update emitted output",
      );
    };

    // The failed update must leave the last successful database usable.
    writeSource(valid.replace("before", "after"), "200001010000.04");
    recovered = System.subprocess(
      args.concat(Array["--data", data]),
    ).fromSuccess();
    T.expectTrue(recovered.success(), "Recovery compile: " + recovered.stderr);
    T.expectTrue(
      System.subprocess(Array["test", "-f", output]).fromSuccess().success(),
      "Recovery compile did not create output",
    );
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
    throw exn
  };
  removed = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
  T.expectTrue(removed.success(), removed.stderr);
}

// Exercise persisted relationships through generic variance, removals, and
// changes to inheritance, method bodies, methods, and layouts.
private fun incrementalRelationships(): void {
  temp = System.subprocess(Array["mktemp", "-d"]).fromSuccess();
  T.expectTrue(temp.success(), temp.stderr);
  dir = temp.stdout.trim();
  source = dir + "/input.sk";
  output = dir + "/program";
  data = dir + "/data";
  baseline =
    "base class RelationBase { fun value(): Int { 7 } }\n" +
    "class RelationChild(extra: Int = 2) extends RelationBase\n" +
    "class RelationBox<+T>(value: T) { fun get(): T { this.value } }\n" +
    "untracked fun main(): void {\n" +
    "  x: RelationBase = RelationChild();\n" +
    "  b: RelationBox<RelationBase> = RelationBox<RelationChild>(RelationChild());\n" +
    "  opt: ?RelationBox<RelationBase> = Some(b);\n" +
    "  print_raw((x.value() + opt.fromSome().get().value()).toString());\n" +
    "}\n";
  try {
    for ((text, expected, timestamp, initialize) in Array[
      (baseline, "14", "200001010000.01", true),
      (
        baseline.replace("Int { 7 }", "Int { 9 }"),
        "18",
        "200001010000.02",
        false,
      ),
      (
        baseline.replace("fun value()", "fun unused(): Int { 3 } fun value()"),
        "14",
        "200001010000.03",
        false,
      ),
      (
        baseline.replace(
          "extra: Int = 2",
          "extra: Int = 2, another: String = \"hello\"",
        ),
        "14",
        "200001010000.04",
        false,
      ),
      (
        baseline
          .replace(
            "class RelationBox",
            "class RelationOther() extends RelationBase\nclass RelationBox",
          )
          .replace(
            "x: RelationBase = RelationChild()",
            "x: RelationBase = RelationOther()",
          ),
        "14",
        "200001010000.05",
        false,
      ),
      (
        baseline.replace("RelationChild", "RelationReplacement"),
        "14",
        "200001010000.06",
        false,
      ),
      (baseline, "14", "200001010000.07", false),
      // A declared descendant changes frontend hierarchy metadata even when
      // it never becomes a specialized class. Its removal must leave the
      // existing class, metaclass, and variance relationships usable.
      (
        baseline.replace(
          "class RelationBox",
          "class RelationUnused() extends RelationBase\nclass RelationBox",
        ),
        "14",
        "200001010000.08",
        false,
      ),
      (baseline, "14", "200001010000.09", false),
    ]) {
      FileSystem.writeTextFile(source, text);
      T.expectTrue(
        System.subprocess(Array["touch", "-t", timestamp, source])
          .fromSuccess()
          .success(),
      );
      compiled = System.subprocess(
        compile_cmd(Array[source], output).concat(
          Array[if (initialize) "--init" else "--data", data],
        ),
      ).fromSuccess();
      T.expectTrue(compiled.success(), compiled.stderr);
      result = System.subprocess(Array[output]).fromSuccess();
      T.expectTrue(result.success(), result.stderr);
      T.expectEq(result.stdout, expected);
    };
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
    throw exn
  };
  T.expectTrue(
    System.subprocess(Array["rm", "-r", dir]).fromSuccess().success(),
  );
}

// Relation attachment has its own tracked rows. A body edit reuses them;
// adding/removing a reachable sibling invalidates the unchanged base row.
private fun incrementalLatchedRelations(): void {
  temp = System.subprocess(Array["mktemp", "-d"]).fromSuccess();
  T.expectTrue(temp.success(), temp.stderr);
  dir = temp.stdout.trim();
  types = dir + "/types.sk";
  source = dir + "/main.sk";
  output = dir + "/program.ll";
  data = dir + "/data";
  baseline =
    "fun latchUse(x: LatchPassBase): Int { x.value() + 0 }\n" +
    "untracked fun main(): void { debug(latchUse(LatchPassFirst()) + LatchPassIndependent().value()); }\n";
  args = compile_cmd(Array[types, source], output).concat(Array["--emit=llvm-ir"]);
  writePrefix = "WRITTEN:  /specializer/latch-classes/OuterIstToIR.SClassIDKey(SClassID(\"";
  baseWrite = writePrefix + "LatchPassBase\"))";
  independentWrite = writePrefix + "LatchPassIndependent\"))";
  try {
    FileSystem.writeTextFile(
      types,
      "base class LatchPassBase { fun value(): Int { 7 } }\n" +
        "class LatchPassFirst() extends LatchPassBase\n" +
        "class LatchPassSecond() extends LatchPassBase\n" +
        "class LatchPassIndependent() { fun value(): Int { 11 } }\n",
    );
    FileSystem.writeTextFile(source, baseline);
    stopped = System.subprocess(
      args.concat(Array["--init", data, "--stop-after-specialization"]),
    ).fromSuccess();
    T.expectTrue(stopped.success(), stopped.stderr);
    T.expectFalse(System.subprocess(Array["test", "-f", output]).fromSuccess().success());
    initial = System.subprocess(args.concat(Array["--data", data])).fromSuccess();
    T.expectTrue(initial.success(), initial.stderr);
    for ((contents, timestamp, relationsChanged) in Array[
      (baseline.replace("+ 0", "+ 1"), "200001010000.01", false),
      (
        baseline.replace(
          "latchUse(LatchPassFirst())",
          "latchUse(LatchPassFirst()) + latchUse(LatchPassSecond())",
        ),
        "200001010000.02",
        true,
      ),
      (baseline, "200001010000.03", true),
    ]) {
      FileSystem.writeTextFile(source, contents);
      touched = System.subprocess(Array["touch", "-t", timestamp, source]).fromSuccess();
      T.expectTrue(touched.success(), touched.stderr);
      updated = System.subprocess(
        args.concat(Array["--data", data, "--debug-skstore"]),
      ).fromSuccess();
      T.expectTrue(updated.success(), updated.stderr);
      T.expectEq(updated.stdout.contains(baseWrite), relationsChanged);
      T.expectFalse(updated.stdout.contains(independentWrite));
      // A body-only edit now leaves discovery and its class passes untouched.
      // Relation changes still revisit the pass and reuse its unchanged rows.
      T.expectEq(
        updated.stdout.contains("REUSING: /specializer/latch-classes/"),
        relationsChanged,
      );
      if (relationsChanged) {
        T.expectTrue(
          updated.stdout.split("\n").any(line ->
            line.startsWith("DIRTY READER: ") &&
              line.contains("=> /specializer/latch-classes/ (dependency: ") &&
              line.contains(
                "OuterIstToIR.SubtypesKey(SClassID(\"LatchPassBase\"))",
              )
          ),
        );
      };
    };
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
    throw exn
  };
  T.expectTrue(System.subprocess(Array["rm", "-r", dir]).fromSuccess().success());
}

// A leaf's representation changes must invalidate unchanged containers and
// array slots through tracked reads of the preceding phase's class records.
private fun incrementalScalarizedFields(): void {
  temp = System.subprocess(Array["mktemp", "-d"]).fromSuccess();
  T.expectTrue(temp.success(), temp.stderr);
  dir = temp.stdout.trim();
  leaf = dir + "/leaf.sk";
  containers = dir + "/containers.sk";
  source = dir + "/main.sk";
  output = dir + "/program";
  data = dir + "/data";
  baselineLeaf = "value class ScalarPassLeaf(x: Int, flag: Bool = false)\n";
  baselineMain =
    "fun scalarPassDelta(): Int { 1 }\n" +
    "untracked fun main(): void {\n" +
    "  a = Array[ScalarPassNested(ScalarPassLeaf(7)), ScalarPassNested(ScalarPassLeaf(8))];\n" +
    "  h = ScalarPassHolder(a[0]);\n" +
    "  print_raw((h.value.value.x + a[1].value.x + ScalarPassIndependent().value + scalarPassDelta()).toString());\n" +
    "}\n";
  args = compile_cmd(Array[leaf, containers, source], output);
  writePrefix = "WRITTEN:  /specializer/scalarize-fields/OuterIstToIR.SClassIDKey(SClassID(\"";
  try {
    FileSystem.writeTextFile(leaf, baselineLeaf);
    FileSystem.writeTextFile(source, baselineMain);
    FileSystem.writeTextFile(
      containers,
      "value class ScalarPassNested(value: ScalarPassLeaf)\n" +
        "class ScalarPassHolder(value: ScalarPassNested)\n" +
        "class ScalarPassIndependent(value: Int = 5)\n",
    );
    initial = System.subprocess(args.concat(Array["--init", data])).fromSuccess();
    T.expectTrue(initial.success(), initial.stderr);
    initialRun = System.subprocess(Array[output]).fromSuccess();
    T.expectTrue(initialRun.success(), initialRun.stderr);
    T.expectEq(initialRun.stdout, "21");
    for ((leafText, mainText, expected, shapeChanged, timestamp) in Array[
      (baselineLeaf, baselineMain.replace("Int { 1 }", "Int { 2 }"), "22", false, "200001010000.01"),
      (
        baselineLeaf.replace("flag: Bool = false", "flag: Bool = false, text: String = \"hello\""),
        baselineMain, "21", true, "200001010000.02",
      ),
      (baselineLeaf, baselineMain, "21", true, "200001010000.03"),
      (baselineLeaf.replace("value class", "class"), baselineMain, "21", true, "200001010000.04"),
      (baselineLeaf, baselineMain, "21", true, "200001010000.05"),
    ]) {
      FileSystem.writeTextFile(leaf, leafText);
      FileSystem.writeTextFile(source, mainText);
      touched = System.subprocess(Array["touch", "-t", timestamp, leaf, source]).fromSuccess();
      T.expectTrue(touched.success(), touched.stderr);
      updated = System.subprocess(
        args.concat(Array["--data", data, "--debug-skstore"]),
      ).fromSuccess();
      T.expectTrue(updated.success(), updated.stderr);
      run = System.subprocess(Array[output]).fromSuccess();
      T.expectTrue(run.success(), run.stderr);
      T.expectEq(run.stdout, expected);
      T.expectEq(updated.stdout.contains(writePrefix + "ScalarPassHolder\"))"), shapeChanged);
      T.expectFalse(updated.stdout.contains(writePrefix + "ScalarPassIndependent\"))"));
      if (shapeChanged) {
        T.expectTrue(updated.stdout.split("\n").any(line ->
          line.startsWith("DIRTY READER: ") &&
          line.contains("=> /specializer/scalarize-fields/ (dependency: ") &&
          line.contains("OuterIstToIR.SClassIDKey(SClassID(\"ScalarPassLeaf\"))")
        ));
        T.expectTrue(updated.stdout.split("\n").any(line ->
          line.startsWith(writePrefix + "Array<") && line.contains("ScalarPassNested")
        ));
      };
    };
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
    throw exn
  };
  T.expectTrue(System.subprocess(Array["rm", "-r", dir]).fromSuccess().success());
}

// Component membership changes must retract the old groups and repack the
// merged/split groups. Empty/value-only groups must retain their dependencies.
private fun incrementalFieldLayouts(): void {
  temp = System.subprocess(Array["mktemp", "-d"]).fromSuccess();
  T.expectTrue(temp.success(), temp.stderr);
  dir = temp.stdout.trim();
  left = dir + "/left.sk";
  right = dir + "/right.sk";
  bridge = dir + "/bridge.sk";
  cpp = dir + "/cpp.sk";
  zero = dir + "/zero.sk";
  source = dir + "/main.sk";
  output = dir + "/program";
  data = dir + "/data";
  baseLeft = "base class LayoutPassLeft(left: Int = 7, flag: Bool = true) { fun leftValue(): Int { this.left } }\nclass LayoutPassL(extra: String = \"l\") extends LayoutPassLeft\n";
  baseRight = "base class LayoutPassRight(right: Int = 11) { fun rightValue(): Int { this.right } }\nclass LayoutPassR(extra: Bool = false) extends LayoutPassRight\n";
  baseBridge = "class LayoutPassBridge(extra: Int = 3) extends LayoutPassLeft\n";
  baseCpp = "class LayoutPassCpp(flag: Bool = true, value: Int = 13, text: String = \"fixed\")\n";
  baseZero = "value class LayoutPassZero()\n";
  baseMain = "class LayoutPassIndependent(value: Int = 5)\nclass LayoutPassZeroHolder(value: LayoutPassZero)\nfun layoutLeft(x: LayoutPassLeft): Int { x.leftValue() }\nfun layoutRight(x: LayoutPassRight): Int { x.rightValue() }\nfun layoutZero(_x: LayoutPassZero): Int { 1 }\nfun layoutDelta(): Int { 1 }\nuntracked fun main(): void {\n  l = LayoutPassL(); r = LayoutPassR(); b = LayoutPassBridge(); c = LayoutPassCpp(); z = LayoutPassZeroHolder(LayoutPassZero());\n  print_raw((layoutLeft(l) + layoutLeft(b) + layoutRight(r) + b.extra + layoutDelta() + LayoutPassIndependent().value + c.value + (if(c.flag) 1 else 0) + c.text.length() + layoutZero(z.value)).toString());\n}\n";
  mergedBridge = baseBridge.replace("extends LayoutPassLeft", "extends LayoutPassLeft, LayoutPassRight");
  mergedMain = baseMain.replace("+ layoutDelta()", "+ layoutRight(b) + layoutDelta()");
  args = compile_cmd(Array[left, right, bridge, cpp, zero, source], output);
  writePrefix = "WRITTEN:  /specializer/layout-fields/OuterIstToIR.SClassIDKey(SClassID(\"";
  try {
    FileSystem.writeTextFile(left, baseLeft);
    FileSystem.writeTextFile(right, baseRight);
    FileSystem.writeTextFile(bridge, baseBridge);
    FileSystem.writeTextFile(cpp, baseCpp);
    FileSystem.writeTextFile(zero, baseZero);
    FileSystem.writeTextFile(source, baseMain);
    initial = System.subprocess(args.concat(Array["--init", data])).fromSuccess();
    T.expectTrue(initial.success(), initial.stderr);
    result = System.subprocess(Array[output]).fromSuccess();
    T.expectTrue(result.success(), result.stderr);
    T.expectEq(result.stdout, "54");
    previousZero = baseZero;
    for ((leftText, bridgeText, cppText, zeroText, mainText, expected, rightChanged, timestamp) in Array[
      (baseLeft, baseBridge, baseCpp, baseZero, baseMain.replace("fun layoutDelta(): Int { 1 }", "fun layoutDelta(): Int { 2 }"), "55", false, "200001010000.01"),
      (baseLeft.replace("flag: Bool = true", "flag: Bool = true, text: String = \"extra\""), baseBridge, baseCpp, baseZero, baseMain, "54", false, "200001010000.02"),
      (baseLeft, baseBridge, baseCpp, baseZero, baseMain, "54", false, "200001010000.03"),
      (baseLeft, mergedBridge, baseCpp, baseZero, mergedMain, "65", true, "200001010000.04"),
      (baseLeft, baseBridge, baseCpp, baseZero, baseMain, "54", true, "200001010000.05"),
      (baseLeft, baseBridge, "@cpp_export\n" + baseCpp, baseZero, baseMain, "54", false, "200001010000.06"),
      (baseLeft, baseBridge, baseCpp, baseZero.replace("value class", "@cpp_export\nclass"), baseMain, "54", false, "200001010000.07"),
      (baseLeft, baseBridge, baseCpp, baseZero, baseMain, "54", false, "200001010000.08"),
    ]) {
      FileSystem.writeTextFile(left, leftText);
      FileSystem.writeTextFile(bridge, bridgeText);
      FileSystem.writeTextFile(cpp, cppText);
      FileSystem.writeTextFile(zero, zeroText);
      FileSystem.writeTextFile(source, mainText);
      touched = System.subprocess(Array["touch", "-t", timestamp, left, bridge, cpp, zero, source]).fromSuccess();
      T.expectTrue(touched.success(), touched.stderr);
      updated = System.subprocess(args.concat(Array["--data", data, "--debug-skstore"])).fromSuccess();
      T.expectTrue(updated.success(), updated.stderr);
      run = System.subprocess(Array[output]).fromSuccess();
      T.expectTrue(run.success(), run.stderr);
      T.expectEq(run.stdout, expected);
      T.expectEq(updated.stdout.contains(writePrefix + "LayoutPassRight\"))"), rightChanged);
      T.expectFalse(updated.stdout.contains(writePrefix + "LayoutPassIndependent\"))"));
      if (zeroText != previousZero) {
        T.expectTrue(updated.stdout.split("\n").any(line ->
          line.startsWith("DIRTY READER: /specializer/layout-groups/") &&
          line.contains("=> /specializer/layout-fields/ (dependency: ") &&
          line.contains("SClassID(\"LayoutPassZero\")")
        ));
      };
      !previousZero = zeroText;
    };
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
    throw exn
  };
  T.expectTrue(
    System.subprocess(Array["rm", "-r", dir]).fromSuccess().success(),
  );
}

// Const accessors and the global initializer share the stable-ID allocator.
// Exercise new generated functions and switching back to local release IDs.
private fun incrementalConstFunctionIDs(): void {
  temp = System.subprocess(Array["mktemp", "-d"]).fromSuccess();
  T.expectTrue(temp.success(), temp.stderr);
  dir = temp.stdout.trim();
  source = dir + "/main.sk";
  output = dir + "/program";
  data = dir + "/data";
  base =
    "const stableText: String = \"base\";\n" +
    "untracked fun main(): void { print_raw(stableText) }\n";
  added =
    "const extraText: String = \"prefix\";\n" +
    base.replace("print_raw(stableText)", "print_raw(extraText + stableText)");
  changedType = added.replace("stableText: String = \"base\"", "stableText: Int = 7")
    .replace("extraText + stableText", "extraText + stableText.toString()");
  args = compile_cmd(Array[source], output).concat(Array["--no-ipa"]);
  try {
    for ((text, expected, initialize, timestamp) in Array[
      (base, "base", true, "200001010000.01"),
      (added, "prefixbase", false, "200001010000.02"),
      (base, "base", false, "200001010000.03"),
      (added, "prefixbase", false, "200001010000.04"),
      (added.replace("\"base\"", "\"next\""), "prefixnext", false, "200001010000.05"),
      (added, "prefixbase", false, "200001010000.06"),
      (changedType, "prefix7", false, "200001010000.07"),
      (added, "prefixbase", false, "200001010000.08"),
    ]) {
      FileSystem.writeTextFile(source, text);
      T.expectTrue(
        System.subprocess(Array["touch", "-t", timestamp, source])
          .fromSuccess()
          .success(),
      );
      result = System.subprocess(
        args.concat(Array[if (initialize) "--init" else "--data", data]),
      ).fromSuccess();
      T.expectTrue(result.success(), result.stderr);
      T.expectEq(
        System.subprocess(Array[output]).fromSuccess().stdout,
        expected,
      );
    };
    // An unchanged declared type must not hide an invalid initializer.
    FileSystem.writeTextFile(source, added.replace("stableText: String = \"base\"", "stableText: String = 17"));
    T.expectTrue(System.subprocess(Array["touch", "-t", "200001010000.09", source]).fromSuccess().success());
    invalid = System.subprocess(args.concat(Array["--data", data])).fromSuccess();
    T.expectFalse(invalid.success(), invalid.stderr);
    FileSystem.writeTextFile(source, added);
    T.expectTrue(System.subprocess(Array["touch", "-t", "200001010000.10", source]).fromSuccess().success());
    recovered = System.subprocess(args.concat(Array["--data", data])).fromSuccess();
    T.expectTrue(recovered.success(), recovered.stderr);
    T.expectEq(System.subprocess(Array[output]).fromSuccess().stdout, "prefixbase");
    for (release in Array[true, false]) {
      switched = System.subprocess(
        args
          .concat(Array["--data", data])
          .concat(if (release) Array["--release"] else Array[]),
      ).fromSuccess();
      T.expectTrue(switched.success(), switched.stderr);
      T.expectEq(
        System.subprocess(Array[output]).fromSuccess().stdout,
        "prefixbase",
      );
    }
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
    throw exn
  };
  T.expectTrue(
    System.subprocess(Array["rm", "-r", dir]).fromSuccess().success(),
  );
}

// Missing member reads must be dependencies too: a new module-local function
// shadows a previously selected global function, and removal restores it.
private fun incrementalModuleMembers(): void {
  temp = System.subprocess(Array["mktemp", "-d"]).fromSuccess();
  T.expectTrue(temp.success(), temp.stderr);
  dir = temp.stdout.trim();
  source = dir + "/main.sk";
  output = dir + "/program";
  data = dir + "/data";
  base =
    "fun lookupValue(): Int { 1 }\nmodule LookupProbe;\n" +
    "fun caller(): Int { lookupValue() }\nmodule end;\n" +
    "untracked fun main(): void { print_raw(LookupProbe.caller().toString()) }\n";
  shadow = base.replace(
    "module LookupProbe;",
    "module LookupProbe; fun lookupValue(): Int { 2 }",
  );
  args = compile_cmd(Array[source], output).concat(Array["--no-ipa"]);
  try {
    for ((text, expected, initialize, timestamp) in Array[
      (base, "1", true, "200001010000.01"),
      (shadow, "2", false, "200001010000.02"),
      (base, "1", false, "200001010000.03"),
    ]) {
      FileSystem.writeTextFile(source, text);
      T.expectTrue(
        System.subprocess(Array["touch", "-t", timestamp, source])
          .fromSuccess()
          .success(),
      );
      result = System.subprocess(
        args.concat(Array[if (initialize) "--init" else "--data", data]),
      ).fromSuccess();
      T.expectTrue(result.success(), result.stderr);
      T.expectEq(
        System.subprocess(Array[output]).fromSuccess().stdout,
        expected,
      );
    }
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
    throw exn
  };
  T.expectTrue(
    System.subprocess(Array["rm", "-r", dir]).fromSuccess().success(),
  );
}

private fun incrementalStableFunctionIDs(): void {
  temp = System.subprocess(Array["mktemp", "-d"]).fromSuccess();
  T.expectTrue(temp.success(), temp.stderr);
  dir = temp.stdout.trim();
  source = dir + "/main.sk";
  output = dir + "/program";
  data = dir + "/data";
  base =
    "fun stableLeft(): Int { 7 }\n" +
    "fun stableRight(): Int { 9 }\n" +
    "untracked fun main(): void { print_raw((stableLeft() + stableRight()).toString()) }\n";
  added =
    base.replace(
      "stableLeft() + stableRight()",
      "stableLeft() + stableRight() + aStableAdded()",
    ) + "fun aStableAdded(): Int { 3 }\n";
  args = compile_cmd(Array[source], output).concat(Array["--no-ipa"]);
  try {
    FileSystem.writeTextFile(source, base);
    first = System.subprocess(args.concat(Array["--init", data])).fromSuccess();
    T.expectTrue(first.success(), first.stderr);
    T.expectEq(System.subprocess(Array[output]).fromSuccess().stdout, "16");
    firstID: ?String = None();
    for ((text, expected, count, timestamp) in Array[
      (added, "19", 2, "200001010000.01"),
      (base, "16", 1, "200001010000.02"),
      (added, "19", 2, "200001010000.03"),
    ]) {
      FileSystem.writeTextFile(source, text);
      T.expectTrue(
        System.subprocess(Array["touch", "-t", timestamp, source])
          .fromSuccess()
          .success(),
      );
      update = System.subprocess(
        args.concat(Array["--data", data, "--debug-skstore"]),
      ).fromSuccess();
      T.expectTrue(update.success(), update.stderr);
      T.expectEq(
        System.subprocess(Array[output]).fromSuccess().stdout,
        expected,
      );
      generated = update.stdout
        .split("\n")
        .filter(line -> line.startsWith("FUNCTION_IR:"))
        .collect(Array);
      T.expectEq(generated.size(), count, generated.join("\n"));
      T.expectTrue(
        generated.all(line ->
          line.contains("main") || line.contains("aStableAdded")
        ),
        generated.join("\n"),
      );
      generated
        .filter(line -> line.contains("aStableAdded"))
        .each(line -> {
          id = line.split(" id=").collect(Array)[1];
          firstID match {
          | None() -> !firstID = Some(id)
          | Some(previous) -> T.expectEq(id, previous)
          }
        });
      T.expectEq(
        update.stdout
          .split("\n")
          .filter(line -> line.startsWith("NATIVE_LOWER:"))
          .collect(Array)
          .size(),
        count,
        update.stdout,
      );
      T.expectFalse(update.stdout.contains("POINTER_ESCAPE"), update.stdout);
      T.expectFalse(update.stdout.contains("VTABLE_LAYOUT"), update.stdout);
    }
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
    throw exn
  };
  T.expectTrue(
    System.subprocess(Array["rm", "-r", dir]).fromSuccess().success(),
  );
}

// Function bodies are cached before method tables, coroutine dependencies and
// emission flags are attached. A generic body edit must rebuild its two
// instantiations without regenerating unrelated bodies.
private fun incrementalFunctionIR(): void {
  temp = System.subprocess(Array["mktemp", "-d"]).fromSuccess();
  T.expectTrue(temp.success(), temp.stderr);
  dir = temp.stdout.trim();
  generic = dir + "/generic.sk";
  independent = dir + "/independent.sk";
  source = dir + "/main.sk";
  output = dir + "/program";
  data = dir + "/data";
  pair = "fun irPair<T>(x: T): (T, Int) { (x, 1) }\n";
  other = "fun irIndependent(): Int { 9 }\n";
  main = "untracked fun main(): void { (i, a) = irPair(7); (s, b) = irPair(\"abc\"); print_raw((i + a + s.length() + b + irIndependent()).toString()) }\n";
  args = compile_cmd(Array[generic, independent, source], output).concat(Array["--verbose"]);
  try {
    FileSystem.writeTextFile(generic, pair);
    FileSystem.writeTextFile(independent, other);
    FileSystem.writeTextFile(source, main);
    initial = System.subprocess(args.concat(Array["--init", data])).fromSuccess();
    T.expectTrue(initial.success(), initial.stderr);
    T.expectEq(initial.stderr.split("\n").filter(line ->
      line.startsWith(">> clang++ ") && !line.contains(" -c ")
    ).collect(Array).size(), 1, initial.stderr);
    first = System.subprocess(Array[output]).fromSuccess();
    T.expectTrue(first.success(), first.stderr);
    T.expectEq(first.stdout, "21");
    for ((pairText, otherText, mainText, expected, expectedWrites, timestamp) in Array[
      (pair.replace("(x, 1)", "(x, 2)"), other, main, "23", 2, "200001010000.01"),
      (pair.replace("(x, 1)", "(x, 2)"), other.replace("9", "8"), main, "22", 1, "200001010000.02"),
      (pair.replace("(x, 1)", "(x, 2)"), other.replace("9", "8"), main, "22", 0, "200001010000.03"),
    ]) {
      FileSystem.writeTextFile(generic, pairText);
      FileSystem.writeTextFile(independent, otherText);
      FileSystem.writeTextFile(source, mainText);
      touched = System.subprocess(Array["touch", "-t", timestamp, generic, independent, source]).fromSuccess();
      T.expectTrue(touched.success(), touched.stderr);
      updated = System.subprocess(args.concat(Array["--data", data, "--debug-skstore"])).fromSuccess();
      T.expectTrue(updated.success(), updated.stderr);
      run = System.subprocess(Array[output]).fromSuccess();
      T.expectTrue(run.success(), run.stderr);
      T.expectEq(run.stdout, expected);
      writes = updated.stdout.split("\n").filter(line ->
        line.startsWith("WRITTEN:  /specializer/function-ir/")
      ).collect(Array);
      T.expectEq(writes.size(), expectedWrites, writes.join("\n"));
      // Both irPair instantiations share one generic compilation. Check
      // execution as well as writes: comparing unchanged outputs afterward
      // used to hide recompilation of every generic body in the global plan.
      genericCompilations = updated.stdout
        .split("\n")
        .filter(line -> line.startsWith("GENERIC_IR:"))
        .collect(Array);
      changedCallable = if (expectedWrites == 2) "irPair" else "irIndependent";
      T.expectEq(
        genericCompilations
          .filter(line -> line.contains(changedCallable))
          .collect(Array)
          .size(),
        if (expectedWrites == 0) 0 else 1,
        genericCompilations.join("\n"),
      );
      // A caller can also be invalidated by its tracked declaration read.
      // It must not cause unrelated callables to compile, nor compile the
      // shared generic once per instantiation.
      T.expectTrue(
        genericCompilations.all(line ->
          expectedWrites != 0 &&
            (line.contains(changedCallable) ||
              line.contains("GenericFunctionKey(main)") ||
              line.contains("\"main\""))
        ),
        genericCompilations.join("\n"),
      );
      T.expectTrue(
        genericCompilations.size() <= 2,
        genericCompilations.join("\n"),
      );
      planWrites = updated.stdout
        .split("\n")
        .filter(line ->
          line.startsWith("WRITTEN:  /specializer/function-ir-plan/")
        )
        .collect(Array);
      T.expectEq(planWrites.size(), 0, planWrites.join("\n"));
      links = updated.stderr.split("\n").filter(line ->
        line.startsWith(">> clang++ ") && !line.contains(" -c ")
      ).collect(Array).size();
      // Updating the cache must not dirty the backend while it is running.
      T.expectTrue(links <= 1, updated.stderr);
      if (expectedWrites != 0) T.expectEq(links, 1, updated.stderr);
    };
    // Reachable-set changes can renumber functions; both adding and removing
    // a callee must regenerate callers with valid IDs.
    extraMain = main.replace("irIndependent()", "irIndependent() + irExtra()");
    for ((pairText, otherText, mainText, expected, timestamp) in Array[
      (pair + "fun irExtra(): Int { 4 }\n", other, extraMain, "25", "200001010000.04"),
      (pair, other, main, "21", "200001010000.05"),
      (
        pair.replace("(x: T)", "(x: T, bias: Int = 1)")
          .replace("(x, 1)", "(x, bias)"),
        other, main, "21", "200001010000.06",
      ),
      (
        pair.replace("(x: T)", "(x: T, bias: Int = 2)")
          .replace("(x, 1)", "(x, bias)"),
        other, main, "23", "200001010000.07",
      ),
      (pair, other, main, "21", "200001010000.08"),
    ]) {
      FileSystem.writeTextFile(generic, pairText);
      FileSystem.writeTextFile(independent, otherText);
      FileSystem.writeTextFile(source, mainText);
      touched = System.subprocess(Array["touch", "-t", timestamp, generic, independent, source]).fromSuccess();
      T.expectTrue(touched.success(), touched.stderr);
      updated = System.subprocess(args.concat(Array["--data", data])).fromSuccess();
      T.expectTrue(updated.success(), updated.stderr);
      run = System.subprocess(Array[output]).fromSuccess();
      T.expectTrue(run.success(), run.stderr);
      T.expectEq(run.stdout, expected);
    };
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
    throw exn
  };
  T.expectTrue(System.subprocess(Array["rm", "-r", dir]).fromSuccess().success());
}

// Moving declarations must update diagnostics and debug metadata without
// replaying serialized class discovery. Exercise both file-wide shifts and
// changes confined to an earlier method in the same class.
// native_eq must distinguish nominal classes even when release omits names.
private fun nativeTypeIdentity(): void {
  temp = System.subprocess(Array["mktemp", "-d"]).fromSuccess();
  T.expectTrue(temp.success(), temp.stderr);
  dir = temp.stdout.trim();
  source = dir + "/main.sk";
  output = dir + "/program";
  try {
    FileSystem.writeTextFile(
      source,
      "base class Kind { children = | A(n: Int) | B(n: Int) }\n" +
        "@no_inline fun differs(a: Kind, b: Kind): Bool { native_eq(a, b) != 0 }\n" +
        "untracked fun main(): void { print_raw(if (differs(A(1), B(1))) \"pass\" else \"fail\") }\n",
    );
    // Aa and BB collide under the runtime's polynomial string hash, including
    // when embedded in IdentityCollisionBox<...>. Collapsed names/layouts must stay nominal.
    generic =
      "class Aa() {}\nclass BB() {}\n" +
      "base class Kind() {}\n" +
      "class IdentityCollisionBox<T>(value: ?T) extends Kind\n" +
      "@no_inline fun differs(a: Kind, b: Kind): Bool { native_eq(a, b) != 0 }\n" +
      "untracked fun main(): void { print_raw(if (differs(IdentityCollisionBox<Aa>(None()), IdentityCollisionBox<BB>(None()))) \"pass\" else \"fail\") }\n";
    for (genericCase in Array[false, true]) {
      if (genericCase) FileSystem.writeTextFile(source, generic);
      for (release in Array[false, true]) {
        compiled = System.subprocess(
          compile_cmd(Array[source], output).concat(
            if (release) Array["--release"] else Array[],
          ),
        ).fromSuccess();
        T.expectTrue(compiled.success(), compiled.stderr);
        run = System.subprocess(Array[output]).fromSuccess();
        T.expectTrue(run.success(), run.stderr);
        T.expectEq(run.stdout, "pass");
      };
    }
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
    throw exn
  };
  T.expectTrue(System.subprocess(Array["rm", "-r", dir]).fromSuccess().success());
}

// Verify selective optimizer work inputs and native results.
// A body edit should visit its caller and reuse the independent function.
private fun incrementalOptimization(): void {
  temp = System.subprocess(Array["mktemp", "-d"]).fromSuccess();
  T.expectTrue(temp.success(), temp.stderr);
  dir = temp.stdout.trim();
  left = dir + "/left.sk";
  right = dir + "/right.sk";
  source = dir + "/main.sk";
  output = dir + "/program";
  data = dir + "/data";
  args = compile_cmd(Array[left, right, source], output).concat(
    Array["--verbose"],
  );
  try {
    FileSystem.writeTextFile(left, "fun optLeft(x: Int): Int { x + 1 }\n");
    FileSystem.writeTextFile(right, "fun optRight(x: Int): Int { x + 9 }\n");
    FileSystem.writeTextFile(
      source,
      "untracked fun main(): void { print_raw((optLeft(7) + optRight(3)).toString()) }\n",
    );
    initial = System.subprocess(
      args.concat(Array["--init", data]),
    ).fromSuccess();
    T.expectTrue(initial.success(), initial.stderr);
    T.expectEq(System.subprocess(Array[output]).fromSuccess().stdout, "20");
    for ((leftValue, rightValue, expected, changed, timestamp) in Array[
      (2, 9, "21", true, "200001010000.01"),
      (2, 8, "20", true, "200001010000.02"),
      (2, 8, "20", false, "200001010000.03"),
    ]) {
      FileSystem.writeTextFile(
        left,
        `fun optLeft(x: Int): Int { x + ${leftValue} }\n`,
      );
      FileSystem.writeTextFile(
        right,
        `fun optRight(x: Int): Int { x + ${rightValue} }\n`,
      );
      T.expectTrue(
        System.subprocess(Array["touch", "-t", timestamp, left, right])
          .fromSuccess()
          .success(),
      );
      updated = System.subprocess(
        args.concat(Array["--data", data, "--debug-skstore"]),
      ).fromSuccess();
      T.expectTrue(updated.success(), updated.stderr);
      T.expectEq(
        System.subprocess(Array[output]).fromSuccess().stdout,
        expected,
      );
      rows = updated.stdout
        .split("\n")
        .filter(line ->
          line.startsWith("WRITTEN:  /optimizer/before-const/0/inputs/") &&
            line.contains("WorkKey")
        )
        .collect(Array);
      if (changed) {
        T.expectTrue(rows.size() == 2, rows.join("\n"))
      } else {
        T.expectEq(rows.size(), 0, rows.join("\n"))
      };
      // A literal edit changes a function body, not the optimizer schedule.
      // Replaying a whole-program snapshot used to make every round do work.
      scheduleWrites = updated.stdout
        .split("\n")
        .filter(line ->
          line.startsWith("WRITTEN:  /optimizer/") &&
            line.contains("/schedule/")
        )
        .collect(Array);
      T.expectEq(scheduleWrites.size(), 0, scheduleWrites.join("\n"));
      links = updated.stderr
        .split("\n")
        .filter(line -> line.startsWith(">> clang++ ") && !line.contains(" -c "))
        .collect(Array)
        .size();
      T.expectTrue(links <= 1, updated.stderr);
    };
    // Adding/removing unrelated anchors must reuse round state as well as work
    // rows. Checking only WorkKey writes missed whole-round validation churn.
    for ((extra, timestamp) in Array[
      ("fun optUnused(): Int { 42 }\n", "200001010000.04"),
      ("", "200001010000.05"),
    ]) {
      FileSystem.writeTextFile(
        right,
        "fun optRight(x: Int): Int { x + 8 }\n" + extra,
      );
      T.expectTrue(
        System.subprocess(Array["touch", "-t", timestamp, right])
          .fromSuccess()
          .success(),
      );
      unrelated = System.subprocess(
        args.concat(Array["--data", data, "--debug-skstore"]),
      ).fromSuccess();
      T.expectTrue(unrelated.success(), unrelated.stderr);
      T.expectEq(System.subprocess(Array[output]).fromSuccess().stdout, "20");
      optimizerWrites = unrelated.stdout
        .split("\n")
        .filter(line -> line.startsWith("WRITTEN:  /optimizer/"))
        .collect(Array);
      T.expectEq(optimizerWrites.size(), 0, optimizerWrites.join("\n"));
    };
    for (release in Array[true, false]) {
      mode = if (release) Array["--release"] else Array[];
      switched = System.subprocess(
        args.concat(Array["--data", data]).concat(mode).concat(
          if (release) Array["--debug-skstore"] else Array[],
        ),
      ).fromSuccess();
      T.expectTrue(switched.success(), switched.stderr);
      T.expectEq(System.subprocess(Array[output]).fromSuccess().stdout, "20");
      if (release) {
        T.expectTrue(!switched.stdout.contains("WRITTEN:  /optimizer/"))
      };
    };
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
    throw exn
  };
  T.expectTrue(
    System.subprocess(Array["rm", "-r", dir]).fromSuccess().success(),
  );
}

// Verify actual lowering executions, not just equal output rows. A stale global
// environment capture or a body-bearing callee dependency would still produce
// correct output while needlessly lowering unrelated functions.
private fun incrementalNativeLowering(): void {
  temp = System.subprocess(Array["mktemp", "-d"]).fromSuccess();
  T.expectTrue(temp.success(), temp.stderr);
  dir = temp.stdout.trim();
  left = dir + "/left.sk";
  right = dir + "/right.sk";
  source = dir + "/main.sk";
  output = dir + "/program";
  data = dir + "/data";
  args = compile_cmd(Array[left, right, source], output).concat(
    Array["--no-ipa"],
  );
  try {
    FileSystem.writeTextFile(left, "fun nativeLeft(): Int { 7 }\n");
    FileSystem.writeTextFile(right, "fun nativeRight(): Int { 9 }\n");
    FileSystem.writeTextFile(source,
      "untracked fun main(): void { print_raw((nativeLeft() + nativeRight()).toString()) }\n",
    );
    initial = System.subprocess(args.concat(Array["--init", data])).fromSuccess();
    T.expectTrue(initial.success(), initial.stderr);
    T.expectEq(System.subprocess(Array[output]).fromSuccess().stdout, "16");
    for ((text, expected, changed, timestamp) in Array[
      ("fun nativeLeft(): Int { 8 }\n", "17", true, "200001010000.01"),
      ("fun nativeLeft(): Int { 8 }\n", "17", false, "200001010000.02"),
      ("fun nativeLeft(): Int { 7 }\n", "16", true, "200001010000.03"),
    ]) {
      FileSystem.writeTextFile(left, text);
      T.expectTrue(System.subprocess(Array["touch", "-t", timestamp, left]).fromSuccess().success());
      updated = System.subprocess(args.concat(Array["--data", data, "--debug-skstore"])).fromSuccess();
      T.expectTrue(updated.success(), updated.stderr);
      T.expectEq(
        System.subprocess(Array[output]).fromSuccess().stdout,
        expected,
      );
      executions = updated.stdout
        .split("\n")
        .filter(line -> line.startsWith("NATIVE_LOWER:"))
        .collect(Array);
      T.expectEq(
        executions.size(),
        if (changed) 1 else 0,
        executions.join("\n"),
      );
      T.expectTrue(
        executions.all(line -> line.contains("nativeLeft")),
        executions.join("\n"),
      );
      T.expectFalse(
        updated.stdout.contains("WRITTEN:  /native-lower/vtables/"),
        updated.stdout,
      );
      T.expectFalse(
        updated.stdout.contains("WRITTEN:  /native-lower/merged/"),
        updated.stdout,
      );
      graphExecutions = updated.stdout
        .split("\n")
        .filter(line -> line.startsWith("LLVM_FUNCTION:"))
        .collect(Array);
      T.expectEq(
        graphExecutions.size(),
        if (changed) 1 else 0,
        graphExecutions.join("\n"),
      );
      T.expectTrue(
        graphExecutions.all(line -> line.contains("nativeLeft")),
        graphExecutions.join("\n"),
      );
      T.expectFalse(updated.stdout.contains("LLVM_SHARED"), updated.stdout);
      edgeAnalyses = updated.stdout
        .split("\n")
        .filter(line -> line.startsWith("REACHABILITY_EDGES:"))
        .collect(Array);
      T.expectEq(
        edgeAnalyses.size(),
        if (changed) 1 else 0,
        edgeAnalyses.join("\n"),
      );
      T.expectTrue(
        edgeAnalyses.all(line -> line.contains("nativeLeft")),
        edgeAnalyses.join("\n"),
      );
      T.expectFalse(updated.stdout.contains("POINTER_ESCAPE"), updated.stdout);
      T.expectFalse(
        updated.stdout.contains("REACHABILITY_LIVE"),
        updated.stdout,
      );
    };
    // Exercise request insertion/removal, dispatch and class layout changes.
    // Compare the cached result to a fresh sequential compilation at each step.
    dispatch =
      "base class NativeBase { overridable fun value(): Int { 3 } }\n" +
      "class NativeA(x: Int) extends NativeBase { fun value(): Int { this.x } }\n" +
      "class NativeB() extends NativeBase { fun value(): Int { 5 } }\n" +
      "fun nativePick(b: Bool): NativeBase { if (b) NativeA(8) else NativeB() }\n" +
      "untracked fun main(): void { print_raw((nativePick(true).value() + nativePick(false).value() + nativeRight()).toString()) }\n";
    for ((text, expected, timestamp) in Array[
      (dispatch, "22", "200001010000.04"),
      (dispatch.replace("NativeB", "NativeC"), "22", "200001010000.05"),
      (dispatch.replace("x: Int)", "x: Int, y: Int = 2)").replace("this.x }", "this.x + this.y }"), "24", "200001010000.06"),
      ("untracked fun main(): void { print_raw((nativeLeft() + nativeRight()).toString()) }\n", "16", "200001010000.07"),
    ]) {
      FileSystem.writeTextFile(source, text);
      T.expectTrue(System.subprocess(Array["touch", "-t", timestamp, source]).fromSuccess().success());
      updated = System.subprocess(args.concat(Array["--data", data, "--debug-skstore"])).fromSuccess();
      T.expectTrue(updated.success(), updated.stderr);
      T.expectEq(System.subprocess(Array[output]).fromSuccess().stdout, expected);
      // nativeRight remains reachable throughout the class edits. Its body
      // and scalar signature stay equal, so class-map changes must not rerun it.
      unaffected = updated.stdout.split("\n").filter(line ->
        (line.startsWith("OPTIMIZE_FUNCTION:") || line.startsWith("NATIVE_LOWER:") ||
          line.startsWith("LLVM_FUNCTION:") || line.startsWith("REACHABILITY_EDGES:")) &&
          line.contains("nativeRight")
      ).collect(Array);
      T.expectEq(unaffected.size(), 0, unaffected.join("\n"));
      sequentialOutput = dir + "/sequential";
      sequential = System.subprocess(compile_cmd(Array[left, right, source], sequentialOutput).concat(Array["--no-ipa"])).fromSuccess();
      T.expectTrue(sequential.success(), sequential.stderr);
      T.expectEq(System.subprocess(Array[sequentialOutput]).fromSuccess().stdout, expected);
    };
    // Persisted mode switches must retire and recreate the incremental graph.
    for (release in Array[true, false]) {
      switched = System.subprocess(args.concat(Array["--data", data, "--verbose"]).concat(
        if (release) Array["--release"] else Array[],
      )).fromSuccess();
      T.expectTrue(switched.success(), switched.stderr);
      T.expectEq(System.subprocess(Array[output]).fromSuccess().stdout, "16");
      T.expectEq(
        switched.stderr.contains("Sequential specialization complete"),
        release,
      );
    };
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
    throw exn
  };
  T.expectTrue(
    System.subprocess(Array["rm", "-r", dir]).fromSuccess().success(),
  );
}

// Shared strings exercise cross-fragment constant identities, including removal
// and reintroduction. Count executions so equal output cannot hide recomputation.
private fun incrementalLLVMGraph(): void {
  temp = System.subprocess(Array["mktemp", "-d"]).fromSuccess();
  T.expectTrue(temp.success(), temp.stderr);
  dir = temp.stdout.trim();
  left = dir + "/left.sk";
  right = dir + "/right.sk";
  source = dir + "/main.sk";
  output = dir + "/program";
  data = dir + "/data";
  args = compile_cmd(Array[left, right, source], output).concat(
    Array["--no-ipa"],
  );
  try {
    FileSystem.writeTextFile(left, "fun graphLeft(): String { \"one\" }\n");
    FileSystem.writeTextFile(right, "fun graphRight(): Array<String> { Array[\"one\"] }\n");
    FileSystem.writeTextFile(
      source,
      "untracked fun main(): void { print_raw(graphLeft()); print_raw(graphRight()[0]) }\n",
    );
    initial = System.subprocess(
      args.concat(Array["--init", data]),
    ).fromSuccess();
    T.expectTrue(initial.success(), initial.stderr);
    T.expectEq(System.subprocess(Array[output]).fromSuccess().stdout, "oneone");
    for ((literal, expected, changed, timestamp) in Array[
      ("two", "twoone", true, "200001010000.01"),
      ("two", "twoone", false, "200001010000.02"),
      ("one", "oneone", true, "200001010000.03"),
    ]) {
      FileSystem.writeTextFile(
        left,
        `fun graphLeft(): String { "${literal}" }\n`,
      );
      T.expectTrue(
        System.subprocess(Array["touch", "-t", timestamp, left])
          .fromSuccess()
          .success(),
      );
      updated = System.subprocess(
        args.concat(Array["--data", data, "--debug-skstore"]),
      ).fromSuccess();
      T.expectTrue(updated.success(), updated.stderr);
      T.expectEq(
        System.subprocess(Array[output]).fromSuccess().stdout,
        expected,
      );
      executions = updated.stdout
        .split("\n")
        .filter(line -> line.startsWith("LLVM_FUNCTION:"))
        .collect(Array);
      T.expectEq(
        executions.size(),
        if (changed) 1 else 0,
        executions.join("\n"),
      );
      T.expectTrue(
        executions.all(line -> line.contains("graphLeft")),
        executions.join("\n"),
      );
      T.expectFalse(updated.stdout.contains("LLVM_SHARED"), updated.stdout);
    };
    // Missing output replay assembles cached fragments without regenerating them.
    T.expectTrue(
      System.subprocess(Array["rm", output]).fromSuccess().success(),
    );
    replay = System.subprocess(
      args.concat(Array["--data", data, "--debug-skstore"]),
    ).fromSuccess();
    T.expectTrue(replay.success(), replay.stderr);
    T.expectEq(System.subprocess(Array[output]).fromSuccess().stdout, "oneone");
    T.expectFalse(replay.stdout.contains("LLVM_FUNCTION:"), replay.stdout);
    T.expectFalse(replay.stdout.contains("LLVM_SHARED"), replay.stdout);
    // A multi-way type switch exercises shared vtable data and target blocks.
    // Computed gotos are disabled, so the active backend uses switch indices.
    dispatch =
      "base class GraphBase() {}\n" +
      "class GraphA() extends GraphBase {}\n" +
      "class GraphB() extends GraphBase {}\n" +
      "class GraphC() extends GraphBase {}\n" +
      "fun graphPick(n: Int): GraphBase { if (n == 0) GraphA() else if (n == 1) GraphB() else GraphC() }\n" +
      "untracked fun graphShow(x: GraphBase): void { x match { | GraphA _ -> print_raw(\"A\"); print_raw(\"A\") | GraphB _ -> print_raw(\"B\") | GraphC _ -> print_raw(\"C\"); print_raw(\"C\"); print_raw(\"C\") } }\n" +
      "untracked fun main(): void { graphShow(graphPick(0)); graphShow(graphPick(1)); graphShow(graphPick(2)); print_raw(graphRight()[0]) }\n";
    for ((text, expected, timestamp) in Array[
      (dispatch, "AABCCCone", "200001010000.04"),
      (
        dispatch.replace("print_raw(\"A\");", "print_raw(\"D\");"),
        "DABCCCone",
        "200001010000.05",
      ),
      (dispatch, "AABCCCone", "200001010000.06"),
    ]) {
      FileSystem.writeTextFile(source, text);
      T.expectTrue(
        System.subprocess(Array["touch", "-t", timestamp, source])
          .fromSuccess()
          .success(),
      );
      updated = System.subprocess(
        args.concat(Array["--data", data, "--debug-skstore"]),
      ).fromSuccess();
      T.expectTrue(updated.success(), updated.stderr);
      // This independent static array retains its class-based vtable reference
      // while new dispatch classes change the shared physical table layout.
      T.expectFalse(updated.stdout.split("\n").any(line ->
        line.startsWith("LLVM_FUNCTION:") && line.contains("graphRight")
      ), updated.stdout);
      T.expectEq(
        System.subprocess(Array[output]).fromSuccess().stdout,
        expected,
      );
    };
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
    throw exn
  };
  T.expectTrue(System.subprocess(Array["rm", "-r", dir]).fromSuccess().success());
}

// Count real emission/clang work, and verify other modules remain byte-identical.
private fun incrementalLLVMEmission(): void {
  dir = System.subprocess(Array["mktemp", "-d"]).fromSuccess().stdout.trim();
  source = dir + "/input.sk";
  output = dir + "/program";
  data = dir + "/data";
  args = compile_cmd(Array[source], output).concat(
    Array["--no-ipa", "--verbose"],
  );
  baseline =
    "untracked fun emitLeft(n: Int): void { print_raw(\"left\" + n.toString()) }\n" +
    "untracked fun emitRight(n: Int): void { print_raw(\"right\" + n.toString()) }\n" +
    "untracked fun main(): void { emitLeft(1); emitRight(2) }\n";
  try {
    FileSystem.writeTextFile(source, baseline);
    initial = System.subprocess(
      args.concat(Array["--init", data]),
    ).fromSuccess();
    T.expectTrue(initial.success(), initial.stderr);
    T.expectEq(
      System.subprocess(Array[output]).fromSuccess().stdout,
      "left1right2",
    );
    support = output + ".llvm/m2_0.ll";
    // readTextFile's tracked wrapper can be CSE'd across child-process writes.
    // Use fresh external reads to verify the bytes actually present on disk.
    originalSupport = System.subprocess(
      Array["cat", support],
    ).fromSuccess().stdout;
    for ((text, expected, changed, stamp) in Array[
      (
        baseline.replace("left", "LEFT"),
        "LEFT1right2",
        true,
        "200001010000.01",
      ),
      (
        baseline.replace("left", "LEFT"),
        "LEFT1right2",
        false,
        "200001010000.02",
      ),
      (baseline, "left1right2", true, "200001010000.03"),
      (
        baseline + "fun emitUnused(): Int { 42 }\n",
        "left1right2",
        false,
        "200001010000.04",
      ),
      (baseline, "left1right2", false, "200001010000.05"),
    ]) {
      FileSystem.writeTextFile(source, text);
      _ = System.subprocess(Array["touch", "-t", stamp, source]).fromSuccess();
      updated = System.subprocess(
        args.concat(Array["--data", data, "--debug-skstore"]),
      ).fromSuccess();
      T.expectTrue(updated.success(), updated.stderr);
      T.expectEq(
        System.subprocess(Array[output]).fromSuccess().stdout,
        expected,
      );
      modules = updated.stdout
        .split("\n")
        .filter(l -> l.startsWith("LLVM_MODULE:"))
        .collect(Array);
      compiles = updated.stderr
        .split("\n")
        .filter(l -> l.startsWith(">> clang++ ") && l.contains(" -c "))
        .collect(Array);
      T.expectTrue(
        modules.size() <= (if (changed) 3 else 0),
        modules.join("\n"),
      );
      T.expectTrue(
        compiles.size() <= (if (changed) 3 else 0),
        compiles.join("\n"),
      );
      if (changed) T.expectTrue(!compiles.isEmpty(), updated.stderr);
      T.expectEq(
        System.subprocess(Array["cat", support]).fromSuccess().stdout,
        originalSupport,
      );
    };
    // Losing one LLVM/object artifact recreates it without rerendering modules.
    for (suffix in Array[".ll", ".o", ".flags"]) {
      missing = output + ".llvm/m2_0" + suffix;
      _ = System.subprocess(Array["rm", missing]).fromSuccess();
      replay = System.subprocess(
        args.concat(Array["--data", data, "--debug-skstore"]),
      ).fromSuccess();
      T.expectTrue(replay.success(), replay.stderr);
      T.expectTrue(FileSystem.exists(missing));
      T.expectFalse(replay.stdout.contains("LLVM_MODULE:"), replay.stdout);
      compiles = replay.stderr
        .split("\n")
        .filter(l -> l.startsWith(">> clang++ ") && l.contains(" -c "))
        .collect(Array);
      T.expectEq(compiles.size(), 1, replay.stderr);
      T.expectEq(
        System.subprocess(Array[output]).fromSuccess().stdout,
        "left1right2",
      );
    };
    // Only the external preamble changes; the Skip sources and configuration
    // stay identical on the second invocation. Its bytes are tracked inputs.
    preamble = dir + "/header.ll";
    FileSystem.writeTextFile(preamble, "; EMISSION_HEADER_FIRST\n");
    withPreamble = Array["env", "SKC_PREAMBLE=" + preamble].concat(args).concat(
      Array["--data", data, "--debug-skstore"],
    );
    firstHeader = System.subprocess(withPreamble).fromSuccess();
    T.expectTrue(firstHeader.success(), firstHeader.stderr);
    FileSystem.writeTextFile(preamble, "; EMISSION_HEADER_SECOND\n");
    nextHeader = System.subprocess(withPreamble).fromSuccess();
    T.expectTrue(nextHeader.success(), nextHeader.stderr);
    actualSupport = System.subprocess(
      Array["cat", support],
    ).fromSuccess().stdout;
    T.expectTrue(
      actualSupport.startsWith("; EMISSION_HEADER_SECOND"),
      actualSupport.take(200),
    );
    T.expectTrue(nextHeader.stdout.contains("LLVM_MODULE:"), nextHeader.stdout);
    T.expectFalse(
      nextHeader.stdout.contains("LLVM_FUNCTION:"),
      nextHeader.stdout,
    );
    T.expectEq(
      System.subprocess(Array[output]).fromSuccess().stdout,
      "left1right2",
    );
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
    throw exn
  };
  _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
}

// Preserve cycle-breaking behavior while bodies and dependency edges change.
private fun incrementalOptimizationCycles(): void {
  temp = System.subprocess(Array["mktemp", "-d"]).fromSuccess();
  T.expectTrue(temp.success(), temp.stderr);
  dir = temp.stdout.trim();
  source = dir + "/input.sk";
  output = dir + "/program";
  data = dir + "/data";
  baseline =
    "fun optCycleLeft(n: Int): Int { if (n == 0) 11 else optCycleRight(n - 1) }\n" +
    "fun optCycleRight(n: Int): Int { if (n == 0) 2 else optCycleLeft(n - 1) }\n" +
    "untracked fun main(): void { print_raw((optCycleLeft(4) + optCycleLeft(5)).toString()) }\n";
  args = compile_cmd(Array[source], output);
  try {
    for ((contents, expected, timestamp, initial) in Array[
      (baseline, "13", "200001010000.01", true),
      (
        baseline.replace(") 11 else", ") 12 else"),
        "14",
        "200001010000.02",
        false,
      ),
      (
        baseline.replace(
          "else optCycleLeft(n - 1)",
          "else optCycleRight(n - 1)",
        ),
        "4",
        "200001010000.03",
        false,
      ),
      (baseline, "13", "200001010000.04", false),
    ]) {
      FileSystem.writeTextFile(source, contents);
      T.expectTrue(
        System.subprocess(Array["touch", "-t", timestamp, source])
          .fromSuccess()
          .success(),
      );
      compiled = System.subprocess(
        args.concat(Array[if (initial) "--init" else "--data", data]),
      ).fromSuccess();
      T.expectTrue(compiled.success(), compiled.stderr);
      T.expectEq(
        System.subprocess(Array[output]).fromSuccess().stdout,
        expected,
      );
      sequential = System.subprocess(
        args.concat(Array["--release"]),
      ).fromSuccess();
      T.expectTrue(sequential.success(), sequential.stderr);
      T.expectEq(
        System.subprocess(Array[output]).fromSuccess().stdout,
        expected,
      );
    }
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
    throw exn
  };
  T.expectTrue(
    System.subprocess(Array["rm", "-r", dir]).fromSuccess().success(),
  );
}

// A verifier failure must still print a function with resolved locations when
// normal optimizer inputs carry no absolute coordinates.
private fun deferredVerifierPositions(): void {
  config = Config.Config{
    release => false,
    verbose => false,
    debug => false,
    optConfig => Optimize.Config::make(
      true,
      true,
      true,
      true,
      true,
      true,
      false,
      true,
    ),
    input_files => Array[],
    direct_dependencies => Array[],
    dependencies => Map[],
    exportedFunctions => UnorderedSet[],
    exportedAsFunctions => UnorderedMap[],
    disasmAll => false,
    disasmAnnotated => false,
    disasmFiles => UnorderedSet[],
    disasmFunctions => UnorderedSet[],
    output => "",
    emit => "llvm-ir",
    lib_name => None(),
    target => "wasm32",
    optLevel => 0,
    asan => false,
    autogc => false,
    sampleRate => 0,
    useSpecializedNames => false,
    check => false,
    no_link => true,
    stopAfterSpecialization => false,
    deferVerifierDiagnostics => true,
    stackAlign => 8,
    stackAlignStr => "8",
    ptrByteSize => 4,
    ptrBitSize => 32,
    vtableByteSize => 4,
    sysroot => "",
    sklib_search_paths => Array[],
    static_libraries => Array[],
    link_args => Array[],
    preambles => Array[],
    canonize_paths => false,
    cwd => Config.WorkingDirectory::create(false),
  };
  file = FileCache.InputSource(None(), "verifier-positions.sk");
  symbol = Array["test", "start"];
  point = SourcePositions.Point{symbol, line => 0, column => 0};
  pos = FileRange{
    file,
    range => SourcePositions.Range{start => point, end => point},
  };
  f = Function{
    id => SFunctionID(0),
    name => "verifierPositions",
    gfunction => GFunctionName("verifierPositions"),
    pos,
    funType => kVoidVoidFunType,
    params => Array[],
    superpositions => UnorderedSet[FunSuperpositionID::empty],
    blocks => Array[
      Block{
        id => BlockID(0),
        pos,
        params => Array[],
        instrs => Array[
          Return{id => InstrID(0), typ => tVoid, pos, values => Array[]},
        ],
      },
    ],
  };
  functions = FunctionIDToFunction::mcreate();
  functions.insert(f);
  env = GlobalEnv{sclasses => SortedMap[], sfuns => functions.chill()};
  for (useTracked in Array[false, true]) {
    _ = SKStore.run(context ~> {
      classRows: Array<(SKStore.Key, SKStore.File)> = Array[
        (SKStore.IID(0), SKStore.BoolFile(false)),
      ];
      classFiles = context.mkdir(
        x ~> x,
        x ~> x,
        SKStore.DirName::create("/test-verifier-classes/"),
        classRows,
      );
      reader = if (useTracked) Some(mutable ClassInputs.Reader(context, classFiles)) else None();
      _ = context.mkdir(
        FileCache.InputSource::keyType,
        SourcePositions.SymbolsFile::type,
        SourcePositions.dir.dirName,
        Array[
          (
            file,
            SourcePositions.SymbolsFile(
              Map[symbol => Position.create(200, 4)],
              Map[symbol => 0],
            ),
          ),
        ],
      );
      reads = context.reads;
      Verify.withSourcePositions(context, () ->
        Verify.verifyFunction(f, env, config, "test", reader)
      );
      T.expectEq(
        context.reads,
        reads,
        "Successful verification must not read coordinates",
      );
      bad = f with {funType => f.funType with {params => Array[tInt]}};
      failed = false;
      try {
        Verify.withSourcePositions(context, () ->
          Verify.verifyFunction(bad, env, config, "test", reader)
        )
      } catch {
      | error @ Assert.InternalError _ ->
        !failed = true;
        T.expectTrue(
          error.getMessage().contains("Argument count mismatch"),
          error.getMessage(),
        )
      | other -> throw other
      };
      T.expectTrue(
        failed,
        "Expected verifier failure with a resolved function dump",
      );
      T.expectTrue(
        context.reads.size() > reads.size(),
        "Failure must read current coordinates",
      );
    });
  };
}

private fun incrementalSourcePositions(): void {
  temp = System.subprocess(Array["mktemp", "-d"]).fromSuccess();
  T.expectTrue(temp.success(), temp.stderr);
  dir = temp.stdout.trim();
  source = dir + "/input.sk";
  output = dir + "/output.ll";
  data = dir + "/data";
  baseline =
    "class PositionExample() {\n" +
    "  fun first(): Int { 1 }\n" +
    "  fun second(): Int { 23456789101 }\n" +
    "}\n" +
    "untracked fun main(): void { print_raw((PositionExample().first() + PositionExample().second()).toString()) }\n";
  args = compile_cmd(Array[source], output).concat(Array["--emit=llvm-ir"]);
  write = (contents, timestamp) -> {
    FileSystem.writeTextFile(source, contents);
    result = System.subprocess(
      Array["touch", "-t", timestamp, source],
    ).fromSuccess();
    T.expectTrue(result.success(), result.stderr);
  };
  try {
    for ((contents, timestamp, line, initialize, expectCached) in Array[
      (baseline, "200001010000.01", 3, true, false),
      ("// moved\n\n\n" + baseline, "200001010000.02", 6, false, true),
      (
        baseline.replace("Int { 1 }", "Int {\n    1 }"),
        "200001010000.03",
        4,
        false,
        true,
      ),
      (
        baseline.replace(
          "  fun first(): Int { 1 }\n  fun second(): Int { 23456789101 }",
          "  fun second(): Int { 23456789101 }\n  fun first(): Int { 1 }",
        ),
        "200001010000.04",
        2,
        false,
        false,
      ),
    ]) {
      write(contents, timestamp);
      compiled = System.subprocess(
        args.concat(Array[if (initialize) "--init" else "--data", data]).concat(
          if (timestamp == "200001010000.02") Array["--debug-skstore"] else Array[],
        ),
      ).fromSuccess();
      T.expectTrue(compiled.success(), compiled.stderr);
      if (timestamp == "200001010000.02") {
        // Moving declarations updates LLVM locations without changing semantic
        // optimization state, including the cached scheduler rounds.
        optimizerWrites = compiled.stdout
          .split("\n")
          .filter(line -> line.startsWith("WRITTEN:  /optimizer/"))
          .collect(Array);
        T.expectEq(optimizerWrites.size(), 0, optimizerWrites.join("\n"));
      };
      if (expectCached) {
        T.expectFalse(compiled.stderr.contains("\"KK\""), compiled.stderr);
      };
      metadata = FileSystem.readTextFile(output)
        .split("\n")
        .filter(s ->
          s.contains("!DISubprogram(") &&
            s.contains("PositionExample") &&
            s.contains("second")
        )
        .collect(Array);
      T.expectFalse(metadata.isEmpty(), "Missing debug metadata for second");
      for (entry in metadata) {
        T.expectTrue(entry.contains(`line: ${line},`), entry)
      };
    };
    // Relative locations must also resolve correctly in frontend diagnostics,
    // including a multiline method and the same-line column offset.
    invalid = baseline.replace("Int { 23456789101 }", "Int {\n    \"bad\" }");
    for ((contents, timestamp, line) in Array[
      (invalid, "200001010000.05", 4),
      ("// moved\n\n" + invalid, "200001010000.06", 6),
    ]) {
      write(contents, timestamp);
      compiled = System.subprocess(
        args.concat(Array["--data", data]),
      ).fromSuccess();
      T.expectEq(compiled.exitcode(), 2, compiled.stderr);
      T.expectTrue(
        compiled.stderr.contains(`line ${line}, characters 5-9:`),
        compiled.stderr,
      );
      T.expectTrue(
        compiled.stderr.contains("incompatible with the return type 'Int'"),
        compiled.stderr,
      );
      T.expectFalse(compiled.stderr.contains("\"KK\""), compiled.stderr);
    };
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
    throw exn
  };
  T.expectTrue(
    System.subprocess(Array["rm", "-r", dir]).fromSuccess().success(),
  );
}

private fun incrementalConstructorPositions(): void {
  temp = System.subprocess(Array["mktemp", "-d"]).fromSuccess();
  T.expectTrue(temp.success(), temp.stderr);
  dir = temp.stdout.trim();
  source = dir + "/input.sk";
  output = dir + "/output.ll";
  data = dir + "/data";
  baseline =
    "class NamedPositionExample{\n" +
    "  first: Int = 1,\n" +
    "  second: Int = 2,\n" +
    "} { fun sum(): Int { this.first + this.second } }\n" +
    "class PositionalPositionExample(\n" +
    "  first: Int,\n" +
    "  second: Int,\n" +
    ") { fun sum(): Int { this.first + this.second } }\n" +
    "class UnnamedPositionExample(\n" +
    "  Int,\n" +
    "  Int,\n" +
    ") {}\n" +
    "untracked fun main(): void { print_raw((NamedPositionExample{}.sum() + PositionalPositionExample(1, 2).sum()).toString()); _ = UnnamedPositionExample(1, 2) }\n";
  args = compile_cmd(Array[source], output).concat(Array["--emit=llvm-ir"]);
  write = (contents, timestamp) -> {
    FileSystem.writeTextFile(source, contents);
    touched = System.subprocess(
      Array["touch", "-t", timestamp, source],
    ).fromSuccess();
    T.expectTrue(touched.success(), touched.stderr);
  };
  try {
    for ((contents, timestamp, initialize, expectCached) in Array[
      (baseline, "200001010000.01", true, false),
      (
        baseline
          .replace("  first:", "\n  first:")
          .replace("  Int,", "\n  Int,"),
        "200001010000.02",
        false,
        true,
      ),
      (
        baseline
          .replace("  second:", "\n\n  second:")
          .replace("  Int,", "\n\n  Int,"),
        "200001010000.03",
        false,
        true,
      ),
      (
        baseline.replace(
          "  first: Int = 1,",
          "  extra: Int = 0,\n  first: Int = 1,",
        ),
        "200001010000.04",
        false,
        false,
      ),
      (baseline, "200001010000.05", false, false),
    ]) {
      write(contents, timestamp);
      compiled = System.subprocess(
        args.concat(Array[if (initialize) "--init" else "--data", data]),
      ).fromSuccess();
      T.expectTrue(compiled.success(), compiled.stderr);
      if (expectCached) {
        T.expectFalse(compiled.stderr.contains("\"KK\""), compiled.stderr);
      };
    };
    // A field's type and initializer resolve through its own anchor.
    invalid = baseline.replace("second: Int = 2", "second: Int = \"bad\"");
    for ((contents, timestamp, line) in Array[
      (invalid, "200001010000.06", 3),
      (invalid.replace("  second:", "\n\n  second:"), "200001010000.07", 5),
    ]) {
      write(contents, timestamp);
      compiled = System.subprocess(
        args.concat(Array["--data", data]),
      ).fromSuccess();
      T.expectEq(compiled.exitcode(), 2, compiled.stderr);
      T.expectTrue(compiled.stderr.contains(`line ${line},`), compiled.stderr);
      T.expectFalse(compiled.stderr.contains("\"KK\""), compiled.stderr);
    };
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
    throw exn
  };
  T.expectTrue(
    System.subprocess(Array["rm", "-r", dir]).fromSuccess().success(),
  );
}

// Ordinary and release invocations discover sequentially; non-release
// persistence opts into the incremental graph, including config-only updates.
private fun specializationModeSelection(): void {
  temp = System.subprocess(Array["mktemp", "-d"]).fromSuccess();
  T.expectTrue(temp.success(), temp.stderr);
  dir = temp.stdout.trim();
  source = dir + "/input.sk";
  output = dir + "/program";
  data = dir + "/data";
  args = compile_cmd(Array[source], output).concat(Array["--verbose"]);
  try {
    FileSystem.writeTextFile(
      source,
      "class ModeThing() { fun value(): Int { 41 } }\n" +
        "untracked fun main(): void { print_raw(ModeThing().value().toString()); }\n",
    );
    for ((release, persistent) in Array[
      (true, false), (true, true), (false, false), (false, true),
    ]) {
      selectedData = if (release) data + "-release" else data;
      compiled = System.subprocess(
        args
          .concat(if (release) Array["--release"] else Array[])
          .concat(if (persistent) Array["--init", selectedData] else Array[]),
      ).fromSuccess();
      T.expectTrue(compiled.success(), compiled.stderr);
      T.expectEq(
        compiled.stderr.contains("Sequential specialization complete"),
        release || !persistent,
      );
      T.expectEq(
        compiled.stderr.contains("Incremental specialization:"),
        persistent && !release,
      );
      result = System.subprocess(Array[output]).fromSuccess();
      T.expectTrue(result.success(), result.stderr);
      T.expectEq(result.stdout, "41");
      if (release && persistent) {
        resumed = System.subprocess(
          args.concat(Array[
            "--release", "--data", selectedData, "--emit=llvm-ir",
          ]),
        ).fromSuccess();
        T.expectTrue(resumed.success(), resumed.stderr);
        T.expectTrue(
          resumed.stderr.contains("Sequential specialization complete"),
          resumed.stderr,
        );
        T.expectFalse(
          resumed.stderr.contains("Incremental specialization:"),
          resumed.stderr,
        );
      };
    };
    FileSystem.writeTextFile(
      source,
      "class ExtraThing() { fun value(): Int { 42 } }\n" +
        "untracked fun configOnlyExtra(): Int { ExtraThing().value() }\n" +
        "untracked fun main(): void { print_raw(ExtraThing().value().toString()); }\n",
    );
    touched = System.subprocess(
      Array["touch", "-t", "200001010000.02", source],
    ).fromSuccess();
    T.expectTrue(touched.success(), touched.stderr);
    updated = System.subprocess(
      args.concat(Array["--data", data]),
    ).fromSuccess();
    T.expectTrue(updated.success(), updated.stderr);
    T.expectFalse(
      updated.stderr.contains("Sequential specialization complete"),
      updated.stderr,
    );
    result = System.subprocess(Array[output]).fromSuccess();
    T.expectTrue(result.success(), result.stderr);
    T.expectEq(result.stdout, "42");
    // Changing exports reruns the driver while preserving the work mappers'
    // target-layout captures. The source stays unchanged during these updates.
    for (exported in Array[true, false]) {
      compiled = System.subprocess(
        args
          .concat(Array["--data", data, "--emit=llvm-ir"])
          .concat(
            if (exported) {
              Array["--export-function-as", "configOnlyExtra=config_only_extra"]
            } else {
              Array[]
            },
          ),
      ).fromSuccess();
      T.expectTrue(compiled.success(), compiled.stderr);
      T.expectEq(
        FileSystem.readTextFile(output).contains("@config_only_extra("),
        exported,
      );
    };
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-r", dir]).fromSuccess();
    throw exn
  };
  T.expectTrue(
    System.subprocess(Array["rm", "-r", dir]).fromSuccess().success(),
  );
}

private class DebugTraceCallable{payload: String} extends OuterIstToIR.LazyGFun {
  fun gname(): GFunctionName { GFunctionName("debugTraceFunction") }

  fun compile(
    _context: mutable SKStore.Context,
    _converter: OuterIstToIR.Converter,
  ): OuterIstToIR.GFunction {
    invariant_violation("Debug key formatting must not compile the callable")
  }
}

private fun compactFunctionDebugKeys(): void {
  callable = DebugTraceCallable{payload => String::tabulate(100000, _ -> 'x')};
  key = OuterIstToIR.GFunKey(callable, FunSuperpositionID::empty);
  for (text in Array[
    key.toString(),
    OuterIstToIR.GFunKeyKey(key).toString(),
    OuterIstToIR.GenericFunctionKey(callable).toString(),
    OuterIstToIR.LazyGFunKey(callable).toString(),
  ]) {
    T.expectTrue(text.contains("debugTraceFunction"), text);
    T.expectTrue(text.length() < 256, "Debug keys expanded the callable payload");
  }
}

private fun incrementalCopydownPolicy(): void {
  dir = System.subprocess(Array["mktemp", "-d"]).fromSuccess().stdout.trim();
  source = Path.join(dir, "input.sk");
  output = Path.join(dir, "program");
  data = Path.join(dir, "data");
  args = compile_cmd(Array[source], output);
  initial =
    "base class CopydownBase { fun value(): Int { 1 } }\n" +
    "class CopydownChild() extends CopydownBase { fun marker(): Int { 7 } }\n" +
    "class CopydownStableKey(value: Int) extends SKStore.Key\n" +
    "untracked fun main(): void { print_raw(CopydownChild().value().toString()); }\n";
  try {
    FileSystem.writeTextFile(source, initial);
    built = System.subprocess(args.concat(Array["--init", data])).fromSuccess();
    T.expectTrue(built.success(), built.stderr);
    T.expectEq(System.subprocess(Array[output]).fromSuccess().stdout, "1");
    FileSystem.writeTextFile(source, initial +
      "class CopydownOtherKey(value: Int) extends SKStore.Key\n");
    T.expectTrue(System.subprocess(Array["touch", "-t", "200001010000.01", source]).fromSuccess().success());
    updated = System.subprocess(args.concat(Array["--data", data, "--debug-skstore"])).fromSuccess();
    T.expectTrue(updated.success(), updated.stderr);
    T.expectFalse(updated.stdout.split("\n").any(line ->
      line.startsWith("TYPECHECK_CLASS:") && line.contains("CopydownStableKey")
    ), updated.stdout);
    T.expectEq(System.subprocess(Array[output]).fromSuccess().stdout, "1");
    // A source-class property used by the policy must still update its users.
    // Explicit `this` return types require typing copied methods in the child.
    selfTyped = initial.replace("fun value(): Int { 1 }",
      "fun value(): Int { 2 } fun same(): this { this }")
      .replace("CopydownChild().value()", "CopydownChild().same().marker()");
    for ((text, expected, timestamp) in Array[
      (selfTyped, "7", "200001010000.02"),
      (initial, "1", "200001010000.03"),
    ]) {
      FileSystem.writeTextFile(source, text);
      T.expectTrue(System.subprocess(Array["touch", "-t", timestamp, source]).fromSuccess().success());
      rebuilt = System.subprocess(args.concat(Array["--data", data])).fromSuccess();
      T.expectTrue(rebuilt.success(), rebuilt.stderr);
      T.expectEq(System.subprocess(Array[output]).fromSuccess().stdout, expected);
      fresh = System.subprocess(compile_cmd(Array[source], output + "-fresh")
        .concat(Array["--release"])).fromSuccess();
      T.expectTrue(fresh.success(), fresh.stderr);
      T.expectEq(System.subprocess(Array[output + "-fresh"]).fromSuccess().stdout, expected);
    }
  } catch {
  | exn ->
    _ = System.subprocess(Array["rm", "-rf", dir]);
    throw exn
  };
  _ = System.subprocess(Array["rm", "-rf", dir]);
}

private fun incrementalBodyCapture(): void {
  file = FileCache.InputSource(None(), "body-capture-probe.sk");
  source = "fun changed(): Int { 1 }\nfun untouched(): Int { 2 }\nclass Stable { fun value(): Int { 3 } }\n";
  edited = source.replace("{ 1 }", "{ 9 }");
  before = SkipParse.parseFile(file, source).defs.collect(Array);
  after = SkipParse.parseFile(file, edited).defs.collect(Array);
  invariant(before.size() == after.size());
  for (i => left in before) {
    name = left match {
    | SkipAst.DFun(def) -> def.name.i1
    | SkipAst.DClass(def) -> def.name.i1
    | _ -> "other"
    };
    T.expectEq(native_eq(left, after[i]) == 0, name != "changed")
  }
}

untracked fun main(): void {
  tests = mutable Map[];
  tests.set(
    "incremental",
    mutable Vector[
      T.Test{name => "body_capture", func => () ~> incrementalBodyCapture()},
      T.Test{name => "copydown_policy", func => () ~> incrementalCopydownPolicy()},
      T.Test{
        name => "compact_function_debug_keys",
        func => () ~> compactFunctionDebugKeys(),
      },
      T.Test{
        name => "mode_selection",
        func => () ~> specializationModeSelection(),
      },
      T.Test{
        name => "verifier_positions",
        func => () ~> deferredVerifierPositions(),
      },
      T.Test{
        name => "source_positions",
        func => () ~> incrementalSourcePositions(),
      },
      T.Test{
        name => "constructor_positions",
        func => () ~> incrementalConstructorPositions(),
      },
      T.Test{name => "relationships", func => () ~> incrementalRelationships()},
      T.Test{
        name => "latched_relations",
        func => () ~> incrementalLatchedRelations(),
      },
      T.Test{
        name => "scalarized_fields",
        func => () ~> incrementalScalarizedFields(),
      },
      T.Test{name => "field_layouts", func => () ~> incrementalFieldLayouts()},
      T.Test{name => "function_ir", func => () ~> incrementalFunctionIR()},
      T.Test{
        name => "stable_function_ids",
        func => () ~> incrementalStableFunctionIDs(),
      },
      T.Test{
        name => "const_function_ids",
        func => () ~> incrementalConstFunctionIDs(),
      },
      T.Test{
        name => "module_members",
        func => () ~> incrementalModuleMembers(),
      },
      T.Test{name => "optimization", func => () ~> incrementalOptimization()},
      T.Test{
        name => "native_lowering",
        func => () ~> incrementalNativeLowering(),
      },
      T.Test{name => "llvm_graph", func => () ~> incrementalLLVMGraph()},
      T.Test{name => "llvm_emission", func => () ~> incrementalLLVMEmission()},
      T.Test{
        name => "optimization_cycles",
        func => () ~> incrementalOptimizationCycles(),
      },
      T.Test{
        name => "native_type_identity",
        func => () ~> nativeTypeIdentity(),
      },
      T.Test{
        name => "frontend_errors",
        func => () ~> incrementalFrontendErrors(),
      },
    ],
  );

  // Escape hatches for the fast paths, both compiling one `skc` per test:
  //   SKC_SUBPROCESS=1 — force *all* tests to subprocess mode (no @exptest,
  //                      no invalid-test batch).
  //   SKC_NO_BATCH=1   — keep @exptest for valid tests, but disable just the
  //                      invalid-test batch (compile each invalid test on its
  //                      own, as before batching).
  subprocessMode = Environ.varOpt("SKC_SUBPROCESS").isSome();
  batchDisabled = subprocessMode || Environ.varOpt("SKC_NO_BATCH").isSome();

  // Discover @exptest-annotated functions. These are present when all
  // test .sk files are compiled into this binary (i.e. when `tests` is
  // not set in Skargo.toml, so Skargo auto-discovers all files in tests/).
  coveredModules = if (!subprocessMode) {
    addExpTestFunctions(tests)
  } else {
    Set[]
  };

  // In unified mode, verify that the skc on PATH is the same one that
  // compiled this test binary.
  if (!coveredModules.isEmpty()) {
    compiledBy = #env ("GIT_COMMIT_HASH");
    tests
      .getOrAdd("Native", () -> mutable Vector[])
      .push(
        T.Test{
          name => "CompilerVersionCheck",
          func => () ~> {
            p = System.subprocess(Array["skc", "--version"]).fromSuccess();
            invariant(
              p.stdout.contains(compiledBy),
              `Test binary compiled by skc (${compiledBy}) but PATH skc ` +
                `reports: ${p.stdout}`,
            );
          },
        },
      );
  };

  // Run any valid tests NOT covered by @exptest in subprocess mode.
  validTests = FileSystem.readFilesRecursive("./tests", fn ->
    fn.endsWith(".exp")
  );

  for (testFile in validTests) {
    basename = testFile.stripSuffix(".exp");
    relPath = basename.stripPrefix("tests/");
    (testSuite, testName) = relPath.splitLast("/");
    moduleName = relPath.split("/").join("_");
    if (coveredModules.contains(moduleName)) continue;
    mainFn = moduleName + ".main";
    tests
      .getOrAdd(testSuite, () -> mutable Vector[])
      .push(
        T.Test{name => testName, func => () ~> genValidTest(basename, mainFn)},
      );
  };

  // Invalid tests (which must fail to compile) are, by default, compiled
  // together via `skc --batch` rather than one `skc` per test (see
  // `batchCompileInvalid`); each test then just reads its pre-batched result.
  // When batching is disabled, fall back to compiling each in its own `skc`.
  invalidTests = FileSystem.readFilesRecursive("./invalid_tests", fn ->
    fn.endsWith(".exp_err")
  );

  invalidBasenames = mutable Vector<String>[];
  for (testFile in invalidTests) {
    basename = testFile.stripSuffix(".exp_err");
    invalidBasenames.push(basename);
    (testSuite, testName) = basename
      .stripPrefix("invalid_tests/")
      .splitLast("/");
    testFunc: untracked () ~> void = if (batchDisabled) {
      () ~> genInvalidTest(basename)
    } else {
      () ~> runInvalidFromBatch(basename)
    };
    tests
      .getOrAdd(testSuite, () -> mutable Vector[])
      .push(T.Test{name => testName, func => testFunc})
  };
  invalidUnits = invalidBasenames.collect(Array);

  // Unless batching is disabled, compile the invalid set once, up front,
  // sharing the stdlib type-check via `skc --batch`. `test_harness` runs this
  // in the parent after parsing its args and before forking the workers,
  // passing its own job count — so the batch shards at the same parallelism the
  // workers run at. The workers (which re-exec this binary) then just read each
  // unit's result from the scratch dir.
  T.test_harness(tests, (njobs, shouldRun) ~> {
    if (!batchDisabled && !invalidUnits.isEmpty()) {
      batchCompileInvalid(invalidUnits, njobs, shouldRun)
    }
  })
}

module end;
