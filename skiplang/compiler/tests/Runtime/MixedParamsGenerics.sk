module Runtime_MixedParamsGenerics;
fun f<T>(a: T){b: T}: T {
  b
}

fun g<T: Orderable>(a: T){b: String}: String {
  b + a.toString()
}

@exptest
fun main(): void {
  print_raw(
    f(1){b => 2}.toString() +
      f{b => 3}(4).toString() +
      f<Int>(5){b => 6}.toString() +
      g(7){b => "y"} +
      "\n",
  )
}
module end;
