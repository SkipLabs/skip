module Runtime_ArrayUnsafeGetConst;
// ArrayUnsafeGet on a constant array with a constant in-bounds index folds
// at compile time. Non-constant arrays or indices are not folded but must
// still compute the right value at runtime.

@exptest
fun main(): void {
  print_raw(
    // Scalar array: first, middle, and last in-bounds indices.
    Unsafe.array_get(Array[10, 20, 30], 0).toString() +
      "\n" +
      Unsafe.array_get(Array[10, 20, 30], 1).toString() +
      "\n" +
      Unsafe.array_get(Array[10, 20, 30], 2).toString() +
      "\n" +
      // Tuple elements exercise tupleIndex 0 and 1.
      Unsafe.array_get(Array[(10, "a"), (20, "b")], 1).i0.toString() +
      "\n" +
      Unsafe.array_get(Array[(10, "a"), (20, "b")], 1).i1 +
      "\n" +
      // Non-constant index: not folded, computed at runtime.
      Unsafe.array_get(Array[10, 20, 30], "ab".length() - 1).toString() +
      "\n" +
      // Non-constant array (clone is not folded): not folded, runtime value.
      Unsafe.array_get(Array[10, 20, 30].clone(), 2).toString() +
      "\n",
  )
}
module end;
