module Runtime_MixedParamsDefaultOrder;
// Omitted default arguments evaluate in declaration order across the two
// groups (positional group first, then the named group in declaration order,
// not lexical order).
fun eff(s: String): String {
  print_raw(s);
  s
}

fun f(a: Int, p: String = `${eff("p")}P`){
  z: String = `${eff("z")}Z`,
  a2: String = `${eff("a")}A`,
}: String {
  `${a}${p}${z}${a2}`
}

@exptest
fun main(): void {
  print_raw(`|${f(1)}|\n`)
}
module end;
