module Runtime_MixedParams;
// A function with both positional and named parameters.
fun f(a: Int){b: String}: String {
  b + a.toString()
}

// A positional parameter with a default, next to named parameters.
fun g(a: Int = 5){b: Int}: Int {
  a + b
}

fun idm<T>(x: T): T {
  x
}

fun mk(a: Int){b: Int}: (Int) -> Int {
  x -> x + a * 10 + b
}

fun fm(a: Int){b: Int}: (Int){c: Int} -> Int {
  (x: Int){c: Int} -> a + b + x + c
}

class C() {
  fun m(x: Int){y: String = "d"}: String {
    y + x.toString()
  }

  static fun s(x: Int){y: Int}: Int {
    x * y
  }
}

@exptest
fun main(): void {
  c = C();
  print_raw(
    `${f(1){b => "a"}}${f{b => "b"}(2)}${g{b => 1}}${g(2){b => 3}}` +
      `${c.m(3)}${c.m(4){y => "e"}}${c.m{y => "f"}(8)}` +
      `${C::s(6){y => 7}}${C::s{y => 9}(2)}` +
      `${idm(g)(2){b => 3}}${mk(1){b => 2}(3)}${fm(1){b => 2}(3){c => 4}}\n`,
  )
}
module end;
