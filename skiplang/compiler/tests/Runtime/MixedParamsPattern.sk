module Runtime_MixedParamsPattern;
// Class patterns on mixed-constructor classes, in both group orders, plus
// 'is' patterns. Exhaustiveness checking treats both groups.
class C(a: Int){b: Int} {
  fun get(): String {
    `${this.a}-${this.b}`
  }
}

fun f(c: C): String {
  c match {
  | C(1){b => 2} -> "one-two"
  | C(x){b => y} -> `${x}-${y}`
  }
}

fun g(c: C): String {
  c match {
  | C{b => 5}(a) -> `named-first-${a}`
  | _ -> "other"
  }
}

fun h(c: C): String {
  c match {
  | C(1){b => _} -> "one"
  | _ -> "other"
  }
}

// Named-first mixed constructor, matched in both group orders.
class N{b: Int}(a: Int) {
  fun get(): String {
    `${this.a}-${this.b}`
  }
}

fun k(c: N): String {
  c match {
  | N{b => 1}(a) -> `nf-${a}`
  | N{b => _}(_) -> "other"
  }
}

// Matching a parent pattern when a child constructor is mixed.
base class B2(a: Bool)
class C2(y: Bool){x: Bool} extends B2

fun m2(b: B2): String {
  b match {
  | B2(true) -> "1"
  | B2(false) -> "2"
  }
}

@exptest
fun main(): void {
  print_raw(`[${f(C(1){b => 2})}]\n`);
  print_raw(`[${f(C(3){b => 4})}]\n`);
  print_raw(`[${g(C(7){b => 5})}]\n`);
  print_raw(`[${g(C(7){b => 6})}]\n`);
  print_raw(`[${h(C(1){b => 99})}]\n`);
  print_raw(`[${h(C(2){b => 99})}]\n`);
  x = C(9){b => 10};
  print_raw(`[${if (x is C(9){b => 10}) "is-ok" else "is-bad"}]\n`);
  print_raw(`[${if (x is C{b => 10}(9)) "is-nf" else "is-nf-bad"}]\n`);
  print_raw(`[${if (x is C(8){b => 10}) "is-bad" else "is-no"}]\n`);
  print_raw(`[${k(N{b => 1}(5))}]\n`);
  print_raw(`[${k(N{b => 2}(6))}]\n`);
  print_raw(`[${m2(C2(true, true){x => false})}]\n`);
  print_raw(`[${m2(C2(false, false){x => true})}]\n`);
}
module end;
