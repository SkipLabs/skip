module Skargo;

fun clean(): (Cli.Command, (GlobalContext, Cli.ParseResults) ~> void) {
  (
    Cli.Command("clean")
      .about("Remove the target directory")
      .arg(Cli.Arg::string("manifest-path").about("Path to Skargo.toml"))
      .arg(
        Cli.Arg::string("target")
          .value_name("TRIPLE")
          .about("Target triple to clean output for"),
      )
      .arg(
        Cli.Arg::string("target-dir")
          .value_name("PATH")
          .about("Directory for all generated artifacts"),
      )
      .args(kProfileArgs),
    execClean,
  )
}

fun clean_target_dir_name(
  target: TargetTriple,
  host_target: TargetTriple,
): String {
  if (target == host_target) kDefaultTarget else target.toString()
}

fun clean_path(
  target_dir: String,
  target_opt: ?TargetTriple,
  profile_opt: ?String,
  host_target: () -> TargetTriple,
): String {
  (target_opt, profile_opt) match {
  | (None(), None()) -> target_dir
  | (Some(t), None()) ->
    Path.join(target_dir, clean_target_dir_name(t, host_target()))
  | (Some(t), Some(profile)) ->
    Path.join(target_dir, clean_target_dir_name(t, host_target()), profile)
  | (None(), Some(profile)) -> Path.join(target_dir, kDefaultTarget, profile)
  }
}

fun execClean(gctx: GlobalContext, args: Cli.ParseResults): void {
  ws = workspace(args, gctx);
  target_opt = args.maybeGetString("target", false).map(t ->
    TargetTriple::fromString(t)
  );
  profile_opt = resolve_profile(
    args.maybeGetString("profile"),
    args.getBool("release"),
  );
  path = clean_path(ws.target_dir(), target_opt, profile_opt, () ->
    get_host_target(gctx)
  );
  p = System.subprocess(Array["rm", "-rf", path]).fromSuccess();
  if (!p.success()) {
    gctx.console.error(subprocess_error_message(p));
    skipExit(2);
  }
}

module end;
