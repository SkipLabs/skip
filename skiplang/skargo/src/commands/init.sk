module Skargo;

fun init(): (Cli.Command, (GlobalContext, Cli.ParseResults) ~> void) {
  (
    Cli.Command("init")
      .about("Create a new skargo package")
      .arg(
        Cli.Arg::string("path")
          .positional()
          .default(".")
          .about("Directory where to perform the initialization"),
      )
      .arg(
        Cli.Arg::string("test-harness")
          .short("t")
          .long("test-harness")
          .value_name("FUNCTION-NAME")
          .about("Specify the test harness"),
      ),
    execInit,
  )
}

fun execInit(gctx: GlobalContext, args: Cli.ParseResults): void {
  path = args
    .maybeGetString("path")
    .map(p -> Path.resolve(p))
    .default(getcwd());
  rootDir = path;
  optManifestFile = loop {
    if (FileSystem.exists(Path.join(path, Skargo.kManifestFile))) {
      break Some(Path.join(path, Skargo.kManifestFile))
    };
    if (Path.isRoot(path)) {
      break None()
    };
    !path = Path.parentname(path)
  };
  optManifestFile match {
  | Some(manifestFile) ->
    print_string(`\`${Path.parentname(manifestFile)}\` already initialized.`)
  | _ ->
    srcDir = Path.join(rootDir, "src");
    mkdir = System.subprocess(Array["mkdir", "-p", "--", srcDir]).fromSuccess();
    if (mkdir.exitcode() != 0) {
      gctx.console.error(subprocess_error_message(mkdir));
      skipExit(1)
    };
    manifestFile = Path.join(rootDir, Skargo.kManifestFile);
    name = Path.basename(rootDir);
    FileSystem.writeTextFile(
      manifestFile,
      generateManifestTemplate(name, args.maybeGetString("test-harness")),
    );
    mainFile = Path.join(srcDir, "main.sk");
    if (!FileSystem.exists(mainFile)) {
      FileSystem.writeTextFile(
        mainFile,
        "module Main;\n\nfun main(): void {\n  print_string(\"Hello, world!\")\n}\n\nmodule end;\n",
      )
    }
  }
}

private fun generateManifestTemplate(
  name: String,
  optTestHarness: ?String = None(),
  version: String = "0.1.0",
): String {
  !name = name.replace("\\", "\\\\").replace("\"", "\\\"");
  Array["[package]", `name = "${name}"`, `version = "${version}"`].concat(
    optTestHarness.map(th -> Array[`test-harness = "${th}"`]).default(Array[]),
  )
    .concat(
      Array[
        "",
        "[dependencies]",
        "# The installed standard library is linked automatically.",
        "#depname = { \"path\" = \"deppath\" }",
        "",
        "[[bin]]",
        `name = "${name}"`,
        "main = \"Main.main\"",
        "",
      ],
    )
    .join("\n");
}

module end;
