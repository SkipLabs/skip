module alias T = SKTest;

module SKWorldTest;

fun run(cmd: String): void {
  _ = system(cmd);
}

// Unique temp dir per test to avoid collisions when tests run in parallel.
fun tmpDir(name: String): String {
  `/tmp/skworld_${name}_${Time.time_ms()}`
}

@test
fun testStat(): void {
  tmpPath = tmpDir("stat");

  // Setup: create temp directory and file
  run(`mkdir -p ${tmpPath}`);
  run(`echo -n hello > ${tmpPath}/file.txt`);
  run(`mkdir ${tmpPath}/subdir`);

  SKStore.runWithGc(SKStore.Context::create{}, context ~> {
    world = SKWorld.World::create(context);

    // Test stat on a file
    fileStat = world.fs.stat(context, `${tmpPath}/file.txt`);
    fileStat match {
    | SKWorld.FSStatFound(s) ->
      T.expectEq(s.kind(), FKRegular(), "file kind");
      T.expectTrue(s.mtime > 0, "file mtime > 0");
      T.expectEq(s.size, 5, "file size")
    | _ -> T.fail("Expected FSStatFound for file")
    };

    // Test stat on a directory
    dirStat = world.fs.stat(context, `${tmpPath}/subdir`);
    dirStat match {
    | SKWorld.FSStatFound(s) -> T.expectEq(s.kind(), FKDirectory(), "dir kind")
    | _ -> T.fail("Expected FSStatFound for directory")
    };

    // Test stat on non-existent path
    missingStat = world.fs.stat(context, `${tmpPath}/nonexistent`);
    T.expectTrue(
      missingStat is SKWorld.FSStatNotFound _,
      "missing is FSStatNotFound",
    );

    SKStore.CStop(None())
  });

  run(`rm -rf ${tmpPath}`);
}

@test
fun testReadTextFile(): void {
  tmpPath = tmpDir("read");

  run(`mkdir -p ${tmpPath}`);
