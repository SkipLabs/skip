@test
fun testReadDirectory(): void {
  tmpPath = tmpDir("readdir");

  run(`mkdir -p ${tmpPath}`);
  run(`echo -n a > ${tmpPath}/a.txt`);
  run(`echo -n b > ${tmpPath}/b.txt`);
  run(`mkdir ${tmpPath}/c`);

  SKStore.runWithGc(SKStore.Context::create{}, context ~> {
    world = SKWorld.World::create(context, SKStore.DirName::create("/world3/"));

    entries = world.fs.readDirectory(context, tmpPath);
    T.expectEq(entries, Array["a.txt", "b.txt", "c"], "directory listing");

    SKStore.CStop(None())
  });

  run(`rm -rf ${tmpPath}`);
}

@test
fun testRefresh(): void {
  tmpPath = tmpDir("refresh");

  run(`mkdir -p ${tmpPath}`);
  run(`echo -n original > ${tmpPath}/file.txt`);

  SKStore.runWithGc(SKStore.Context::create{}, context ~> {
    world = SKWorld.World::create(context, SKStore.DirName::create("/world4/"));

    // Create an input dir with a file path
    pathsDir = context.mkdir(
      SKStore.SID::keyType,
      SKStore.StringFile::type,
      SKStore.DirName::create("/paths/"),
      Array[(SKStore.SID("a"), SKStore.StringFile(`${tmpPath}/file.txt`))],
    );

    // Map file paths to their contents via eager dir
    _contentsDir = pathsDir.map(
      SKStore.SID::keyType,
      SKStore.StringFile::type,
      context,
      SKStore.DirName::create("/contents/"),
      (context, writer, key, pathIter) ~> {
        filePath = pathIter.first.value;
        content = world.fs.readTextFile(context, filePath);
        writer.set(key, SKStore.StringFile(content));
      },
    );

    // Verify initial content
    contentsDir = SKStore.DirName::create("/contents/");
    initial = context
      .unsafeGetDir(contentsDir)
      .typed()
      .getArrayRaw(SKStore.SID("a"));
    T.expectEq(
      initial.map(SKStore.StringFile::type).map(f -> f.value),
      Array["original"],
      "initial content",
    );

    // Modify file on disk
    run(`echo -n modified > ${tmpPath}/file.txt`);

    // Refresh and verify content updated
    world.signalRefresh(context);
    context.update();

    updated = context
      .unsafeGetDir(contentsDir)
      .typed()
      .getArrayRaw(SKStore.SID("a"));
    T.expectEq(
      updated.map(SKStore.StringFile::type).map(f -> f.value),
      Array["modified"],
      "content after refresh",
    );

    SKStore.CStop(None())
  });

  run(`rm -rf ${tmpPath}`);
}

@test
fun testWorld(): void {
  tmpPath = tmpDir("world");

  run(`mkdir -p ${tmpPath}`);
  run(`echo -n world > ${tmpPath}/file.txt`);

  SKStore.runWithGc(SKStore.Context::create{}, context ~> {
    world = SKWorld.World::create(context, SKStore.DirName::create("/world5/"));

    // Access filesystem through World facade
    content = world.fs.readTextFile(context, `${tmpPath}/file.txt`);
    T.expectEq(content, "world", "read via World facade");

    // Modify file and refresh via World
    run(`echo -n updated > ${tmpPath}/file.txt`);
    world.signalRefresh(context);
    context.update();

    updated = world.fs.readTextFile(context, `${tmpPath}/file.txt`);
    T.expectEq(updated, "updated", "read after World.refresh");

    SKStore.CStop(None())
  });

  run(`rm -rf ${tmpPath}`);
}

@test
fun testPath(): void {
  SKStore.runWithGc(SKStore.Context::create{}, context ~> {
    world = SKWorld.World::create(context, SKStore.DirName::create("/world6/"));

    // getcwd should return the actual process cwd
    cwd = world.path.getcwd(context);
    T.expectEq(cwd, getcwd(), "cwd matches getcwd()");

    // Resolve absolute path is identity (modulo normalization)
    T.expectEq(
      world.path.resolve(context, "/tmp/foo"),
      "/tmp/foo",
      "resolve absolute",
    );

    // Resolve relative path prepends cwd
    T.expectEq(
      world.path.resolve(context, "relative/path"),
      Path.join(getcwd(), "relative/path"),
      "resolve relative",
    );

    // Resolve with no args returns cwd
    T.expectEq(
      world.path.resolve(context),
      Path.normalize(getcwd()),
      "resolve no args",
    );

    // Resolve two paths
    T.expectEq(
      world.path.resolve(context, "/base", "sub"),
      "/base/sub",
      "resolve two paths",
    );

    // Resolve: second absolute path wins
    T.expectEq(
      world.path.resolve(context, "/base", "/other"),
      "/other",
      "resolve second absolute wins",
    );

    // Resolve three paths
    T.expectEq(
      world.path.resolve(context, "/a", "b", "c"),
      "/a/b/c",
      "resolve three paths",
    );

    SKStore.CStop(None())
  });
}

@test
fun testEnviron(): void {
  SKStore.runWithGc(SKStore.Context::create{}, context ~> {
    world = SKWorld.World::create(context, SKStore.DirName::create("/world7/"));

    // Set a test variable and refresh
    Environ.set_var("SKWORLD_TEST_VAR", "hello");
    world.signalRefresh(context);
    context.update();

    // varOpt returns Some for existing var
    T.expectEq(
      world.environ.varOpt(context, "SKWORLD_TEST_VAR"),
      Some("hello"),
      "varOpt existing",
    );

    // var returns value for existing var
    T.expectEq(
      world.environ.var(context, "SKWORLD_TEST_VAR"),
      "hello",
      "var existing",
    );

    // varOpt returns None for missing var
    T.expectEq(
      world.environ.varOpt(context, "SKWORLD_NONEXISTENT_VAR"),
      None(),
      "varOpt missing",
    );

    // Update the variable and refresh
    Environ.set_var("SKWORLD_TEST_VAR", "updated");
    world.signalRefresh(context);
    context.update();

    T.expectEq(
      world.environ.var(context, "SKWORLD_TEST_VAR"),
      "updated",
      "var after refresh",
    );

    // vars() returns all env vars as key-value pairs
    allVars = world.environ.vars(context);
    T.expectTrue(
      allVars.any(kv -> kv.i0 == "SKWORLD_TEST_VAR" && kv.i1 == "updated"),
      "vars contains SKWORLD_TEST_VAR",
    );

    // Clean up
    Environ.remove_var("SKWORLD_TEST_VAR");

    SKStore.CStop(None())
  });
}

@test
fun testArgs(): void {
  cmd = Cli.Command("test")
    .arg(Cli.Arg::bool("verbose").short("v").long("verbose"))
    .arg(Cli.Arg::string("output").short("o").long("output").default("out.txt"))
    .arg(Cli.Arg::int("jobs").short("j").long("jobs").default(4));

  SKStore.runWithGc(SKStore.Context::create{}, context ~> {
    // Test raw args (create)
    rawArgs = SKWorld.Args::create(context, SKStore.DirName::create("/args1/"));
    T.expectTrue(rawArgs.raw(context).size() >= 0, "raw args is an array");

    // Test fromParsed with values
    result = Cli.parseArgsFrom(
      cmd,
      Array["--verbose", "-o", "result.txt", "-j", "8"],
    );
    args = SKWorld.Args::fromParsed(
      context,
      result,
      SKStore.DirName::create("/args2/"),
    );

    // Typed getters
    T.expectEq(args.getBool(context, "verbose"), true, "getBool verbose");
    T.expectEq(
      args.getString(context, "output"),
      "result.txt",
      "getString output",
    );
    T.expectEq(args.getInt(context, "jobs"), 8, "getInt jobs");

    // maybeGet variants
    T.expectEq(
      args.maybeGetBool(context, "verbose"),
      Some(true),
      "maybeGetBool verbose",
    );
    T.expectEq(
      args.maybeGetString(context, "output"),
      Some("result.txt"),
      "maybeGetString",
    );
    T.expectEq(args.maybeGetInt(context, "jobs"), Some(8), "maybeGetInt");

    // Defaults
    defaultResult = Cli.parseArgsFrom(cmd, Array[]);
    defaultArgs = SKWorld.Args::fromParsed(
      context,
      defaultResult,
      SKStore.DirName::create("/args3/"),
    );
    T.expectEq(defaultArgs.getBool(context, "verbose"), false, "default bool");
    T.expectEq(
      defaultArgs.getString(context, "output"),
      "out.txt",
      "default string",
    );
    T.expectEq(defaultArgs.getInt(context, "jobs"), 4, "default int");

    SKStore.CStop(None())
  });
}

@test
fun testArgsInWorld(): void {
  cmd = Cli.Command("test").arg(Cli.Arg::bool("flag").long("flag"));
