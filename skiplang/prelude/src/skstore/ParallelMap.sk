module SKStore;

// A frozen registry of eager directories, without a mutable Context capability.
class ParallelSnapshot(private resolve: DirName ~> EagerDir) {
  fun get(dirName: DirName): EagerDir {
    this.resolve(dirName)
  }
}

// One reader per source row. Its log and all scratch allocation are local.
mutable class ParallelReader private {
  private snapshot: ParallelSnapshot,
  private mutable requests: SortedSet<Path> = SortedSet[],
} {
  static fun create(snapshot: ParallelSnapshot): mutable this {
    mutable static{snapshot}
  }

  mutable fun getArray<K: Key, V: File>(
    handle: EHandle<K, V>,
    key: K,
  ): Array<V> {
    dir = this.snapshot.get(handle.dirName);
    this.!requests = this.requests.set(Path::create(handle.dirName, key));
    dir.getArrayRaw(key).map(handle.type)
  }

  readonly fun getRequests(): SortedSet<Path> {
    this.requests
  }
}

type ParallelMapFun<K, V, K2, V2> = (
  mutable ParallelReader,
  mutable TWriter<K2, V2>,
  K,
  Array<V>,
) ~> void;

type RawParallelMapFun = (
  mutable ParallelReader,
  mutable Writer,
  Key,
  Array<File>,
) ~> void;

// Main-thread hooks run in the source row's ordinary arrow/read scope. Their
// inputs and read logs live only until this batch has been installed.
type ParallelPrepareFun = (mutable Context, Key, Array<File>) ~> Array<File>;
type ParallelRecoverFun = (
  mutable Context,
  mutable Writer,
  Key,
  Array<File>,
  .Exception,
) ~> Bool;

class ParallelPreparation(
  inputs: Array<File>,
  reads: SortedSet<Path>,
  dirs: SortedSet<DirName>,
)
class PreparedParallelRow(
  result: ParallelRowResult,
  reads: SortedSet<Path>,
  dirs: SortedSet<DirName>,
)

class ParallelRowResult(
  writes: SortedMap<Key, Array<File>>,
  reads: SortedSet<Path>,
)

class ParallelOutcome(result: ?ParallelRowResult, exception: ?.Exception)

class ParallelMapJob(
  snapshot: ParallelSnapshot,
  parent: EagerDir,
  keys: Array<Key>,
  lambda: RawParallelMapFun,
  inputs: ?Array<Array<File>> = None(),
) {
  fun evaluate(index: Int): ParallelOutcome {
    try {
      reader = ParallelReader::create(this.snapshot);
      writer = mutable Writer{};
      key = this.keys[index];
      values = this.inputs match {
      | Some(inputs) -> inputs[index]
      | None() -> this.parent.getArrayRaw(key)
      };
      this.lambda(reader, writer, key, values);
      ParallelOutcome(
        Some(ParallelRowResult(writer.writes, reader.getRequests())),
        None(),
      )
    } catch {
    | exn -> ParallelOutcome(None(), Some(exn))
    }
  }
}

// Exports bridge the native thread runner without assuming closure/array layouts.
@cpp_export("sk_parallel_map_evaluate")
@wasm_export("sk_parallel_map_evaluate")
fun parallelMapEvaluate(
  job: ParallelMapJob,
  start: Int,
  end: Int,
): Array<ParallelOutcome> {
  Array::fillBy(end - start, i -> job.evaluate(start + i))
}

@cpp_export("sk_parallel_map_results_create")
fun parallelMapResultsCreate(count: Int): mutable Array<ParallelOutcome> {
  Array::mfillBy(count, _ -> ParallelOutcome(None(), None()))
}

@cpp_export("sk_parallel_map_result_get")
fun parallelMapResultGet(
  results: Array<ParallelOutcome>,
  index: Int,
): ParallelOutcome {
  results[index]
}

@cpp_export("sk_parallel_map_result_set")
fun parallelMapResultSet(
  results: mutable Array<ParallelOutcome>,
  index: Int,
  value: ParallelOutcome,
): void {
  results![index] = value
}

// The Wasm C stub calls parallelMapEvaluate directly: an ordinary serial map.
@cpp_extern("SKIP_skstore_parallel_map")
@may_alloc
native fun parallelMapRun(
  job: ParallelMapJob,
  count: Int,
  workers: Int,
  retainArenas: Bool,
): Array<ParallelOutcome>;

class ParallelMapper(
  lambda: RawParallelMapFun,
  workers: Int,
  select: Key ~> Bool = _ ~> true,
  serial: ?MapFun<Key, File> = None(),
  prepareRow: ?ParallelPrepareFun = None(),
  recoverRow: ?ParallelRecoverFun = None(),
  retainWorkerArenas: Bool = false,
) extends Mapper<Key, File> {
  fun map(
    _context: mutable Context,
    _writer: mutable Writer,
    _key: Key,
    _values: mutable Iterator<File>,
  ): void {
    invariant_violation("Parallel mapper must be prepared as a batch")
  }

  fun hasWork(keys: Array<Key>): Bool {
    keys.any(this.select)
  }

  fun serialMapper(): Mapper<Key, File> {
    LambdaMapper(
      this.serial.fromSome("Nonparallel keys require a serial mapper"),
    )
  }

  fun prepare(
    context: mutable Context,
    parent: EagerDir,
    keys: Array<Key>,
    childName: DirName,
    timeStack: TimeStack,
  ): Mapper<Key, File> {
    selected = keys.filter(this.select);
    if (selected.isEmpty()) return this.serialMapper();
    preparations = this.prepareRow.map(prepare ->
      selected.map(key -> {
        arrow = TArrowKey::create{parentName => parent.dirName, childName, key};
        context.enter(arrow, timeStack);
        savedReads = context.reads;
        savedDirs = context.newDirs;
        context.!reads = SortedSet[];
        context.!newDirs = SortedSet[];
        try {
          inputs = prepare(context, key, parent.getArrayRaw(key));
          result = ParallelPreparation(
            inputs,
            context.getReads(),
            context.newDirs,
          );
          context.!reads = savedReads;
          context.!newDirs = savedDirs;
          context.leave(arrow);
          result
        } catch {
        | ex ->
          context.!reads = savedReads;
          context.!newDirs = savedDirs;
          context.leave(arrow);
          throw ex
        }
      })
    );
    job = ParallelMapJob(
      context.parallelSnapshot(),
      parent,
      selected,
      this.lambda,
      preparations.map(rows -> rows.map(row -> row.inputs)),
    );
    outcomes = parallelMapRun(
      job,
      selected.size(),
      this.workers,
      this.retainWorkerArenas,
    );
    results = SortedMap[];
    for (i in Range(0, selected.size())) {
      key = selected[i];
      preparedReads = preparations
        .map(rows -> rows[i].reads)
        .default(SortedSet[]);
      preparedDirs = preparations
        .map(rows -> rows[i].dirs)
        .default(SortedSet[]);
      outcome = outcomes[i];
      result = outcome.exception match {
      | None() -> outcome.result.fromSome()
      | Some(ex) ->
        recover = this.recoverRow match {
        | Some(recover) -> recover
        | None() -> throw ex
        };
        arrow = TArrowKey::create{parentName => parent.dirName, childName, key};
        context.enter(arrow, timeStack);
        savedReads = context.reads;
        savedDirs = context.newDirs;
        context.!reads = preparedReads;
        context.!newDirs = preparedDirs;
        try {
          writer = mutable Writer{};
          if (!recover(context, writer, key, parent.getArrayRaw(key), ex)) {
            throw ex
          };
          recovered = ParallelRowResult(writer.writes, SortedSet[]);
          !preparedReads = context.getReads();
          !preparedDirs = context.newDirs;
          context.!reads = savedReads;
          context.!newDirs = savedDirs;
          context.leave(arrow);
          recovered
        } catch {
        | failure ->
          context.!reads = savedReads;
          context.!newDirs = savedDirs;
          context.leave(arrow);
          throw failure
        }
      };
      !results = results.set(
        key,
        PreparedParallelRow(result, preparedReads, preparedDirs),
      );
    };
    ParallelReplayMapper(results, this.serial, !this.retainWorkerArenas)
  }

  fun ==(other: Mapper<Key, File>): Bool {
    Unsafe.maybeCast(other, ParallelMapper) match {
    | Some(o) ->
      this.workers == o.workers &&
        native_eq(this.lambda, o.lambda) == 0 &&
        native_eq(this.select, o.select) == 0 &&
        native_eq(this.serial, o.serial) == 0 &&
        native_eq(this.prepareRow, o.prepareRow) == 0 &&
        native_eq(this.recoverRow, o.recoverRow) == 0 &&
        this.retainWorkerArenas == o.retainWorkerArenas
    | _ -> false
    }
  }
}

class ParallelReplayMapper(
  results: SortedMap<Key, PreparedParallelRow>,
  serial: ?MapFun<Key, File>,
  collect: Bool = true,
) extends Mapper<Key, File> {
  fun collectsRows(): Bool {
    this.collect
  }

  fun map(
    context: mutable Context,
    writer: mutable Writer,
    key: Key,
    values: mutable Iterator<File>,
  ): void {
    prepared = this.results.maybeGet(key) match {
    | None() -> return this.serial.fromSome()(context, writer, key, values)
    | Some(row) -> row
    };
    context.!reads = context.reads.union(prepared.reads);
    context.!newDirs = context.newDirs.union(prepared.dirs);
    result = prepared.result;
    for (path in result.reads) {
      // Match Handle.getArray: track both directory replacement and row writes.
      dir = context.getEagerDir(path.dirName);
      _ = dir.getArray(context, path.baseName);
    };
    writer.!writes = result.writes;
  }

  fun ==(other: Mapper<Key, File>): Bool {
    native_eq(this, other) == 0
  }
}

module end;
