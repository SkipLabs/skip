/*****************************************************************************/
/* Lazy directories. */
/*****************************************************************************/
module SKStore;

class CyclicExn(Key) extends Exception {
  fun toString(): String {
    inspect(this).toString()
  }
}

base class LazyResult<F> {
  children =
  | LDefined(Array<F>, Array<Path>)
  | LRemoved(Array<Path>)
  | LCycle()
  | LAbsent()
}

base class LazyCompute<K: frozen, F: frozen> uses Unsafe.Downcastable, Equality{
  fun compute(mutable Context, DirName, K): ?Array<F>;
}

class LambdaLazyCompute<K: frozen, F: frozen>(
  lambda: (mutable Context, DirName, K) ~> ?Array<F>,
) extends LazyCompute<K, F> {
  fun compute(context: mutable Context, dirname: DirName, key: K): ?Array<F> {
    this.lambda(context, dirname, key)
  }

  fun ==(other: LazyCompute<K, F>): Bool {
    Unsafe.maybeCast(other, LambdaLazyCompute<K, F>) match {
    | Some(o) -> native_eq(this.lambda, o.lambda) == 0
    | _ -> false
    }
  }
}

base class LazyDir protected {protected collect: Bool} extends Dir {
  /* Updates the lazyGets ref counts and return as well a potentially updated
    LazyDir in which dead keys have been removed. */
  fun updateLazyGets(
    refCountsOpt: ?KeyMap<Int>,
    newKeysOpt: ?KeySet,
    deadKeysOpt: ?KeySet,
  ): (?KeyMap<Int>, ?this);

  fun update(
    context: mutable Context,
    dirtyReadersOpt: ?SortedMap<DirName, KeySet>,
  ): void;

  fun typed(): TLazyDir;
}

class TLazyDir{
  protected data: SortedMap<Key, LazyResult<File>> = SortedMap[],
  protected compute: LazyCompute<Key, File>,
  // Fixed with the directory, including snapshots. This changes only cache
  // maintenance, never the retention window or dependency invalidation.
  private deltaRetention: Bool = Environ.varOpt(
    "SKSTORE_DELTA_LAZY_RETENTION",
  ).isSome(),
} extends LazyDir, TDir {
  fun updateLazyGets(
    refCountsOpt: ?KeyMap<Int>,
    newKeysOpt: ?KeySet,
    deadKeysOpt: ?KeySet,
  ): (?KeyMap<Int>, ?this) {
    refCounts = this.castOrEmptyKeyMap(refCountsOpt);
    previousRefCounts = refCounts;
    newKeys = this.castOrEmptyKeySet(newKeysOpt);
    deadKeys = this.castOrEmptyKeySet(deadKeysOpt);

    toRemove = mutable Vector[];
    if (
      this.deltaRetention &&
      newKeys.inner.size() + deadKeys.inner.size() < refCounts.inner.size() / 8
    ) {
      // A tiny update must not rebuild a large retained count map. A key read
      // in both the entering and expiring batch has no net count change.
      for (key in newKeys.values()) {
        if (!deadKeys.inner.contains(key)) {
          !refCounts[key] = refCounts.inner.maybeGet(key).default(0) + 1
        }
      };
      for (key in deadKeys.values()) {
        if (newKeys.inner.contains(key)) continue;
        refCounts.inner.maybeGet(key) match {
        | None() -> void
        | Some(1) ->
          toRemove.push(key);
          !refCounts = refCounts.remove(key)
        | Some(count) -> !refCounts[key] = count - 1
        }
      }
    } else {
      !refCounts = refCounts.mergeWith2(
        newKeys.getInner(),
        deadKeys.getInner(),
        (key, refCountOpt, newOpt, deadOpt) -> {
          (refCountOpt, newOpt, deadOpt) match {
          | (_, None(), None())
          | (_, Some(void), Some(void)) ->
            refCountOpt
          | (None(), None(), Some(void)) ->
            // Not found, but since the aim is to remove them, we can do nothing.
            refCountOpt
          | (Some(1), None(), Some(void)) ->
            toRemove.push(key);
            None()
          | _ ->
            Some(
              refCountOpt.default(0) +
                newOpt.maybe(0, (_: void) -> 1) -
                deadOpt.maybe(0, (_: void) -> 1),
            )
          }
        },
      )
    };
    dirOpt = if (toRemove.isEmpty()) None() else {
      Some(
        if (this.deltaRetention && toRemove.size() > this.data.size() / 8) {
          // Expiring a cold-build batch can retire almost every row. Merge
          // ordered maps once instead of copying a search path for each row.
          // Use the OLD counts: only a final reference leaving without a new
          // read expires, exactly as in the count update above.
          this with {
            data => this.data.mergeWith2(
              previousRefCounts.inner,
              deadKeys.getInner().inner,
              (key, value, count, dead) -> {
                if (
                  count == Some(1) &&
                  dead.isSome() &&
                  !newKeys.inner.contains(key)
                ) {
                  value match {
                  | Some(LDefined(_, reads)) -> Some(LRemoved(reads))
                  | _ -> value
                  }
                } else {
                  value
                }
              },
            ),
          }
        } else {
          this.removeKeys(toRemove)
        },
      )
    };
    !refCountsOpt = if (refCounts.isEmpty()) None() else Some(refCounts);
    (refCountsOpt, dirOpt)
  }

  protected fun removeKeys(keys: readonly Vector<Key>): this {
    data = this.data;
    for (key in keys) {
      data.maybeGet(key) match {
      | Some(LDefined(_, reads)) -> !data[key] = LRemoved(reads)
      | _ -> void
      }
    };
    this with {data}
  }

  fun keys(): SortedSet<Key> {
    keys = SortedSet[];
    for (newKey => value in this.data) {
      if (value is LDefined _) {
        !keys = keys.set(newKey);
      };
    };
    keys
  }

  fun retentionCounts(): SortedMap<String, Int> {
    defined = 0;
    removed = 0;
    absent = 0;
    cyclic = 0;
    reads = 0;
    for (value in this.data.values()) {
      value match {
      | LDefined(_, paths) ->
        !defined = defined + 1;
        !reads = reads + paths.size()
      | LRemoved(paths) ->
        !removed = removed + 1;
        !reads = reads + paths.size()
      | LAbsent() -> !absent = absent + 1
      | LCycle() -> !cyclic = cyclic + 1
      }
    };
    SortedMap[
      "lazy_defined" => defined,
      "lazy_removed" => removed,
      "lazy_absent" => absent,
      "lazy_cyclic" => cyclic,
      "lazy_read_paths" => reads,
    ]
  }

  fun getArrayRaw(key: Key): Array<File> {
    this.data.maybeGet(key) match {
    | Some(LDefined(arr, _)) -> arr
    | _ -> Array[]
    }
  }

  fun update(
    context: mutable Context,
    dirtyReadersOpt: ?SortedMap<DirName, KeySet>,
  ): void {
    dirtyReadersOpt match {
    | None() -> void
    | Some(dirtyReaders) ->
      for (dirtyReaderDirName => dirtyReaderKeys in dirtyReaders) {
        // Dependency removal rebuilds reverse-index trees. Collect between
        // complete keys so invalidating many cached values does not retain
        // every obsolete tree version until the entire arrow finishes.
        !this = withRegionFold(
          Some(context),
          this.castKeySet(dirtyReaderKeys).values(),
          this,
          (contextOpt, key, dir) ~> {
            ctx = contextOpt.fromSome();
            oldValue = dir.data.maybeGet(key);
            if (ctx.debugMode && oldValue.isSome()) {
              path = Path::create(dirtyReaderDirName, key);
              print_string(`INVALIDATED LAZY: ${path} (dependency changed)`)
            };
            !dir.data = dir.data.remove(key);
            ctx.updateDirtyReaders(Path::create(dirtyReaderDirName, key));
            oldValue match {
            | Some(LDefined(_, reads))
            | Some(LRemoved(reads)) ->
              arrow = TArrowKey::create{
                parentName => dir.dirName,
                childName => dir.dirName,
                key,
              };
              ctx.removeDeps(arrow, reads.iterator())
            | _ -> void
            };
            dir
          },
        )
      }
    };

    context.setDir(this);
  }

  protected fun doGet(context: mutable Context, key: Key): LazyResult<File> {
    dirName = this.dirName;

    dir = context.unsafeGetLazyDir(dirName).typed();
    !dir.data[key] = LCycle();
    context.setDir(dir);

    readsCopy = context.reads;
    context.!reads = SortedSet[];

    resultOpt = try {
      this.compute.compute(context, dirName, key)
    } catch {
    | exn ->
      !dir = context.unsafeGetLazyDir(dirName).typed();
      !dir.data[key] = LAbsent();
      context.setDir(dir);
      context.!reads = readsCopy;
      throw exn
    };

    result = resultOpt match {
    | None() -> LAbsent()
    | Some(x) -> LDefined(x, context.reads.toArray())
    };

    arrowKey = TArrowKey::create{
      parentName => dirName,
      childName => dirName,
      key,
    };
    context.updateNewDeps(arrowKey, context.reads);

    !dir = context.unsafeGetLazyDir(dirName).typed();
    !dir.data[key] = result;
    context.setDir(dir);

    if (context.debugMode) {
      print_string(`WRITTEN LAZY:  ${dirName}${key}`);
    };
    context.!reads = readsCopy;
    result
  }

  fun unsafeGetArray(context: mutable Context, key: Key): Array<File> {
    if (context.isParallelReadOnly()) {
      return this.data.maybeGet(key) match {
      | Some(LDefined(values, _)) -> values
      | _ -> throw ParallelContextUnavailable()
      }
    };
    if (this.collect) {
      context.addLazyGet(this, key)
    };
    lazyResult = this.data.maybeGet(key) match {
    | Some(LCycle()) -> throw CyclicExn(key)
    | x @ None()
    | x @ Some(LRemoved _)
    | x @ Some(LAbsent()) ->
      if (x is Some(LRemoved _) && context.debugMode) {
        print_string(`LRemoved: ${this.dirName}${key}`)
      };
      arrow = TArrowKey::create{
        parentName => this.dirName,
        childName => this.dirName,
        key,
      };
      context.enter(arrow, this.timeStack);
      res = this.doGet(context, key);
      context.leave(arrow);
      res
    | Some(x) -> x
    };
    lazyResult match {
    | LDefined(arr, _reads) -> arr
    | _ -> Array[]
    }
  }

  fun getArray(context: mutable Context, key: Key): Array<File> {
    path = Path::create(this.dirName, key);
    context.addRead(path);
    this.unsafeGetArray(context, key)
  }

  fun getIter(context: mutable Context, key: Key): mutable Iterator<File> {
    this.getArray(context, key).iterator()
  }

  fun typed(): this {
    this
  }

  static fun create(
    context: mutable Context,
    dirName: DirName,
    lazyFun: (mutable Context, DirName, Key) ~> ?Array<File>,
    collect: Bool = true,
  ): Dir {
    static::createFor(context, dirName, LambdaLazyCompute(lazyFun), collect)
  }

  static fun createFor(
    context: mutable Context,
    dirName: DirName,
    compute: LazyCompute<Key, File>,
    collect: Bool = true,
  ): Dir {
    context.addRead(Path::dirTag(dirName));
    (context.fromContext.flatMap(ctx ->
      ctx.unsafeMaybeGetLazyDir(dirName)
    ) match {
    | d @ Some _ -> d
    | _ -> context.unsafeMaybeGetLazyDir(dirName)
    }) match {
    | Some(ldir) if (ldir.typed().compute == compute) ->
      if (context.debugMode) {
        print_string(`REUSING: ${dirName}`);
      };
      context.setDir(ldir);
      ldir
    | _ ->
      if (
        context.debugMode &&
        context.unsafeMaybeGetLazyDir(dirName).isSome()
      ) {
        print_string(`INVALIDATED LAZY DIR: ${dirName} (callback changed)`);
      };
      time = context.timeStamp();
      newDir = static{
        timeStack => TimeStack::create(context, time),
        dirName,
        compute,
        collect,
      };
      context.updateDirtyReaders(Path::dirTag(dirName));
      context.setDir(newDir);
      newDir
    }
  }
}

module end;
