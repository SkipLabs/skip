module Hashable;

trait .Hashable {
  // The hash method should return a 64-bit hash value. The bits do not
  // need to be scrambled, that is the responsibility of the user of this
  // method.
  overridable macro fun hash(): Int {
    h = #thisClassName.hash();
    #forEachField (#field) !h = combine(h, this.#field);
    h
  }
}

// Accumulate hash bits from n into seed using an asymmetric 1-multiply 64-bit
// mixer so both inputs diffuse across all 64 bits and combine(a, b) != combine(b, a).
fun combine<T: Hashable>(seed: Int, n: T): Int {
  a = seed + 0x9e3779b97f4a7c15;
  !a = a.xor(a.shl(17));
  !a = a.xor(a.ushr(11));
  b = n.hash() + 0x94d049bb133111eb;
  !b = b.xor(b.shl(23));
  !b = b.xor(b.ushr(13));
  x = a + b;
  !x = x.xor(x.ushr(32)) * 0xbf58476d1ce4e5b9;
  x.xor(x.ushr(32))
}

module end;

@cpp_extern("SKIP_hash")
@no_alloc
native fun unsafe_hash_native<T>(T): Int;

fun hash<T>(v: T): Int {
  unsafe_hash_native(List[v])
}
