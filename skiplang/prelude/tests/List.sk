module alias T = SKTest;

module ListTest;

@test
fun testRevAppend(): void {
  T.expectEq(List[].revAppend(List::of(1)), List[1]);
  T.expectEq(List[].revAppend(List.Cons(1, List[2, 3, 4])), List[1, 2, 3, 4]);
  T.expectEq(List[1].revAppend(List::of(2)), List[1, 2]);
  T.expectEq(List[1].revAppend(List.Cons(2, List[3, 4])), List[1, 2, 3, 4]);
  T.expectEq(List[3, 2, 1].revAppend(List::of(4)), List[1, 2, 3, 4]);
  T.expectEq(
    List[3, 2, 1].revAppend(List.Cons(4, List[5, 6])),
    List[1, 2, 3, 4, 5, 6],
  );
}

@test
fun testCollectFromIterator(): void {
  empty: Array<Int> = Array[];
  T.expectEq(empty.values().collect(List), List<Int>[]);
  T.expectEq(Array[1, 2, 3].values().collect(List), List[1, 2, 3]);
  T.expectEq(
    Array[1, 2, 3, 4, 5].values()
      .filter(x -> x % 2 == 1)
      .map(x -> x * 10)
      .collect(List),
    List[10, 30, 50],
  );
}

@test
fun testCollectFromSequence(): void {
  empty: Vector<String> = Vector[];
  T.expectEq(empty.collect(List), List<String>[]);
  T.expectEq(Array["a", "b", "c"].collect(List), List["a", "b", "c"]);
  T.expectEq(SortedSet[3, 1, 2].collect(List), List[1, 2, 3]);
  // Round-trip List -> Array / List
  T.expectEq(List[1, 2, 3].collect(Array), Array[1, 2, 3]);
  T.expectEq(List[1, 2, 3].collect(List), List[1, 2, 3]);
}

module end;
