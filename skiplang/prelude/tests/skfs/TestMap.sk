module alias T = SKTest;

module SKStoreTest;

fun keyToInt(k: SKStore.Key): Int {
  SKStore.IID::keyType(k).value
}

fun toString(f: SKStore.File): String {
  SKStore.StringFile::type(f).value
}

fun testMap(): mutable SKStore.Context {
  data = Array[
    (SKStore.IID(1), SKStore.IntFile(1)),
    (SKStore.IID(2), SKStore.IntFile(2)),
  ];
  SKStore.run(context ~> {
    dir1 = context.mkdir(
      SKStore.IID::keyType,
      SKStore.IntFile::type,
      SKStore.DirName::create("/dir1/"),
      data,
    );
    dir2 = dir1.map(
      SKStore.IID::keyType,
      SKStore.IntFile::type,
      context,
      SKStore.DirName::create("/dir2/"),
      (_context, writer, _, v) ~> writer.set(SKStore.IID(0), v.first),
    );
    _dir3 = dir2.map(
      SKStore.IID::keyType,
      SKStore.IntFile::type,
      context,
      SKStore.DirName::create("/dir3/"),
      (_context, writer, _key, values) ~> {
        writer.set(SKStore.IID(1), values.first)
      },
    );
  });
}

fun testMap2(): mutable SKStore.Context {
  dataStr1 = Array[
    (SKStore.IID(1), SKStore.StringFile("1")),
    (SKStore.IID(2), SKStore.StringFile("2")),
  ];
  dataStr2 = Array[
    (SKStore.IID(1), SKStore.StringFile("3")),
    (SKStore.IID(2), SKStore.StringFile("4")),
  ];
  SKStore.run(context ~> {
    dirStr1 = context.mkdir(
      SKStore.IID::keyType,
      SKStore.StringFile::type,
      SKStore.DirName::create("/dirStr1/"),
      dataStr1,
    );
    dirStr2 = context.mkdir(
      SKStore.IID::keyType,
      SKStore.StringFile::type,
      SKStore.DirName::create("/dirStr2/"),
      dataStr2,
    );
    dir1 = dirStr1.map(
      SKStore.IID::keyType,
      SKStore.IntFile::type,
      context,
      SKStore.DirName::create("/dir1/"),
      ((_context, writer, key, values) ~>
        writer.set(key, SKStore.IntFile(values.first.value.toInt()))),
    );
    dir2 = dirStr2.map(
      SKStore.IID::keyType,
      SKStore.IntFile::type,
      context,
      SKStore.DirName::create("/dir2/"),
      ((_, writer, key, values) ~>
        writer.set(key, SKStore.IntFile(values.first.value.toInt()))),
    );
    _dir3 = dir1.map(
      SKStore.IID::keyType,
      SKStore.IntFile::type,
      context,
      SKStore.DirName::create("/dir3/"),
      (context, writer, key, values) ~> {
        dirName = SKStore.DirName::create("/dir3/" + key + "/");
        _ = dir2.map(
          SKStore.IID::keyType,
          SKStore.IntFile::type,
          context,
          dirName,
          (_, writer, key, values) ~> writer.setArray(key, values.toArray()),
        );
        writer.set(key, values.first);
      },
    );
  });
}

@test
fun testMultiMap(): void {
  dirName1 = SKStore.DirName::create("/sinput1/");
  dirName2 = SKStore.DirName::create("/sinput2/");
  dirNameResult = SKStore.DirName::create("/result/");
  context = SKStore.run(context ~> {
    dir1 = context.mkdir(
      SKStore.IID::keyType,
      SKStore.StringFile::type,
      dirName1,
      Array[
        (SKStore.IID(0), SKStore.StringFile("0")),
        (SKStore.IID(1), SKStore.StringFile("0")),
      ],
    );
    dir2 = context.mkdir(
      SKStore.IID::keyType,
      SKStore.StringFile::type,
      dirName2,
      Array[
        (SKStore.IID(0), SKStore.StringFile("1")),
        (SKStore.IID(1), SKStore.StringFile("1")),
      ],
    );
    _res = SKStore.EHandle::multiMap(
      SKStore.IID::keyType,
      SKStore.StringFile::type,
      context,
      Array[
        (
          dir1,
          (
            (_ctx, writer, key, values) ~>
              writer.set(
                key,
                SKStore.StringFile("0" + values.first.value.toString()),
              ),
            None(),
          ),
        ),
        (
          dir2,
          (
            (_ctx, writer, key, values) ~>
              writer.set(
                key,
                SKStore.StringFile("1" + values.first.value.toString()),
              ),
            None(),
          ),
        ),
      ],
      dirNameResult,
    );
  });

  tick = context.getTick();
  context.update();
  (_, changedKeys) = context
    .unsafeGetEagerDir(dirNameResult)
    .getChangesAfter(tick);
  T.expectEq(
    Array<SKStore.Key>[SKStore.IID(0), SKStore.IID(1)],
    changedKeys.collect(Array).sorted(),
    "Test multiMap 0",
  );
  T.expectEq(
    getData(context, dirNameResult, SKStore.IID(0))
      .map(x -> SKStore.StringFile::type(x).value)
      .sorted(),
    Array["00", "11"],
  );
  !tick = context.getTick();
  write(context, dirName1, SKStore.IID(0), Array[]);
  write(context, dirName2, SKStore.IID(1), Array[SKStore.StringFile("22")]);
  context.update();
  (_, !changedKeys) = context
    .unsafeGetEagerDir(dirNameResult)
    .getChangesAfter(tick);
  T.expectEq(
    Array[0, 1],
    changedKeys.collect(Array).sorted().map(keyToInt),
    "Test multiMap 1",
  );
  T.expectEq(
    getData(context, dirNameResult, SKStore.IID(0)).map(toString),
    Array["11"],
  );
  T.expectEq(
    getData(context, dirNameResult, SKStore.IID(1))
      .map(x -> SKStore.StringFile::type(x).value)
      .sorted(),
    Array["00", "122"],
  );
}

@test
fun testMultiMapSameParent(): void {
  dirName1 = SKStore.DirName::create("/sinput1/");
  dirNameResult = SKStore.DirName::create("/result/");
  context = SKStore.run(context ~> {
    dir1 = context.mkdir(
      SKStore.IID::keyType,
      SKStore.StringFile::type,
      dirName1,
      Array[
        (SKStore.IID(0), SKStore.StringFile("0")),
        (SKStore.IID(1), SKStore.StringFile("1")),
      ],
    );
    _res = SKStore.EHandle::multiMap(
      SKStore.IID::keyType,
      SKStore.StringFile::type,
      context,
      Array[
        (
          dir1,
          (
            (_ctx, writer, key, values) ~> {
              writer.set(
                key,
                SKStore.StringFile("0" + values.first.value.toString()),
              )
            },
            None(),
          ),
        ),
        (
          dir1,
          (
            (_ctx, writer, key, values) ~> {
              writer.set(
                key,
                SKStore.StringFile("1" + values.first.value.toString()),
              )
            },
            None(),
          ),
        ),
      ],
      dirNameResult,
    );
  });

  tick = context.getTick();
  context.update();
  (_, changedKeys) = context
    .unsafeGetEagerDir(dirNameResult)
    .getChangesAfter(tick);
  T.expectEq(
    Array<SKStore.Key>[SKStore.IID(0), SKStore.IID(1)],
    changedKeys.collect(Array).sorted(),
    "Test multiMap 0",
  );
  T.expectEq(
    getData(context, dirNameResult, SKStore.IID(0))
      .map(x -> SKStore.StringFile::type(x).value)
      .sorted(),
    Array["00", "10"],
  );
  T.expectEq(
    getData(context, dirNameResult, SKStore.IID(1))
      .map(x -> SKStore.StringFile::type(x).value)
      .sorted(),
    Array["01", "11"],
  );

  !tick = context.getTick();
  write(context, dirName1, SKStore.IID(0), Array[]);
  write(context, dirName1, SKStore.IID(1), Array[SKStore.StringFile("2")]);
  context.update();
  (_, !changedKeys) = context
    .unsafeGetEagerDir(dirNameResult)
    .getChangesAfter(tick);
  T.expectEq(
    Array[0, 1],
    changedKeys.collect(Array).sorted().map(keyToInt),
    "Test multiMap 1",
  );
  T.expectEq(
    getData(context, dirNameResult, SKStore.IID(0)).map(toString),
    Array[],
  );
  T.expectEq(
    getData(context, dirNameResult, SKStore.IID(1))
      .map(x -> SKStore.StringFile::type(x).value)
      .sorted(),
    Array["02", "12"],
  );
}

// Exercise single-map writes as their keys, dependencies, and cardinality
// change. Arrays must retain both ordering and repeated values.
@test
fun testMapWriteTransitions(): void {
  inputName = SKStore.DirName::create("/write-transitions-input/");
  depsName = SKStore.DirName::create("/write-transitions-deps/");
  outputName = SKStore.DirName::create("/write-transitions-output/");
  context = SKStore.run(context ~> {
    deps = context.mkdir(
      SKStore.IID::keyType,
      SKStore.IntFile::type,
      depsName,
      Array[
        (SKStore.IID(0), SKStore.IntFile(10)),
        (SKStore.IID(1), SKStore.IntFile(20)),
      ],
    );
    input = context.mkdir(
      SKStore.IID::keyType,
      SKStore.IntFile::type,
      inputName,
      Array[(SKStore.IID(0), SKStore.IntFile(0))],
    );
    _ = input.map(
      SKStore.IID::keyType,
      SKStore.IntFile::type,
      context,
      outputName,
      (ctx, writer, _, values) ~> {
        count = ctx
          .getGlobal("transition-calls")
          .map(SKStore.IntFile::type)
          .map(v -> v.value)
          .default(0);
        ctx.setGlobal("transition-calls", SKStore.IntFile(count + 1));
        mode = values.first.value;
        if (mode == 3) {
          writer.remove(SKStore.IID(2));
          return void
        };
        if (mode == 4) return void;
        dep = deps.getArray(ctx, SKStore.IID(if (mode == 0) 0 else 1))[0];
        writer.setArray(
          SKStore.IID(mode),
          Array[dep, SKStore.IntFile(99), dep],
        );
        if (mode == 2) writer.set(SKStore.IID(3), dep);
      },
    );
  });
  output = id -> getData(context, outputName, SKStore.IID(id)).map(toInt);
  calls = () ->
    SKStore.IntFile::type(context.getGlobal("transition-calls").fromSome())
      .value;
  T.expectEq(output(0), Array[10, 99, 10]);
  write(context, depsName, SKStore.IID(0), Array[SKStore.IntFile(11)]);
  context.update();
  T.expectEq(output(0), Array[11, 99, 11]);
  write(context, inputName, SKStore.IID(0), Array[SKStore.IntFile(1)]);
  context.update();
  T.expectEq(output(0), Array[]);
  T.expectEq(output(1), Array[20, 99, 20]);
  before = calls();
  write(context, depsName, SKStore.IID(0), Array[SKStore.IntFile(12)]);
  context.update();
  T.expectEq(calls(), before, "The obsolete dependency was removed");
  write(context, inputName, SKStore.IID(0), Array[SKStore.IntFile(2)]);
  context.update();
  T.expectEq(output(1), Array[]);
  T.expectEq(output(2), Array[20, 99, 20]);
  T.expectEq(output(3), Array[20]);
  write(context, inputName, SKStore.IID(0), Array[SKStore.IntFile(3)]);
  context.update();
  T.expectEq(output(2), Array[]);
  T.expectEq(output(3), Array[]);
  write(context, inputName, SKStore.IID(0), Array[SKStore.IntFile(4)]);
  context.update();
  write(context, inputName, SKStore.IID(0), Array[SKStore.IntFile(0)]);
  context.update();
  T.expectEq(output(0), Array[12, 99, 12]);
  write(context, inputName, SKStore.IID(0), Array[]);
  context.update();
  T.expectEq(output(0), Array[]);
  removedCalls = calls();
  write(context, depsName, SKStore.IID(0), Array[SKStore.IntFile(13)]);
  context.update();
  T.expectEq(
    calls(),
    removedCalls,
    "A removed input no longer reads dependencies",
  );
}

@test
fun testMapSharedOutputRemoval(): void {
  inputName = SKStore.DirName::create("/shared-output-input/");
  outputName = SKStore.DirName::create("/shared-output-result/");
  context = SKStore.run(context ~> {
    input = context.mkdir(
      SKStore.IID::keyType,
      SKStore.IntFile::type,
      inputName,
      Array[
        (SKStore.IID(0), SKStore.IntFile(7)),
        (SKStore.IID(1), SKStore.IntFile(7)),
      ],
    );
    _ = input.map(
      SKStore.IID::keyType,
      SKStore.IntFile::type,
      context,
      outputName,
      (_, writer, _, values) ~> writer.set(SKStore.IID(0), values.first),
    );
  });
  output = () -> getData(context, outputName, SKStore.IID(0)).map(toInt);
  T.expectEq(output(), Array[7, 7]);
  write(context, inputName, SKStore.IID(0), Array[]);
  context.update();
  T.expectEq(output(), Array[7], "The second producer still contributes");
  write(context, inputName, SKStore.IID(1), Array[]);
  context.update();
  T.expectEq(output(), Array[]);
}

module end;
