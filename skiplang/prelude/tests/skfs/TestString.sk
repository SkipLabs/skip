module alias T = SKTest;

module SKStoreTest;

const str: String = "123";

@cpp_extern("SKIP_utf8_test_string")
@alloc("bounded")
native fun getUtf8(): String;

@cpp_extern("SKIP_invalid_utf8_test_string")
@alloc("bounded")
native fun getInvalidUtf8(): String;

@test
fun testString(): void {
  utf8 = getUtf8();
  iter = str.getIter();
  sub = str.sub(iter, 3);
  sub2 = str.substring(iter);
  T.expectEq(str, sub, "Compare strings");
  T.expectEq(str.hash(), sub.hash(), "Compare hashes");
  T.expectEq(str, sub2, "Compare strings sub");
  T.expectEq(str.hash(), sub2.hash(), "Compare hashes sub");
  T.expectEq("3", str.substring(iter.forward(2)), "Compare sub");
  T.expectEq(utf8.length(), 23, "Utf8 length");
  T.expectEq(String.byteSize(utf8), UInt32::truncate(65), "Utf8 byteSize");
  T.expectEq(
    utf8,
    String::fromChars(utf8.chars().toArray()),
    "Utf8 from/to chars",
  )
}

@cpp_extern("SKIP_largest_string")
@alloc("bounded")
native fun largestString(): String;

// largestString compares larger than any valid utf8, but by constructing
// strings that are not valid utf8, strings larger than largestString exist
//
// note that largestString is only mean to be used as the upper bound
// of Ranges and should only be involved in comparison operations
@test
fun testLargestString(): void {
  T.expectFalse(
    largestString() + largestString() < largestString(),
    "Largest string isn't largest",
  )
}

@test
fun testEmbeddedNul(): void {
  s1 = "foo" + Char::fromCode(0).toString() + "bar";
  s2 = "foo bar";
  T.expectEq(s1.length(), s2.length(), "length of string with embedded nul");
}

@test
fun testIsWhitespace(): void {
  // Char.isWhitespace covers the full Unicode whitespace set (Z*, C0
  // controls U+0009..U+000D, U+0085), the same set String::trim* uses (#1488).
  T.expectTrue(Chars.isWhitespace(' '), "space");
  T.expectTrue(Chars.isWhitespace('\u0009'), "tab");
  T.expectTrue(Chars.isWhitespace('\u000A'), "line feed");
  T.expectTrue(Chars.isWhitespace('\u000B'), "vertical tab");
  T.expectTrue(Chars.isWhitespace('\u000C'), "form feed");
  T.expectTrue(Chars.isWhitespace('\u000D'), "carriage return");
  T.expectTrue(Chars.isWhitespace('\u0085'), "next line");
  T.expectTrue(Chars.isWhitespace('\u00A0'), "no-break space");
  T.expectTrue(Chars.isWhitespace('\u1680'), "ogham space mark");
  T.expectTrue(Chars.isWhitespace('\u2028'), "line separator");
  T.expectTrue(Chars.isWhitespace('\u2029'), "paragraph separator");
  T.expectTrue(Chars.isWhitespace('\u202F'), "narrow no-break space");
  T.expectTrue(Chars.isWhitespace('\u3000'), "ideographic space");
  T.expectFalse(Chars.isWhitespace('a'), "letter is not whitespace");
  T.expectFalse(Chars.isWhitespace('\u200B'), "zero-width space is not Zs");
  // String::trim and Char.isWhitespace agree.
  T.expectEq("abc".trim(), "abc", "trim with no surrounding whitespace");
  T.expectEq(
    "\u00A0\u2028abc\u2029\u3000".trim(),
    "abc",
    "trim removes Unicode whitespace",
  );
  T.expectEq(
    "\t\u00A0abc \u2028".trimLeft(),
    "abc \u2028",
    "trimLeft removes Unicode whitespace",
  );
  T.expectEq(
    "\u2029 abc\u3000".trimRight(),
    "\u2029 abc",
    "trimRight removes Unicode whitespace",
  );
}

module end;
