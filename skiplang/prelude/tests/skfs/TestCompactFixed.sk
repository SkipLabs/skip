module SKStoreTest;

// Like downstream keys (e.g. skjs's FPath), compare rejects other Key classes.
class StrictCompactKey(value: Int) extends SKStore.Key {
  fun compare(other: SKStore.Key): Order {
    other match {
    | StrictCompactKey(value) -> this.value.compare(value)
    | _ -> invariant_violation("StrictCompactKey compared to another Key class")
    }
  }
}

// A mapped collection's output keys can be of another class than its source
// keys. Building its compact storage must not compare the two: Key's `!=`
// dispatches to the source key's compare, which may reject other classes.
@test
fun testCompactFixedStrictSourceKeys(): void {
  dir = SKStore.DirName::create("/compact-sources/");
  rows = mutable Vector[];
  for (i in Range(0, 10)) {
    rows.push(
      SKStore.FixedRow(
        (SKStore.IID(i) : SKStore.Key),
        Array[(SKStore.IntFile(i) : SKStore.File)],
        SKStore.Path::create(dir, StrictCompactKey(i)),
        SKStore.TickRange::create(SKStore.Tick(1)),
      ),
    );
  };
  compact = SKStore.CompactFixedDir::create(rows);
  invariant(compact is SKStore.SharedSingletonFixedDir _);
  for (i in Range(0, 10)) {
    key = SKStore.IID(i);
    invariant(compact.getArray(key).size() == 1);
    invariant(
      compact
        .getArraySourceKey(SKStore.Path::create(dir, StrictCompactKey(i)), key)
        .size() == 1,
    );
  }
}

// End to end: map StrictCompactKey-keyed input to IID-keyed outputs.
@test
fun testCompactFixedStrictSourceKeysMap(): void {
  input = SKStore.DirName::create("/strict-input/");
  output = SKStore.DirName::create("/strict-output/");
  context = SKStore.run(context ~> {
    source = context.mkdir(
      StrictCompactKey::keyType,
      SKStore.IntFile::type,
      input,
      Array[
        (StrictCompactKey(0), SKStore.IntFile(10)),
        (StrictCompactKey(1), SKStore.IntFile(11)),
      ],
    );
    _ = source.map(
      SKStore.IID::keyType,
      SKStore.IntFile::type,
      context,
      output,
      (_context, writer, key, values) ~> {
        writer.set(SKStore.IID(key.value), values.first)
      },
    );
  });
  dir = context.unsafeGetEagerDir(output);
  for (i in Range(0, 2)) {
    files = dir.getArrayRaw(SKStore.IID(i));
    invariant(files.size() == 1);
    invariant(SKStore.IntFile::type(files[0]).value == 10 + i);
  }
}

// Two more strict key classes, so a map chain can use a distinct class at each
// level, like skjs's FPath -> CGNode -> CGNode call graph.
class StrictMidKey(value: Int) extends SKStore.Key {
  fun compare(other: SKStore.Key): Order {
    other match {
    | StrictMidKey(value) -> this.value.compare(value)
    | _ -> invariant_violation("StrictMidKey compared to another Key class")
    }
  }
}

class StrictOutKey(value: Int) extends SKStore.Key {
  fun compare(other: SKStore.Key): Order {
    other match {
    | StrictOutKey(value) -> this.value.compare(value)
    | _ -> invariant_violation("StrictOutKey compared to another Key class")
    }
  }
}

// Single-key forwarding stores MInfoSingle(outputKey) per source. Building the
// source map must not compare the output key with the source key: here the
// output key's compare is the one that rejects the source key's class.
@test
fun testCompactFixedStrictForwardedKeys(): void {
  dir = SKStore.DirName::create("/strict-forwarded/");
  deps = mutable Vector[];
  for (i in Range(0, 10)) {
    deps.push(
      (
        SKStore.Path::create(dir, StrictCompactKey(i)),
        (SKStore.MInfoSingle(StrictMidKey(i)) : SKStore.MInfo),
      ),
    );
  };
  sourceMap = SKStore.FixedSourceMap::create(deps);
  invariant(sourceMap.size() == 10);
  for (i in Range(0, 10)) {
    sourceMap.maybeGet(SKStore.Path::create(dir, StrictCompactKey(i))) match {
    | Some(SKStore.MInfoSingle(StrictMidKey(value))) -> invariant(value == i)
    | _ -> invariant_violation("Expected the forwarded StrictMidKey")
    }
  }
}

// Compact SKDB rows keep their source key only when it differs from the row
// key. That check must not call a strict source key's compare on a RowKey.
@test
fun testCompactFixedStrictSourceKeysRows(): void {
  dir = SKStore.DirName::create("/strict-rows/");
  kinds = Array[(0, SQLParser.IASC(), SQLParser.INTEGER())];
  rows = mutable Vector[];
  for (i in Range(0, 10)) {
    values = SKDB.RowValues(Array[Some(SKDB.CInt(i))], 1);
    rows.push(
      SKStore.FixedRow(
        (SKDB.RowKey(values, kinds) : SKStore.Key),
        Array[(values : SKStore.File)],
        SKStore.Path::create(dir, StrictCompactKey(i)),
        SKStore.TickRange::create(SKStore.Tick(1)),
      ),
    );
  };
  compact = SKStore.CompactFixedDir::create(rows);
  invariant(compact is SKStore.CompactFixedDir _);
  for (i in Range(0, 10)) {
    row = compact.get(i);
    invariant(row.value.size() == 1);
    row.source.baseName match {
    | StrictCompactKey(value) -> invariant(value == i)
    | _ -> invariant_violation("Expected the StrictCompactKey source")
    }
  }
}

// End to end: a two-level map chain over three strict key classes, with
// single-key forwarding at each level, then an update that rewrites both
// levels and purges them.
@test
fun testCompactFixedStrictKeysMapChain(): void {
  input = SKStore.DirName::create("/strict-chain-input/");
  middle = SKStore.DirName::create("/strict-chain-middle/");
  output = SKStore.DirName::create("/strict-chain-output/");
  size = 4;
  context = SKStore.run(context ~> {
    source = context.mkdir(
      StrictCompactKey::keyType,
      SKStore.IntFile::type,
      input,
      Array::fillBy(size, i -> (StrictCompactKey(i), SKStore.IntFile(10 + i))),
    );
    mid = source.map(
      StrictMidKey::keyType,
      SKStore.IntFile::type,
      context,
      middle,
      (_context, writer, key, values) ~> {
        writer.set(StrictMidKey(key.value), values.first)
      },
    );
    _ = mid.map(
      StrictOutKey::keyType,
      SKStore.IntFile::type,
      context,
      output,
      (_context, writer, key, values) ~> {
        writer.set(StrictOutKey(key.value), values.first)
      },
    );
  });
  check = (expected: Int ~> Int) -> {
    for (i in Range(0, size)) {
      files = getData(context, output, StrictOutKey(i));
      invariant(files.size() == 1);
      invariant(SKStore.IntFile::type(files[0]).value == expected(i));
    }
  };
  check(i ~> 10 + i);
  for (i in Range(0, size)) {
    write(context, input, StrictCompactKey(i), Array[SKStore.IntFile(20 + i)]);
    context.update();
  };
  check(i ~> 20 + i);
  // Every row was rewritten, so both mapped directories are queued for
  // purging, which rebuilds their fixed data and source maps.
  context.purge();
  check(i ~> 20 + i);
  write(context, input, StrictCompactKey(0), Array[SKStore.IntFile(30)]);
  context.update();
  check(i ~> if (i == 0) 30 else 20 + i);
}

@test
fun testCompactFixedCollections(): void {
  dir = SKStore.DirName::create("/compact/");
  rows = mutable Vector[];
  deps = mutable Vector[];
  for (i in Range(0, 100)) {
    key: SKStore.Key = SKStore.IID(99 - i);
    path = SKStore.Path::create(dir, key);
    rows.push(
      SKStore.FixedRow(
        key,
        Array[(SKStore.IntFile(i) : SKStore.File)],
        path,
        SKStore.TickRange::create(SKStore.Tick(7)),
      ),
    );
    deps.push((path, (SKStore.MInfoSingle(key) : SKStore.MInfo)));
  };
  compact = SKStore.CompactFixedDir::create(rows);
  sourceMap = SKStore.FixedSourceMap::create(deps);
  invariant(compact is SKStore.SingletonFixedDir _);
  invariant(compact.size() == 100);
  invariant(sourceMap.size() == 100);
  for (i in Range(0, 100)) {
    key: SKStore.Key = SKStore.IID(i);
    path = SKStore.Path::create(dir, key);
    invariant(compact.getArraySourceKey(path, key).size() == 1);
    invariant(compact.getArray(key).size() == 1);
    invariant(sourceMap.maybeGet(path).isSome());
    invariant(sourceMap.get(i).i0 == path);
    invariant(
      compact.getIterAfter(SKStore.Tick(7), key).collect(Array).size() == 1,
    );
    invariant(
      compact.getIterAfter(SKStore.Tick(8), key).collect(Array).size() == 0,
    );
  };
  invariant(compact.getChangesAfter(SKStore.Tick(7)).size() == 100);
  invariant(compact.getChangesAfter(SKStore.Tick(8)).isEmpty());
  invariant(sourceMap.maybeGet(SKStore.Path::iid(dir, 100)).isNone());
  other = SKStore.DirName::create("/other/");
  invariant(sourceMap.maybeGet(SKStore.Path::iid(other, 0)).isNone());
  // A mixed tick must retain per-row change information.
  rows.push(
    SKStore.FixedRow(
      (SKStore.IID(100) : SKStore.Key),
      Array[(SKStore.IntFile(100) : SKStore.File)],
      SKStore.Path::iid(dir, 100),
      SKStore.TickRange::create(SKStore.Tick(9)),
    ),
  );
  mixed = SKStore.CompactFixedDir::create(rows);
  invariant(mixed is SKStore.SharedSingletonFixedDir _);
  invariant(mixed.getChangesAfter(SKStore.Tick(8)).size() == 1);
  // Nonidentity sources must remain distinct from output keys.
  redirected = mutable Vector[
    SKStore.FixedRow(
      (SKStore.IID(0) : SKStore.Key),
      Array[(SKStore.IntFile(42) : SKStore.File)],
      SKStore.Path::iid(dir, 10),
      SKStore.TickRange::create(SKStore.Tick(3)),
    ),
  ];
  indirect = SKStore.CompactFixedDir::create(redirected);
  invariant(
    indirect
      .getArraySourceKey(SKStore.Path::iid(dir, 10), SKStore.IID(0))
      .size() == 1,
  );
  invariant(
    indirect
      .getArraySourceKey(SKStore.Path::iid(dir, 0), SKStore.IID(0))
      .size() == 0,
  );
  redirected.push(
    SKStore.FixedRow(
      (SKStore.IID(1) : SKStore.Key),
      Array[(SKStore.IntFile(1) : SKStore.File), SKStore.IntFile(2)],
      SKStore.Path::iid(other, 1),
      SKStore.TickRange::create(SKStore.Tick(4)),
    ),
  );
  fallback = SKStore.CompactFixedDir::create(redirected);
  invariant(fallback.getArray(SKStore.IID(1))[0].size() == 2);
  explicitDeps = mutable Vector[
    (
      SKStore.Path::iid(dir, 0),
      (SKStore.MInfoSingle(SKStore.IID(10)) : SKStore.MInfo),
    ),
  ];
  explicitMap = SKStore.FixedSourceMap::create(explicitDeps);
  explicitMap.get(0).i1 match {
  | SKStore.MInfoSingle(key) -> invariant(key == SKStore.IID(10))
  | _ -> invariant_violation("Expected singleton dependency")
  };
}

module end;
