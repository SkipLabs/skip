module SKBigInt;

// Internal helpers for SKBigInt: 30-bit limb arithmetic on canonical
// little-endian magnitude arrays (see UBigInt.sk / BigInt.sk for the design).

const kLimbBits: Int = 30;
const kLimbBase: Int = 1073741824; // 2^30
const kLimbMask: Int = 1073741823; // 2^30 - 1
const kDecChunk: Int = 1000000000; // 10^9 < 2^30, decimal chunk for parsing

class BigIntDivisionByZero() extends Exception {
  fun getMessage(): String {
    "BigInt division by zero"
  }
}

class BigIntNegativeExponent() extends Exception {
  fun getMessage(): String {
    "BigInt exponent must be non-negative"
  }
}

// Magnitude helpers. A magnitude is a canonical little-endian limb array
// (limbs in [0, 2^30), no trailing zero limb; the empty array is zero).

fun dropZeros(a: Array<Int>): Array<Int> {
  n = a.size();
  while (n > 0 && a[n - 1] == 0) {
    !n = n - 1;
  };
  if (n == a.size()) {
    a
  } else {
    Array::fillBy(n, i -> a[i])
  }
}

fun cmpMag(a: Array<Int>, b: Array<Int>): Order {
  if (a.size() != b.size()) {
    if (a.size() < b.size()) {
      LT()
    } else {
      GT()
    }
  } else {
    res: Order = EQ();
    done = false;
    i = a.size() - 1;
    while (i >= 0 && !done) {
      if (a[i] < b[i]) {
        !res = LT();
        !done = true;
      } else if (a[i] > b[i]) {
        !res = GT();
        !done = true;
      } else {
        !i = i - 1;
      }
    };
    res
  }
}

fun addMag(a: Array<Int>, b: Array<Int>): Array<Int> {
  n = if (a.size() > b.size()) a.size() else b.size();
  r = Vector::mfill(n + 1, 0);
  carry = 0;
  i = 0;
  while (i < n) {
    s = carry;
    if (i < a.size()) {
      !s = s + a[i];
    };
    if (i < b.size()) {
      !s = s + b[i];
    };
    r.set(i, s.and(kLimbMask));
    !carry = s.shr(kLimbBits);
    !i = i + 1;
  };
  r.set(n, carry);
  dropZeros(r.toArray())
}

// a - b, requires a >= b (magnitudes).
fun subMag(a: Array<Int>, b: Array<Int>): Array<Int> {
  r = Vector::mfill(a.size(), 0);
  borrow = 0;
  i = 0;
  while (i < a.size()) {
    d = a[i] - borrow;
    if (i < b.size()) {
      !d = d - b[i];
    };
    if (d < 0) {
      !d = d + kLimbBase;
      !borrow = 1;
    } else {
      !borrow = 0;
    };
    r.set(i, d);
    !i = i + 1;
  };
  dropZeros(r.toArray())
}

fun mulMag(a: Array<Int>, b: Array<Int>): Array<Int> {
  if (a.size() == 0 || b.size() == 0) {
    Array[]
  } else {
    r = Vector::mfill(a.size() + b.size(), 0);
    i = 0;
    while (i < a.size()) {
      ai = a[i];
      if (ai != 0) {
        carry = 0;
        j = 0;
        while (j < b.size()) {
          t = ai * b[j] + r.get(i + j) + carry; // < 2^61
          r.set(i + j, t.and(kLimbMask));
          !carry = t.shr(kLimbBits);
          !j = j + 1;
        };
        k = i + b.size();
        while (carry != 0 && k < r.size()) {
          t = r.get(k) + carry;
          r.set(k, t.and(kLimbMask));
          !carry = t.shr(kLimbBits);
          !k = k + 1;
        };
      };
      !i = i + 1;
    };
    dropZeros(r.toArray())
  }
}

// a * m for a single limb m in [0, 2^30).
fun mulMagSmall(a: Array<Int>, m: Int): Array<Int> {
  if (m == 0 || a.size() == 0) {
    Array[]
  } else {
    r = Vector::mfill(a.size() + 1, 0);
    carry = 0;
    i = 0;
    while (i < a.size()) {
      t = a[i] * m + carry; // < 2^60
      r.set(i, t.and(kLimbMask));
      !carry = t.shr(kLimbBits);
      !i = i + 1;
    };
    r.set(a.size(), carry);
    dropZeros(r.toArray())
  }
}

// a + m for a single limb m in [0, 2^30).
fun addMagSmall(a: Array<Int>, m: Int): Array<Int> {
  if (m == 0) {
    a
  } else {
    r = Vector::mfill(a.size() + 1, 0);
    carry = m;
    i = 0;
    while (i < a.size() && carry != 0) {
      t = a[i] + carry;
      r.set(i, t.and(kLimbMask));
      !carry = t.shr(kLimbBits);
      !i = i + 1;
    };
    while (i < a.size()) {
      r.set(i, a[i]);
      !i = i + 1;
    };
    r.set(a.size(), carry);
    dropZeros(r.toArray())
  }
}

// a * 2^s (magnitude).
fun shlMag(a: Array<Int>, s: Int): Array<Int> {
  if (a.size() == 0 || s == 0) {
    a
  } else {
    limbShift = s / kLimbBits;
    bitShift = s % kLimbBits;
    r = Vector::mfill(a.size() + limbShift + 1, 0);
    carry = 0;
    i = 0;
    while (i < a.size()) {
      v = a[i].shl(bitShift) + carry;
      r.set(i + limbShift, v.and(kLimbMask));
      !carry = v.shr(kLimbBits);
      !i = i + 1;
    };
    r.set(a.size() + limbShift, carry);
    dropZeros(r.toArray())
  }
}

// floor(a / 2^s) (magnitude).
fun shrMag(a: Array<Int>, s: Int): Array<Int> {
  limbShift = s / kLimbBits;
  bitShift = s % kLimbBits;
  if (limbShift >= a.size()) {
    Array[]
  } else {
    n = a.size() - limbShift;
    r = Vector::mfill(n, 0);
    i = 0;
    while (i < n) {
      v = a[i + limbShift].shr(bitShift);
      if (bitShift != 0 && i + limbShift + 1 < a.size()) {
        !v = v.or(a[i + limbShift + 1].shl(kLimbBits - bitShift));
      };
      r.set(i, v.and(kLimbMask));
      !i = i + 1;
    };
    dropZeros(r.toArray())
  }
}

// a divided by a single nonzero limb d: (quotient, remainder), 0 <= rem < d.
fun divModMagSmall(a: Array<Int>, d: Int): (Array<Int>, Int) {
  q = Vector::mfill(a.size(), 0);
  rem = 0;
  i = a.size() - 1;
  while (i >= 0) {
    cur = rem * kLimbBase + a[i]; // < 2^60
    q.set(i, cur / d);
    !rem = cur % d;
    !i = i - 1;
  };
  (dropZeros(q.toArray()), rem)
}

// Knuth's Algorithm D: a = q*b + r with 0 <= r < b; b must be nonzero.
fun divModMag(a: Array<Int>, b: Array<Int>): (Array<Int>, Array<Int>) {
  n = b.size();
  if (cmpMag(a, b) == LT()) {
    (Array[], a)
  } else if (n == 1) {
    (q, rem) = divModMagSmall(a, b[0]);
    (q, if (rem == 0) Array[] else Array[rem])
  } else {
    // Normalize so the divisor's top limb is >= 2^29 (then the quotient
    // estimates and all intermediates below fit in i64).
    top = b[n - 1];
    s = 0;
    while (top.shl(s + 1) < kLimbBase) {
      !s = s + 1;
    };
    bn = shlMag(b, s); // still n limbs: top limb of b * 2^s is in [2^29, 2^30)
    un = shlMag(a, s); // m or m+1 limbs
    m = a.size();
    q = Vector::mfill(m - n + 1, 0);
    // The remainder register always has m+1 limbs (the top one may stay 0);
    // the quotient estimate reads r[j+n], which can be index m.
    r = Vector::mfill(m + 1, 0);
    i = 0;
    while (i < un.size()) {
      r.set(i, un[i]);
      !i = i + 1;
    };
    j = m - n;
    while (j >= 0) {
      // Estimate the quotient digit from the top two remainder limbs.
      num = r.get(j + n) * kLimbBase + r.get(j + n - 1); // < 2^60
      qh = num / bn[n - 1];
      rh = num % bn[n - 1];
      correcting = true;
      while (correcting) {
        if (
          qh >= kLimbBase ||
          qh * bn[n - 2] > rh * kLimbBase + r.get(j + n - 2)
        ) {
          !qh = qh - 1;
          !rh = rh + bn[n - 1];
          if (rh >= kLimbBase) {
            !correcting = false;
          }
        } else {
          !correcting = false;
        }
      };
      // r[j..j+n] -= qh * bn. Two's-complement limb arithmetic: on i64,
      // u.and(mask) gives the correct low bits and u.shr gives floor(u / 2^30)
      // even when u < 0.
      k = 0;
      !i = 0;
      while (i < n) {
        p = qh * bn[i]; // < 2^61
        u = r.get(j + i) - k - p.and(kLimbMask);
        r.set(j + i, u.and(kLimbMask));
        !k = p.shr(kLimbBits) - u.shr(kLimbBits);
        !i = i + 1;
      };
      u = r.get(j + n) - k;
      r.set(j + n, u.and(kLimbMask));
      q.set(j, qh);
      if (u < 0) {
        // Rare add-back: qh was one too large.
        q.set(j, qh - 1);
        carry = 0;
        !i = 0;
        while (i < n) {
          t = r.get(j + i) + bn[i] + carry;
          r.set(j + i, t.and(kLimbMask));
          !carry = t.shr(kLimbBits);
          !i = i + 1;
        };
        t = r.get(j + n) + carry;
        r.set(j + n, t.and(kLimbMask));
      };
      !j = j - 1;
    };
    (dropZeros(q.toArray()), shrMag(dropZeros(r.toArray()), s))
  }
}

fun powMag(a: Array<Int>, e: Int): Array<Int> {
  result = Array[1];
  base = a;
  exp = e;
  while (exp > 0) {
    if (exp % 2 == 1) {
      !result = mulMag(result, base);
    };
    !exp = exp / 2;
    if (exp > 0) {
      !base = mulMag(base, base);
    };
  };
  result
}

fun gcdMag(a: Array<Int>, b: Array<Int>): Array<Int> {
  x = a;
  y = b;
  while (y.size() != 0) {
    qr = divModMag(x, y);
    !x = y;
    !y = qr.i1;
  };
  x
}

// Parses the decimal digits in bs[from..to) ("[0-9]+"); returns None() if
// the range is empty or contains a non-digit. The result is normalized.
fun parseDecimal(bs: readonly Bytes, from: Int, to: Int): ?Array<Int> {
  if (from >= to) {
    None()
  } else {
    valid = true;
    j = from;
    while (j < to && valid) {
      c = bs.get(j).toInt();
      if (c < 48 || c > 57) {
        !valid = false;
      } else {
        !j = j + 1;
      }
    };
    if (!valid) {
      None()
    } else {
      // Accumulate 9-digit chunks from the left (the first chunk may be
      // short): acc = acc*10^9 + chunk.
      acc = Array[];
      pos = from;
      firstLen = (to - from) % 9;
      if (firstLen == 0) {
        !firstLen = 9;
      };
      while (pos < to) {
        take = if (pos == from) firstLen else 9;
        chunk = 0;
        k = pos;
        while (k < pos + take) {
          !chunk = chunk * 10 + (bs.get(k).toInt() - 48);
          !k = k + 1;
        };
        !acc = addMagSmall(mulMagSmall(acc, kDecChunk), chunk);
        !pos = pos + take;
      };
      Some(dropZeros(acc))
    }
  }
}

// The decimal digits of a magnitude, least significant 9-digit chunk first.
fun decimalChunks(limbs: Array<Int>): Array<String> {
  parts = mutable Vector[];
  r = limbs;
  while (r.size() > 0) {
    qr = divModMagSmall(r, kDecChunk);
    parts.push(qr.i1.toString());
    !r = qr.i0;
  };
  parts.toArray()
}

// Joins decimal chunks (least significant first), padding all but the most
// significant to 9 digits.
fun joinDecimalChunks(parts: Array<String>): String {
  out = "";
  i = parts.size() - 1;
  first = true;
  while (i >= 0) {
    p = parts[i];
    if (!first) {
      while (p.length() < 9) {
        !p = "0" + p;
      };
    };
    !out = out + p;
    !first = false;
    !i = i - 1;
  };
  out
}

module end;
