module SKBigInt;

value class UBigInt private (
  private limbs: Array<Int>,
) uses Show, Orderable, Hashable {
  // Unsigned big integer: the magnitude core of BigInt. Canonical: limbs has
  // no trailing zero limb; zero is [].

  // Internal helper (normalizes); prefer fromInt/fromString.
  static fun make(limbs: Array<Int>): UBigInt {
    UBigInt(dropZeros(limbs))
  }

  static fun zero(): UBigInt {
    UBigInt(Array[])
  }

  // Magnitude of v as limbs (v may be negative, including Int::min).
  // Internal helper: magnitude limbs of v (v may be negative).
  static fun limbsOfInt(v: Int): Array<Int> {
    r = mutable Vector[];
    x = v;
    while (x != 0) {
      rem = x % kLimbBase; // sign of x; (x - rem) is exactly divisible
      !x = (x - rem) / kLimbBase;
      if (rem < 0) {
        !rem = -rem;
      };
      r.push(rem);
    };
    r.toArray()
  }

  static fun fromInt(v: Int): UBigInt {
    invariant(v >= 0, "UBigInt::fromInt: expected a non-negative Int");
    static::make(static::limbsOfInt(v))
  }

  // Parses "[0-9]+"; returns None() if invalid. Normalized ("007" -> "7").
  static fun fromString(s: String): ?UBigInt {
    parseDecimal(s.bytes(), 0, s.length()) match {
    | Some(limbs) -> Some(static::make(limbs))
    | None() -> None()
    }
  }

  fun toString(): String {
    if (this.limbs.size() == 0) {
      "0"
    } else {
      joinDecimalChunks(decimalChunks(this.limbs))
    }
  }

  fun isZero(): Bool {
    this.limbs.size() == 0
  }

  fun add(other: UBigInt): UBigInt {
    static::make(addMag(this.limbs, other.limbs))
  }

  // this - other, requires this >= other.
  fun sub(other: UBigInt): UBigInt {
    invariant(
      this.compare(other) != LT(),
      "UBigInt::sub: underflow (this < other)",
    );
    static::make(subMag(this.limbs, other.limbs))
  }

  fun mul(other: UBigInt): UBigInt {
    static::make(mulMag(this.limbs, other.limbs))
  }

  // this = q*other + r with 0 <= r < other.
  fun divMod(other: UBigInt): (UBigInt, UBigInt) {
    invariant(!other.isZero(), "UBigInt::divMod: division by zero");
    qr = divModMag(this.limbs, other.limbs);
    (static::make(qr.i0), static::make(qr.i1))
  }

  fun div(other: UBigInt): UBigInt {
    this.divMod(other).i0
  }

  fun mod(other: UBigInt): UBigInt {
    this.divMod(other).i1
  }

  // this^exp for exp >= 0.
  fun pow(exp: Int): UBigInt {
    invariant(exp >= 0, "UBigInt::pow: expected a non-negative exponent");
    static::make(powMag(this.limbs, exp))
  }

  // Greatest common divisor, always non-negative.
  fun gcd(other: UBigInt): UBigInt {
    static::make(gcdMag(this.limbs, other.limbs))
  }

  fun compare(other: UBigInt): Order {
    cmpMag(this.limbs, other.limbs)
  }
}

module end;
