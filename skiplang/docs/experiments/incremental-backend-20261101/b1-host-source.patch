+  inPrefix = true;
+  for (line in preamble.toString().split("\n")) {
+    trimmed = line.trimLeft();
+    if (inPrefix && (trimmed.isEmpty() || trimmed.startsWith(";"))) {
+      prefix.push(line)
+    } else {
+      !inPrefix = false;
+      if (trimmed.startsWith("target datalayout =") ||
+          trimmed.startsWith("target triple =") ||
+          trimmed.startsWith("source_filename =")) {
+        headers.push(line)
+      } else body.push(line)
+    }
+  };
+  prefix.toArray().concat(headers.toArray()).concat(body.toArray()).join("\n")
