+// LLVM module headers must precede definitions. A user preamble can contain a
+// global definition before the standard library's target headers. Keep leading
+// comments (and ordinary preambles' bytes) in place while hoisting those headers.
+private fun nativePreamble(config: Config.Config): String {
   preamble = mutable TextOutputStream.StringTextOutputStream{};
   for (p in config.preambles) preamble.write(FileSystem.readTextFile(p));
   for (dep in config.dependencies.values()) {
     for (p in dep.i1.preambles) preamble.write(p)
   };
