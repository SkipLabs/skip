+// Opt-in diagnostics. These counters are observational and do not become
+// dependencies of compiler callbacks. Persistent bytes are size-class-rounded
+// live allocations across the runtime's contexts, not RSS or file length.
+@allow_tracked_call
+@cpp_extern("SKIP_print_persistent_size")
+untracked native fun printCompilerPersistentBytes(): void;
+
+fun profileCompilerMemory(context: readonly SKStore.Context, label: String): void {
+  if (Environ.varOpt("SKC_MEMORY_STATS").isNone()) return void;
+  tick = context.getTick().value;
+  print_raw(`##PERSISTENT## ${tick} ${label} `);
+  printCompilerPersistentBytes();
+  // size() normally records a dependency. Use a disposable context so this
+  // diagnostic never broadens the reads of the active compiler operation.
+  diagnostic = context.clone().mclone();
+  counts = mutable Map<String, Int>[];
+  for (dir in context.listDirs()) {
+    dir match {
+    | eager @ SKStore.EagerDir _ ->
+      name = dir.getDirName().toString();
+      parts = name.split("/");
+      owner = if (parts.size() > 1) parts[1] else name;
+      counts.set(owner, counts.maybeGet(owner).default(0) + eager.size(diagnostic))
+    | _ -> void
+    }
+  };
+  for ((owner, count) in counts.items()) {
+    print_error(`##ROWS## ${tick} ${label} ${owner} ${count}\n`)
+  }
+}
