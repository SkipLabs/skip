+fun compile_incremental_module(
+  name: String,
+  contents: String,
+  config: Config.Config,
+  toolVersion: String,
+): String {
+  dir = config.output + ".llvm";
+  ll = dir + "/" + name + ".ll";
+  object = dir + "/" + name + ".o";
+  stamp = dir + "/" + name + ".flags";
+  temp = object + ".tmp";
+  args = Array[
+    "clang++", `-O${config.optLevel}`, `--target=${config.target}`,
+    "-c", ll, "-o", temp,
+  ].concat(if (config.emit == "cdylib") Array["-fPIC"] else Array[])
+    .concat(config.link_args)
+    .concat(config.dependencies.values().collect(Array).flatMap(dep -> dep.i1.links));
+  flags = toolVersion + "\n" + args.join("\n");
+  changed = !FileSystem.exists(ll) || FileSystem.readTextFile(ll) != contents;
+  if (changed || !FileSystem.exists(object) || !FileSystem.exists(stamp) ||
+      FileSystem.readTextFile(stamp) != flags) {
+    // Invalidate success before replacing the input. A failed clang must never
+    // make a retry mistake the old object for a successful compilation.
+    if (FileSystem.exists(stamp)) runShell(Array["rm", stamp], config.verbose);
+    if (changed) FileSystem.writeTextFile(ll, contents);
+    runShell(args, config.verbose);
+    runShell(Array["mv", temp, object], config.verbose);
+    FileSystem.writeTextFile(stamp, flags)
