+// Optimization hints only. Every current transaction still runs or reuses
+// its tracked result, and the complete current footprints are validated.
+private const classGroupHintsKey: String = "COMPILER_CLASS_GROUP_HINTS";
+private class ClassGroupHintsFile(
+  rounds: SortedMap<Int, SortedMap<String, SortedSet<String>>>,
+) extends SKStore.File
+
+private fun readClassGroupHints(
+  context: readonly SKStore.Context,
+): SortedMap<Int, SortedMap<String, SortedSet<String>>> {
+  context.getPersistent(classGroupHintsKey) match {
+  | Some(ClassGroupHintsFile(rounds)) -> rounds
+  | _ -> SortedMap[]
+  }
+}
+
+// Intersect old groups with today's requests. Even malformed/overlapping hints
+// cannot duplicate or omit a current family, and new families start alone.
+fun seedClassGroupPartition(
+  families: SortedSet<String>,
+  previous: SortedMap<String, SortedSet<String>>,
+): SortedMap<String, SortedSet<String>> {
+  remaining = families;
+  groups = SortedMap<String, SortedSet<String>>[];
+  for (old in previous.values()) {
+    current = old.intersection(remaining);
+    if (current.isEmpty()) continue;
+    !groups[current.min().fromSome()] = current;
+    !remaining = remaining.difference(current)
+  };
+  for (family in remaining) !groups[family] = SortedSet[family];
+  groups
+}
+
+// Called only after discovery has completed. The current manifest is a tracked
+// read, including empty membership and directory lifetime. It removes hints
+// for vanished rounds and families, including rounds now doing function work.
+fun pruneClassGroupHints(
+  context: mutable SKStore.Context,
+  roundCount: Int,
+  enabled: Bool,
+): void {
+  if (!enabled) {
+    context.removePersistent(classGroupHintsKey);
+    return void
+  };
+  kept = SortedMap<Int, SortedMap<String, SortedSet<String>>>[];
+  for ((round, groups) in readClassGroupHints(context).items()) {
+    if (round >= roundCount) continue;
+    requests: SKStore.EHandle<SKStore.Key, SKStore.File> = SKStore.EHandle(
+      (x: SKStore.Key) ~> x,
+      (x: SKStore.File) ~> x,
+      classRequestsName(round),
+    );
+    if (context.maybeGetDir(requests.dirName).isNone()) continue;
+    files = requests.getArray(context, ClassRequestFamiliesKey());
+    if (files.isEmpty()) continue;
+    families = ClassRequestFamiliesFile::type(files[0]).families;
+    if (families.isEmpty()) continue;
+    !kept[round] = seedClassGroupPartition(families, groups)
+  };
+  context.setPersistent(classGroupHintsKey, ClassGroupHintsFile(kept))
 }
 
